---

<section class="section-calcs" aria-labelledby="calcs-heading">
  <div class="container-site">
    <div class="section-header fade-up">
      <span class="eyebrow">Calculators</span>
      <h2 class="text-display-lg" id="calcs-heading" style="margin-top: 8px; color: var(--color-ink);">
        Everything you need to calculate.
      </h2>
      <p class="text-body-lg" style="color: var(--color-body); margin-top: 12px; max-width: 520px;">
        From health metrics to financial planning — fast, free, and accurate.
      </p>
    </div>

    <div class="calcs-grid">
      {calculators.map((calc, i) => (
        <div class={`fade-up stagger-${i + 1}`}>
          <CalculatorCard {...calc} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-calcs { padding: 96px 0; background: var(--color-canvas-soft); }
  .section-header { margin-bottom: 48px; }
  .calcs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 1023px) { .calcs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) { .calcs-grid { grid-template-columns: 1fr; } }
</style>
