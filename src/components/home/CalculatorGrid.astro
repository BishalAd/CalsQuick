    badge: 'New',
  },
  {
    name: 'Image Size Reducer',
    href: '/image-size-reducer',
    icon: '🖼️',
    desc: 'Compress and resize images online to reduce file size without losing quality.',
    badge: 'New',
  },
  {
    name: 'Pomodoro Timer',
    href: '/pomodoro-timer',
    icon: '🍅',
    desc: 'Stay focused and boost productivity with custom work/break intervals and task tracking.',
    badge: 'New',
  },
  {
    name: 'Countdown Timer',
    href: '/countdown-timer',
    icon: '⏱️',
    desc: 'Set custom count down timers for events, workouts, study sessions, and presentations.',
    badge: 'New',
  },
  {
    name: 'Image Cropper',
    href: '/image-cropper',
    icon: '✂️',
    desc: 'Crop, resize, rotate, and shape images using platform presets or custom ratios.',
    badge: 'New',
  },
  {
    name: 'Aspect Ratio Calculator',
    href: '/aspect-ratio-calculator',
    icon: '📐',
    desc: 'Calculate aspect ratios for images, videos, and designs',
    badge: 'New',
  },
  {
    name: 'Child Support Calculator',
    href: '/child-support-calculator',
    icon: '👨‍👩‍👧‍👦',
    desc: 'Estimate child support payments based on income and guidelines',
    badge: 'New',
  },
  {
    name: 'Compound Interest Calculator',
    href: '/compound-interest-calculator',
    icon: '📈',
    desc: 'Calculate compound interest growth over time',
    badge: 'New',
  },
  {
    name: 'Credit Card Payoff Calculator',
    href: '/credit-card-payoff-calculator',
    icon: '💳',
    desc: 'See how long it takes to pay off credit card debt',
    badge: 'New',
  },
  {
    name: 'JSON Formatter',
    href: '/json-formatter',
    icon: '{}',
    desc: 'Format, validate, and beautify JSON data',
    badge: 'New',
  },
  {
    name: 'Unit Converter',
    href: '/unit-converter',
    icon: '📏',
    desc: 'Convert between length, weight, volume, temperature, and 15+ other categories.',
    badge: 'New',
  },
  {
    name: 'PDF Merger',
    href: '/pdf-merger',
    icon: '📄',
    desc: 'Combine multiple PDF files into one document entirely in your browser.',
    badge: 'New',
  },
  {
    name: 'PDF Splitter',
    href: '/pdf-splitter',
    icon: '✂️',
    desc: 'Extract specific pages, delete pages, or split PDFs into separate files.',
    badge: 'New',
  },
  {
    name: 'PDF Tools & Security',
    href: '/pdf-tools',
    icon: '🔒',
