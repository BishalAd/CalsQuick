---
const testimonials = [
  {
    quote: "Finally a calculator site that doesn't feel like it was built in 2005. CalcQuick is clean, fast, and actually works on my phone.",
    name: 'Sarah M.',
    role: 'Fitness Coach',
    initials: 'SM',
  },
  {
    quote: "I use the tip calculator every time I'm at a restaurant. Love that it lets me split by person easily.",
    name: 'James R.',
    role: 'Software Engineer',
    initials: 'JR',
  },
  {
    quote: "The calorie calculator is spot on. It uses the right formula and actually explains the result. Bookmarked!",
    name: 'Priya K.',
    role: 'Nutritionist',
    initials: 'PK',
  },
];
---

<section class="section-testimonials" aria-labelledby="testimonials-heading">
  <div class="container-site">
    <div class="testimonials-header fade-up">
      <span class="eyebrow">Testimonials</span>
      <h2 class="text-display-lg" id="testimonials-heading" style="margin-top: 8px; color: var(--color-ink);">
        Loved by users everywhere.
      </h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <figure class={`testimonial-card card fade-up stagger-${i + 1}`} aria-label={`Testimonial from ${t.name}`}>
          <blockquote class="testimonial-quote">
            <p>"{t.quote}"</p>
          </blockquote>
          <figcaption class="testimonial-author">
            <div class="testimonial-avatar" aria-hidden="true">{t.initials}</div>
            <div>
              <div class="testimonial-name">{t.name}</div>
              <div class="testimonial-role">{t.role}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .section-testimonials { padding: 96px 0; background: var(--color-canvas); border-top: 1px solid var(--color-hairline); }
  .testimonials-header { margin-bottom: 48px; }
  .testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .testimonial-card { padding: 28px; display: flex; flex-direction: column; gap: 20px; }
  .testimonial-quote p { font-size: 15px; line-height: 24px; color: var(--color-body); font-style: normal; }
  .testimonial-author { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .testimonial-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--color-ink); color: var(--color-on-ink);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 600; flex-shrink: 0;
  }
  .testimonial-name { font-size: 14px; font-weight: 500; color: var(--color-ink); }
  .testimonial-role { font-size: 12px; color: var(--color-muted); }
  @media (max-width: 767px) { .testimonials-grid { grid-template-columns: 1fr; } }
  @media (min-width: 600px) and (max-width: 767px) { .testimonials-grid { grid-template-columns: 1fr 1fr; } }
</style>
