---
import DigitalCalculator from './DigitalCalculator.astro';

const stats = [
  { value: '40+', label: 'Calculators & Tools' },
  { value: '100%', label: 'Free forever' },
  { value: '100%', label: 'Client-side' },
  { value: '<1s', label: 'Load time' },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="container-site">
    <div class="hero-grid">
      <!-- Left Column: Copy & Stats -->
      <div class="hero-left-col">
        <!-- Eyebrow badge -->
        <div class="fade-up">
          <span class="banner-pill">
            <span class="banner-dot" aria-hidden="true"></span>
            Fast, Accurate &amp; Free Online Calculators
          </span>
        </div>

        <!-- Headline -->
        <h1 class="hero-headline fade-up stagger-1" id="hero-heading">
          Calculate anything<br />
          <span class="gradient-text">in seconds.</span>
        </h1>

        <!-- Sub -->
        <p class="hero-sub fade-up stagger-2">
          Free online calculators for health, finance, and everyday life.
          No signup. No ads. Just instant results.
        </p>

        <!-- CTA Row -->
        <div class="hero-cta fade-up stagger-3">
          <a href="/age-calculator" class="btn-primary hero-btn-primary" id="hero-cta-primary">
            Try Age Calculator
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#calculators" class="btn-secondary" id="hero-cta-secondary">
            Browse all calculators
          </a>
        </div>

        <!-- Stats row -->
        <div class="hero-stats fade-up stagger-4" aria-label="CalcQuick statistics">
          {stats.map((stat, i) => (
            <div class="hero-stat">
              <div class="hero-stat-value">{stat.value}</div>
              <div class="hero-stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Interactive Digital Calculator -->
      <div class="hero-right-col">
        <DigitalCalculator />
      </div>
    </div>
  </div>
</section>

<!-- Quick calculator search anchors -->
<div id="calculators"></div>

<style>
  .hero {
    position: relative;
    padding: 128px 0 96px;
    background: var(--color-canvas);
    overflow: hidden;
  }
  .hero-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 15% 30%, rgba(0, 112, 243, 0.12) 0%, transparent 65%),
      radial-gradient(ellipse 60% 70% at 85% 15%, rgba(121, 40, 202, 0.10) 0%, transparent 65%),
      radial-gradient(ellipse 50% 50% at 70% 85%, rgba(255, 0, 128, 0.08) 0%, transparent 65%),
      radial-gradient(ellipse 60% 40% at 40% 5%, rgba(0, 223, 216, 0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-left-col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero-right-col {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
  }
  .banner-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    padding: 6px 16px 6px 10px;
    font-size: 13px;
    color: var(--color-body);
    font-weight: 500;
    letter-spacing: -0.1px;
  }
  .banner-dot {
    width: 7px; height: 7px;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulse-dot 2s ease infinite;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4); }
    50% { opacity: 0.8; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0); }
  }
  .hero-headline {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: var(--color-ink);
    margin: 0;
  }
  .hero-sub {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 540px;
    margin: 0;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-btn-primary {
    height: 44px;
    padding: 0 22px;
    font-size: 15px;
    border-radius: var(--radius-lg);
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
    margin-top: 8px;
    width: 100%;
  }
  .hero-stat {
    flex: 1;
    padding: 0 0 0 24px;
    border-left: 1px solid var(--color-hairline);
  }
  .hero-stat:first-child {
    padding-left: 0;
    border-left: none;
  }
  .hero-stat-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.06em;
    line-height: 1.2;
  }
  .hero-stat-label {
    font-size: 12px;
    color: var(--color-muted);
    margin-top: 3px;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 1023px) {
    .hero { padding: 96px 0 64px; }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .hero-left-col {
      max-width: 720px;
    }
    .hero-right-col {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .hero { padding: 80px 0 64px; }
    .hero-headline { font-size: 42px; letter-spacing: -0.04em; }
    .hero-sub { font-size: 16px; }
    .hero-stats { gap: 0; }
    .hero-stat { padding-left: 16px; }
  }
  @media (max-width: 480px) {
    .hero-headline { font-size: 34px; }
    .hero-stats { flex-wrap: wrap; gap: 12px; }
    .hero-stat { flex: 0 0 calc(50% - 6px); border: none; padding: 0; }
  }
</style>
