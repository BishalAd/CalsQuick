<script>
  // ─── Audio ───────────────────────────────────────────────────────────────────
  function playBeep() {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = 800;
      osc.type = 'sine';
      gain.gain.value = 0.3;
      osc.start();
      osc.stop(ctx.currentTime + 0.15);
    } catch(e) {}
  }

  function playDoubleBeep() {
    playBeep();
    setTimeout(playBeep, 200);
  }

  // ─── Tab Switching ──────────────────────────────────────────────────────────
  const panels: Record<string, HTMLElement> = {
    simple: document.getElementById('simple-panel')!,
    event: document.getElementById('event-panel')!,
    interval: document.getElementById('interval-panel')!,
    presentation: document.getElementById('presentation-panel')!,
    multi: document.getElementById('multi-panel')!,
  };

  let activeMode = 'simple';

  document.querySelectorAll('.ct-mode-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.ct-mode-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const mode = (tab as HTMLElement).dataset.mode!;
      activeMode = mode;
      Object.keys(panels).forEach(k => { panels[k].style.display = k === mode ? '' : 'none'; });
      if (mode === 'event') updateEventCountdown();
      if (mode === 'multi') renderMultiTimers();
      if (mode === 'interval') renderIntervalDots();
    });
  });

  // ─── Fullscreen ─────────────────────────────────────────────────────────────
  let fsOverlay: HTMLElement | null = null;

  function openFullscreen(timeStr: string, label: string, warningClass: string = '') {
    if (fsOverlay) closeFullscreen();
    fsOverlay = document.createElement('div');
    fsOverlay.className = 'fs-overlay';
    fsOverlay.innerHTML = `
      <button class="fs-close">✕ Exit Fullscreen</button>
      <div class="fs-time ${warningClass}" id="fs-time">${timeStr}</div>
      ${label ? `<div class="fs-label">${label}</div>` : ''}
    `;
    document.body.appendChild(fsOverlay);
    fsOverlay.querySelector('.fs-close')!.addEventListener('click', closeFullscreen);
    
    // Exit on Escape
    const escHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { closeFullscreen(); document.removeEventListener('keydown', escHandler); }
    };
    document.addEventListener('keydown', escHandler);
  }

  function closeFullscreen() {
    if (fsOverlay) {
      fsOverlay.remove();
      fsOverlay = null;
    }
  }

  function updateFullscreenTime(timeStr: string) {
    if (fsOverlay) {
      const el = fsOverlay.querySelector('#fs-time');
      if (el) el.textContent = timeStr;
    }
  }

  // ─── SIMPLE COUNTDOWN ───────────────────────────────────────────────────────
  let simpleInterval: ReturnType<typeof setInterval> | null = null;
  let simpleTimeLeft = 300; // 5 min default
  let simpleTotal = 300;
  let simpleRunning = false;

  function getSimpleTotalSeconds(): number {
    const h = parseInt((document.getElementById('simple-hours') as HTMLInputElement).value) || 0;
    const m = parseInt((document.getElementById('simple-minutes') as HTMLInputElement).value) || 0;
    const s = parseInt((document.getElementById('simple-seconds') as HTMLInputElement).value) || 0;
    return h * 3600 + m * 60 + s;
  }

  function formatHMS(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    if (h > 0) return `${h}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
    return `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
  }

  function updateSimpleDisplay() {
    (document.getElementById('simple-display') as HTMLElement).textContent = formatHMS(simpleTimeLeft);
    updateFullscreenTime(formatHMS(simpleTimeLeft));
  }

  function simpleStart() {
    if (simpleRunning) return;
    if (simpleTimeLeft <= 0) {
      simpleTimeLeft = getSimpleTotalSeconds();
      simpleTotal = simpleTimeLeft;
    }
    simpleRunning = true;
    document.getElementById('simple-start-btn')!.style.display = 'none';
    document.getElementById('simple-pause-btn')!.style.display = '';
    document.getElementById('simple-status')!.textContent = 'Running...';
    
    simpleInterval = setInterval(() => {
      simpleTimeLeft--;
      updateSimpleDisplay();
      if (simpleTimeLeft <= 0) {
        simpleStop();
        playDoubleBeep();
        document.getElementById('simple-status')!.textContent = '⏰ Time\'s up!';
        if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
      }
    }, 1000);
  }

  function simplePause() {
    simpleRunning = false;
    if (simpleInterval) { clearInterval(simpleInterval); simpleInterval = null; }
    document.getElementById('simple-start-btn')!.style.display = '';
    document.getElementById('simple-pause-btn')!.style.display = 'none';
    document.getElementById('simple-status')!.textContent = 'Paused';
  }

  function simpleReset() {
    simplePause();
    simpleTimeLeft = getSimpleTotalSeconds();
    simpleTotal = simpleTimeLeft;
    updateSimpleDisplay();
    document.getElementById('simple-status')!.textContent = 'Ready';
  }

  document.getElementById('simple-start-btn')!.addEventListener('click', simpleStart);
  document.getElementById('simple-pause-btn')!.addEventListener('click', simplePause);
  document.getElementById('simple-reset-btn')!.addEventListener('click', simpleReset);
  document.getElementById('simple-fullscreen-btn')!.addEventListener('click', () => {
    const label = (document.getElementById('simple-label') as HTMLInputElement).value || 'Countdown';
    openFullscreen(formatHMS(simpleTimeLeft), label);
  });

  // Quick presets
  document.querySelectorAll('#simple-panel .preset-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const el = chip as HTMLElement;
      (document.getElementById('simple-hours') as HTMLInputElement).value = el.dataset.h || '0';
      (document.getElementById('simple-minutes') as HTMLInputElement).value = el.dataset.m || '0';
      (document.getElementById('simple-seconds') as HTMLInputElement).value = el.dataset.s || '0';
      simpleReset();
      document.querySelectorAll('#simple-panel .preset-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
    });
  });

  // ─── EVENT COUNTDOWN ────────────────────────────────────────────────────────
  let eventInterval: ReturnType<typeof setInterval> | null = null;
  let eventTargetDate: Date | null = null;

  function updateEventCountdown() {
    if (!eventTargetDate) {
      const dateStr = (document.getElementById('event-date') as HTMLInputElement).value;
      const timeStr = (document.getElementById('event-time') as HTMLInputElement).value;
      if (dateStr) {
        eventTargetDate = new Date(`${dateStr}T${timeStr || '00:00'}:00`);
      }
    }
    
    if (!eventTargetDate) return;
    
    const now = new Date().getTime();
    const diff = eventTargetDate.getTime() - now;
    
    if (diff <= 0) {
      document.getElementById('event-days')!.textContent = '0';
      document.getElementById('event-hours')!.textContent = '00';
      document.getElementById('event-minutes')!.textContent = '00';
      document.getElementById('event-seconds')!.textContent = '00';
      document.getElementById('event-status')!.textContent = '🎉 Event has arrived!';
      document.getElementById('event-progress-bar')!.style.width = '100%';
      return;
    }
    
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
    
    document.getElementById('event-days')!.textContent = String(days);
    document.getElementById('event-hours')!.textContent = hours.toString().padStart(2, '0');
    document.getElementById('event-minutes')!.textContent = minutes.toString().padStart(2, '0');
    document.getElementById('event-seconds')!.textContent = seconds.toString().padStart(2, '0');
    document.getElementById('event-label-display')!.textContent = (document.getElementById('event-label') as HTMLInputElement).value;
    
    // Progress bar (approximate for 1 year)
    const totalDuration = eventTargetDate.getTime() - (eventTargetDate.getTime() - 365 * 24 * 60 * 60 * 1000);
    const elapsed = totalDuration - diff;
    const pct = Math.min(100, Math.max(0, (elapsed / totalDuration) * 100));
    document.getElementById('event-progress-bar')!.style.width = pct + '%';
    
    document.getElementById('event-status')!.textContent = `${days} day${days !== 1 ? 's' : ''} remaining`;
  }

  document.getElementById('event-date')!.addEventListener('change', () => {
    eventTargetDate = null;
    updateEventCountdown();
  });
  document.getElementById('event-time')!.addEventListener('change', () => {
    eventTargetDate = null;
    updateEventCountdown();
  });
  document.getElementById('event-label')!.addEventListener('input', () => {
    document.getElementById('event-label-display')!.textContent = (document.getElementById('event-label') as HTMLInputElement).value;
  });

  document.querySelectorAll('.event-preset').forEach(chip => {
    chip.addEventListener('click', () => {
      const el = chip as HTMLElement;
      const dateStr = el.dataset.date!;
      const [datePart, timePart] = dateStr.split('T');
      (document.getElementById('event-date') as HTMLInputElement).value = datePart;
      (document.getElementById('event-time') as HTMLInputElement).value = timePart || '00:00';
      (document.getElementById('event-label') as HTMLInputElement).value = el.dataset.label || '';
      eventTargetDate = new Date(dateStr);
      updateEventCountdown();
      saveEventSettings();
    });
  });

  document.getElementById('event-fullscreen-btn')!.addEventListener('click', () => {
    const label = (document.getElementById('event-label') as HTMLInputElement).value || 'Event Countdown';
    const days = document.getElementById('event-days')!.textContent;
    const hours = document.getElementById('event-hours')!.textContent;
    const mins = document.getElementById('event-minutes')!.textContent;
    const secs = document.getElementById('event-seconds')!.textContent;
    openFullscreen(`${days}d ${hours}:${mins}:${secs}`, label);
  });

  function saveEventSettings() {
    try {
      localStorage.setItem('ct_event', JSON.stringify({
        date: (document.getElementById('event-date') as HTMLInputElement).value,
        time: (document.getElementById('event-time') as HTMLInputElement).value,
        label: (document.getElementById('event-label') as HTMLInputElement).value,
      }));
    } catch(e) {}
  }

  // ─── INTERVAL TIMER ─────────────────────────────────────────────────────────
  let intInterval: ReturnType<typeof setInterval> | null = null;
  let intTimeLeft = 30;
  let intPhase: 'work' | 'rest' = 'work';
  let intRound = 1;
  let intRunning = false;

  function getIntervalSettings() {
    return {
      work: parseInt((document.getElementById('work-duration') as HTMLInputElement).value) || 30,
      rest: parseInt((document.getElementById('rest-duration') as HTMLInputElement).value) || 15,
      rounds: parseInt((document.getElementById('num-rounds') as HTMLInputElement).value) || 8,
    };
  }

  function renderIntervalDots() {
    const { rounds } = getIntervalSettings();
    const container = document.getElementById('interval-dots')!;
    container.innerHTML = '';
    for (let i = 0; i < rounds; i++) {
      const dot = document.createElement('span');
      dot.className = 'interval-dot';
      if (i < intRound - 1) dot.classList.add('completed');
      if (i === intRound - 1 && intRunning) dot.classList.add('active');
      container.appendChild(dot);
    }
  }

  function updateIntervalDisplay() {
    document.getElementById('interval-display')!.textContent = String(intTimeLeft);
    document.getElementById('interval-round-info')!.textContent = `Round ${intRound} of ${getIntervalSettings().rounds}`;
    
    const phaseEl = document.getElementById('interval-phase')!;
    phaseEl.textContent = intPhase === 'work' ? '💪 WORK' : '😌 REST';
    phaseEl.className = `interval-phase ${intPhase}`;
    
    updateFullscreenTime(`${intPhase === 'work' ? 'WORK' : 'REST'} ${intTimeLeft}`);
    renderIntervalDots();
  }

  function intervalStart() {
    if (intRunning) return;
    intRunning = true;
    document.getElementById('interval-start-btn')!.style.display = 'none';
    document.getElementById('interval-pause-btn')!.style.display = '';
    
    intInterval = setInterval(() => {
      intTimeLeft--;
      updateIntervalDisplay();
      
      if (intTimeLeft <= 0) {
        playBeep();
        const { work, rest, rounds } = getIntervalSettings();
        
        if (intPhase === 'work') {
          if (rest > 0) {
            intPhase = 'rest';
            intTimeLeft = rest;
          } else {
            intRound++;
            intTimeLeft = work;
          }
        } else {
          intRound++;
          intPhase = 'work';
          intTimeLeft = work;
        }
        
        if (intRound > rounds) {
          intervalStop();
          playDoubleBeep();
          document.getElementById('interval-phase')!.textContent = '🏁 DONE!';
          document.getElementById('interval-round-info')!.textContent = 'Workout complete!';
          if (navigator.vibrate) navigator.vibrate([300, 100, 300]);
          return;
        }
        
        updateIntervalDisplay();
      }
    }, 1000);
  }

  function intervalPause() {
    intRunning = false;
    if (intInterval) { clearInterval(intInterval); intInterval = null; }
    document.getElementById('interval-start-btn')!.style.display = '';
    document.getElementById('interval-pause-btn')!.style.display = 'none';
  }

  function intervalReset() {
    intervalPause();
    intPhase = 'work';
    intRound = 1;
    intTimeLeft = getIntervalSettings().work;
    updateIntervalDisplay();
  }

  document.getElementById('interval-start-btn')!.addEventListener('click', intervalStart);
  document.getElementById('interval-pause-btn')!.addEventListener('click', intervalPause);
  document.getElementById('interval-reset-btn')!.addEventListener('click', intervalReset);
  document.getElementById('interval-fullscreen-btn')!.addEventListener('click', () => {
    openFullscreen(`${intPhase === 'work' ? 'WORK' : 'REST'} ${intTimeLeft}`, `Round ${intRound}`);
  });

  document.querySelectorAll('.interval-preset').forEach(chip => {
    chip.addEventListener('click', () => {
      const el = chip as HTMLElement;
      (document.getElementById('work-duration') as HTMLInputElement).value = el.dataset.work!;
      (document.getElementById('rest-duration') as HTMLInputElement).value = el.dataset.rest!;
      (document.getElementById('num-rounds') as HTMLInputElement).value = el.dataset.rounds!;
      intervalReset();
    });
  });

  // ─── PRESENTATION TIMER ────────────────────────────────────────────────────
  let presInterval: ReturnType<typeof setInterval> | null = null;
  let presTimeLeft = 1200; // 20 min default
  let presTotal = 1200;
  let presRunning = false;
  let presWarnings: number[] = [5, 2]; // minutes

  function getPresTotal(): number {
    const h = parseInt((document.getElementById('pres-hours') as HTMLInputElement).value) || 0;
    const m = parseInt((document.getElementById('pres-minutes') as HTMLInputElement).value) || 0;
    const s = parseInt((document.getElementById('pres-seconds') as HTMLInputElement).value) || 0;
    return h * 3600 + m * 60 + s;
  }

  function updatePresDisplay() {
    document.getElementById('pres-display')!.textContent = formatHMS(presTimeLeft);
    document.getElementById('pres-remaining')!.textContent = formatHMS(presTimeLeft);
    document.getElementById('pres-elapsed')!.textContent = formatHMS(presTotal - presTimeLeft);
    
    const pct = (presTimeLeft / presTotal) * 100;
    const bar = document.getElementById('pres-progress-bar')!;
    bar.style.width = pct + '%';
    
    const panel = document.getElementById('pres-display-panel')!;
    panel.classList.remove('warning', 'danger');
    
    if (presTimeLeft <= 60) {
      bar.style.background = '#dc2626';
      panel.classList.add('danger');
    } else if (presTimeLeft <= 300) {
      bar.style.background = '#f59e0b';
      panel.classList.add('warning');
    } else {
      bar.style.background = 'var(--color-link)';
    }
    
    // Check warnings
    const minsLeft = Math.floor(presTimeLeft / 60);
    const secsLeft = presTimeLeft % 60;
    if (presRunning && presWarnings.includes(minsLeft) && secsLeft === 0 && presTimeLeft > 0) {
      playDoubleBeep();
      if (navigator.vibrate) navigator.vibrate(200);
    }
    
    updateFullscreenTime(formatHMS(presTimeLeft));
  }

  function presStart() {
    if (presRunning) return;
    if (presTimeLeft <= 0) { presTimeLeft = getPresTotal(); presTotal = presTimeLeft; }
    presRunning = true;
    document.getElementById('pres-start-btn')!.style.display = 'none';
    document.getElementById('pres-pause-btn')!.style.display = '';
    document.getElementById('pres-status')!.textContent = 'Speaking...';
    
    presInterval = setInterval(() => {
      presTimeLeft--;
      updatePresDisplay();
      if (presTimeLeft <= 0) {
        presStop();
        playDoubleBeep();
        document.getElementById('pres-status')!.textContent = '⏰ Time\'s up!';
      }
    }, 1000);
  }

  function presPause() {
    presRunning = false;
    if (presInterval) { clearInterval(presInterval); presInterval = null; }
    document.getElementById('pres-start-btn')!.style.display = '';
    document.getElementById('pres-pause-btn')!.style.display = 'none';
    document.getElementById('pres-status')!.textContent = 'Paused';
  }

  function presReset() {
    presPause();
    presTimeLeft = getPresTotal();
    presTotal = presTimeLeft;
    updatePresDisplay();
    document.getElementById('pres-status')!.textContent = 'Ready to present';
    document.getElementById('pres-display-panel')!.classList.remove('warning', 'danger');
    (document.getElementById('pres-progress-bar') as HTMLElement).style.background = 'var(--color-link)';
  }

  document.getElementById('pres-start-btn')!.addEventListener('click', presStart);
  document.getElementById('pres-pause-btn')!.addEventListener('click', presPause);
  document.getElementById('pres-reset-btn')!.addEventListener('click', presReset);
  document.getElementById('pres-fullscreen-btn')!.addEventListener('click', () => {
    openFullscreen(formatHMS(presTimeLeft), 'Presentation Timer', presTimeLeft <= 60 ? 'fs-danger' : presTimeLeft <= 300 ? 'fs-warning' : '');
  });

  document.querySelectorAll('.pres-warning').forEach(cb => {
    cb.addEventListener('change', () => {
      presWarnings = [];
      document.querySelectorAll('.pres-warning:checked').forEach(c => {
        presWarnings.push(parseInt((c as HTMLElement).dataset.minutes!));
      });
    });
  });

  document.querySelectorAll('.pres-time-preset').forEach(chip => {
    chip.addEventListener('click', () => {
      const m = parseInt((chip as HTMLElement).dataset.m!);
      (document.getElementById('pres-minutes') as HTMLInputElement).value = String(m);
      (document.getElementById('pres-hours') as HTMLInputElement).value = '0';
      (document.getElementById('pres-seconds') as HTMLInputElement).value = '0';
      presReset();
    });
  });

  // ─── MULTI-TIMER ────────────────────────────────────────────────────────────
  interface MultiTimer {
    id: string;
    label: string;
    totalSeconds: number;
    remaining: number;
    running: boolean;
    interval: ReturnType<typeof setInterval> | null;
    color: string;
  }

  let multiTimers: MultiTimer[] = [];
  const timerColors = ['#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#f97316'];

  function renderMultiTimers() {
    const container = document.getElementById('multi-timers-container')!;
    if (multiTimers.length === 0) {
      container.innerHTML = '<div style="padding:20px;text-align:center;color:var(--color-muted);grid-column:1/-1;">No timers yet. Click "+ Add Timer" to create your first timer.</div>';
      return;
    }
    container.innerHTML = multiTimers.map((t, i) => `
      <div class="multi-timer-card">
        <div class="multi-timer-label">
          <span class="multi-timer-color" style="background:${t.color};"></span>
          ${t.label || `Timer ${i + 1}`}
        </div>
        <div class="multi-timer-display">${formatHMS(t.remaining)}</div>
        <div style="display:flex;gap:6px;justify-content:center;margin-top:10px;flex-wrap:wrap;">
          ${!t.running ? `<button class="btn-primary" style="font-size:11px;padding:6px 14px;" onclick="multiStart('${t.id}')">▶</button>` : 
                        `<button class="btn-secondary" style="font-size:11px;padding:6px 14px;" onclick="multiPause('${t.id}')">⏸</button>`}
          <button class="btn-secondary" style="font-size:11px;padding:6px 14px;" onclick="multiReset('${t.id}')">🔄</button>
          <button class="btn-secondary" style="font-size:11px;padding:6px 10px;color:#dc2626;" onclick="multiRemove('${t.id}')">✕</button>
        </div>
      </div>
    `).join('');
  }

  function addMultiTimer() {
    const label = prompt('Timer label (optional):') || '';
    const minutes = prompt('Duration in minutes:') || '5';
    const mins = parseInt(minutes) || 5;
    const total = mins * 60;
    const timer: MultiTimer = {
      id: Date.now().toString(),
      label,
      totalSeconds: total,
      remaining: total,
      running: false,
      interval: null,
      color: timerColors[multiTimers.length % timerColors.length],
    };
    multiTimers.push(timer);
    renderMultiTimers();
    saveMultiTimers();
  }

  function multiStart(id: string) {
    const t = multiTimers.find(t => t.id === id);
    if (!t || t.running) return;
    if (t.remaining <= 0) t.remaining = t.totalSeconds;
    t.running = true;
    t.interval = setInterval(() => {
      t.remaining--;
      renderMultiTimers();
      if (t.remaining <= 0) {
        multiPause(id);
        playDoubleBeep();
      }
    }, 1000);
    renderMultiTimers();
  }

  function multiPause(id: string) {
    const t = multiTimers.find(t => t.id === id);
    if (!t) return;
    t.running = false;
    if (t.interval) { clearInterval(t.interval); t.interval = null; }
    renderMultiTimers();
  }

  function multiReset(id: string) {
    const t = multiTimers.find(t => t.id === id);
    if (!t) return;
    t.running = false;
    if (t.interval) { clearInterval(t.interval); t.interval = null; }
    t.remaining = t.totalSeconds;
    renderMultiTimers();
  }

  function multiRemove(id: string) {
    const t = multiTimers.find(t => t.id === id);
    if (t && t.interval) clearInterval(t.interval);
    multiTimers = multiTimers.filter(t => t.id !== id);
    renderMultiTimers();
    saveMultiTimers();
  }

  function saveMultiTimers() {
    try {
      const data = multiTimers.map(t => ({
        id: t.id, label: t.label, totalSeconds: t.totalSeconds, remaining: t.remaining, color: t.color
      }));
      localStorage.setItem('ct_multi_timers', JSON.stringify(data));
    } catch(e) {}
  }

  function loadMultiTimers() {
    try {
      const saved = localStorage.getItem('ct_multi_timers');
      if (saved) {
        const data = JSON.parse(saved);
        multiTimers = data.map((d: any) => ({
          ...d, running: false, interval: null
        }));
      }
    } catch(e) {}
  }

  document.getElementById('add-timer-btn')!.addEventListener('click', addMultiTimer);

  // Make functions global for onclick handlers
  (window as any).multiStart = multiStart;
  (window as any).multiPause = multiPause;
  (window as any).multiReset = multiReset;
  (window as any).multiRemove = multiRemove;

  // ─── Init ──────────────────────────────────────────────────────────────────
  updateSimpleDisplay();
  
  // Load event settings
  try {
    const saved = localStorage.getItem('ct_event');
    if (saved) {
      const s = JSON.parse(saved);
      (document.getElementById('event-date') as HTMLInputElement).value = s.date || '';
      (document.getElementById('event-time') as HTMLInputElement).value = s.time || '00:00';
      (document.getElementById('event-label') as HTMLInputElement).value = s.label || '';
      if (s.date) {
        eventTargetDate = new Date(`${s.date}T${s.time || '00:00'}:00`);
      }
    }
  } catch(e) {}

  loadMultiTimers();

  // Start event countdown loop
  setInterval(() => {
    if (activeMode === 'event') updateEventCountdown();
  }, 1000);

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>