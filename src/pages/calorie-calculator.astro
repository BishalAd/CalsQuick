<script>
  let activeSystem = 'metric'; // 'metric', 'imperial', 'other'

  const ACTIVITY: Record<string, number> = {
    sedentary: 1.2,
    light: 1.375,
    moderate: 1.55,
    active: 1.725,
    very_active: 1.9,
    bmr: 1.0
  };

  const GOAL: Record<string, number> = {
    lose_fast: -1000,
    lose: -500,
    maintain: 0,
    gain: 500,
    gain_fast: 1000
  };

  const GOAL_LABEL: Record<string, string> = {
    lose_fast: 'Goal: Lose 2 lbs/week',
    lose: 'Goal: Lose 1 lb/week',
    maintain: 'Goal: Maintain weight',
    gain: 'Goal: Gain 1 lb/week',
    gain_fast: 'Goal: Gain 2 lbs/week'
  };

  // Unit switcher tabs
  const metricBtn = document.getElementById('btn-cal-metric') as HTMLButtonElement;
  const imperialBtn = document.getElementById('btn-cal-imperial') as HTMLButtonElement;
  const otherBtn = document.getElementById('btn-cal-other') as HTMLButtonElement;

  const heightMetricContainer = document.getElementById('cal-height-metric-container') as HTMLElement;
  const heightImperialContainer = document.getElementById('cal-height-imperial-container') as HTMLElement;
  const heightOtherContainer = document.getElementById('cal-height-other-container') as HTMLElement;

  const weightMetricContainer = document.getElementById('cal-weight-metric-container') as HTMLElement;
  const weightImperialContainer = document.getElementById('cal-weight-imperial-container') as HTMLElement;
  const weightOtherContainer = document.getElementById('cal-weight-other-container') as HTMLElement;

  const converterWidget = document.getElementById('converter-widget') as HTMLElement;

  function switchSystem(system: string) {
    activeSystem = system;
    
    // Toggle active classes on buttons
    metricBtn.classList.toggle('active', system === 'metric');
    metricBtn.setAttribute('aria-pressed', String(system === 'metric'));
    
    imperialBtn.classList.toggle('active', system === 'imperial');
    imperialBtn.setAttribute('aria-pressed', String(system === 'imperial'));
    
    otherBtn.classList.toggle('active', system === 'other');
    otherBtn.setAttribute('aria-pressed', String(system === 'other'));

    // Toggle forms
    heightMetricContainer.hidden = system !== 'metric';
    heightImperialContainer.hidden = system !== 'imperial';
    heightOtherContainer.hidden = system !== 'other';

    weightMetricContainer.hidden = system !== 'metric';
    weightImperialContainer.hidden = system !== 'imperial';
    weightOtherContainer.hidden = system !== 'other';

    // Show conversion widget only when Other Units is selected
    converterWidget.hidden = system !== 'other';
    
    updateUrl();
  }

  metricBtn?.addEventListener('click', () => switchSystem('metric'));
  imperialBtn?.addEventListener('click', () => switchSystem('imperial'));
  otherBtn?.addEventListener('click', () => switchSystem('other'));

  // Collapsible Settings drawer
  const settingsToggleBtn = document.getElementById('settings-toggle-btn') as HTMLButtonElement;
  const settingsDrawer = document.getElementById('settings-drawer') as HTMLElement;
  const settingsToggleIcon = document.getElementById('settings-toggle-icon') as HTMLElement;

  settingsToggleBtn?.addEventListener('click', () => {
    const isExpanded = settingsToggleBtn.getAttribute('aria-expanded') === 'true';
    settingsToggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    settingsDrawer.style.display = isExpanded ? 'none' : 'block';
    settingsToggleIcon.textContent = isExpanded ? '＋' : '－';
  });

  // BMR Formula listener to show/hide body fat percentage input
  const bmrFormulaRadios = document.getElementsByName('bmr-formula');
  const bodyFatContainer = document.getElementById('body-fat-container') as HTMLElement;

  function updateBodyFatVisibility() {
    const checkedFormula = Array.from(bmrFormulaRadios).find(r => (r as HTMLInputElement).checked) as HTMLInputElement;
    if (checkedFormula && checkedFormula.value === 'katch') {
      bodyFatContainer.hidden = false;
    } else {
      bodyFatContainer.hidden = true;
    }
  }

  bmrFormulaRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      updateBodyFatVisibility();
      updateUrl();
    });
  });

  // Embedded Unit Converter Widget functionality
  let activeConvTab = 'length'; // 'length', 'weight'
  const btnConvLength = document.getElementById('btn-conv-length') as HTMLButtonElement;
  const btnConvWeight = document.getElementById('btn-conv-weight') as HTMLButtonElement;
  
  const convInput = document.getElementById('conv-input') as HTMLInputElement;
  const convOutput = document.getElementById('conv-output') as HTMLInputElement;
  const convFromUnit = document.getElementById('conv-from-unit') as HTMLSelectElement;
  const convToUnit = document.getElementById('conv-to-unit') as HTMLSelectElement;

  const lengthUnits = [
    { value: 'm', label: 'Meter (m)' },
    { value: 'cm', label: 'Centimeter (cm)' },
    { value: 'in', label: 'Inch (in)' },
    { value: 'ft', label: 'Foot (ft)' },
    { value: 'yard', label: 'Yard' },
    { value: 'km', label: 'Kilometer (km)' }
  ];

  const weightUnits = [
    { value: 'kg', label: 'Kilogram (kg)' },
    { value: 'g', label: 'Gram (g)' },
    { value: 'lbs', label: 'Pound (lbs)' },
    { value: 'st', label: 'Stone (st)' },
    { value: 'oz', label: 'Ounce (oz)' }
  ];

  const lengthMultipliers: Record<string, number> = {
    m: 1,
    cm: 0.01,
    in: 0.0254,
    ft: 0.3048,
    yard: 0.9144,
    km: 1000
  };

  const weightMultipliers: Record<string, number> = {
    kg: 1,
    g: 0.001,
    lbs: 0.45359237,
    st: 6.35029318,
    oz: 0.0283495231
  };

  function populateConvDropdowns() {
    const list = activeConvTab === 'length' ? lengthUnits : weightUnits;
    
    // Save current values to restore if possible
    const prevFrom = convFromUnit.value;
    const prevTo = convToUnit.value;

    convFromUnit.innerHTML = '';
    convToUnit.innerHTML = '';

    list.forEach(item => {
      const optFrom = document.createElement('option');
      optFrom.value = item.value;
      optFrom.textContent = item.label;
      convFromUnit.appendChild(optFrom);

      const optTo = document.createElement('option');
      optTo.value = item.value;
      optTo.textContent = item.label;
      convToUnit.appendChild(optTo);
    });

    // Restore or select defaults
    if (activeConvTab === 'length') {
      convFromUnit.value = list.map(x=>x.value).includes(prevFrom) ? prevFrom : 'm';
      convToUnit.value = list.map(x=>x.value).includes(prevTo) ? prevTo : 'cm';
    } else {
      convFromUnit.value = list.map(x=>x.value).includes(prevFrom) ? prevFrom : 'lbs';
      convToUnit.value = list.map(x=>x.value).includes(prevTo) ? prevTo : 'kg';
    }
  }

  function runConversion() {
    const val = parseFloat(convInput.value);
    if (isNaN(val)) {
      convOutput.value = '';
      return;
    }
    const from = convFromUnit.value;
    const to = convToUnit.value;
    let res = 0;
    
    if (activeConvTab === 'length') {
      const baseM = val * lengthMultipliers[from];
      res = baseM / lengthMultipliers[to];
    } else {
      const baseKg = val * weightMultipliers[from];
      res = baseKg / weightMultipliers[to];
    }

    convOutput.value = res.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 4 });
  }

  function switchConvTab(tab: string) {
    activeConvTab = tab;
    btnConvLength.classList.toggle('active', tab === 'length');
    btnConvWeight.classList.toggle('active', tab === 'weight');
    populateConvDropdowns();
    runConversion();
  }

  btnConvLength?.addEventListener('click', () => switchConvTab('length'));
  btnConvWeight?.addEventListener('click', () => switchConvTab('weight'));
  convInput?.addEventListener('input', runConversion);
  convFromUnit?.addEventListener('change', runConversion);
  convToUnit?.addEventListener('change', runConversion);

  // Helper selectors for standard calculations
  function getRadioValue(name: string): string {
    const el = document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement;
    return el ? el.value : '';
  }

  function setRadioValue(name: string, value: string) {
    const el = document.querySelector(`input[name="${name}"][value="${value}"]`) as HTMLInputElement;
    if (el) {
      el.checked = true;
      el.dispatchEvent(new Event('change'));
    }
  }

  // Animation values helper
  function animateCalorieValue(obj: HTMLElement, start: number, end: number, duration: number, suffix: string = '') {
    let startTimestamp: number | null = null;
    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      const current = progress * (end - start) + start;
      obj.textContent = Math.round(current).toLocaleString() + suffix;
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    };
    window.requestAnimationFrame(step);
  }

  // Core calculations and execution
  function calculateCalories() {
    const ageVal = parseFloat((document.getElementById('cal-age') as HTMLInputElement).value);
    
    let heightCm = 0;
    let weightKg = 0;

    if (activeSystem === 'metric') {
      heightCm = parseFloat((document.getElementById('cal-height-cm') as HTMLInputElement).value) || 0;
      weightKg = parseFloat((document.getElementById('cal-weight-kg') as HTMLInputElement).value) || 0;
    } else if (activeSystem === 'imperial') {
      const ft = parseFloat((document.getElementById('cal-height-ft') as HTMLInputElement).value) || 0;
      const inch = parseFloat((document.getElementById('cal-height-in') as HTMLInputElement).value) || 0;
      heightCm = (ft * 12 + inch) * 2.54;
      
      const lbs = parseFloat((document.getElementById('cal-weight-lbs') as HTMLInputElement).value) || 0;
      weightKg = lbs / 2.20462262;
    } else {
      const heightVal = parseFloat((document.getElementById('cal-height-other-val') as HTMLInputElement).value) || 0;
      const heightUnit = (document.getElementById('cal-height-other-unit') as HTMLSelectElement).value;
      if (heightUnit === 'm') heightCm = heightVal * 100;
      else if (heightUnit === 'cm') heightCm = heightVal;
      else if (heightUnit === 'in') heightCm = heightVal * 2.54;
      else if (heightUnit === 'ft') heightCm = heightVal * 30.48;

      const weightVal = parseFloat((document.getElementById('cal-weight-other-val') as HTMLInputElement).value) || 0;
      const weightUnit = (document.getElementById('cal-weight-other-unit') as HTMLSelectElement).value;
      if (weightUnit === 'kg') weightKg = weightVal;
      else if (weightUnit === 'lbs') weightKg = weightVal / 2.20462262;
      else if (weightUnit === 'g') weightKg = weightVal / 1000;
      else if (weightUnit === 'st') weightKg = weightVal * 6.35029318;
    }

    const activity = getRadioValue('cal-activity-radio');
    const goal = (document.getElementById('cal-goal') as HTMLSelectElement).value;
    const gender = getRadioValue('cal-gender');
    
    const errEl = document.getElementById('cal-error') as HTMLElement;
    const errMsg = document.getElementById('cal-error-msg') as HTMLElement;

    if (!ageVal || !heightCm || !weightKg || heightCm <= 0 || weightKg <= 0) {
      errMsg.textContent = 'Please fill in all fields with valid positive values.';
      errEl.hidden = false;
      return;
    }
    if (ageVal < 15 || ageVal > 80) {
      errMsg.textContent = 'Age must be between 15 and 80.';
      errEl.hidden = false;
      return;
    }
    errEl.hidden = true;

    // Retrieve formula details
    const formula = getRadioValue('bmr-formula');
    let bmrKcal = 0;

    if (formula === 'mifflin') {
      bmrKcal = gender === 'male'
        ? (10 * weightKg) + (6.25 * heightCm) - (5 * ageVal) + 5
        : (10 * weightKg) + (6.25 * heightCm) - (5 * ageVal) - 161;
    } else if (formula === 'harris') {
      bmrKcal = gender === 'male'
        ? 88.362 + (13.397 * weightKg) + (4.799 * heightCm) - (5.677 * ageVal)
        : 447.593 + (9.247 * weightKg) + (3.098 * heightCm) - (4.330 * ageVal);
    } else if (formula === 'katch') {
      const bf = parseFloat((document.getElementById('cal-bodyfat') as HTMLInputElement).value) || 20;
      const lbm = weightKg * (100 - bf) / 100;
      bmrKcal = 370 + (21.6 * lbm);
    }

    const tdeeKcal = bmrKcal * ACTIVITY[activity];
    
    // Output conversions (Calories vs Kilojoules)
    const resultsUnit = getRadioValue('results-unit');
    const isKj = resultsUnit === 'kilojoules';
    const convFactor = isKj ? 4.184 : 1;
    const unitSuffix = isKj ? ' kJ' : ' kcal';

    const bmrOut = bmrKcal * convFactor;
    const tdeeOut = tdeeKcal * convFactor;
    
    // Adjust target according to goal
    const goalDelta = GOAL[goal] * convFactor;
    const targetOut = Math.max(1000 * convFactor, tdeeOut + goalDelta);

    // Dynamic macros grammar
    // Protein: 30%, Carbs: 40%, Fat: 30%
    // 1g Protein = 4 kcal (16.736 kJ)
    // 1g Carbs = 4 kcal (16.736 kJ)
    // 1g Fat = 9 kcal (37.656 kJ)
    const proteinG = Math.round((targetOut * 0.30) / (4 * convFactor));
    const carbsG = Math.round((targetOut * 0.40) / (4 * convFactor));
    const fatG = Math.round((targetOut * 0.30) / (9 * convFactor));

    // Update labels contextually
    const targetLabelText = document.getElementById('cal-target-label-text') as HTMLElement;
    targetLabelText.textContent = isKj ? 'Kilojoules / Day' : 'Calories / Day';

    const bmrTitleLabel = document.getElementById('bmr-title-label') as HTMLElement;
    bmrTitleLabel.textContent = isKj ? '🔥 BMR (Basal Metabolic Rate)' : '🔥 BMR (Basal Metabolic Rate)';

    const tdeeTitleLabel = document.getElementById('tdee-title-label') as HTMLElement;
    tdeeTitleLabel.textContent = isKj ? '⚡ TDEE (Total Daily Energy Expenditure)' : '⚡ TDEE (Total Daily Energy Expenditure)';

    // Set textual outputs
    (document.getElementById('cal-goal-label') as HTMLElement).textContent = GOAL_LABEL[goal];
    (document.getElementById('cal-bmr') as HTMLElement).textContent = Math.round(bmrOut).toLocaleString() + unitSuffix;
    (document.getElementById('cal-tdee') as HTMLElement).textContent = Math.round(tdeeOut).toLocaleString() + unitSuffix;
    (document.getElementById('cal-target-row') as HTMLElement).textContent = Math.round(targetOut).toLocaleString() + unitSuffix;
    (document.getElementById('macro-protein') as HTMLElement).textContent = proteinG + 'g';
    (document.getElementById('macro-carbs') as HTMLElement).textContent = carbsG + 'g';
    (document.getElementById('macro-fat') as HTMLElement).textContent = fatG + 'g';

    const results = document.getElementById('cal-results') as HTMLElement;
    results.hidden = false;
    results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    const targetEl = document.getElementById('cal-target') as HTMLElement;
    animateCalorieValue(targetEl, 0, targetOut, 800, isKj ? ' kJ' : '');

    updateUrl();
  }

  // Clear inputs action
  function clearAllInputs() {
    (document.getElementById('cal-age') as HTMLInputElement).value = '';
    (document.getElementById('cal-height-cm') as HTMLInputElement).value = '';
    (document.getElementById('cal-weight-kg') as HTMLInputElement).value = '';
    
    (document.getElementById('cal-height-ft') as HTMLInputElement).value = '';
    (document.getElementById('cal-height-in') as HTMLInputElement).value = '';
    (document.getElementById('cal-weight-lbs') as HTMLInputElement).value = '';

    (document.getElementById('cal-height-other-val') as HTMLInputElement).value = '';
    (document.getElementById('cal-weight-other-val') as HTMLInputElement).value = '';

    (document.getElementById('cal-bodyfat') as HTMLInputElement).value = '20';

    (document.getElementById('cal-goal') as HTMLSelectElement).selectedIndex = 2; // maintain

    setRadioValue('cal-gender', 'male');
    setRadioValue('cal-activity-radio', 'sedentary');
    setRadioValue('results-unit', 'calories');
    setRadioValue('bmr-formula', 'mifflin');

    // Hide output
    (document.getElementById('cal-results') as HTMLElement).hidden = true;
    (document.getElementById('cal-error') as HTMLElement).hidden = true;

    // Reset url
    const url = new URL(window.location.href);
    url.search = '';
    window.history.replaceState({}, '', url.toString());
  }

  document.getElementById('calc-cal-btn')?.addEventListener('click', calculateCalories);
  document.getElementById('clear-cal-btn')?.addEventListener('click', clearAllInputs);

  // URL State persistence sync
  function updateUrl() {
    const url = new URL(window.location.href);
    const params = new URLSearchParams();

    params.set('system', activeSystem);
    params.set('age', (document.getElementById('cal-age') as HTMLInputElement).value || '');
    params.set('gender', getRadioValue('cal-gender'));
    params.set('activity', getRadioValue('cal-activity-radio'));
    params.set('goal', (document.getElementById('cal-goal') as HTMLSelectElement).value);
    params.set('res_unit', getRadioValue('results-unit'));
    params.set('formula', getRadioValue('bmr-formula'));
    params.set('bodyfat', (document.getElementById('cal-bodyfat') as HTMLInputElement).value || '20');

    if (activeSystem === 'metric') {
      params.set('height', (document.getElementById('cal-height-cm') as HTMLInputElement).value || '');
      params.set('weight', (document.getElementById('cal-weight-kg') as HTMLInputElement).value || '');
    } else if (activeSystem === 'imperial') {
      params.set('height_ft', (document.getElementById('cal-height-ft') as HTMLInputElement).value || '');
      params.set('height_in', (document.getElementById('cal-height-in') as HTMLInputElement).value || '');
      params.set('weight', (document.getElementById('cal-weight-lbs') as HTMLInputElement).value || '');
    } else {
      params.set('height', (document.getElementById('cal-height-other-val') as HTMLInputElement).value || '');
      params.set('height_unit', (document.getElementById('cal-height-other-unit') as HTMLSelectElement).value);
      params.set('weight', (document.getElementById('cal-weight-other-val') as HTMLInputElement).value || '');
      params.set('weight_unit', (document.getElementById('cal-weight-other-unit') as HTMLSelectElement).value);
    }

    url.search = params.toString();
    window.history.replaceState({}, '', url.toString());
  }

  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('system')) return; // nothing to load

    const sys = params.get('system') || 'metric';
    switchSystem(sys);

    const age = params.get('age');
    if (age) (document.getElementById('cal-age') as HTMLInputElement).value = age;

    const gender = params.get('gender');
    if (gender) setRadioValue('cal-gender', gender);

    const activity = params.get('activity');
    if (activity) setRadioValue('cal-activity-radio', activity);

    const goal = params.get('goal');
    if (goal) (document.getElementById('cal-goal') as HTMLSelectElement).value = goal;

    const resUnit = params.get('res_unit');
    if (resUnit) setRadioValue('results-unit', resUnit);

    const formula = params.get('formula');
    if (formula) setRadioValue('bmr-formula', formula);

    const bodyfat = params.get('bodyfat');
    if (bodyfat) (document.getElementById('cal-bodyfat') as HTMLInputElement).value = bodyfat;

    if (sys === 'metric') {
      const h = params.get('height');
      const w = params.get('weight');
      if (h) (document.getElementById('cal-height-cm') as HTMLInputElement).value = h;
      if (w) (document.getElementById('cal-weight-kg') as HTMLInputElement).value = w;
    } else if (sys === 'imperial') {
      const hFt = params.get('height_ft');
      const hIn = params.get('height_in');
      const w = params.get('weight');
      if (hFt) (document.getElementById('cal-height-ft') as HTMLInputElement).value = hFt;
      if (hIn) (document.getElementById('cal-height-in') as HTMLInputElement).value = hIn;
      if (w) (document.getElementById('cal-weight-lbs') as HTMLInputElement).value = w;
    } else {
      const hVal = params.get('height');
      const hUnit = params.get('height_unit');
      const wVal = params.get('weight');
      const wUnit = params.get('weight_unit');
      if (hVal) (document.getElementById('cal-height-other-val') as HTMLInputElement).value = hVal;
      if (hUnit) (document.getElementById('cal-height-other-unit') as HTMLSelectElement).value = hUnit;
      if (wVal) (document.getElementById('cal-weight-other-val') as HTMLInputElement).value = wVal;
      if (wUnit) (document.getElementById('cal-weight-other-unit') as HTMLSelectElement).value = wUnit;
    }

    calculateCalories();
  }

  // Food Energy Converter Widget client operations
  const foodInput = document.getElementById('food-input-val') as HTMLInputElement;
  const foodFromUnit = document.getElementById('food-from-unit') as HTMLSelectElement;
  const foodToUnit = document.getElementById('food-to-unit') as HTMLSelectElement;
  const foodOutput = document.getElementById('food-output-val') as HTMLInputElement;

  const foodMultipliers: Record<string, number> = {
    kcal: 4.184,
    kj: 1,
    j: 0.001,
    kcal_it: 4.1868,
    wh: 3.6
  };

  function calculateFoodConversion() {
    const val = parseFloat(foodInput.value);
    if (isNaN(val)) {
      foodOutput.value = '';
      return;
    }
    const from = foodFromUnit.value;
    const to = foodToUnit.value;

    const baseKj = val * foodMultipliers[from];
    const res = baseKj / foodMultipliers[to];

    foodOutput.value = res.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 4 });
  }

  document.getElementById('calc-food-btn')?.addEventListener('click', calculateFoodConversion);
  document.getElementById('clear-food-btn')?.addEventListener('click', () => {
    foodInput.value = '1';
    foodOutput.value = '';
    foodFromUnit.selectedIndex = 0;
    foodToUnit.selectedIndex = 0;
  });

  // Global triggers
  populateConvDropdowns();
  switchConvTab('length');
  initFromUrl();

  // FAQ listeners
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
