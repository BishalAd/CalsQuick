---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { q: 'What is a calorie calculator?', a: 'A calorie calculator is an online tool that estimates the number of daily calories your body needs to maintain, lose, or gain weight based on your age, biological sex, height, weight, and physical activity level.' },
  { q: 'what is calorie deficit calculator', a: 'A calorie deficit calculator is a tool that computes how many calories you should consume below your maintenance calories (TDEE) to trigger weight loss, typically recommending a reduction of 500 to 1,000 calories daily.' },
  { q: 'what is the most accurate calorie calculator', a: 'The most accurate calorie calculator is one that uses validated clinical formulas like the Mifflin-St Jeor equation (which our tool uses) or the Katch-McArdle formula (if body fat percentage is known) to estimate resting metabolic rate.' },
  { q: 'what should my calorie deficit be calculator', a: 'Your calorie deficit should ideally be between 500 and 1,000 calories below your daily maintenance level. This allows for a safe and sustainable weight loss rate of 1 to 2 pounds per week without triggering severe muscle loss or fatigue.' },
  { q: 'how much weight will i lose calorie calculator', a: 'Using a calorie calculator, you can estimate that a daily deficit of 500 calories results in approximately 1 pound (0.45 kg) of weight loss per week, as 1 pound of fat contains roughly 3,500 calories.' },
  { q: 'what is my calorie deficit calculator', a: 'Your calorie deficit calculator computes your targets by first finding your Total Daily Energy Expenditure (TDEE) and then subtracting the required amount for your specific weight loss speed.' },
  { q: 'how many calories should i eat calorie deficit calculator', a: 'To find how many calories you should eat on a calorie deficit calculator, subtract your deficit (e.g. 500 calories) from your maintenance calories. For instance, if your maintenance is 2,200 calories, your deficit target is 1,700 calories.' },
  { q: 'how to lose weight calorie calculator', a: 'To lose weight using a calorie calculator, enter your metrics to find your TDEE, select a weight loss goal to calculate your target deficit, and consistently track your food intake to stay within that budget.' },
  { q: 'what is my calorie maintenance calculator', a: 'Your calorie maintenance calculator (or TDEE calculator) estimates the total daily energy your body burns. Consuming exactly this amount of food energy ensures your weight remains stable.' },
  { q: 'How many calories should I eat per day?', a: 'The number of calories you should eat per day depends on your goals: to maintain weight, eat your maintenance calories; to lose weight safely, consume 500-1,000 calories less; and to gain weight or build muscle, consume a surplus of 500 calories.' },
  { q: 'What is my maintenance calorie level?', a: 'Your maintenance calorie level is the baseline energy required to fuel your daily life, combining your Basal Metabolic Rate (BMR) with the energy expended during work, walking, and exercise.' },
  { q: 'How many calories should I eat to lose weight?', a: 'To lose weight, you should eat fewer calories than your TDEE. For most adults, this ranges between 1,200 to 1,500 calories per day for women, and 1,500 to 1,800 calories per day for men.' },
  { q: 'What calorie deficit should I use?', a: 'A standard and healthy calorie deficit is 500 calories per day (for moderate weight loss) or up to 1,000 calories per day (for faster weight loss). Never drop below 1,200 (females) or 1,500 (males) daily calories.' },
  { q: 'How much weight can I lose with a calorie deficit?', a: 'You can expect to lose about 1 to 2 pounds (0.5 to 1 kg) per week with a moderate calorie deficit. This rate is recommended by doctors to preserve lean muscle mass and ensure long-term success.' },
  { q: 'How accurate is a calorie calculator?', a: 'While a calorie calculator is a highly accurate estimation tool, it can vary by 10-15% based on personal metabolic speed, thyroid activity, and differences in actual daily muscle movement.' }
];

const schemas = [
  generateSoftwareApplication({ name: 'Calorie Calculator', description: 'Free online calorie calculator using the Mifflin-St Jeor formula. Calculate BMR, TDEE, and daily calories for your weight goals.', url: '/calorie-calculator' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'BMI Calculator', href: '/bmi-calculator', icon: '⚖️', desc: 'Check your body mass index' },
  { name: 'Age Calculator', href: '/age-calculator', icon: '🎂', desc: 'Calculate your exact age' },
  { name: 'Tip Calculator', href: '/tip-calculator', icon: '💰', desc: 'Split the bill perfectly' },
];

const activityOptions = [
  { value: 'sedentary', label: 'Sedentary (little or no exercise)' },
  { value: 'light', label: 'Lightly active (1–3 days/week)' },
  { value: 'moderate', label: 'Moderately active (3–5 days/week)' },
  { value: 'active', label: 'Very active (6–7 days/week)' },
  { value: 'very_active', label: 'Extra active (physical job)' },
];

const goalOptions = [
  { value: 'lose_fast', label: 'Lose 2 lbs/week (−1,000 cal/day)' },
  { value: 'lose', label: 'Lose 1 lb/week (−500 cal/day)' },
  { value: 'maintain', label: 'Maintain current weight' },
  { value: 'gain', label: 'Gain 1 lb/week (+500 cal/day)' },
  { value: 'gain_fast', label: 'Gain 2 lbs/week (+1,000 cal/day)' },
];
---

<CalculatorLayout
  title="Calorie Calculator — Maintenance Calorie Calculator to Lose Weight"
  description="Free daily calorie calculator for weight loss. Estimate maintenance calories, food and recipe inputs, and calculate exercise calorie burn."
  canonical="/calorie-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Calorie Calculator', url: '/calorie-calculator' }]}
  relatedCalcs={relatedCalcs}
>
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Health Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Calorie Calculator</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Find your daily calorie needs using the Mifflin-St Jeor formula — supporting both metric and US customary units.
    </p>
  </div>

  <div class="calc-panel fade-up stagger-1" id="calorie-calculator">
    <!-- Unit switcher toggle -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
      <span class="text-body-sm-strong" style="color: var(--color-ink);">Units:</span>
      <div class="toggle-group" role="group" aria-label="Unit system">
        <button class="toggle-option active" id="btn-cal-metric" aria-pressed="true">Metric (cm, kg)</button>
        <button class="toggle-option" id="btn-cal-imperial" aria-pressed="false">Imperial (ft/in, lbs)</button>
      </div>
    </div>

    <div class="calc-form">
      <!-- Age & Gender -->
      <div class="form-row-2">
        <div>
          <label for="cal-age" class="label">Age</label>
          <input type="number" id="cal-age" class="input-base input-lg" placeholder="25" min="15" max="120" aria-label="Age in years" />
        </div>
        <div>
          <label class="label">Gender</label>
          <div class="toggle-group" role="group" aria-label="Select gender" style="width: 100%;">
            <button class="toggle-option active" id="btn-male" aria-pressed="true" style="flex: 1;">Male</button>
            <button class="toggle-option" id="btn-female" aria-pressed="false" style="flex: 1;">Female</button>
          </div>
        </div>
      </div>

      <!-- Height (Metric/Imperial) -->
      <div id="cal-height-metric-container">
        <label for="cal-height-cm" class="label">Height</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-height-cm" class="input-base input-lg" placeholder="175" min="100" max="280" aria-label="Height in centimeters" />
          <span class="unit-badge">cm</span>
        </div>
      </div>
      <div id="cal-height-imperial-container" hidden>
        <label class="label">Height</label>
        <div style="display: flex; gap: 12px;">
          <div style="flex: 1; position: relative; display: flex; align-items: center;">
            <input type="number" id="cal-height-ft" class="input-base input-lg" placeholder="5" min="1" max="9" aria-label="Height feet" />
            <span class="unit-badge">ft</span>
          </div>
          <div style="flex: 1; position: relative; display: flex; align-items: center;">
            <input type="number" id="cal-height-in" class="input-base input-lg" placeholder="9" min="0" max="11" aria-label="Height inches" />
            <span class="unit-badge">in</span>
          </div>
        </div>
      </div>

      <!-- Weight (Metric/Imperial) -->
      <div id="cal-weight-metric-container">
        <label for="cal-weight-kg" class="label">Weight</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-weight-kg" class="input-base input-lg" placeholder="70" min="20" max="500" aria-label="Weight in kilograms" />
          <span class="unit-badge">kg</span>
        </div>
      </div>
      <div id="cal-weight-imperial-container" hidden>
        <label for="cal-weight-lbs" class="label">Weight</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-weight-lbs" class="input-base input-lg" placeholder="154" min="40" max="1100" aria-label="Weight in pounds" />
          <span class="unit-badge">lbs</span>
        </div>
      </div>

      <!-- Activity -->
      <div>
        <label for="cal-activity" class="label">Activity Level</label>
        <select id="cal-activity" class="select-base" aria-label="Activity level">
          {activityOptions.map(o => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>

      <!-- Goal -->
      <div>
        <label for="cal-goal" class="label">Goal</label>
        <select id="cal-goal" class="select-base" aria-label="Weight goal">
          {goalOptions.map(o => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>

      <button id="calc-cal-btn" class="btn-primary" style="margin-top: 8px;" aria-label="Calculate daily calorie needs">
        Calculate Calories
      </button>
    </div>

    <!-- Error -->
    <div id="cal-error" class="calc-error" role="alert" aria-live="polite" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span id="cal-error-msg"></span>
    </div>

    <!-- Results -->
    <div id="cal-results" hidden aria-live="polite">
      <div class="results-divider"></div>

      <!-- Main Result Card -->
      <div class="main-result-card">
        <div class="main-result-value" id="cal-target">--</div>
        <div class="main-result-label">Calories / Day</div>
        <div id="cal-goal-label" style="font-size: 14px; color: var(--color-muted); margin-top: 10px; font-weight: 500;"></div>
      </div>

      <!-- BMR + TDEE Details -->
      <div class="result-panel">
        <div class="result-row">
          <div>
            <div class="result-row-label">🔥 BMR (Basal Metabolic Rate)</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories burned at complete rest</div>
          </div>
          <span class="result-row-value" id="cal-bmr">--</span>
        </div>
        <div class="result-row">
          <div>
            <div class="result-row-label">⚡ TDEE (Total Daily Energy Expenditure)</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories burned with daily activity</div>
          </div>
          <span class="result-row-value" id="cal-tdee">--</span>
        </div>
        <div class="result-row" style="border-bottom: none;">
          <div>
            <div class="result-row-label">🎯 Target Calories</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories to consume for selected goal</div>
          </div>
          <span class="result-row-value" id="cal-target-row" style="font-size: 16px; font-weight: 600;">--</span>
        </div>
      </div>

      <!-- Macros -->
      <div style="margin-top: 32px;">
        <h3 class="text-caption-mono" style="margin-bottom: 12px;">Suggested Macros</h3>
        <div class="macros-grid">
          <div class="macro-card">
            <div class="macro-value" id="macro-protein" style="color: #3b82f6;">--g</div>
            <div class="macro-label">Protein</div>
            <div class="macro-pct">30%</div>
          </div>
          <div class="macro-card">
            <div class="macro-value" id="macro-carbs" style="color: #7928ca;">--g</div>
            <div class="macro-label">Carbs</div>
            <div class="macro-pct">40%</div>
          </div>
          <div class="macro-card">
            <div class="macro-value" id="macro-fat" style="color: #f5a623;">--g</div>
            <div class="macro-label">Fat</div>
            <div class="macro-pct">30%</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed SEO Article Section -->
  <div style="margin-top: 48px;" class="prose-section fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 20px;">The Complete Guide to Daily Calorie Calculation and Weight Management</h2>
    
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Achieving your health and fitness goals begins with understanding energy balance. Whether you want to lose weight, build muscle, or maintain your current physique, using a scientific <strong>calorie calculator</strong> is the best first step. By calculating your daily energy needs, you can customize your diet and training plans based on exact data rather than guesswork. To stay at your current weight, a <strong>maintenance calorie calculator</strong> helps you find the precise number of calories your body needs to fuel daily operations and general activity. Using our <strong>free calorie calculator</strong> online is one of the most effective ways to plan out your physical health journey.
    </p>

    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Calorie Calculations for Weight Loss & Deficits</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      If your objective is to shed fat, you must create a caloric deficit. A deficit means you consume fewer calories than your body burns, prompting it to use stored fat for energy. Consider the following tools and methods:
    </p>
    <ul style="margin-left: 20px; margin-bottom: 16px; color: var(--color-body); line-height: 26px; font-size: 15px; display: flex; flex-direction: column; gap: 8px;">
      <li><strong>Calorie Deficit Calculator:</strong> Our tool acts as a <strong>calorie deficit calculator</strong> by automatically subtracting 500 or 1,000 calories from your TDEE. This creates a safe, sustainable deficit leading to 1 to 2 pounds of weight loss per week.</li>
      <li><strong>Weight Loss Calorie Calculator:</strong> When using a <strong>weight loss calorie calculator</strong>, it is crucial not to drop calories too low. For safety, women should rarely consume under 1,200 calories per day, and men should stay above 1,500 calories, unless under medical supervision.</li>
      <li><strong>Calorie Calculator to Lose Weight:</strong> Using a <strong>calorie calculator to lose weight</strong> helps prevent metabolic adaptation (where your metabolism slows down excessively due to severe food restriction).</li>
    </ul>

    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Tracking Food & Dining Out Calories</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Knowing your target daily intake is only half the battle; tracking what you eat is equally vital. Modern nutrition tracking involves several techniques:
    </p>
    <ul style="margin-left: 20px; margin-bottom: 16px; color: var(--color-body); line-height: 26px; font-size: 15px; display: flex; flex-direction: column; gap: 8px;">
      <li><strong>Food Calorie Calculator:</strong> A digital <strong>food calorie calculator</strong> or a <strong>free food calorie calculator</strong> helps you log ingredients, snacks, and meals. Measuring foods with a kitchen scale provides the most accurate logs.</li>
      <li><strong>Food Calorie Calculator to Gain Weight:</strong> If you are looking to build muscle or bulk, a <strong>food calorie calculator to gain weight</strong> will help you track a calorie surplus. Consuming 300 to 500 calories above your maintenance level ensures you have enough energy to build clean mass.</li>
      <li><strong>Recipe Calorie Calculator:</strong> When preparing meals at home, a <strong>recipe calorie calculator</strong> allows you to input raw ingredients and divide the total energy by the number of servings, making home-cooked fitness meals simple to track.</li>
      <li><strong>Restaurant Dining Estimations:</strong> Eating out can make tracking difficult. Fortunately, major chains provide official nutrition menus. For example, if you eat Tex-Mex, you can use a <strong>chipotle calorie calculator</strong> to estimate your burrito bowl's total energy. Likewise, before ordering a morning beverage, checking a <strong>starbucks calorie calculator</strong> prevents liquid calories from exceeding your daily budget.</li>
    </ul>

    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Accounting for Exercise and Daily Energy Burn</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Physical activity plays a key role in boosting your daily energy expenditure. Our tool functions as an active <strong>TDEE calculator</strong> and <strong>daily calorie calculator</strong>. People often overestimate the calories burned during exercise. For example, the display on a <strong>treadmill calorie calculator</strong> often overestimates calorie burn by up to 20% because it does not account for baseline metabolic rate or individual fitness efficiency. Rather than tracking individual workouts, it is much more accurate to select the correct baseline activity multiplier in your daily calorie equations.
    </p>

    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">The Mifflin-St Jeor Equation</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Our tool uses the Mifflin-St Jeor formula, widely recognized by dietitians as the gold standard for calculating Basal Metabolic Rate (BMR):
    </p>
    <div class="formula-block" style="background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 16px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
      <p class="text-code" style="color: var(--color-ink); margin: 0; font-family: var(--font-mono); font-size: 13px;"><strong>Men:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age in years) + 5</p>
      <p class="text-code" style="color: var(--color-ink); margin: 0; font-family: var(--font-mono); font-size: 13px;"><strong>Women:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age in years) − 161</p>
    </div>

    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Daily Energy Expenditure Breakdown</h3>
    <div style="overflow-x: auto; margin-top: 16px; margin-bottom: 24px; border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; color: var(--color-body);">
        <thead>
          <tr style="background: var(--color-canvas-soft-2); border-bottom: 1px solid var(--color-hairline); font-weight: 600; color: var(--color-ink);">
            <th style="padding: 12px 16px;">Activity Level</th>
            <th style="padding: 12px 16px;">Description</th>
            <th style="padding: 12px 16px;">TDEE Multiplier</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 12px 16px;">Sedentary</td>
            <td style="padding: 12px 16px;">Little to no exercise, desk job</td>
            <td style="padding: 12px 16px;">BMR × 1.200</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 12px 16px;">Lightly Active</td>
            <td style="padding: 12px 16px;">Light exercise 1–3 days/week</td>
            <td style="padding: 12px 16px;">BMR × 1.375</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 12px 16px;">Moderately Active</td>
            <td style="padding: 12px 16px;">Moderate exercise 3–5 days/week</td>
            <td style="padding: 12px 16px;">BMR × 1.550</td>
          </tr>
          <tr>
            <td style="padding: 12px 16px;">Very Active</td>
            <td style="padding: 12px 16px;">Hard exercise 6–7 days/week, physical job</td>
            <td style="padding: 12px 16px;">BMR × 1.725</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-body-md" style="color: var(--color-body); line-height: 28px;">
      Start tracking your goals today. Enter your age, gender, weight, height, and activity level above to calculate your exact caloric budget!
    </p>
  </div>

  <!-- FAQ -->
  <div style="margin-top: 48px;" class="fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top: 1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`cal-faq-${i}`} id={`cal-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`cal-faq-${i}`} role="region" aria-labelledby={`cal-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>

<style>
  .calc-form { display: flex; flex-direction: column; gap: 20px; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: end; }
  .unit-badge {
    position: absolute;
    right: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
    pointer-events: none;
    user-select: none;
  }
  .input-base { padding-right: 48px; }
  .results-divider { height: 1px; background: var(--color-hairline); margin: 32px 0; }
  
  .main-result-card {
    text-align: center; 
    padding: 36px 24px; 
    background: var(--color-canvas-soft-2); 
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    margin-bottom: 24px;
  }
  .main-result-value { font-size: 72px; font-weight: 700; color: var(--color-ink); line-height: 1; letter-spacing: -4px; }
  .main-result-label { font-size: 12px; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-mono); margin-top: 8px; font-weight: 600; }
  
  .result-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--color-hairline); }
  .result-row-label { font-size: 14px; color: var(--color-body); }
  .result-row-value { font-size: 14px; font-weight: 600; color: var(--color-ink); }
  
  .macros-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .macro-card { background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); padding: 20px 16px; text-align: center; }
  .macro-value { font-size: 32px; font-weight: 700; letter-spacing: -1px; line-height: 1.1; }
  .macro-label { font-size: 13px; font-weight: 500; color: var(--color-body); margin-top: 4px; }
  .macro-pct { font-size: 11px; color: var(--color-muted); font-family: var(--font-mono); margin-top: 2px; }
  
  .calc-error { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--color-error-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-top: 16px; font-size: 14px; color: var(--color-error); }
  .prose-section { padding: 32px; background: var(--color-canvas); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); }
  .formula-block { background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 16px; margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  @media (max-width: 599px) {
    .form-row-2 { grid-template-columns: 1fr; }
    .macros-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .main-result-value {
      font-size: 54px;
    }
    .prose-section {
      padding: 20px 16px;
    }
  }
</style>

<script>
  let gender = 'male';
  let isMetric = true;

  const ACTIVITY: Record<string, number> = { sedentary: 1.2, light: 1.375, moderate: 1.55, active: 1.725, very_active: 1.9 };
  const GOAL: Record<string, number> = { lose_fast: -1000, lose: -500, maintain: 0, gain: 500, gain_fast: 1000 };
  const GOAL_LABEL: Record<string, string> = { lose_fast: 'Goal: Lose 2 lbs/week', lose: 'Goal: Lose 1 lb/week', maintain: 'Goal: Maintain weight', gain: 'Goal: Gain 1 lb/week', gain_fast: 'Goal: Gain 2 lbs/week' };

  const metricBtn = document.getElementById('btn-cal-metric') as HTMLButtonElement;
  const imperialBtn = document.getElementById('btn-cal-imperial') as HTMLButtonElement;
  const heightMetricContainer = document.getElementById('cal-height-metric-container') as HTMLElement;
  const heightImperialContainer = document.getElementById('cal-height-imperial-container') as HTMLElement;
  const weightMetricContainer = document.getElementById('cal-weight-metric-container') as HTMLElement;
  const weightImperialContainer = document.getElementById('cal-weight-imperial-container') as HTMLElement;

  function switchUnit(metric: boolean) {
    isMetric = metric;
    metricBtn.setAttribute('aria-pressed', String(metric));
    imperialBtn.setAttribute('aria-pressed', String(!metric));
    metricBtn.classList.toggle('active', metric);
    imperialBtn.classList.toggle('active', !metric);
    heightMetricContainer.hidden = !metric;
    heightImperialContainer.hidden = metric;
    weightMetricContainer.hidden = !metric;
    weightImperialContainer.hidden = metric;
  }

  metricBtn?.addEventListener('click', () => switchUnit(true));
  imperialBtn?.addEventListener('click', () => switchUnit(false));

  const maleBtn = document.getElementById('btn-male') as HTMLButtonElement;
  const femaleBtn = document.getElementById('btn-female') as HTMLButtonElement;
  maleBtn?.addEventListener('click', () => { gender = 'male'; maleBtn.classList.add('active'); femaleBtn.classList.remove('active'); maleBtn.setAttribute('aria-pressed','true'); femaleBtn.setAttribute('aria-pressed','false'); });
  femaleBtn?.addEventListener('click', () => { gender = 'female'; femaleBtn.classList.add('active'); maleBtn.classList.remove('active'); femaleBtn.setAttribute('aria-pressed','true'); maleBtn.setAttribute('aria-pressed','false'); });

  function animateCalorieValue(obj: HTMLElement, start: number, end: number, duration: number) {
    let startTimestamp: number | null = null;
    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      const current = progress * (end - start) + start;
      obj.textContent = Math.round(current).toLocaleString();
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    };
    window.requestAnimationFrame(step);
  }

  document.getElementById('calc-cal-btn')?.addEventListener('click', () => {
    const age = parseFloat((document.getElementById('cal-age') as HTMLInputElement).value);
    
    let height = 0;
    let weight = 0;

    if (isMetric) {
      height = parseFloat((document.getElementById('cal-height-cm') as HTMLInputElement).value);
      weight = parseFloat((document.getElementById('cal-weight-kg') as HTMLInputElement).value);
    } else {
      const ft = parseFloat((document.getElementById('cal-height-ft') as HTMLInputElement).value) || 0;
      const inch = parseFloat((document.getElementById('cal-height-in') as HTMLInputElement).value) || 0;
      height = (ft * 12 + inch) * 2.54; // convert to cm
      const lbs = parseFloat((document.getElementById('cal-weight-lbs') as HTMLInputElement).value);
      weight = lbs / 2.20462; // convert to kg
    }

    const activity = (document.getElementById('cal-activity') as HTMLSelectElement).value;
    const goal = (document.getElementById('cal-goal') as HTMLSelectElement).value;
    const errEl = document.getElementById('cal-error') as HTMLElement;
    const errMsg = document.getElementById('cal-error-msg') as HTMLElement;

    if (!age || !height || !weight || height <= 0 || weight <= 0) { errMsg.textContent = 'Please fill in all fields with valid positive values.'; errEl.hidden = false; return; }
    if (age < 15 || age > 120) { errMsg.textContent = 'Age must be between 15 and 120.'; errEl.hidden = false; return; }
    errEl.hidden = true;

    const bmr = gender === 'male'
      ? 10 * weight + 6.25 * height - 5 * age + 5
      : 10 * weight + 6.25 * height - 5 * age - 161;
    const tdee = bmr * ACTIVITY[activity];
    const target = Math.max(1200, tdee + GOAL[goal]);
    const protein = Math.round((target * 0.30) / 4);
    const carbs = Math.round((target * 0.40) / 4);
    const fat = Math.round((target * 0.30) / 9);

    const targetVal = Math.round(target);

    (document.getElementById('cal-goal-label') as HTMLElement).textContent = GOAL_LABEL[goal];
    (document.getElementById('cal-bmr') as HTMLElement).textContent = Math.round(bmr).toLocaleString() + ' kcal';
    (document.getElementById('cal-tdee') as HTMLElement).textContent = Math.round(tdee).toLocaleString() + ' kcal';
    (document.getElementById('cal-target-row') as HTMLElement).textContent = targetVal.toLocaleString() + ' kcal';
    (document.getElementById('macro-protein') as HTMLElement).textContent = protein + 'g';
    (document.getElementById('macro-carbs') as HTMLElement).textContent = carbs + 'g';
    (document.getElementById('macro-fat') as HTMLElement).textContent = fat + 'g';

    const results = document.getElementById('cal-results') as HTMLElement;
    results.hidden = false;
    results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    const targetEl = document.getElementById('cal-target') as HTMLElement;
    animateCalorieValue(targetEl, 0, targetVal, 800);
  });

  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
