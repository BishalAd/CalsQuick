---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';
const faqs = [
  { q: 'What is a calorie calculator?', a: 'A calorie calculator is an online tool that estimates the number of daily calories your body needs to maintain, lose, or gain weight based on your age, biological sex, height, weight, and physical activity level.' },
  { q: 'what is calorie deficit calculator', a: 'A calorie deficit calculator is a tool that computes how many calories you should consume below your maintenance calories (TDEE) to trigger weight loss, typically recommending a reduction of 500 to 1,000 calories daily.' },
  { q: 'what is the most accurate calorie calculator', a: 'The most accurate calorie calculator is one that uses validated clinical formulas like the Mifflin-St Jeor equation (which our tool uses) or the Katch-McArdle formula (if body fat percentage is known) to estimate resting metabolic rate.' },
  { q: 'what should my calorie deficit be calculator', a: 'Your calorie deficit should ideally be between 500 and 1,000 calories below your daily maintenance level. This allows for a safe and sustainable weight loss rate of 1 to 2 pounds per week without triggering severe muscle loss or fatigue.' },
  { q: 'how much weight will i lose calorie calculator', a: 'Using a calorie calculator, you can estimate that a daily deficit of 500 calories results in approximately 1 pound (0.45 kg) of weight loss per week, as 1 pound of fat contains roughly 3,500 calories.' },
  { q: 'what is my calorie deficit calculator', a: 'Your calorie deficit calculator computes your targets by first finding your Total Daily Energy Expenditure (TDEE) and then subtracting the required amount for your specific weight loss speed.' },
  { q: 'how many calories should i eat calorie deficit calculator', a: 'To find how many calories you should eat on a calorie deficit calculator, subtract your deficit (e.g. 500 calories) from your maintenance calories. For instance, if your maintenance is 2,200 calories, your deficit target is 1,700 calories.' },
  { q: 'how to lose weight calorie calculator', a: 'To lose weight using a calorie calculator, enter your metrics to find your TDEE, select a weight loss goal to calculate your target deficit, and consistently track your food intake to stay within that budget.' },
  { q: 'what is my calorie maintenance calculator', a: 'Your calorie maintenance calculator (or TDEE calculator) estimates the total daily energy your body burns. Consuming exactly this amount of food energy ensures your weight remains stable.' },
  { q: 'How many calories should I eat per day?', a: 'The number of calories you should eat per day depends on your goals: to maintain weight, eat your maintenance calories; to lose weight safely, consume 500-1,000 calories less; and to gain weight or build muscle, consume a surplus of 500 calories.' },
  { q: 'What is my maintenance calorie level?', a: 'Your maintenance calorie level is the baseline energy required to fuel your daily life, combining your Basal Metabolic Rate (BMR) with the energy expended during work, walking, and exercise.' },
  { q: 'How many calories should I eat to lose weight?', a: 'To lose weight, you should eat fewer calories than your TDEE. For most adults, this ranges between 1,200 to 1,500 calories per day for women, and 1,500 to 1,800 calories per day for men.' },
  { q: 'What calorie deficit should I use?', a: 'A standard and healthy calorie deficit is 500 calories per day (for moderate weight loss) or up to 1,000 calories per day (for faster weight loss). Never drop below 1,200 (females) or 1,500 (males) daily calories.' },
  { q: 'How much weight can I lose with a calorie deficit?', a: 'You can expect to lose about 1 to 2 pounds (0.5 to 1 kg) per week with a moderate calorie deficit. This rate is recommended by doctors to preserve lean muscle mass and ensure long-term success.' },
  { q: 'How accurate is a calorie calculator?', a: 'While a calorie calculator is a highly accurate estimation tool, it can vary by 10-15% based on personal metabolic speed, thyroid activity, and differences in actual daily muscle movement.' }
];

const schemas = [
  generateSoftwareApplication({ name: 'Calorie Calculator', description: 'Free online calorie calculator using the Mifflin-St Jeor formula. Calculate BMR, TDEE, and daily calories for your weight goals.', url: '/calorie-calculator' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'BMI Calculator', href: '/bmi-calculator', icon: '⚖️', desc: 'Check your body mass index' },
  { name: 'Age Calculator', href: '/age-calculator', icon: '🎂', desc: 'Calculate your exact age' },
  { name: 'Tip Calculator', href: '/tip-calculator', icon: '💰', desc: 'Split the bill perfectly' },
];

const activityOptions = [
  { value: 'sedentary', label: 'Sedentary (little or no exercise)' },
  { value: 'light', label: 'Lightly active (1–3 days/week)' },
  { value: 'moderate', label: 'Moderately active (3–5 days/week)' },
  { value: 'active', label: 'Very active (6–7 days/week)' },
  { value: 'very_active', label: 'Extra active (physical job)' },
];

const goalOptions = [
  { value: 'lose_fast', label: 'Lose 2 lbs/week (−1,000 cal/day)' },
  { value: 'lose', label: 'Lose 1 lb/week (−500 cal/day)' },
  { value: 'maintain', label: 'Maintain current weight' },
  { value: 'gain', label: 'Gain 1 lb/week (+500 cal/day)' },
  { value: 'gain_fast', label: 'Gain 2 lbs/week (+1,000 cal/day)' },
];
---

<CalculatorLayout
  title="Calorie Calculator — Maintenance Calorie Calculator to Lose Weight"
  description="Free daily calorie calculator for weight loss. Estimate maintenance calories, food and recipe inputs, and calculate exercise calorie burn."
  canonical="/calorie-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Calorie Calculator', url: '/calorie-calculator' }]}
  relatedCalcs={relatedCalcs}
>
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Health Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Calorie Calculator</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Find your daily calorie needs using the Mifflin-St Jeor formula — supporting both metric and US customary units.
    </p>
  </div>

  <div class="calc-panel fade-up stagger-1" id="calorie-calculator">
    <!-- Unit switcher toggle -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
      <span class="text-body-sm-strong" style="color: var(--color-ink);">Units:</span>
      <div class="toggle-group" role="group" aria-label="Unit system" style="display: flex; flex-wrap: wrap; gap: 4px;">
        <button class="toggle-option active" id="btn-cal-metric" aria-pressed="true">Metric Units (cm, kg)</button>
        <button class="toggle-option" id="btn-cal-imperial" aria-pressed="false">US Units (ft/in, lbs)</button>
        <button class="toggle-option" id="btn-cal-other" aria-pressed="false">Other Units</button>
      </div>
    </div>

    <!-- Embedded Unit Converter (Visible only when Other Units is selected) -->
    <div id="converter-widget" class="result-panel" style="margin-bottom: 24px; background: var(--color-canvas-soft-2); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline);" hidden>
      <h4 style="font-size: 11px; font-weight: 600; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-mono); margin-bottom: 12px;">Unit Conversion Assistant</h4>
      
      <div class="toggle-group" role="group" aria-label="Converter Tab" style="display: flex; gap: 4px; margin-bottom: 16px;">
        <button class="toggle-option active" id="btn-conv-length" style="padding: 6px 12px; font-size: 12px; flex: 1;">Length</button>
        <button class="toggle-option" id="btn-conv-weight" style="padding: 6px 12px; font-size: 12px; flex: 1;">Weight</button>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label for="conv-input" class="label" style="font-size: 12px;">From:</label>
          <input type="number" id="conv-input" class="input-base input-lg" style="height: 38px; font-size: 14px;" placeholder="Value" />
          <select id="conv-from-unit" class="input-base input-lg" style="height: 38px; font-size: 14px; margin-top: 6px; padding-right: 12px;">
            <!-- Options populated dynamically -->
          </select>
        </div>
        <div>
          <label for="conv-output" class="label" style="font-size: 12px;">To:</label>
          <input type="text" id="conv-output" class="input-base input-lg" style="height: 38px; font-size: 14px;" readonly placeholder="Converted" />
          <select id="conv-to-unit" class="input-base input-lg" style="height: 38px; font-size: 14px; margin-top: 6px; padding-right: 12px;">
            <!-- Options populated dynamically -->
          </select>
        </div>
      </div>
    </div>

    <div class="calc-form">
      <!-- Age & Gender -->
      <div class="form-row">
        <div>
          <label for="cal-age" class="label">Age <span style="font-size: 11px; color: var(--color-muted); font-weight: normal; margin-left: 4px;">(ages 15 - 80)</span></label>
          <input type="number" id="cal-age" class="input-base input-lg" placeholder="25" min="15" max="80" aria-label="Age in years" />
        </div>
        <div>
          <label class="label">Gender</label>
          <div style="display: flex; gap: 16px; margin-top: 10px;">
            <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
              <input type="radio" name="cal-gender" value="male" checked style="accent-color: var(--color-ink);" />
              Male
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
              <input type="radio" name="cal-gender" value="female" style="accent-color: var(--color-ink);" />
              Female
            </label>
          </div>
        </div>
      </div>

      <!-- Height (Metric) -->
      <div id="cal-height-metric-container">
        <label for="cal-height-cm" class="label">Height</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-height-cm" class="input-base input-lg" placeholder="175" min="100" max="280" aria-label="Height in centimeters" />
          <span class="unit-badge">cm</span>
        </div>
      </div>

      <!-- Height (Imperial) -->
      <div id="cal-height-imperial-container" hidden>
        <label class="label">Height</label>
        <div style="display: flex; gap: 12px;">
          <div style="flex: 1; position: relative; display: flex; align-items: center;">
            <input type="number" id="cal-height-ft" class="input-base input-lg" placeholder="5" min="1" max="9" aria-label="Height feet" />
            <span class="unit-badge">ft</span>
          </div>
          <div style="flex: 1; position: relative; display: flex; align-items: center;">
            <input type="number" id="cal-height-in" class="input-base input-lg" placeholder="9" min="0" max="11" aria-label="Height inches" />
            <span class="unit-badge">in</span>
          </div>
        </div>
      </div>

      <!-- Height (Other) -->
      <div id="cal-height-other-container" hidden>
        <label for="cal-height-other-val" class="label">Height</label>
        <div style="display: flex; gap: 8px;">
          <input type="number" id="cal-height-other-val" class="input-base input-lg" style="flex: 2;" placeholder="1.75" min="0.1" max="1000" step="any" aria-label="Height value" />
          <select id="cal-height-other-unit" class="input-base input-lg" style="flex: 1.2; min-width: 80px; padding-right: 12px;" aria-label="Height unit">
            <option value="m">m (Meter)</option>
            <option value="cm">cm</option>
            <option value="in">in</option>
            <option value="ft">ft</option>
          </select>
        </div>
      </div>

      <!-- Weight (Metric) -->
      <div id="cal-weight-metric-container">
        <label for="cal-weight-kg" class="label">Weight</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-weight-kg" class="input-base input-lg" placeholder="70" min="20" max="500" aria-label="Weight in kilograms" />
          <span class="unit-badge">kg</span>
        </div>
      </div>

      <!-- Weight (Imperial) -->
      <div id="cal-weight-imperial-container" hidden>
        <label for="cal-weight-lbs" class="label">Weight</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="number" id="cal-weight-lbs" class="input-base input-lg" placeholder="154" min="40" max="1100" aria-label="Weight in pounds" />
          <span class="unit-badge">lbs</span>
        </div>
      </div>

      <!-- Weight (Other) -->
      <div id="cal-weight-other-container" hidden>
        <label for="cal-weight-other-val" class="label">Weight</label>
        <div style="display: flex; gap: 8px;">
          <input type="number" id="cal-weight-other-val" class="input-base input-lg" style="flex: 2;" placeholder="70" min="0.1" max="10000" step="any" aria-label="Weight value" />
          <select id="cal-weight-other-unit" class="input-base input-lg" style="flex: 1.2; min-width: 80px; padding-right: 12px;" aria-label="Weight unit">
            <option value="kg">kg</option>
            <option value="lbs">lbs</option>
            <option value="g">g (Gram)</option>
            <option value="st">st (Stone)</option>
          </select>
        </div>
      </div>

      <!-- Activity Level list of radios -->
      <div>
        <label class="label" style="margin-bottom: 12px;">Activity Level</label>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="sedentary" checked style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Sedentary</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Little or no exercise</div>
            </div>
          </label>
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="light" style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Lightly active</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Exercise 1–3 times/week</div>
            </div>
          </label>
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="moderate" style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Moderately active</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Exercise 3–5 times/week</div>
            </div>
          </label>
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="active" style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Very active</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Exercise 6–7 times/week</div>
            </div>
          </label>
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="very_active" style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Extra active</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Very intense daily exercise or physical job</div>
            </div>
          </label>
          <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; cursor: pointer; line-height: 1.4;">
            <input type="radio" name="cal-activity-radio" value="bmr" style="accent-color: var(--color-ink); margin-top: 3px;" />
            <div>
              <strong>Basal Metabolic Rate (BMR)</strong>
              <div style="font-size: 12px; color: var(--color-muted);">Base metabolism only (no activity)</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Goal -->
      <div>
        <label for="cal-goal" class="label">Goal</label>
        <select id="cal-goal" class="select-base" aria-label="Weight goal">
          {goalOptions.map(o => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>

      <!-- Settings collapsible trigger -->
      <div style="margin-top: 8px;">
        <button type="button" id="settings-toggle-btn" style="background: none; border: none; color: var(--color-ink); font-weight: 600; font-size: 13.5px; display: flex; align-items: center; gap: 6px; cursor: pointer; padding: 4px 0;" aria-expanded="false">
          <span id="settings-toggle-icon">＋</span> Settings
        </button>
        
        <!-- Settings drawer content -->
        <div id="settings-drawer" style="margin-top: 12px; padding: 16px; border: 1px dashed var(--color-hairline); border-radius: var(--radius-md); background: var(--color-canvas-soft); display: none;">
          <!-- Results unit -->
          <div style="margin-bottom: 16px;">
            <label class="label" style="margin-bottom: 8px;">Results Unit</label>
            <div style="display: flex; gap: 16px;">
              <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
                <input type="radio" name="results-unit" value="calories" checked style="accent-color: var(--color-ink);" />
                Calories
              </label>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
                <input type="radio" name="results-unit" value="kilojoules" style="accent-color: var(--color-ink);" />
                Kilojoules
              </label>
            </div>
          </div>
          
          <!-- BMR Formula -->
          <div>
            <label class="label" style="margin-bottom: 8px;">BMR Estimation Formula</label>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
                <input type="radio" name="bmr-formula" value="mifflin" checked style="accent-color: var(--color-ink);" />
                Mifflin St Jeor
              </label>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
                <input type="radio" name="bmr-formula" value="harris" style="accent-color: var(--color-ink);" />
                Revised Harris-Benedict
              </label>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer;">
                <input type="radio" name="bmr-formula" value="katch" style="accent-color: var(--color-ink);" />
                Katch-McArdle
              </label>
            </div>
          </div>

          <!-- Body fat % input (Only shown when Katch-McArdle is selected) -->
          <div id="body-fat-container" style="margin-top: 12px;" hidden>
            <label for="cal-bodyfat" class="label">Body Fat %</label>
            <div style="position: relative; display: flex; align-items: center;">
              <input type="number" id="cal-bodyfat" class="input-base input-lg" placeholder="20" min="2" max="80" value="20" aria-label="Body fat percentage" />
              <span class="unit-badge">%</span>
            </div>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 16px;">
        <button id="calc-cal-btn" class="btn-primary" style="flex: 1;" aria-label="Calculate daily calorie needs">Calculate Calories</button>
        <button id="clear-cal-btn" class="btn-secondary" aria-label="Clear inputs">Clear</button>
      </div>
    </div>

    <!-- Error -->
    <div id="cal-error" class="calc-error" role="alert" aria-live="polite" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span id="cal-error-msg"></span>
    </div>

    <!-- Results -->
    <div id="cal-results" hidden aria-live="polite">
      <div class="results-divider"></div>

      <!-- Main Result Card -->
      <div class="main-result-card">
        <div class="main-result-value" id="cal-target">--</div>
        <div class="main-result-label" id="cal-target-label-text">Calories / Day</div>
        <div id="cal-goal-label" style="font-size: 14px; color: var(--color-muted); margin-top: 10px; font-weight: 500;"></div>
      </div>

      <!-- BMR + TDEE Details -->
      <div class="result-panel">
        <div class="result-row">
          <div>
            <div class="result-row-label" id="bmr-title-label">🔥 BMR (Basal Metabolic Rate)</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories burned at complete rest</div>
          </div>
          <span class="result-row-value" id="cal-bmr">--</span>
        </div>
        <div class="result-row">
          <div>
            <div class="result-row-label" id="tdee-title-label">⚡ TDEE (Total Daily Energy Expenditure)</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories burned with daily activity</div>
          </div>
          <span class="result-row-value" id="cal-tdee">--</span>
        </div>
        <div class="result-row" style="border-bottom: none;">
          <div>
            <div class="result-row-label">🎯 Target Energy</div>
            <div style="font-size: 12px; color: var(--color-muted); margin-top: 2px;">Calories to consume for selected goal</div>
          </div>
          <span class="result-row-value" id="cal-target-row" style="font-size: 16px; font-weight: 600;">--</span>
        </div>
      </div>

      <!-- Macros -->
      <div style="margin-top: 32px;">
        <h3 class="text-caption-mono" style="margin-bottom: 12px;">Suggested Macros</h3>
        <div class="macros-grid">
          <div class="macro-card">
            <div class="macro-value" id="macro-protein" style="color: #3b82f6;">--g</div>
            <div class="macro-label">Protein</div>
            <div class="macro-pct">30%</div>
          </div>
          <div class="macro-card">
            <div class="macro-value" id="macro-carbs" style="color: #7928ca;">--g</div>
            <div class="macro-label">Carbs</div>
            <div class="macro-pct">40%</div>
          </div>
          <div class="macro-card">
            <div class="macro-value" id="macro-fat" style="color: #f5a623;">--g</div>
            <div class="macro-label">Fat</div>
            <div class="macro-pct">30%</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Food Energy Converter Section -->
  <div style="margin-top: 48px;" class="prose-section fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 8px;">Food Energy Converter</h2>
    <p class="text-body-md" style="color: var(--color-body); margin-bottom: 24px;">
      Convert values between Calories and other common food energy units.
    </p>
    
    <div class="calc-panel animate-fade-in" style="background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); padding: 24px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input type="number" id="food-input-val" class="input-base input-lg" style="flex: 1; min-width: 120px;" placeholder="1" value="1" />
          <select id="food-from-unit" class="input-base input-lg" style="flex: 2; min-width: 180px; padding-right: 12px;">
            <option value="kcal">Calorie (Nutrition) [kcal]</option>
            <option value="kj">Kilojoules [kJ]</option>
            <option value="j">Joules [J]</option>
            <option value="kcal_it">Kilocalories (IT) [kcal]</option>
            <option value="wh">Watt-hour [Wh]</option>
          </select>
        </div>
        
        <div style="text-align: center; font-size: 20px; font-weight: 700; color: var(--color-ink);">=</div>
        
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input type="text" id="food-output-val" class="input-base input-lg" style="flex: 1; min-width: 120px;" readonly placeholder="Result" />
          <select id="food-to-unit" class="input-base input-lg" style="flex: 2; min-width: 180px; padding-right: 12px;">
            <option value="kj">Kilojoules [kJ]</option>
            <option value="kcal">Calorie (Nutrition) [kcal]</option>
            <option value="j">Joules [J]</option>
            <option value="kcal_it">Kilocalories (IT) [kcal]</option>
            <option value="wh">Watt-hour [Wh]</option>
          </select>
        </div>
        
        <div style="display: flex; gap: 12px; margin-top: 8px;">
