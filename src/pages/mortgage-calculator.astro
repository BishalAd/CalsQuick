<script>
  // ─── STAGE 1: TABS MANAGEMENT ──────────────────────────────────────────────
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTabId = btn.getAttribute('data-tab');
      
      tabButtons.forEach(b => b.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));
      
      btn.classList.add('active');
      const target = document.getElementById(targetTabId!);
      if (target) target.classList.add('active');

      // Re-trigger calculations based on active tab
      if (targetTabId === 'tab-standard') calculateStandard();
      else if (targetTabId === 'tab-commercial') calculateCommercial();
      else if (targetTabId === 'tab-reverse') calculateReverse();
      else if (targetTabId === 'tab-affordability') calculateAffordability();
    });
  });

  // ─── STAGE 2: ACCORDIONS MANAGEMENT ─────────────────────────────────────────
  const accordionToggles = document.querySelectorAll('.accordion-toggle');
  accordionToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const contentId = toggle.getAttribute('aria-controls');
      const content = document.getElementById(contentId!);
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      toggle.classList.toggle('active', !isExpanded);
      if (content) content.hidden = isExpanded;
    });
  });

  // ─── STAGE 3: STANDARD MORTGAGE & EXTRA PAYMENTS CALCS ──────────────────────
  
  // Elements
  const stdHomePrice = document.getElementById('std-home-price') as HTMLInputElement;
  const stdState = document.getElementById('std-state') as HTMLSelectElement;
  const stdDownPercent = document.getElementById('std-down-percent') as HTMLInputElement;
  const stdDownCash = document.getElementById('std-down-cash') as HTMLInputElement;
  const stdTerm = document.getElementById('std-term') as HTMLSelectElement;
  const stdRate = document.getElementById('std-rate') as HTMLInputElement;
  const stdStartMonth = document.getElementById('std-start-month') as HTMLSelectElement;
  const stdStartYear = document.getElementById('std-start-year') as HTMLInputElement;

  // Escrow Elements
  const stdTaxRate = document.getElementById('std-tax-rate') as HTMLInputElement;
  const stdInsurance = document.getElementById('std-insurance') as HTMLInputElement;
  const stdPmi = document.getElementById('std-pmi') as HTMLInputElement;
  const stdHoa = document.getElementById('std-hoa') as HTMLInputElement;
  const stdHomestead = document.getElementById('std-homestead') as HTMLInputElement;

  // Extra Principal Elements
  const extraMonthly = document.getElementById('extra-monthly') as HTMLInputElement;
  const extraYearly = document.getElementById('extra-yearly') as HTMLInputElement;
  const extraYearlyMonth = document.getElementById('extra-yearly-month') as HTMLSelectElement;
  const extraOnetime = document.getElementById('extra-onetime') as HTMLInputElement;
  const extraOnetimeMonth = document.getElementById('extra-onetime-month') as HTMLSelectElement;
  const extraOnetimeYear = document.getElementById('extra-onetime-year') as HTMLInputElement;

  // Scenario Comparison Elements
  const compTerm = document.getElementById('comp-term') as HTMLSelectElement;
  const compRate = document.getElementById('comp-rate') as HTMLInputElement;
  const compAPi = document.getElementById('comp-a-pi') as HTMLElement;
  const compAInterest = document.getElementById('comp-a-interest') as HTMLElement;
  const compBPi = document.getElementById('comp-b-pi') as HTMLElement;
  const compBInterest = document.getElementById('comp-b-interest') as HTMLElement;
  const compSavingsBox = document.getElementById('comp-savings-box') as HTMLElement;
  const compSavingsText = document.getElementById('comp-savings-text') as HTMLElement;

  // Outputs
  const stdMonthlyPayment = document.getElementById('std-monthly-payment') as HTMLElement;
  const stdBreakdownPi = document.getElementById('std-breakdown-pi') as HTMLElement;
  const stdBreakdownTaxes = document.getElementById('std-breakdown-taxes') as HTMLElement;
  const stdBreakdownIns = document.getElementById('std-breakdown-ins') as HTMLElement;
  const stdBreakdownPmi = document.getElementById('std-breakdown-pmi') as HTMLElement;
  const stdBreakdownHoa = document.getElementById('std-breakdown-hoa') as HTMLElement;

  const stdSummaryLoan = document.getElementById('std-summary-loan') as HTMLElement;
  const stdSummaryDown = document.getElementById('std-summary-down') as HTMLElement;
  const stdSummaryInterest = document.getElementById('std-summary-interest') as HTMLElement;
  const stdSummaryTotal = document.getElementById('std-summary-total') as HTMLElement;
  const stdSummaryPayoff = document.getElementById('std-summary-payoff') as HTMLElement;

  const extraSavingsBanner = document.getElementById('extra-savings-banner') as HTMLElement;
  const savingsYears = document.getElementById('savings-years') as HTMLElement;
  const savingsInterest = document.getElementById('savings-interest') as HTMLElement;
  const texasInfoCard = document.getElementById('texas-info-card') as HTMLElement;

  // Schedule Toggles & Export
  const btnScheduleAnnual = document.getElementById('btn-schedule-annual') as HTMLButtonElement;
  const btnScheduleMonthly = document.getElementById('btn-schedule-monthly') as HTMLButtonElement;
  const btnExportCsv = document.getElementById('btn-export-csv') as HTMLButtonElement;
  const scheduleMetaInfo = document.getElementById('schedule-meta-info') as HTMLElement;
  const amortTableBody = document.getElementById('amortization-table-body') as HTMLElement;

  let scheduleMode: 'annual' | 'monthly' = 'annual';
  let lastScheduleRows: any[] = [];

  // Sync Downpayment
  function syncDownPayment(changed: 'percent' | 'cash') {
    const hp = parseFloat(stdHomePrice.value) || 400000;
    if (changed === 'percent') {
      const pct = stdDownPercent.value === "" ? 20 : parseFloat(stdDownPercent.value) || 0;
      stdDownCash.value = stdHomePrice.value === "" ? "" : String(Math.round((pct * hp) / 100));
    } else {
      const cash = stdDownCash.value === "" ? 80000 : parseFloat(stdDownCash.value) || 0;
      stdDownPercent.value = stdHomePrice.value === "" ? "" : (cash / hp * 100).toFixed(2);
    }
  }

  stdHomePrice.addEventListener('input', () => {
    syncDownPayment('percent');
    calculateStandard();
  });
  stdDownPercent.addEventListener('input', () => {
    syncDownPayment('percent');
    calculateStandard();
  });
  stdDownCash.addEventListener('input', () => {
    syncDownPayment('cash');
    calculateStandard();
  });

  stdState.addEventListener('change', () => {
    if (stdState.value === 'tx') {
      stdTaxRate.value = '1.8';
      texasInfoCard.style.display = 'block';
    } else {
      stdTaxRate.value = '1.2';
      texasInfoCard.style.display = 'none';
    }
    calculateStandard();
  });

  // Re-run standard on any change
  [
    stdTerm, stdRate, stdStartMonth, stdStartYear,
    stdTaxRate, stdInsurance, stdPmi, stdHoa, stdHomestead,
    extraMonthly, extraYearly, extraYearlyMonth, extraOnetime, extraOnetimeMonth, extraOnetimeYear,
    compTerm, compRate
  ].forEach(input => {
    input.addEventListener('input', () => calculateStandard());
    input.addEventListener('change', () => calculateStandard());
  });

  btnScheduleAnnual.addEventListener('click', () => {
    scheduleMode = 'annual';
    btnScheduleAnnual.classList.add('active');
    btnScheduleMonthly.classList.remove('active');
    calculateStandard();
  });
  btnScheduleMonthly.addEventListener('click', () => {
    scheduleMode = 'monthly';
    btnScheduleMonthly.classList.add('active');
    btnScheduleAnnual.classList.remove('active');
    calculateStandard();
  });

  // Export CSV Listener
  btnExportCsv.addEventListener('click', () => {
    if (lastScheduleRows.length === 0) return;
    let csvContent = 'data:text/csv;charset=utf-8,';
    csvContent += 'Period,Date,Interest,Principal,Extra Payment,Ending Balance\n';
    
    lastScheduleRows.forEach(row => {
      csvContent += `"${scheduleMode === 'annual' ? 'Year ' + row.period : 'Month ' + row.period}","${row.dateStr}",${row.interest.toFixed(2)},${row.principal.toFixed(2)},${row.extra.toFixed(2)},${row.balance.toFixed(2)}\n`;
    });
    
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `mortgage_amortization_schedule_${scheduleMode}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  const monthsText = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function formatCurrency(val: number): string {
    return '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Core Standard Amortization Math
  function calculateStandard() {
    // Dynamic Fallbacks
    const hp = parseFloat(stdHomePrice.value) || 400000;
    const dp = stdDownCash.value === "" ? (stdDownPercent.value === "" ? 80000 : Math.round((parseFloat(stdDownPercent.value) || 20) * hp / 100)) : (parseFloat(stdDownCash.value) || 0);
    const principal = Math.max(0, hp - dp);
    const years = parseInt(stdTerm.value) || 30;
    const numPayments = years * 12;
    const annualRate = parseFloat(stdRate.value) || 6.5;
    const monthlyRate = annualRate / 12 / 100;
    const startM = parseInt(stdStartMonth.value) || 0;
    const startY = parseInt(stdStartYear.value) || 2026;

    // Escrow Items
    const taxRate = stdTaxRate.value === "" ? (stdState.value === 'tx' ? 1.8 : 1.2) : parseFloat(stdTaxRate.value) || 0;
    const insVal = stdInsurance.value === "" ? 1200 : parseFloat(stdInsurance.value) || 0;
    const pmiVal = stdPmi.value === "" ? 0.5 : parseFloat(stdPmi.value) || 0;
    const hoaVal = stdHoa.value === "" ? 0 : parseFloat(stdHoa.value) || 0;
    const homestead = stdHomestead.value === "" ? 0 : parseFloat(stdHomestead.value) || 0;

    // Monthly escrow (Taxes are evaluated on property value minus homestead exemption reduction)
    const taxableHp = Math.max(0, hp - homestead);
    const mTax = (taxableHp * (taxRate / 100)) / 12;
    const mIns = insVal / 12;
    // PMI is typically only applied if Down Payment is < 20%
    const isPmiApplies = dp < (hp * 0.20);
    const mPmi = isPmiApplies ? (principal * (pmiVal / 100)) / 12 : 0;
    const mHoa = hoaVal;

    // Standard P&I payment
    let mPi = 0;
    if (monthlyRate === 0) {
      mPi = principal / numPayments;
    } else {
      mPi = principal * (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) / (Math.pow(1 + monthlyRate, numPayments) - 1);
    }

    const totalMonthlyPayment = mPi + mTax + mIns + mPmi + mHoa;

    // Render Monthly Outputs
    stdMonthlyPayment.textContent = formatCurrency(totalMonthlyPayment);
    stdBreakdownPi.textContent = formatCurrency(mPi);
    stdBreakdownTaxes.textContent = formatCurrency(mTax);
    stdBreakdownIns.textContent = formatCurrency(mIns);
    stdBreakdownPmi.textContent = formatCurrency(mPmi);
    stdBreakdownHoa.textContent = formatCurrency(mHoa);

    stdSummaryLoan.textContent = formatCurrency(principal);
    stdSummaryDown.textContent = formatCurrency(dp);

    // Extra Payments Parameters
    const eMonthly = Math.max(0, parseFloat(extraMonthly.value) || 0);
    const eYearly = Math.max(0, parseFloat(extraYearly.value) || 0);
    const eYearlyMonth = parseInt(extraYearlyMonth.value) || 0;
    const eOnetime = Math.max(0, parseFloat(extraOnetime.value) || 0);
    const eOnetimeMonth = parseInt(extraOnetimeMonth.value) || 0;
    const eOnetimeYear = parseInt(extraOnetimeYear.value) || 2027;

    // ── Run Loop A: Standard Amortization (No Extras)
    let balanceA = principal;
    let totalInterestA = 0;
    let payoffMonthA = 0;
    const chartBalanceDataA: number[] = [principal];

    for (let i = 1; i <= numPayments; i++) {
      const interestA = balanceA * monthlyRate;
      let principalA = mPi - interestA;
      if (principalA > balanceA) principalA = balanceA;
      balanceA -= principalA;
      totalInterestA += interestA;
      chartBalanceDataA.push(balanceA);
      if (balanceA <= 0 && payoffMonthA === 0) {
        payoffMonthA = i;
      }
    }
    if (payoffMonthA === 0) payoffMonthA = numPayments;

    // ── Run Loop B: Amortization with Extra Payments
    let balanceB = principal;
    let totalInterestB = 0;
    let payoffMonthB = 0;
    const chartBalanceDataB: number[] = [principal];
    const scheduleRows: Array<{
      period: number;
      dateStr: string;
      interest: number;
      principal: number;
      extra: number;
      balance: number;
    }> = [];

    // Tracks yearly totals
    let yrInterest = 0;
    let yrPrincipal = 0;
    let yrExtra = 0;

    let currentM = startM;
    let currentY = startY;

    // We cap loop safety at 600 payments (50 years)
    for (let i = 1; i <= 600; i++) {
      if (balanceB <= 0) {
        if (payoffMonthB === 0) payoffMonthB = i - 1;
        break;
      }

      const interestB = balanceB * monthlyRate;
      let regularPrincipalB = mPi - interestB;
      if (regularPrincipalB > balanceB) regularPrincipalB = balanceB;

      // Calculate Extras
      let extraB = eMonthly;
      
      // Yearly Extra
      if (currentM === eYearlyMonth && i > 1) {
        extraB += eYearly;
      }
      // One-time Extra
      if (currentM === eOnetimeMonth && currentY === eOnetimeYear) {
        extraB += eOnetime;
      }

      // Cap at remaining balance
      let totalPrincipalB = regularPrincipalB + extraB;
      if (totalPrincipalB > balanceB) {
        totalPrincipalB = balanceB;
        extraB = Math.max(0, balanceB - regularPrincipalB);
      }

      const prevBal = balanceB;
      balanceB -= totalPrincipalB;
      totalInterestB += interestB;

      chartBalanceDataB.push(balanceB);

      // Save for Schedule Table
      yrInterest += interestB;
      yrPrincipal += totalPrincipalB - extraB;
      yrExtra += extraB;

      const dateStr = monthsText[currentM] + ' ' + currentY;

      if (scheduleMode === 'monthly') {
        scheduleRows.push({
          period: i,
          dateStr,
          interest: interestB,
          principal: totalPrincipalB - extraB,
          extra: extraB,
          balance: balanceB
        });
      } else {
        // Annual Schedule aggregates
        // Push at Dec or if it's the final month of the loan
        const isYearEnd = currentM === 11;
        const isFinal = balanceB <= 0;
        if (isYearEnd || isFinal) {
          const yearNum = currentY - startY + 1;
          scheduleRows.push({
            period: yearNum,
            dateStr: String(currentY),
            interest: yrInterest,
            principal: yrPrincipal,
            extra: yrExtra,
            balance: balanceB
          });
          // Reset year aggregators
          yrInterest = 0;
          yrPrincipal = 0;
          yrExtra = 0;
        }
      }

      // Advance Date
      currentM++;
      if (currentM > 11) {
        currentM = 0;
        currentY++;
      }
    }

    if (payoffMonthB === 0) payoffMonthB = numPayments;

    // Save for CSV download
    lastScheduleRows = scheduleRows;

    // Display Savings Info
    const hasExtras = eMonthly > 0 || eYearly > 0 || eOnetime > 0;
    if (hasExtras && payoffMonthB < payoffMonthA) {
      extraSavingsBanner.style.display = 'block';
      const mSaved = payoffMonthA - payoffMonthB;
      const yrs = Math.floor(mSaved / 12);
      const mos = mSaved % 12;
      savingsYears.textContent = yrs > 0 ? `${yrs} yrs, ${mos} mos` : `${mos} mos`;
      savingsInterest.textContent = formatCurrency(totalInterestA - totalInterestB);
      
      stdSummaryInterest.textContent = formatCurrency(totalInterestB);
      stdSummaryTotal.textContent = formatCurrency(principal + totalInterestB);

      const payoffTargetM = (startM + payoffMonthB) % 12;
      const payoffTargetY = startY + Math.floor((startM + payoffMonthB) / 12);
      stdSummaryPayoff.textContent = monthsText[payoffTargetM] + ' ' + payoffTargetY;
    } else {
      extraSavingsBanner.style.display = 'none';
      stdSummaryInterest.textContent = formatCurrency(totalInterestA);
      stdSummaryTotal.textContent = formatCurrency(principal + totalInterestA);

      const payoffTargetM = (startM + payoffMonthA) % 12;
      const payoffTargetY = startY + Math.floor((startM + payoffMonthA) / 12);
      stdSummaryPayoff.textContent = monthsText[payoffTargetM] + ' ' + payoffTargetY;
    }

    // Render Table Rows
    let tableHtml = '';
    const hasExtraCol = hasExtras;
    const tableHeaderExtra = document.querySelector('.extra-col') as HTMLElement;
    if (tableHeaderExtra) tableHeaderExtra.style.display = hasExtraCol ? '' : 'none';

    scheduleRows.forEach(row => {
      tableHtml += `
        <tr>
          <td>${scheduleMode === 'annual' ? 'Yr ' + row.period : 'Mo ' + row.period}</td>
          <td>${row.dateStr}</td>
          <td>${formatCurrency(row.interest)}</td>
          <td>${formatCurrency(row.principal)}</td>
          ${hasExtraCol ? `<td>${formatCurrency(row.extra)}</td>` : ''}
          <td>${formatCurrency(row.balance)}</td>
        </tr>
      `;
    });
    amortTableBody.innerHTML = tableHtml;
    scheduleMetaInfo.textContent = scheduleMode === 'annual' 
      ? `${Math.ceil(payoffMonthB / 12)} Years`
      : `${payoffMonthB} Payments`;

    // Render Visual Pie Chart
    drawPieChart(mPi, mTax, mIns, mPmi, mHoa);

    // Render Line Chart
    drawLineChart(chartBalanceDataA, chartBalanceDataB, startY);

    // ── Comparison Logic (Scenario B calculation)
    calculateComparison(principal, mPi, totalInterestA);
  }

  // Side-by-side scenario calculator
  function calculateComparison(principal: number, standardPi: number, standardInterest: number) {
    const termB = parseInt(compTerm.value) || 15;
    const rateB = parseFloat(compRate.value) || 5.5;

    const rB = rateB / 12 / 100;
    const nB = termB * 12;

    let piB = 0;
    if (rB === 0) {
      piB = principal / nB;
    } else {
      piB = principal * (rB * Math.pow(1 + rB, nB)) / (Math.pow(1 + rB, nB) - 1);
    }

    // Calculate Scenario B interest
    let balance = principal;
    let interestB = 0;
    for (let i = 0; i < nB; i++) {
      const interestPayment = balance * rB;
      let principalPayment = piB - interestPayment;
      if (principalPayment > balance) principalPayment = balance;
      balance -= principalPayment;
      interestB += interestPayment;
    }

    // Render badges
    compAPi.textContent = formatCurrency(standardPi);
    compAInterest.textContent = formatCurrency(standardInterest);

    compBPi.textContent = formatCurrency(piB);
    compBInterest.textContent = formatCurrency(interestB);

    // Render Savings note
    const savings = standardInterest - interestB;
    compSavingsBox.style.display = 'block';
    if (savings > 0) {
      compSavingsText.innerHTML = `✨ <strong>Savings Highlight:</strong> Scenario B saves you <strong>${formatCurrency(savings)}</strong> in lifetime interest compared to Scenario A, though the monthly P&amp;I payment changes by <strong>${formatCurrency(Math.abs(standardPi - piB))}</strong>.`;
    } else if (savings < 0) {
      compSavingsText.innerHTML = `💡 <strong>Payment Highlight:</strong> Scenario B costs <strong>${formatCurrency(Math.abs(savings))}</strong> more in interest, but lowers your monthly P&amp;I payment by <strong>${formatCurrency(Math.abs(standardPi - piB))}</strong>.`;
    } else {
      compSavingsText.textContent = `Both scenarios are equivalent.`;
    }
  }

  // ─── STAGE 4: PIE CHART RENDERING ──────────────────────────────────────────
  function drawPieChart(pi: number, tax: number, ins: number, pmi: number, hoa: number) {
    const canvas = document.getElementById('payment-pie-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const total = pi + tax + ins + pmi + hoa;
    if (total === 0) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      return;
    }

    // Reset scale / clear
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const values = [pi, tax, ins, pmi, hoa];
    const colors = ['#0070f3', '#10b981', '#f5a623', '#ee0000', '#7928ca'];
    
    let startAngle = -Math.PI / 2;
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    const outerRadius = Math.min(centerX, centerY) - 5;
    const innerRadius = outerRadius * 0.55;

    values.forEach((val, idx) => {
      if (val === 0) return;
      const sliceAngle = (val / total) * 2 * Math.PI;

      // Draw Slice
      ctx.fillStyle = colors[idx];
      ctx.beginPath();
      ctx.arc(centerX, centerY, outerRadius, startAngle, startAngle + sliceAngle);
      ctx.arc(centerX, centerY, innerRadius, startAngle + sliceAngle, startAngle, true);
      ctx.closePath();
      ctx.fill();

      startAngle += sliceAngle;
    });

    // Draw center hole overlay to make a nice donut chart
    const cs = getComputedStyle(document.documentElement);
    const bgColor = cs.getPropertyValue('--color-canvas').trim() || '#ffffff';
    ctx.fillStyle = bgColor;
    ctx.beginPath();
    ctx.arc(centerX, centerY, innerRadius, 0, 2 * Math.PI);
    ctx.fill();

    // Center Text
    ctx.fillStyle = cs.getPropertyValue('--color-ink').trim() || '#171717';
    ctx.font = 'bold 12px -apple-system, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    
    // Percentage helper
    const piPct = Math.round((pi / total) * 100);
    ctx.fillText(`${piPct}% P&I`, centerX, centerY);
  }

  // ─── STAGE 5: LINE CHART RENDERING ─────────────────────────────────────────
  function drawLineChart(dataA: number[], dataB: number[], startYear: number) {
    const canvas = document.getElementById('balance-line-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    // Make canvas display correct pixel sizes
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const W = rect.width;
    const H = rect.height;

    ctx.clearRect(0, 0, W, H);

    const padding = { top: 20, right: 20, bottom: 30, left: 55 };
    const chartW = W - padding.left - padding.right;
    const chartH = H - padding.top - padding.bottom;

    const maxVal = dataA[0]; // original principal is always max
    if (maxVal === 0) return;

    const cs = getComputedStyle(document.documentElement);
    const inkColor = cs.getPropertyValue('--color-ink').trim() || '#171717';
    const hairColor = cs.getPropertyValue('--color-hairline').trim() || '#e5e7eb';
    const bodyColor = cs.getPropertyValue('--color-body').trim() || '#4b5563';

    // Draw Grid Lines (Y axis)
    ctx.strokeStyle = hairColor;
    ctx.lineWidth = 0.8;
    ctx.fillStyle = bodyColor;
    ctx.font = '10px -apple-system, sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';

    const yTicks = 4;
    for (let i = 0; i <= yTicks; i++) {
      const pct = i / yTicks;
      const y = padding.top + chartH * (1 - pct);
      const val = maxVal * pct;

      // Grid line
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(W - padding.right, y);
      ctx.stroke();

      // Label
      ctx.fillText('$' + Math.round(val/1000) + 'k', padding.left - 8, y);
    }

    // Draw X-axis ticks (every 5 years)
    const totalPayments = dataA.length - 1;
    const totalYears = Math.ceil(totalPayments / 12);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';

    const xTickStep = Math.max(1, Math.ceil(totalYears / 6)); // Step in years
    for (let yVal = 0; yVal <= totalYears; yVal += xTickStep) {
      const mVal = yVal * 12;
      const xPct = Math.min(1, mVal / totalPayments);
      const x = padding.left + chartW * xPct;

      // Label
      ctx.fillText(String(startYear + yVal), x, H - padding.bottom + 8);
    }

    // Graph Drawing function
    function drawCurve(data: number[], strokeStyle: string, lineWidth: number, isDashed = false) {
      ctx.strokeStyle = strokeStyle;
      ctx.lineWidth = lineWidth;
      if (isDashed) ctx.setLineDash([4, 4]);
      else ctx.setLineDash([]);
      ctx.beginPath();

      const totalPoints = data.length;
      data.forEach((val, idx) => {
        const xPct = idx / (totalPoints - 1);
        const yPct = val / maxVal;
        const x = padding.left + chartW * xPct;
        const y = padding.top + chartH * (1 - yPct);

        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Standard Loan trajectory (dashed if extras are present)
    const hasExtras = dataB.length < dataA.length;
    drawCurve(dataA, '#8e8e93', 1.5, hasExtras);

    // Extra Payoff trajectory (solid blue/success line)
    if (hasExtras) {
      drawCurve(dataB, '#0070f3', 2.5);
    }

    // Draw Axes Borders
    ctx.strokeStyle = inkColor;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(padding.left, padding.top);
    ctx.lineTo(padding.left, H - padding.bottom);
    ctx.lineTo(W - padding.right, H - padding.bottom);
    ctx.stroke();
  }

  // ─── STAGE 6: COMMERCIAL MORTGAGE CALCULATOR ──────────────────────────────
  const commAmount = document.getElementById('comm-amount') as HTMLInputElement;
  const commRate = document.getElementById('comm-rate') as HTMLInputElement;
  const commAmort = document.getElementById('comm-amort') as HTMLSelectElement;
  const commTerm = document.getElementById('comm-term') as HTMLSelectElement;

  const commMonthlyVal = document.getElementById('comm-monthly-val') as HTMLElement;
  const commBalloonVal = document.getElementById('comm-balloon-val') as HTMLElement;
  const commBalloonYear = document.getElementById('comm-balloon-year') as HTMLElement;
  const commTotalPrincipal = document.getElementById('comm-total-principal') as HTMLElement;
  const commTotalInterest = document.getElementById('comm-total-interest') as HTMLElement;
  const commTotalPayments = document.getElementById('comm-total-payments') as HTMLElement;

  [commAmount, commRate, commAmort, commTerm].forEach(input => {
    input?.addEventListener('input', calculateCommercial);
    input?.addEventListener('change', calculateCommercial);
  });

  // ─── STAGE 7: REVERSE MORTGAGE HECM ESTIMATOR ─────────────────────────────
  const revHomeVal = document.getElementById('rev-home-val') as HTMLInputElement;
  const revBalance = document.getElementById('rev-balance') as HTMLInputElement;
  const revAge = document.getElementById('rev-age') as HTMLInputElement;
  const revRate = document.getElementById('rev-rate') as HTMLInputElement;

  const revLimitVal = document.getElementById('rev-limit-val') as HTMLElement;
  const revNetVal = document.getElementById('rev-net-val') as HTMLElement;
  const revFactorVal = document.getElementById('rev-factor-val') as HTMLElement;
  const revPayoffVal = document.getElementById('rev-payoff-val') as HTMLElement;
  const revLocVal = document.getElementById('rev-loc-val') as HTMLElement;
  const revTenureVal = document.getElementById('rev-tenure-val') as HTMLElement;
  const revWarningBox = document.getElementById('rev-warning-box') as HTMLElement;

  [revHomeVal, revBalance, revAge, revRate].forEach(input => {
    input?.addEventListener('input', calculateReverse);
    input?.addEventListener('change', calculateReverse);
  });

  // ─── STAGE 8: HOUSE AFFORDABILITY CALCULATOR ──────────────────────────────
  const affIncome = document.getElementById('aff-income') as HTMLInputElement;
  const affDebts = document.getElementById('aff-debts') as HTMLInputElement;
  const affDown = document.getElementById('aff-down') as HTMLInputElement;
  const affRate = document.getElementById('aff-rate') as HTMLInputElement;
  const affTerm = document.getElementById('aff-term') as HTMLSelectElement;
  const affEscrow = document.getElementById('aff-escrow') as HTMLInputElement;

  const affHomeVal = document.getElementById('aff-home-val') as HTMLElement;
  const affPaymentVal = document.getElementById('aff-payment-val') as HTMLElement;
  const affLoanVal = document.getElementById('aff-loan-val') as HTMLElement;
  const affSavedVal = document.getElementById('aff-saved-val') as HTMLElement;
  const affDtiVal = document.getElementById('aff-dti-val') as HTMLElement;

  [affIncome, affDebts, affDown, affRate, affTerm, affEscrow].forEach(input => {
    input?.addEventListener('input', calculateAffordability);
    input?.addEventListener('change', calculateAffordability);
  });

  // Shared implementation logic
  function calculateCommercial() {
    if (!commAmount) return;
    const principal = parseFloat(commAmount.value) || 1000000;
    const rate = parseFloat(commRate.value) || 7.5;
    const amortYears = parseInt(commAmort.value) || 25;
    const termYears = parseInt(commTerm.value) || 5;

    const r = rate / 12 / 100;
    const nAmort = amortYears * 12;
    const nTerm = termYears * 12;

    let mPi = 0;
    if (r === 0) {
      mPi = principal / nAmort;
    } else {
      mPi = principal * (r * Math.pow(1 + r, nAmort)) / (Math.pow(1 + r, nAmort) - 1);
    }

    let balloon = principal;
    let totalInterest = 0;
    for (let i = 1; i <= nTerm; i++) {
      const interest = balloon * r;
      let regularPrincipal = mPi - interest;
      if (regularPrincipal > balloon) regularPrincipal = balloon;
      balloon -= regularPrincipal;
      totalInterest += interest;
    }

    const totalPrincipalPaid = principal - balloon;
    const totalPayments = (mPi * nTerm);

    commMonthlyVal.textContent = formatCurrency(mPi);
    commBalloonVal.textContent = formatCurrency(balloon);
    commBalloonYear.textContent = String(termYears);
    commTotalPrincipal.textContent = formatCurrency(totalPrincipalPaid);
    commTotalInterest.textContent = formatCurrency(totalInterest);
    commTotalPayments.textContent = formatCurrency(totalPayments);
  }

  function calculateReverse() {
    if (!revHomeVal) return;
    const homeVal = parseFloat(revHomeVal.value) || 500000;
    const balance = revBalance.value === "" ? 100000 : parseFloat(revBalance.value) || 0;
    const age = parseInt(revAge.value) || 68;
    const rate = parseFloat(revRate.value) || 6.25;

    const cappedHomeVal = Math.min(homeVal, 1149825);
    let plf = 0.35 + (age - 62) * 0.012 - (rate - 6.0) * 0.025;
    plf = Math.min(0.75, Math.max(0.10, plf));

    const principalLimit = cappedHomeVal * plf;
    const netProceeds = principalLimit - balance;

    revLimitVal.textContent = formatCurrency(principalLimit);
    revFactorVal.textContent = (plf * 100).toFixed(1) + '%';
    revPayoffVal.textContent = formatCurrency(balance);

    if (netProceeds < 0) {
      revNetVal.textContent = '$0.00';
      revLocVal.textContent = '$0.00';
      revTenureVal.textContent = '$0.00 /mo';
      revWarningBox.style.display = 'block';
    } else {
      revNetVal.textContent = formatCurrency(netProceeds);
      revLocVal.textContent = formatCurrency(netProceeds);
      revWarningBox.style.display = 'none';

      const lifeExpectancyYears = Math.max(5, 90 - age);
      const tenurePay = netProceeds / (lifeExpectancyYears * 12);
      revTenureVal.textContent = formatCurrency(tenurePay) + ' /mo';
    }
  }

  function calculateAffordability() {
    if (!affIncome) return;
    const annualIncome = parseFloat(affIncome.value) || 100000;
    const monthlyDebts = affDebts.value === "" ? 400 : parseFloat(affDebts.value) || 0;
    const downPayment = affDown.value === "" ? 50000 : parseFloat(affDown.value) || 0;
    const rate = parseFloat(affRate.value) || 6.5;
    const termYears = parseInt(affTerm.value) || 30;
    const escrowPct = affEscrow.value === "" ? 1.5 : parseFloat(affEscrow.value) || 0;

    const monthlyIncome = annualIncome / 12;
    const frontLimit = monthlyIncome * 0.28;
    const backLimit = monthlyIncome * 0.36 - monthlyDebts;

    const maxMonthlyHousing = Math.max(0, Math.min(frontLimit, backLimit));
    
    const r = rate / 12 / 100;
    const n = termYears * 12;
    let F = 0;
    if (r === 0) {
      F = 1 / n;
    } else {
      F = (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    const escrowFactor = escrowPct / 1200;
    const affordableHomePrice = (maxMonthlyHousing + downPayment * F) / (F + escrowFactor);
    const affordableLoanAmount = Math.max(0, affordableHomePrice - downPayment);

    affHomeVal.textContent = formatCurrency(Math.max(0, affordableHomePrice));
    affPaymentVal.textContent = formatCurrency(maxMonthlyHousing);
    affLoanVal.textContent = formatCurrency(affordableLoanAmount);
    affSavedVal.textContent = formatCurrency(downPayment);
    affDtiVal.textContent = formatCurrency(monthlyIncome * 0.36);
  }

  // ─── STAGE 9: INITIALIZE AND AUTO-REDRAW ON THEME CHANGED ───────────────────
  
  // Watch for theme changes (re-draw canvas)
  const themeObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'data-theme') {
        requestAnimationFrame(() => {
          if (document.getElementById('tab-standard')?.classList.contains('active')) {
            calculateStandard();
          }
        });
      }
    });
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Accordion FAQ Toggle
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });

  // Init inputs on load
  requestAnimationFrame(() => {
    calculateStandard();
    calculateCommercial();
    calculateReverse();
    calculateAffordability();
  });
</script>
