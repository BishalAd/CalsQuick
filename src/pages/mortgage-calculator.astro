---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { 
    q: 'How do extra principal payments affect my mortgage payoff?', 
    a: 'Extra principal payments go directly toward reducing the outstanding loan balance, rather than paying interest. This shortens the loan term and reduces the total interest paid over the life of the loan. Even small monthly or annual extra payments can save tens of thousands of dollars and shave years off your payoff timeline.' 
  },
  { 
    q: 'How does a commercial mortgage calculator differ from a residential mortgage calculator?', 
    a: 'Commercial mortgage payment calculators differ because commercial loans often feature shorter terms (like 5, 7, or 10 years) combined with longer amortization periods (typically 20 or 25 years). This leads to a balloon payment at the end of the loan term, where the remaining balance must be paid off or refinanced.' 
  },
  { 
    q: 'What is a reverse mortgage calculator estimate based on?', 
    a: 'A reverse mortgage estimate (HECM) calculates the Principal Limit based on the youngest borrower\'s age (minimum 62), current interest rates, and the home\'s appraised value (subject to FHA limits). The net proceeds can pay off any existing home loan, and the rest can be taken as cash, monthly payments, or a line of credit.' 
  },
  { 
    q: 'How do property taxes and insurance affect my monthly mortgage payments?', 
    a: 'Your monthly out-of-pocket cost consists of Principal & Interest (P&I) plus escrow expenses like property taxes, homeowner\'s insurance, Private Mortgage Insurance (PMI), and HOA fees. PMI is typically required if your down payment is less than 20%.' 
  },
  { 
    q: 'What are the average property tax rates for a mortgage in Texas?', 
    a: 'Texas has some of the highest property tax rates in the US, with an average rate of about 1.6% to 2.0% of the home\'s value. However, Texas residents can qualify for the General Residence Homestead Exemption, which exempts up to $100,000 of their home\'s value from school district taxes, helping lower payments.' 
  },
];

const schemas = [
  generateSoftwareApplication({
    name: 'Mortgage Calculator Suite with Extra Payments',
    description: 'Free online mortgage calculator to estimate monthly payments, property taxes, home insurance, PMI, extra principal payoffs, commercial loans, and reverse mortgages.',
    url: '/mortgage-calculator',
  }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Tip Calculator', href: '/tip-calculator', icon: '💰', desc: 'Calculate & split tips easily' },
  { name: 'BMI Calculator', href: '/bmi-calculator', icon: '⚖️', desc: 'Check your body mass index' },
  { name: 'Calorie Calculator', href: '/calorie-calculator', icon: '🔥', desc: 'Find daily calorie needs' },
];
---

<CalculatorLayout
  title="Mortgage Calculator with Extra Payments — Payoff & Commercial Suite"
  description="Free online mortgage calculator with taxes, insurance, and extra principal payments. Supports commercial loans, reverse mortgage estimates, Texas property tax rules, and home affordability."
  canonical="/mortgage-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Mortgage Calculator', url: '/mortgage-calculator' }]}
  relatedCalcs={relatedCalcs}
>

  <!-- Header -->
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Financial Calculators</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Mortgage Calculator Suite</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Plan your home purchase, calculate monthly payments with taxes and insurance, estimate extra principal payoffs, or calculate commercial and reverse mortgages.
    </p>
  </div>

  <!-- Tab Selectors -->
  <div class="tabs-container fade-up stagger-1">
    <button class="tab-btn active" data-tab="tab-standard">Standard & Extra Payments</button>
    <button class="tab-btn" data-tab="tab-commercial">Commercial Mortgage</button>
    <button class="tab-btn" data-tab="tab-reverse">Reverse Mortgage</button>
    <button class="tab-btn" data-tab="tab-affordability">How Much House Can I Afford?</button>
  </div>

  <!-- Calculator Panels -->
  <div class="calc-panel fade-up stagger-2" style="position: relative;">

    <!-- TAB 1: STANDARD & EXTRA PAYMENTS -->
    <div id="tab-standard" class="tab-content active">
      <div class="calc-grid-layout">
        
        <!-- Inputs -->
        <div class="calc-inputs">
          <h2 class="section-title">Loan Details</h2>
          
          <div class="input-row">
            <div class="input-group">
              <label for="std-home-price" class="label">Home Price ($)</label>
              <input type="number" id="std-home-price" class="input-base" placeholder="e.g. 400000" min="0" step="1000" />
            </div>
            <div class="input-group">
              <label for="std-state" class="label">Property Location</label>
              <select id="std-state" class="select-base">
                <option value="all">Default (US Average)</option>
                <option value="tx">Texas (Property Tax ~1.8%)</option>
              </select>
            </div>
          </div>

          <div class="input-row">
            <div class="input-group">
              <label for="std-down-percent" class="label">Down Payment (%)</label>
              <input type="number" id="std-down-percent" class="input-base" placeholder="e.g. 20" min="0" max="100" step="0.1" />
            </div>
            <div class="input-group">
              <label for="std-down-cash" class="label">Down Payment ($)</label>
              <input type="number" id="std-down-cash" class="input-base" placeholder="e.g. 80000" min="0" step="500" />
            </div>
          </div>

          <div class="input-row">
            <div class="input-group">
              <label for="std-term" class="label">Loan Term</label>
              <select id="std-term" class="select-base">
                <option value="30">30 Years</option>
                <option value="20">20 Years</option>
                <option value="15">15 Years</option>
                <option value="10">10 Years</option>
              </select>
            </div>
            <div class="input-group">
              <label for="std-rate" class="label">Interest Rate (%)</label>
              <input type="number" id="std-rate" class="input-base" placeholder="e.g. 6.5" min="0.1" max="25" step="0.01" />
            </div>
          </div>

          <div class="input-row">
            <div class="input-group">
              <label for="std-start-month" class="label">Start Month</label>
              <select id="std-start-month" class="select-base">
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
            </div>
            <div class="input-group">
              <label for="std-start-year" class="label">Start Year</label>
              <input type="number" id="std-start-year" class="input-base" placeholder="e.g. 2026" min="2000" max="2100" />
            </div>
          </div>

          <!-- Escrow Toggles -->
          <div class="accordion-section">
            <button class="accordion-toggle" type="button" aria-expanded="false" id="toggle-escrow-btn" aria-controls="escrow-fields">
              <span>🏠 Escrow: Taxes, Insurance &amp; Exemption</span>
              <span class="accordion-arrow">▼</span>
            </button>
            <div id="escrow-fields" class="accordion-content" hidden>
              <div class="input-row" style="margin-top: 12px;">
                <div class="input-group">
                  <label for="std-tax-rate" class="label">Property Tax Rate (%/yr)</label>
                  <input type="number" id="std-tax-rate" class="input-base" placeholder="e.g. 1.2" min="0" max="10" step="0.05" />
                </div>
                <div class="input-group">
                  <label for="std-insurance" class="label">Home Insurance ($/yr)</label>
                  <input type="number" id="std-insurance" class="input-base" placeholder="e.g. 1200" min="0" step="100" />
                </div>
              </div>
              <div class="input-row">
                <div class="input-group">
                  <label for="std-pmi" class="label">PMI Rate (%/yr) <small style="color:var(--color-muted)">(if DP &lt; 20%)</small></label>
                  <input type="number" id="std-pmi" class="input-base" placeholder="e.g. 0.5" min="0" max="5" step="0.05" />
                </div>
                <div class="input-group">
                  <label for="std-hoa" class="label">HOA Fees ($/month)</label>
                  <input type="number" id="std-hoa" class="input-base" placeholder="e.g. 0" min="0" step="10" />
                </div>
              </div>
              <div class="input-row">
                <div class="input-group">
                  <label for="std-homestead" class="label">Homestead Exemption ($) <small style="color:var(--color-muted)">(tax reduction)</small></label>
                  <input type="number" id="std-homestead" class="input-base" placeholder="e.g. 100000" min="0" step="1000" />
                </div>
              </div>
            </div>
          </div>

          <!-- Extra Payments Toggle -->
          <div class="accordion-section" style="margin-top: 16px;">
            <button class="accordion-toggle" type="button" aria-expanded="false" id="toggle-extra-btn" aria-controls="extra-fields">
              <span>📈 Extra Principal Payments</span>
              <span class="accordion-arrow">▼</span>
            </button>
            <div id="extra-fields" class="accordion-content" hidden>
              <div class="input-row" style="margin-top: 12px;">
                <div class="input-group">
                  <label for="extra-monthly" class="label">Add to Monthly Payment ($)</label>
                  <input type="number" id="extra-monthly" class="input-base" placeholder="e.g. 0" min="0" step="50" />
                </div>
                <div class="input-group">
                  <label for="extra-yearly" class="label">Add Every Year ($)</label>
                  <input type="number" id="extra-yearly" class="input-base" placeholder="e.g. 0" min="0" step="100" />
                </div>
              </div>
              <div class="input-row">
                <div class="input-group">
                  <label for="extra-yearly-month" class="label">Yearly Payment Month</label>
                  <select id="extra-yearly-month" class="select-base">
                    <option value="0">January</option>
                    <option value="1">February</option>
                    <option value="2">March</option>
                    <option value="3">April</option>
                    <option value="4">May</option>
                    <option value="5">June</option>
                    <option value="6">July</option>
                    <option value="7">August</option>
                    <option value="8">September</option>
                    <option value="9">October</option>
                    <option value="10">November</option>
                    <option value="11">December</option>
                  </select>
                </div>
                <div class="input-group">
                  <label for="extra-onetime" class="label">One-Time Payment ($)</label>
                  <input type="number" id="extra-onetime" class="input-base" placeholder="e.g. 0" min="0" step="500" />
                </div>
              </div>
              <div class="input-row">
                <div class="input-group">
                  <label for="extra-onetime-month" class="label">One-Time Month</label>
                  <select id="extra-onetime-month" class="select-base">
                    <option value="0">January</option>
                    <option value="1">February</option>
                    <option value="2">March</option>
                    <option value="3">April</option>
                    <option value="4">May</option>
                    <option value="5">June</option>
                    <option value="6">July</option>
                    <option value="7">August</option>
                    <option value="8">September</option>
                    <option value="9">October</option>
                    <option value="10">November</option>
                    <option value="11">December</option>
                  </select>
                </div>
                <div class="input-group">
                  <label for="extra-onetime-year" class="label">One-Time Year</label>
                  <input type="number" id="extra-onetime-year" class="input-base" placeholder="e.g. 2027" min="2000" max="2100" />
                </div>
              </div>
            </div>
          </div>

          <!-- Comparison Tool Accordion -->
          <div class="accordion-section" style="margin-top: 16px;">
            <button class="accordion-toggle" type="button" aria-expanded="false" id="toggle-compare-btn" aria-controls="compare-fields">
              <span>⚖️ Compare Scenarios Side-by-Side</span>
              <span class="accordion-arrow">▼</span>
            </button>
            <div id="compare-fields" class="accordion-content" hidden>
              <div style="padding-top: 12px;">
                <p class="text-caption" style="color:var(--color-body); margin-bottom:12px; line-height: 1.4;">
                  Compare your current mortgage against an alternative scenario (e.g. different term or interest rate) to see your potential savings.
                </p>
                <div class="input-row">
                  <div class="input-group">
                    <label for="comp-term" class="label">Alternative Term</label>
                    <select id="comp-term" class="select-base">
                      <option value="30">30 Years</option>
                      <option value="20">20 Years</option>
                      <option value="15" selected>15 Years</option>
                      <option value="10">10 Years</option>
                    </select>
                  </div>
                  <div class="input-group">
                    <label for="comp-rate" class="label">Alternative Interest Rate (%)</label>
                    <input type="number" id="comp-rate" class="input-base" placeholder="e.g. 5.5" min="0.1" max="25" step="0.01" />
                  </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px;">
                  <div style="padding:12px; background:var(--color-canvas-soft-2); border-radius:var(--radius-md); border:1px solid var(--color-hairline);">
                    <div style="font-size:11px; font-weight:700; color:var(--color-ink); margin-bottom:6px;">Scenario A (Current)</div>
                    <div style="font-size:12px; color:var(--color-body); display:flex; flex-direction:column; gap:4px;">
                      <div>P&amp;I: <strong id="comp-a-pi">$0.00</strong></div>
                      <div>Interest: <strong id="comp-a-interest">$0.00</strong></div>
                    </div>
                  </div>
                  <div style="padding:12px; background:var(--color-canvas-soft-2); border-radius:var(--radius-md); border:1px solid var(--color-hairline);">
                    <div style="font-size:11px; font-weight:700; color:var(--color-link); margin-bottom:6px;">Scenario B (Alternative)</div>
                    <div style="font-size:12px; color:var(--color-body); display:flex; flex-direction:column; gap:4px;">
                      <div>P&amp;I: <strong id="comp-b-pi">$0.00</strong></div>
                      <div>Interest: <strong id="comp-b-interest">$0.00</strong></div>
                    </div>
                  </div>
                </div>

                <div id="comp-savings-box" class="savings-alert-box" style="margin-top:12px; padding:10px 12px; display:none;">
                  <span style="font-size:11.5px; color:var(--color-success); line-height:1.45;" id="comp-savings-text"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Texas Homestead Exemption Note -->
          <div id="texas-info-card" class="state-info-box" style="display: none; margin-top: 16px;">
            <h4 style="font-weight:600; color:var(--color-link); font-size:13px; margin-bottom:4px;">Texas Mortgage & Property Tax Info</h4>
            <p style="font-size:12px; color:var(--color-body); line-height:1.5; margin:0;">
              Texas does not levy state income taxes, so property taxes are higher. Property taxes typically range from 1.6% to 2.2%. Texas homeowners should apply for the <strong>General Residence Homestead Exemption</strong>, which exempts $100,000 of assessed value from school district taxes.
            </p>
          </div>

        </div>

        <!-- Results Side Panel -->
        <div class="calc-results">
          <div class="result-panel-sticky">
            <h2 class="section-title" style="margin-bottom: 16px;">Monthly Payment</h2>
            
            <div class="main-payment-badge">
              <span class="payment-amount" id="std-monthly-payment">$0.00</span>
              <span class="payment-lbl">Total Out-of-Pocket</span>
            </div>

            <div class="payment-breakdown-box">
              <div class="breakdown-row">
                <span class="breakdown-dot" style="background:#0070f3;"></span>
                <span class="breakdown-label">Principal &amp; Interest</span>
                <span class="breakdown-val" id="std-breakdown-pi">$0.00</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-dot" style="background:#10b981;"></span>
                <span class="breakdown-label">Property Taxes</span>
                <span class="breakdown-val" id="std-breakdown-taxes">$0.00</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-dot" style="background:#f5a623;"></span>
                <span class="breakdown-label">Home Insurance</span>
                <span class="breakdown-val" id="std-breakdown-ins">$0.00</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-dot" style="background:#ee0000;"></span>
                <span class="breakdown-label">PMI Insurance</span>
                <span class="breakdown-val" id="std-breakdown-pmi">$0.00</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-dot" style="background:#7928ca;"></span>
                <span class="breakdown-label">HOA Fees</span>
                <span class="breakdown-val" id="std-breakdown-hoa">$0.00</span>
              </div>
            </div>

            <!-- Native Canvas Pie Chart -->
            <div class="chart-container" style="position:relative; margin-top:20px; width:100%; height:160px; display:flex; justify-content:center;">
              <canvas id="payment-pie-chart" width="160" height="160" aria-label="Monthly Payment Breakdown Chart" role="img"></canvas>
            </div>

            <!-- Savings Banner -->
            <div id="extra-savings-banner" class="savings-alert-box" style="display:none; margin-top:20px;">
              <div style="font-weight:700; font-size:13px; color:var(--color-success); margin-bottom:4px;">✨ Extra Payment Savings!</div>
              <div style="font-size:12px; color:var(--color-body); line-height:1.4;">
                Paying extra principal pays off your mortgage <strong id="savings-years">—</strong> earlier, saving you <strong id="savings-interest">—</strong> in interest!
              </div>
            </div>

            <div class="summary-details-list" style="margin-top: 24px; border-top: 1px solid var(--color-hairline); padding-top: 16px;">
              <div class="summary-row">
                <span>Loan Amount</span>
                <strong id="std-summary-loan">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Down Payment</span>
                <strong id="std-summary-down">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Total Interest Paid</span>
                <strong id="std-summary-interest">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Total Payments</span>
                <strong id="std-summary-total">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Payoff Date</span>
                <strong id="std-summary-payoff" style="color: var(--color-link);">—</strong>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Amortization Schedule & Graph -->
      <div class="amortization-wrapper" style="margin-top: 48px; border-top: 1px solid var(--color-hairline); padding-top: 32px;">
        <h3 class="section-title" style="margin-bottom: 24px;">Amortization Schedule &amp; Trajectory</h3>
        
        <!-- Canvas Balance Chart -->
        <div style="margin-bottom: 32px; background:var(--color-canvas-soft-2); border-radius:var(--radius-lg); border:1px solid var(--color-hairline); padding:20px;">
          <h4 style="font-size:14px; font-weight:600; color:var(--color-ink); margin-bottom:12px;">Remaining Balance Trajectory ($)</h4>
          <div style="width:100%; height:240px;">
            <canvas id="balance-line-chart" style="width:100%; height:240px;" aria-label="Loan Balance Reduction Chart" role="img"></canvas>
          </div>
        </div>

        <!-- Schedule Options & Table -->
        <div class="table-controls" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap: wrap; gap: 12px;">
          <div class="toggle-group">
            <button class="toggle-option active" id="btn-schedule-annual">Annual Schedule</button>
            <button class="toggle-option" id="btn-schedule-monthly">Monthly Schedule</button>
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <button id="btn-export-csv" class="tool-btn-action" style="font-size:12px; height:28px; padding:0 10px; border-radius:6px; cursor:pointer;">📥 Export CSV</button>
            <span style="font-size:12px; color:var(--color-muted); font-family:var(--font-mono);" id="schedule-meta-info">360 Payments</span>
          </div>
        </div>

        <div class="table-scroll-container">
          <table class="schedule-table">
            <thead>
              <tr>
                <th>Period</th>
                <th>Date</th>
                <th>Interest</th>
                <th>Principal</th>
                <th class="extra-col" style="display:none;">Extra Pay</th>
                <th>Ending Balance</th>
              </tr>
            </thead>
            <tbody id="amortization-table-body">
              <!-- JS Injected Rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: COMMERCIAL MORTGAGE -->
    <div id="tab-commercial" class="tab-content">
      <div class="calc-grid-layout">
        
        <!-- Inputs -->
        <div class="calc-inputs">
          <h2 class="section-title">Commercial Loan Inputs</h2>
          <p class="text-body-sm" style="color:var(--color-body); margin-bottom:20px;">
            Commercial mortgages frequently feature amortization timelines (e.g., 25 years) that exceed the actual duration of the loan (e.g., 5 or 10 years). The remaining balance is paid as a lump sum "balloon" payment.
          </p>

          <div class="input-group">
            <label for="comm-amount" class="label">Loan Amount ($)</label>
            <input type="number" id="comm-amount" class="input-base" placeholder="e.g. 1000000" min="0" step="10000" />
          </div>

          <div class="input-row">
            <div class="input-group">
              <label for="comm-rate" class="label">Interest Rate (%)</label>
              <input type="number" id="comm-rate" class="input-base" placeholder="e.g. 7.5" min="0.1" max="25" step="0.05" />
            </div>
            <div class="input-group">
              <label for="comm-amort" class="label">Amortization Period (Years)</label>
              <select id="comm-amort" class="select-base">
                <option value="30">30 Years</option>
                <option value="25" selected>25 Years</option>
                <option value="20">20 Years</option>
                <option value="15">15 Years</option>
              </select>
            </div>
          </div>

          <div class="input-group">
            <label for="comm-term" class="label">Loan Term / Balloon Due (Years)</label>
            <select id="comm-term" class="select-base">
              <option value="15">15 Years</option>
              <option value="10">10 Years</option>
              <option value="5" selected>5 Years</option>
            </select>
          </div>
        </div>

        <!-- Commercial Results -->
        <div class="calc-results">
          <div class="result-panel">
            <h3 class="section-title" style="margin-bottom:16px;">Commercial Payments</h3>
            
            <div class="stat-card" style="margin-bottom:16px; padding:16px;">
              <span class="stat-value" id="comm-monthly-val" style="font-size:28px;">$0.00</span>
              <span class="stat-label">Monthly P&amp;I Payment</span>
            </div>

            <div class="stat-card" style="margin-bottom:16px; padding:16px; border-color:var(--color-error-soft);">
              <span class="stat-value" id="comm-balloon-val" style="font-size:28px; color:var(--color-error);">$0.00</span>
              <span class="stat-label">Balloon Payment (Due Year <span id="comm-balloon-year">5</span>)</span>
            </div>

            <div class="summary-details-list" style="margin-top: 16px;">
              <div class="summary-row">
                <span>Total Principal Paid</span>
                <strong id="comm-total-principal">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Total Interest Paid</span>
                <strong id="comm-total-interest">$0.00</strong>
              </div>
              <div class="summary-row">
                <span>Total Out-of-Pocket</span>
                <strong id="comm-total-payments">$0.00</strong>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- TAB 3: REVERSE MORTGAGE -->
    <div id="tab-reverse" class="tab-content">
      <div class="calc-grid-layout">
        
        <!-- Inputs -->
        <div class="calc-inputs">
