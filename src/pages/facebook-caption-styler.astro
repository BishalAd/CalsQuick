</style>

<div id="fc-toast" class="fc-toast">✓ Copied!</div>

<script>
  // ─── Unicode Style Map ──────────────────────────────────────────────────────
  const styleMap: Record<string, (txt: string) => string> = {
    bold: (txt) => [...txt].map(ch => {
      if (/[A-Z]/.test(ch)) return String.fromCodePoint(0x1D400 + ch.charCodeAt(0) - 65);
      if (/[a-z]/.test(ch)) return String.fromCodePoint(0x1D41A + ch.charCodeAt(0) - 97);
      if (/[0-9]/.test(ch)) return String.fromCodePoint(0x1D7CE + ch.charCodeAt(0) - 48);
      return ch;
    }).join(''),
    italic: (txt) => [...txt].map(ch => {
      if (/[A-Z]/.test(ch)) return String.fromCodePoint(0x1D434 + ch.charCodeAt(0) - 65);
      if (/[a-z]/.test(ch)) return String.fromCodePoint(0x1D44E + ch.charCodeAt(0) - 97);
      return ch;
    }).join(''),
    boldItalic: (txt) => [...txt].map(ch => {
      if (/[A-Z]/.test(ch)) return String.fromCodePoint(0x1D468 + ch.charCodeAt(0) - 65);
      if (/[a-z]/.test(ch)) return String.fromCodePoint(0x1D482 + ch.charCodeAt(0) - 97);
      return ch;
    }).join(''),
    cursive: (txt) => [...txt].map(ch => {
      const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const lower = 'abcdefghijklmnopqrstuvwxyz';
      const cU = [...'𝒜ℬ𝒞𝒟ℰℱ𝒢ℋℐ𝒥𝒦ℒℳ𝒩𝒪𝒫𝒬ℛ𝒮𝒯𝒰𝒱𝒲𝒳𝒴𝒵'];
      const cL = [...'𝒶𝒷𝒸𝒹ℯ𝒻ℊ𝒽𝒾𝒿𝓀𝓁𝓂𝓃ℴ𝓅𝓆𝓇𝓈𝓉𝓊𝓋𝓌𝓍𝓎𝓏'];
      const i = upper.indexOf(ch);
      if (i !== -1) return cU[i];
      const il = lower.indexOf(ch);
      if (il !== -1) return cL[il];
      return ch;
    }).join(''),
    gothic: (txt) => [...txt].map(ch => {
      const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const lower = 'abcdefghijklmnopqrstuvwxyz';
      const gU = [...'𝔄𝔅ℭ𝔇𝔈𝔉𝔊ℌℑ𝔍𝔎𝔏𝔐𝔑𝔒𝔓𝔔ℜ𝔖𝔗𝔘𝔙𝔚𝔛𝔜ℨ'];
      const gL = [...'𝔞𝔟𝔠𝔡𝔢𝔣𝔤𝔥𝔦𝔧𝔨𝔩𝔪𝔫𝔬𝔭𝔮𝔯𝔰𝔱𝔲𝔳𝔴𝔵𝔶𝔷'];
      const i = upper.indexOf(ch);
      if (i !== -1) return gU[i];
      const il = lower.indexOf(ch);
      if (il !== -1) return gL[il];
      return ch;
    }).join(''),
    doubleStruck: (txt) => [...txt].map(ch => {
      if (/[A-Z]/.test(ch)) return String.fromCodePoint(0x1D538 + ch.charCodeAt(0) - 65);
      if (/[a-z]/.test(ch)) return String.fromCodePoint(0x1D552 + ch.charCodeAt(0) - 97);
      if (/[0-9]/.test(ch)) return String.fromCodePoint(0x1D7D8 + ch.charCodeAt(0) - 48);
      return ch;
    }).join(''),
    mono: (txt) => [...txt].map(ch => {
      if (/[A-Z]/.test(ch)) return String.fromCodePoint(0x1D670 + ch.charCodeAt(0) - 65);
      if (/[a-z]/.test(ch)) return String.fromCodePoint(0x1D68A + ch.charCodeAt(0) - 97);
      if (/[0-9]/.test(ch)) return String.fromCodePoint(0x1D7F6 + ch.charCodeAt(0) - 48);
      return ch;
    }).join(''),
    bubble: (txt) => [...txt].map(ch => {
      const map: Record<string, string> = {};
      [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].forEach((l, i) => map[l] = String.fromCodePoint(0x24B6 + i));
      [...'abcdefghijklmnopqrstuvwxyz'].forEach((l, i) => map[l] = String.fromCodePoint(0x24D0 + i));
      [...'0123456789'].forEach((d, i) => map[d] = String.fromCodePoint(0x2460 + i));
      return map[ch] || ch;
    }).join(''),
    wide: (txt) => [...txt].map(ch => /[A-Za-z0-9]/.test(ch) ? String.fromCodePoint(ch.charCodeAt(0) + 0xFEE0) : ch).join(''),
    spark: (txt) => `✨ ${txt} ✨`,
    deco: (txt) => `꧁ ${txt} ꧂`,
    underline: (txt) => [...txt].map(ch => ch === ' ' ? ' ' : ch + '\u0332').join(''),
    strike: (txt) => [...txt].map(ch => ch === ' ' ? ' ' : ch + '\u0336').join(''),
  };

  const styleLabels: Record<string, string> = {
    bold: '𝗕𝗼𝗹𝗱',
    italic: '𝘐𝘵𝘢𝘭𝘪𝘤',
    boldItalic: '𝘽𝙤𝙡𝙙 𝙄𝙩',
    cursive: '𝒞𝓊𝓇𝓈𝒾𝓋𝑒',
    gothic: '𝔊𝔬𝔱𝔥𝔦𝔠',
    doubleStruck: '𝔻𝕠𝕦𝕓𝕝𝕖',
    mono: '𝙼𝚘𝚗𝚘',
    bubble: 'Ⓒⓘⓡⓒⓛⓔ',
    wide: 'Ｗｉｄｅ',
    spark: '✨ Sparkle',
    deco: '꧁ Decor ꧂',
    underline: 'U̲n̲d̲e̲r̲',
    strike: 'S̶t̶r̶i̶k̶e̶'
  };

  function applyStyle(text: string, styleKey: string): string {
    if (!text.trim()) return text;
    const fn = styleMap[styleKey];
    return fn ? fn(text) : text;
  }

  // ─── Toast Helper ───────────────────────────────────────────────────────────
  function showToast(msg: string) {
    const toast = document.getElementById('fc-toast')!;
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2000);
  }

  // ─── Tab Switcher (Single vs Multi-Line) ─────────────────────────────────────
  let activeTab = 'single';
  const singlePanel = document.getElementById('single-panel')!;
  const multiPanel = document.getElementById('multi-panel')!;

  document.querySelectorAll('.fc-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.fc-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeTab = (tab as HTMLElement).dataset.tab!;
      if (activeTab === 'single') {
        singlePanel.style.display = '';
        multiPanel.style.display = 'none';
        updateStylerPreview();
      } else {
        singlePanel.style.display = 'none';
        multiPanel.style.display = '';
        updateMultiLinePreview();
      }
    });
  });

  // ─── Helper Panel Tabs (Emojis vs Hashtags) ─────────────────────────────────
  document.querySelectorAll('.helper-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.helper-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.helper-panel').forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      const targetId = `helper-${(tab as HTMLElement).dataset.helper}`;
      document.getElementById(targetId)!.classList.add('active');
    });
  });

  // Cursor Insert Helper
  const stylerInput = document.getElementById('styler-input') as HTMLTextAreaElement;

  function insertAtCursor(textarea: HTMLTextAreaElement, text: string) {
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const currentVal = textarea.value;
    textarea.value = currentVal.substring(0, start) + text + currentVal.substring(end);
    textarea.selectionStart = textarea.selectionEnd = start + text.length;
    textarea.focus();
    textarea.dispatchEvent(new Event('input'));
  }

  // Bind Emojis click
  document.querySelectorAll('.emoji-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-insert')!;
      if (activeTab === 'single') {
        insertAtCursor(stylerInput, val);
      } else {
        // For Multi-Line active input
        const activeTextarea = document.querySelector('.multi-line-row.active .line-row-input') as HTMLTextAreaElement;
        if (activeTextarea) {
          insertAtCursor(activeTextarea, val);
        } else {
          showToast('⚠️ Click on a line in Multi-Line editor first');
        }
      }
    });
  });

  // Bind Hashtags click
  document.querySelectorAll('.hashtag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-insert')! + ' ';
      if (activeTab === 'single') {
        insertAtCursor(stylerInput, val);
      } else {
        // For Multi-Line active input
        const activeTextarea = document.querySelector('.multi-line-row.active .line-row-input') as HTMLTextAreaElement;
        if (activeTextarea) {
          insertAtCursor(activeTextarea, val);
        } else {
          showToast('⚠️ Click on a line in Multi-Line editor first');
        }
      }
    });
  });

  // ─── Single Styler Preview and Controls ─────────────────────────────────────
  let currentStyle = 'bold';
  const mockContent = document.getElementById('mock-content-text')!;
  const stylerCharCount = document.getElementById('styler-char-count')!;

  function updateStylerPreview() {
    if (activeTab !== 'single') return;
    const text = stylerInput.value;
    stylerCharCount.textContent = `${text.length} characters`;
    if (!text.trim()) {
      mockContent.textContent = 'Your styled caption preview will render here...';
    } else {
      mockContent.textContent = applyStyle(text, currentStyle);
    }
  }

  stylerInput.addEventListener('input', updateStylerPreview);

  document.getElementById('clear-styler-btn')!.addEventListener('click', () => {
    stylerInput.value = '';
    updateStylerPreview();
    showToast('🗑️ Input cleared');
  });

  // Style chips selection
  document.querySelectorAll('#style-grid .style-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('#style-grid .style-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentStyle = chip.getAttribute('data-style')!;
      updateStylerPreview();
    });
  });

  // ─── Notion-Style Multi-Line Styler ─────────────────────────────────────────
  interface Line { text: string; style: string; }
  let multiLines: Line[] = [
    { text: 'The sun set behind the mountains, painting the sky in orange.', style: 'bold' },
    { text: 'A gentle breeze carried the scent of pine through the valley.', style: 'cursive' },
    { text: 'In that moment, everything felt perfectly still.', style: 'spark' }
  ];
  let activeLineIndex = 0;
  let multiStyle = 'bold';

  const multiLinesContainer = document.getElementById('multi-lines-list')!;

  function renderMultiLines() {
    multiLinesContainer.innerHTML = '';
    multiLines.forEach((line, idx) => {
      const row = document.createElement('div');
      row.className = `multi-line-row${idx === activeLineIndex ? ' active' : ''}`;
      
      // Inline styles dropdown list
      const selectHtml = `
        <div class="line-row-select-wrapper">
          <select class="line-row-select" data-line="${idx}">
            ${Object.keys(styleLabels).map(key => 
              `<option value="${key}" ${line.style === key ? 'selected' : ''}>${styleLabels[key]}</option>`
            ).join('')}
          </select>
        </div>
      `;

      row.innerHTML = `
        <span class="line-row-num">${String(idx + 1).padStart(2, '0')}</span>
        <textarea class="line-row-input" placeholder="Type line ${idx + 1}...">${line.text}</textarea>
        ${selectHtml}
        <button class="line-row-delete" title="Delete Line">✕</button>
      `;

      const textarea = row.querySelector('.line-row-input') as HTMLTextAreaElement;
      const select = row.querySelector('.line-row-select') as HTMLSelectElement;
      const deleteBtn = row.querySelector('.line-row-delete') as HTMLButtonElement;

      // Auto-resize height
      setTimeout(() => {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
      }, 0);

      textarea.addEventListener('input', () => {
        multiLines[idx].text = textarea.value;
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
        updateMultiLinePreview();
      });

      textarea.addEventListener('focus', () => {
        activeLineIndex = idx;
        multiStyle = multiLines[idx].style;
        document.querySelectorAll('.multi-line-row').forEach((r, rIdx) => {
          r.classList.toggle('active', rIdx === idx);
        });
        updateMultiStyleGridHighlight();
      });

      textarea.addEventListener('keydown', (e) => {
        // Enter adds line below
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          multiLines.splice(idx + 1, 0, { text: '', style: 'bold' });
          activeLineIndex = idx + 1;
          renderMultiLines();
          
          const textareas = document.querySelectorAll('.line-row-input');
          (textareas[activeLineIndex] as HTMLTextAreaElement)?.focus();
        }

        // Backspace empty line deletes it
        if (e.key === 'Backspace' && textarea.value === '' && multiLines.length > 1) {
          e.preventDefault();
          multiLines.splice(idx, 1);
          activeLineIndex = Math.max(0, idx - 1);
          renderMultiLines();

          const textareas = document.querySelectorAll('.line-row-input');
          (textareas[activeLineIndex] as HTMLTextAreaElement)?.focus();
        }
      });

      select.addEventListener('change', () => {
        multiLines[idx].style = select.value;
        updateMultiLinePreview();
        if (idx === activeLineIndex) {
          multiStyle = select.value;
          updateMultiStyleGridHighlight();
        }
      });

      deleteBtn.addEventListener('click', () => {
        if (multiLines.length > 1) {
          multiLines.splice(idx, 1);
          activeLineIndex = Math.max(0, idx - 1);
          renderMultiLines();
          updateMultiLinePreview();
        } else {
          multiLines[0].text = '';
          renderMultiLines();
          updateMultiLinePreview();
        }
      });

      multiLinesContainer.appendChild(row);
    });
  }

  function updateMultiLinePreview() {
    if (activeTab !== 'multi') return;
    if (multiLines.length === 0) {
      mockContent.textContent = 'Your multi-line styled caption preview will render here...';
    } else {
      mockContent.textContent = multiLines.map(l => applyStyle(l.text, l.style)).join('\n');
    }
  }

  // Add Line button
  document.getElementById('add-line-btn')!.addEventListener('click', () => {
    multiLines.push({ text: '', style: 'bold' });
    activeLineIndex = multiLines.length - 1;
    renderMultiLines();
    const textareas = document.querySelectorAll('.line-row-input');
    (textareas[activeLineIndex] as HTMLTextAreaElement)?.focus();
  });

  // Clear Multi Lines
  document.getElementById('clear-multi-btn')!.addEventListener('click', () => {
    multiLines = [{ text: '', style: 'bold' }];
    activeLineIndex = 0;
    renderMultiLines();
    updateMultiLinePreview();
    showToast('🗑️ Cleared');
  });

  // Reset Styles to Bold
  document.getElementById('reset-multi-btn')!.addEventListener('click', () => {
    multiLines.forEach(l => l.style = 'bold');
    multiStyle = 'bold';
    renderMultiLines();
    updateMultiLinePreview();
    showToast('🔄 All lines reset to Bold');
  });

  // ─── Import Logic ──────────────────────────────────────────────────────────
  const importBtn = document.getElementById('import-paragraph-btn')!;
  const importContainer = document.getElementById('import-container')!;
  const importTextArea = document.getElementById('import-textarea') as HTMLTextAreaElement;
  const doImportBtn = document.getElementById('do-import-btn')!;

  importBtn.addEventListener('click', () => {
    importContainer.style.display = importContainer.style.display === 'none' ? 'block' : 'none';
  });

  doImportBtn.addEventListener('click', () => {
    const text = importTextArea.value;
    if (!text.trim()) {
      showToast('⚠️ Paste some text first');
      return;
    }
    const raw = text.split(/\r?\n/).filter(l => l.trim().length > 0);
    if (raw.length > 0) {
      multiLines = raw.map(l => ({ text: l.trim(), style: 'bold' }));
      activeLineIndex = 0;
      renderMultiLines();
      updateMultiLinePreview();
      importContainer.style.display = 'none';
      importTextArea.value = '';
      showToast(`✅ Imported ${raw.length} lines`);
    }
  });

  // ─── Mockup Customizable Options ───────────────────────────────────────────
  const verifiedCheckbox = document.getElementById('toggle-verified') as HTMLInputElement;
  const verifiedBadge = document.getElementById('mock-verified-badge')!;
  const nameInput = document.getElementById('profile-name-input') as HTMLInputElement;
  const profileNameSpan = document.getElementById('mock-profile-name')!;

  verifiedCheckbox.addEventListener('change', (e) => {
    verifiedBadge.style.display = (e.target as HTMLInputElement).checked ? 'inline-flex' : 'none';
  });

  nameInput.addEventListener('input', () => {
    const val = nameInput.value.trim();
    profileNameSpan.textContent = val || 'CalcQuick';
  });

  // ─── Copy Actions ──────────────────────────────────────────────────────────
  document.getElementById('copy-styled-btn')!.addEventListener('click', () => {
    let resultText = '';
    if (activeTab === 'single') {
      resultText = stylerInput.value.trim() ? applyStyle(stylerInput.value, currentStyle) : '';
    } else {
      resultText = multiLines.map(l => applyStyle(l.text, l.style)).join('\n');
    }

    if (!resultText) {
      showToast('⚠️ No text to copy');
      return;
    }
    navigator.clipboard.writeText(resultText).then(() => showToast('✓ Styled text copied!'));
  });

  document.getElementById('copy-plain-btn')!.addEventListener('click', () => {
    let plain = '';
    if (activeTab === 'single') {
      plain = stylerInput.value.trim();
    } else {
      plain = multiLines.map(l => l.text).join('\n');
    }

    if (!plain) {
      showToast('⚠️ No text to copy');
      return;
    }
    navigator.clipboard.writeText(plain).then(() => showToast('✓ Plain text copied!'));
  });

  // ─── Init ──────────────────────────────────────────────────────────────────
  document.querySelector('#style-grid .style-chip[data-style="bold"]')?.classList.add('active');

  renderMultiLines();
  updateStylerPreview();

  // ─── Accordion Logic ────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>