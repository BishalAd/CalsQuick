---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';
const faqs = [
  { 
    q: 'What is a Facebook caption styler?', 
    a: 'A Facebook caption styler is a free online tool that transforms your plain text into eye-catching styled text using Unicode characters. It converts regular text into bold, italic, cursive, gothic, bubble, monospace, and many other styles that work perfectly on Facebook, Instagram, Twitter, TikTok, and most social media platforms. Unlike standard formatting, Unicode-styled text maintains its formatting when pasted anywhere — no special app needed.' 
  },
  { 
    q: 'How does Unicode text styling work?', 
    a: 'Unicode text styling uses special mathematical and decorative Unicode characters that look like stylized versions of regular letters. For example, the letter "A" becomes "𝗔" (bold), "𝘈" (italic), or "𝔄" (gothic). These characters are part of the Unicode standard and display correctly on virtually all modern devices, apps, and websites. Our styler automatically converts your text to these Unicode equivalents, making your captions stand out.' 
  },
  { 
    q: 'Will styled text work on Facebook posts and comments?', 
    a: 'Yes! Unicode-styled text works perfectly on Facebook posts, comments, Messenger, and Facebook Stories. It also works on Instagram captions, bios, comments, Twitter/X posts, LinkedIn, TikTok captions, WhatsApp messages, and virtually any platform that supports Unicode text. The styling remains intact when you copy and paste — no formatting loss, no special characters breaking.' 
  },
  { 
    q: 'What text styles are available?', 
    a: 'Our Facebook caption styler offers 13+ unique text styles: Bold (𝗕𝗼𝗹𝗱), Italic (𝘐𝘵𝘢𝘭𝘪𝘤), Bold Italic (𝘽𝙤𝙡𝙙 𝙄𝙩), Cursive (𝒞𝓊𝓇𝓈𝒾𝓋𝑒), Gothic (𝔊𝔬𝔱𝔥𝔦𝔠), Double Struck (𝔻𝕠𝕦𝕓𝕝𝕖), Monospace (𝙼𝚘𝚗𝚘), Circled/Bubble (Ⓒⓘⓡⓒⓛⓔ), Wide (Ｗｉｄｅ), Sparkle (✨ text ✨), Decorative (꧁text꧂), Underline (t̲e̲x̲t̲), and Strikethrough (t̶e̶x̶t̶). Each style gives your captions a unique look that grabs attention.' 
  },
  { 
    q: 'Can I use multiple styles in one Facebook caption?', 
    a: 'Yes! Our Multi-Line Styler lets you apply different text styles to each line of your caption. For example, make your first line bold for impact, the second line cursive for elegance, and add a sparkle effect to your call-to-action. This creates visually dynamic Facebook posts that get more engagement and stand out in crowded feeds.' 
  },
  { 
    q: 'Will my text lose its style when I copy it?', 
    a: 'No! Unlike formatted text (which uses HTML or rich text), Unicode-styled characters are actual characters that persist when copied. When you paste styled text from our tool into Facebook, Instagram, or any other platform, the styling remains intact because it\'s not formatting — it\'s the actual characters themselves.' 
  },
  { 
    q: 'Does Unicode styling affect SEO or readability?', 
    a: 'Screen readers may read Unicode-styled text differently, and search engines may not index it the same as regular text. Unicode styling is best for social media posts, visual content, and creative captions where visual impact matters more than search optimization. For accessibility, consider adding a plain-text version for screen readers.' 
  },
  { 
    q: 'How do I make my Facebook captions more engaging?', 
    a: 'Engaging Facebook captions combine several elements: (1) Use styled text to make key phrases stand out, (2) Include emojis naturally (2-4 per post), (3) Ask questions to encourage comments, (4) Keep captions between 40-80 characters for best engagement (Facebook\'s sweet spot), (5) Add a clear call-to-action like "Share this!" or "Tag a friend." Our Multi-Line Styler helps you create visually dynamic captions that get more likes, comments, and shares.' 
  },
  { 
    q: 'Is this Facebook caption styler free to use?', 
    a: 'Yes! Our Facebook caption styler is completely free with no sign-up required. All text processing happens directly in your browser — your text never leaves your device. We don\'t store, track, or collect any of your content. You can use it unlimited times for Facebook posts, Instagram captions, Twitter posts, TikTok captions, YouTube descriptions, and anywhere else you want styled text.' 
  },
];

const schemas = [
  generateSoftwareApplication({
    name: 'Facebook Caption Styler — Free Unicode Text Styler for Social Media',
    description: 'Free Facebook caption styler and Unicode text generator. Create bold, italic, cursive, gothic, bubble text for Facebook, Instagram, Twitter, and TikTok. Multi-line styling with 13+ unique font styles.',
    url: '/facebook-caption-styler',
  }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Word Counter', href: '/word-counter', icon: '📝', desc: 'Count words & characters' },
  { name: 'Online Ruler', href: '/online-ruler', icon: '📏', desc: 'Measure on your screen' },
  { name: 'Age Calculator', href: '/age-calculator', icon: '🎂', desc: 'Calculate your exact age' },
  { name: 'What Is My IP', href: '/what-is-my-ip', icon: '🌐', desc: 'Find your IP address' },
];

const stylesCatalog = [
  { key: 'bold', name: 'Bold', sample: '𝗕𝗼𝗹𝗱' },
  { key: 'italic', name: 'Italic', sample: '𝘐𝘵𝘢𝘭𝘪𝘤' },
  { key: 'boldItalic', name: 'Bold Italic', sample: '𝘽𝙤𝙡𝙙 𝙄𝙩' },
  { key: 'cursive', name: 'Cursive', sample: '𝒞𝓊𝓇𝓈𝒾𝓋𝑒' },
  { key: 'gothic', name: 'Gothic', sample: '𝔊𝔬𝔱𝔥𝔦𝔠' },
  { key: 'doubleStruck', name: 'Double', sample: 'Double' },
  { key: 'mono', name: 'Monospace', sample: 'Monospace' },
  { key: 'bubble', name: 'Circled', sample: 'Ⓒⓘⓡⓒⓛⓔ' },
  { key: 'wide', name: 'Wide', sample: 'Ｗｉｄｅ' },
  { key: 'spark', name: 'Sparkle', sample: '✨ Spark ✨' },
  { key: 'deco', name: 'Decor', sample: '꧁Deco꧂' },
  { key: 'underline', name: 'Underline', sample: 'U̲n̲d̲e̲r̲' },
  { key: 'strike', name: 'Strike', sample: 'S̶t̶r̶i̶k̶e̶' },
];

const socialPlatforms = [
  { platform: 'Facebook', icon: '👤', bestLength: '40-80 chars', worksWith: 'Posts, comments, stories, Messenger' },
  { platform: 'Instagram', icon: '📸', bestLength: '138-150 chars', worksWith: 'Captions, bio, comments, stories' },
  { platform: 'Twitter / X', icon: '🐦', bestLength: '71-100 chars', worksWith: 'Posts, bio, DMs' },
  { platform: 'TikTok', icon: '🎵', bestLength: '100-150 chars', worksWith: 'Captions, comments' },
  { platform: 'LinkedIn', icon: '💼', bestLength: '100-140 chars', worksWith: 'Posts, articles, comments' },
  { platform: 'WhatsApp', icon: '💬', bestLength: 'Any length', worksWith: 'Messages, status' },
  { platform: 'YouTube', icon: '▶️', bestLength: '157 chars visible', worksWith: 'Titles, descriptions, comments' },
  { platform: 'Pinterest', icon: '📌', bestLength: '100-200 chars', worksWith: 'Pin titles, descriptions' },
];

const emojiCategories = [
  { name: '🔥 Popular', emojis: ['✨', '🔥', '🚀', '❤️', '💡', '📌', '✅', '⚠️', '⏰', '💬', '👀', '💯'] },
  { name: '💼 Business', emojis: ['💼', '📈', '💰', '🎯', '🤝', '📢', '📞', '📧', '💡', '🎉', '📅', '📝'] },
  { name: '📸 Lifestyle', emojis: ['📸', '✈️', '🌴', '☕', '🍕', '🎧', '🎉', '🌟', '🌈', '🛍️', '🏃', '🐶'] },
  { name: '👉 CTA', emojis: ['👇', '👉', '🗳️', '🚨', '🔍', '🙌', '🔔', '💥', '📣', '👇', '🎯', '🛒'] }
];

const presetHashtags = [
  { category: 'Growth', tags: ['#motivation', '#success', '#goals', '#growth', '#mindset'] },
  { category: 'Marketing', tags: ['#marketing', '#branding', '#business', '#socialmedia', '#entrepreneur'] },
  { category: 'Lifestyle', tags: ['#love', '#lifestyle', '#travel', '#photography', '#goodvibes'] },
  { category: 'Viral', tags: ['#trending', '#viral', '#instagood', '#foryou', '#explorepage'] }
];
---

<CalculatorLayout
  title="Facebook Caption Styler — Free Unicode Text Generator (13+ Styles)"
  description="Free Facebook caption styler with 13+ unique text styles. Create bold, italic, cursive, gothic, bubble, and more styled text for Facebook, Instagram, TikTok, and Twitter. Multi-line styling included."
  canonical="/facebook-caption-styler"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Facebook Caption Styler', url: '/facebook-caption-styler' }]}
  relatedCalcs={relatedCalcs}
>

  <!-- Header -->
  <div style="margin-bottom: 24px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Social Media Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Facebook Caption Styler</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 700px;">
      Transform plain text into eye-catching styled captions with 13+ unique Unicode text styles. Create bold, italic, cursive, gothic, and bubble text that works on Facebook, Instagram, TikTok, and everywhere else.
    </p>
  </div>

  <!-- TABS -->
  <div class="tabs-wrap fade-up stagger-1" style="margin-bottom: 24px;">
    <button class="fc-tab active" data-tab="single">✧ Single Styler</button>
    <button class="fc-tab" data-tab="multi">📝 Multi-Line Styler</button>
  </div>

  <!-- STYLER WORKSPACE -->
  <div class="fc-editor-grid fade-up stagger-1">
    
    <!-- Left column: Editor Controls -->
    <div class="fc-editor-controls">
      
      <!-- SINGLE STYLER PANEL -->
      <div id="single-panel" class="calc-panel" style="margin-bottom: 16px;">
        <label for="styler-input" class="label" style="margin-bottom:10px;">Enter your text</label>
        <textarea 
          id="styler-input" 
          class="fc-textarea" 
          placeholder="Type or paste your caption here... e.g., Good morning, world!"
          rows="4"
          aria-label="Text input for styling"
        ></textarea>
        <div class="char-counter" id="styler-char-count">0 characters</div>

        <!-- Emoji & Hashtag Helpers -->
        <div class="helper-tabs-container">
          <div class="helper-tabs">
            <button class="helper-tab active" data-helper="emojis">😀 Emojis</button>
            <button class="helper-tab" data-helper="hashtags">🏷️ Hashtags</button>
          </div>
          
          <div class="helper-panel active" id="helper-emojis">
            {emojiCategories.map(cat => (
              <div class="emoji-category-row">
                <span class="category-label">{cat.name}</span>
                <div class="emoji-buttons">
                  {cat.emojis.map(e => (
                    <button class="emoji-btn" data-insert={e}>{e}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="helper-panel" id="helper-hashtags">
            {presetHashtags.map(cat => (
              <div class="hashtag-category-row">
                <span class="category-label">{cat.category}</span>
                <div class="hashtag-buttons">
                  {cat.tags.map(t => (
                    <button class="hashtag-btn" data-insert={t}>{t}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <button id="clear-styler-btn" class="btn-secondary" style="margin-top:12px;width:100%;font-size:12px;padding:8px;">🗑️ Clear Text</button>

        <!-- Style Selection -->
        <div style="margin-top:20px;">
          <label class="label" style="margin-bottom:10px;">Choose a Text Style</label>
          <div class="style-grid" id="style-grid">
            {stylesCatalog.map(s => (
              <button class="style-chip" data-style={s.key} aria-label={`Apply ${s.name} style`}>
                <span class="style-sample">{s.sample}</span>
                <span class="style-name">{s.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- MULTI-LINE STYLER PANEL -->
      <div id="multi-panel" class="calc-panel" style="margin-bottom: 16px; display: none;">
        
        <div class="multi-toolbar">
          <button id="import-paragraph-btn" class="btn-secondary" style="font-size:12px; padding:6px 12px;">📂 Import Paragraph</button>
          <button id="reset-multi-btn" class="btn-secondary" style="font-size:12px; padding:6px 12px;">🔄 Reset Styles to Bold</button>
          <button id="clear-multi-btn" class="btn-secondary" style="font-size:12px; padding:6px 12px;">🗑️ Clear All</button>
        </div>

        <!-- Import drawer container -->
        <div id="import-container" class="import-drawer" style="display: none; margin-bottom: 16px; padding: 12px; border: 1px dashed var(--color-hairline); border-radius: 8px; background: var(--color-canvas-soft-2);">
          <label for="import-textarea" class="label" style="font-size: 12px; margin-bottom: 6px;">Paste paragraph text to import:</label>
          <textarea id="import-textarea" class="fc-textarea" rows="3" placeholder="Paste your text here... each paragraph break will become a new line."></textarea>
          <button id="do-import-btn" class="btn-primary" style="margin-top:8px; font-size:12px; padding:6px 12px; width: 100%;">Split and Import</button>
        </div>

        <div class="multi-instructions" style="font-size: 11.5px; color: var(--color-muted); margin-bottom: 12px; background: var(--color-canvas-soft); padding: 8px 12px; border-radius: 6px;">
          💡 <strong>Tip:</strong> Type directly in the line inputs below. Press <strong>Enter</strong> to quickly add a new line underneath. Press <strong>Backspace</strong> on an empty line to delete it.
        </div>

        <!-- Notion-style interactive lines editor -->
        <div id="multi-lines-list" class="multi-lines-list">
          <!-- Populated by JavaScript -->
        </div>

        <button id="add-line-btn" class="btn-primary" style="width: 100%; margin-top: 12px; font-size:13.5px; font-weight:600; padding: 10px;">➕ Add New Line</button>
      </div>

    </div>

    <!-- Right column: Facebook Feed Preview & Actions -->
    <div class="fc-preview-sidebar">
      
      <!-- Facebook Feed Mockup Card -->
      <div class="facebook-mock-card">
        <div class="mock-header">
          <div class="mock-avatar">⚡</div>
          <div class="mock-user-meta">
            <div class="mock-user-name">
              <span id="mock-profile-name">CalcQuick</span>
              <span class="mock-badge" id="mock-verified-badge">✓</span>
            </div>
            <div class="mock-timestamp">Just now • 🌐</div>
          </div>
        </div>

        <div class="mock-content" id="mock-content-text">
          Your styled caption preview will render here...
        </div>

        <div class="mock-likes-count">
          <span>👍❤️ 1.2K</span>
          <span>48 Comments • 12 Shares</span>
        </div>

        <div class="mock-action-buttons">
          <div class="mock-action">👍 Like</div>
          <div class="mock-action">💬 Comment</div>
          <div class="mock-action">🔄 Share</div>
        </div>
      </div>

      <!-- Preview Options -->
      <div class="calc-panel" style="margin-top: 12px; padding: 14px;">
        <h4 style="font-size:11px; font-weight:700; color:var(--color-muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">Mockup Settings</h4>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <label style="display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--color-body); cursor:pointer;">
            <input type="checkbox" id="toggle-verified" checked style="accent-color:var(--color-link);" /> Show Blue Verified Badge
          </label>
          <div style="display:flex; flex-direction:column; gap:4px; margin-top:4px;">
            <label for="profile-name-input" style="font-size:11px; color:var(--color-muted);">Customize Profile Name</label>
            <input type="text" id="profile-name-input" class="input-base" value="CalcQuick" style="padding:6px 10px; font-size:12.5px;" />
          </div>
        </div>
      </div>

      <!-- Copy & Actions Panel -->
      <div class="calc-panel" style="margin-top: 12px;">
        <label class="label" style="margin-bottom:8px;">Copy Actions</label>
        <button id="copy-styled-btn" class="btn-primary" style="width:100%;font-size:13.5px;padding:12px;font-weight:600;">📋 Copy All Styled Text</button>
        <button id="copy-plain-btn" class="btn-secondary" style="width:100%;margin-top:6px;font-size:12px;padding:8px;">📄 Copy Plain Text Only</button>
      </div>

    </div>

  </div>

  <!-- PLATFORM COMPATIBILITY -->
  <div class="calc-panel fade-up" style="margin-bottom:24px; margin-top:24px;">
    <h2 style="color:var(--color-ink);font-size:18px;font-weight:600;margin-bottom:12px;">📱 Where Styled Text Works</h2>
    <p class="text-body-sm" style="color:var(--color-body);margin-bottom:16px;">Unicode-styled text works on all major social media platforms. Here's where you can use it:</p>
    <div class="platform-compat-grid">
      {socialPlatforms.map(p => (
        <div class="compat-card">
          <div class="compat-icon">{p.icon}</div>
          <div class="compat-name">{p.platform}</div>
          <div class="compat-detail">Best: {p.bestLength}</div>
          <div class="compat-detail" style="color:var(--color-muted);font-size:11px;">{p.worksWith}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- TIPS CARDS -->
  <div class="tips-grid fade-up" style="margin-bottom:40px;">
    <div class="tip-card">
      <div class="tip-icon">💡</div>
      <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin-bottom:6px;">Hook First Line</h3>
      <p style="font-size:13px;color:var(--color-body);line-height:1.5;">Make your first line bold to grab attention in the feed. Facebook truncates captions after 125 characters.</p>
    </div>
    <div class="tip-card">
      <div class="tip-icon">🎨</div>
      <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin-bottom:6px;">Mix Styles</h3>
      <p style="font-size:13px;color:var(--color-body);line-height:1.5;">Use Multi-Line Styler to combine bold headlines with cursive body text for a professional look.</p>
    </div>
    <div class="tip-card">
      <div class="tip-icon">📊</div>
      <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin-bottom:6px;">Optimal Length</h3>
      <p style="font-size:13px;color:var(--color-body);line-height:1.5;">Facebook posts with 40-80 characters get highest engagement. Keep it concise with styled keywords.</p>
    </div>
    <div class="tip-card">
      <div class="tip-icon">🔑</div>
      <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin-bottom:6px;">CTA Line</h3>
      <p style="font-size:13px;color:var(--color-body);line-height:1.5;">Style your call-to-action differently — try Sparkle or Bubble style to make it stand out.</p>
    </div>
  </div>

  <!-- FAQ -->
  <div style="margin-top:48px;" class="faq-accordion-wrap fade-up">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top:1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`fcs-faq-${i}`} id={`fcs-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`fcs-faq-${i}`} role="region" aria-labelledby={`fcs-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>

</CalculatorLayout>

<style>
  /* Tabs switching */
  .fc-tab {
    border: none;
    background: transparent;
    padding: 0.7rem 1.8rem;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 40px;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--color-body);
    font-family: inherit;
  }
  .fc-tab.active {
    background: var(--color-link);
    color: white;
    box-shadow: 0 2px 6px rgba(0, 112, 243, 0.2);
  }
  .fc-tab:hover:not(.active) {
    background: var(--color-canvas-soft-2);
    color: var(--color-ink);
  }
  .tabs-wrap {
    display: flex;
    gap: 0.5rem;
    background: var(--color-canvas);
    border-radius: 60px;
    padding: 0.35rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 8px 20px -8px rgba(0,0,0,0.08);
    width: fit-content;
  }

  /* Grid Editor & Preview */
  .fc-editor-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
  }

  .fc-textarea {
    width: 100%;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    background: var(--color-canvas);
    resize: vertical;
    outline: none;
    color: var(--color-ink);
    min-height: 110px;
  }
  .fc-textarea:focus {
    border-color: var(--color-link);
    box-shadow: 0 0 0 3px var(--color-link-bg);
  }

  .char-counter {
    font-size: 11px;
    color: var(--color-muted);
    margin-top: 6px;
    text-align: right;
  }

  /* Helper tabs for Emojis & Hashtags */
  .helper-tabs-container {
    margin-top: 12px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-canvas-soft);
  }
  .helper-tabs {
    display: flex;
    border-bottom: 1px solid var(--color-hairline);
  }
  .helper-tab {
    flex: 1;
    border: none;
    background: transparent;
    padding: 8px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-body);
    transition: all 0.15s ease;
  }
  .helper-tab.active {
    background: var(--color-canvas);
    color: var(--color-link);
    border-bottom: 2px solid var(--color-link);
  }
  .helper-panel {
    display: none;
    padding: 12px;
    max-height: 160px;
    overflow-y: auto;
    background: var(--color-canvas);
  }
  .helper-panel.active {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .emoji-category-row, .hashtag-category-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .category-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-muted);
    min-width: 75px;
  }
  .emoji-buttons, .hashtag-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .emoji-btn {
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    border-radius: 6px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 15px;
