---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

const contactMethods = [
  {
    icon: '✉️',
    title: 'Email Us',
    desc: 'For general inquiries, bug reports, or partnership requests.',
    value: 'hello@calcquick.online',
    href: 'mailto:hello@calcquick.online',
  },
  {
    icon: '🐛',
    title: 'Report a Bug',
    desc: 'Found a calculation error? Tell us and we\'ll fix it ASAP.',
    value: 'Use the form below',
    href: '#contact-form',
  },
  {
    icon: '💡',
    title: 'Suggest a Calculator',
    desc: 'Have an idea for a new tool? We\'d love to hear it.',
    value: 'Use the form below',
    href: '#contact-form',
  },
];
---

<BaseLayout
  title="Contact CalcQuick — Get in Touch"
  description="Contact the CalcQuick team. Report bugs, suggest new calculators, or ask questions about our free online calculator tools."
  canonical="/contact"
>
  <Header />
  <main id="main-content">

    <!-- Hero -->
    <section class="contact-hero">
      <div class="container-site">
        <div class="hero-inner fade-up">
          <span class="eyebrow" style="margin-bottom: 12px; display: block;">Contact</span>
          <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 16px;">Get in touch.</h1>
          <p class="text-body-lg" style="color: var(--color-body); max-width: 500px; line-height: 28px;">
            Found a bug? Have a suggestion for a new calculator? Want to partner with us? We'd love to hear from you.
          </p>
        </div>
      </div>
    </section>

    <div class="container-site contact-body">

      <!-- Contact Methods -->
      <div class="contact-methods fade-up">
        {contactMethods.map((method) => (
          <a href={method.href} class="method-card">
            <span class="method-icon" aria-hidden="true">{method.icon}</span>
            <div>
              <div class="method-title">{method.title}</div>
              <div class="method-desc">{method.desc}</div>
              <div class="method-value">{method.value}</div>
            </div>
          </a>
        ))}
      </div>

      <!-- Form Section -->
      <div class="contact-form-section">
        <div class="form-header fade-up">
          <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 8px;">Send us a message</h2>
          <p class="text-body-md" style="color: var(--color-body);">
            Fill out the form below and we'll get back to you as soon as possible. Usually within 1–3 business days.
          </p>
        </div>

        <div class="calc-panel fade-up stagger-1" style="margin-top: 32px;">
          <form id="contact-form" aria-label="Contact form" novalidate>
            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
              <div class="form-field">
                <label for="contact-name" class="label">Full Name <span aria-hidden="true" style="color: #ef4444;">*</span></label>
                <input type="text" id="contact-name" name="name" class="input-base input-lg" placeholder="Your name" autocomplete="name" required />
              </div>
              <div class="form-field">
                <label for="contact-email" class="label">Email Address <span aria-hidden="true" style="color: #ef4444;">*</span></label>
                <input type="email" id="contact-email" name="email" class="input-base input-lg" placeholder="you@example.com" autocomplete="email" required />
              </div>
            </div>
            <div class="form-field" style="margin-bottom: 16px;">
              <label for="contact-subject" class="label">Subject</label>
              <select id="contact-subject" name="subject" class="select-base">
                <option value="feedback">General feedback</option>
                <option value="bug">Bug report</option>
                <option value="suggestion">New calculator suggestion</option>
                <option value="partnership">Partnership / collaboration inquiry</option>
                <option value="adsense">Advertising inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-field" style="margin-bottom: 24px;">
              <label for="contact-message" class="label">Message <span aria-hidden="true" style="color: #ef4444;">*</span></label>
              <textarea id="contact-message" name="message" class="input-base" style="height: 140px; padding-top: 12px; resize: vertical;" placeholder="Tell us more about your inquiry..." required aria-label="Your message"></textarea>
            </div>

            <div class="form-disclaimer" style="margin-bottom: 20px;">
              <p>By submitting this form, you agree to our <a href="/privacy-policy">Privacy Policy</a> and <a href="/terms">Terms of Use</a>. We will only use your email address to respond to your inquiry.</p>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; justify-content: center;" id="contact-submit">
              Send Message
            </button>
          </form>

          <div id="contact-success" hidden style="text-align: center; padding: 48px 0;">
            <div style="font-size: 48px; margin-bottom: 16px;" aria-hidden="true">✅</div>
            <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 8px;">Message sent!</h2>
            <p class="text-body-md" style="color: var(--color-body);">
              Thanks for reaching out. We typically respond within 1–3 business days.
            </p>
            <a href="/" class="btn-secondary" style="display: inline-flex; margin-top: 24px;">Back to Home</a>
          </div>
        </div>

        <!-- Disclaimer -->
        <div class="form-note fade-up">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex-shrink:0; margin-top: 2px;">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 7v4M8 5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <p>We respect your privacy and will only use your email to respond. For direct support, you can reach us at <strong>hello@calcquick.online</strong>.</p>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('contact-success') as HTMLElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('contact-submit') as HTMLButtonElement;
    btn.textContent = 'Sending Message…';
    btn.disabled = true;
    
    // Simulate server side request delay
    await new Promise(resolve => setTimeout(resolve, 1200));
    
    form.hidden = true;
    success.hidden = false;
  });
</script>

<style>
  .contact-hero {
    padding: 80px 0 64px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .contact-body {
    padding: 64px 0 96px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    align-items: start;
  }
  .contact-methods { display: flex; flex-direction: column; gap: 16px; }
  .method-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .method-card:hover { border-color: var(--color-link); transform: translateX(4px); }
  .method-icon { font-size: 24px; flex-shrink: 0; }
  .method-title { font-size: 14px; font-weight: 600; color: var(--color-ink); margin-bottom: 4px; }
  .method-desc { font-size: 13px; color: var(--color-muted); line-height: 20px; margin-bottom: 4px; }
  .method-value { font-size: 13px; color: var(--color-link); font-weight: 500; }
  .form-disclaimer p { font-size: 12px; color: var(--color-muted); line-height: 20px; }
  .form-disclaimer a { color: var(--color-link); text-decoration: underline; }
  .form-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 16px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 13px;
  }
  .form-note p { line-height: 20px; }
  @media (max-width: 767px) {
    .contact-body { grid-template-columns: 1fr; gap: 40px; }
    .form-row { grid-template-columns: 1fr !important; }
  }
</style>
