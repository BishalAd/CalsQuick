  .mat-cement{border-top:3px solid #6366f1;}
  .mat-sand{border-top:3px solid #f59e0b;}
  .mat-agg{border-top:3px solid #6b7280;}
  .mat-water{border-top:3px solid #3b82f6;}

  /* Mix bar */
  .mix-bar-wrap{padding:14px 16px;background:var(--color-canvas-soft-2);border:1px solid var(--color-hairline);border-radius:var(--radius-lg);}
  .mix-bar-track{display:flex;height:16px;border-radius:99px;overflow:hidden;margin-bottom:8px;}
