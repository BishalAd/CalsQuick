  /* Concrete hero */
  .concrete-hero{display:flex;align-items:stretch;gap:0;background:var(--color-canvas-soft-2);border:1px solid var(--color-hairline);border-radius:var(--radius-lg);overflow:hidden;flex-wrap:wrap;}
  .con-hero-item{flex:1;min-width:120px;padding:20px 16px;text-align:center;}
  .con-hero-accent{background:var(--color-link);color:#fff;}
  .con-hero-accent .con-hero-label,.con-hero-accent .con-hero-sub{color:rgba(255,255,255,0.8);}
  .con-hero-accent .con-hero-value{color:#fff;}
  .con-hero-divider{width:1px;background:var(--color-hairline);flex-shrink:0;}
  .con-hero-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--color-muted);font-family:var(--font-mono);margin-bottom:6px;}
