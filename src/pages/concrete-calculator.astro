</style>

<script>
  // ── State ────────────────────────────────────────────────────────────────────
  let shape = 'slab';
  let dimUnit = 'metric';
  let activeMix = 'M20';
  const mixData: Record<string, {c:number;s:number;a:number}> = {
    M10:{c:1,s:3,a:6}, M15:{c:1,s:2,a:4}, M20:{c:1,s:1.5,a:3},
    M25:{c:1,s:1,a:2}, custom:{c:1,s:2,a:3},
  };

  // ── Shape selector ───────────────────────────────────────────────────────────
  document.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      shape = (btn as HTMLElement).dataset.shape!;
      document.querySelectorAll('.shape-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      document.querySelectorAll('.dim-section').forEach(s => ((s as HTMLElement).hidden = true));
      (document.getElementById('dim-'+shape) as HTMLElement).hidden = false;
    });
  });

  // ── Dim unit ─────────────────────────────────────────────────────────────────
  document.querySelectorAll('.seg-btn[data-dimunit]').forEach(b => {
    b.addEventListener('click', () => {
      dimUnit = (b as HTMLElement).dataset.dimunit!;
      document.querySelectorAll('.seg-btn[data-dimunit]').forEach(x => { x.classList.remove('active'); x.setAttribute('aria-pressed','false'); });
      b.classList.add('active'); b.setAttribute('aria-pressed','true');
      (document.getElementById('imperial-note') as HTMLElement).hidden = dimUnit !== 'imperial';
    });
  });

  // ── Waste slider ─────────────────────────────────────────────────────────────
  const wasteSlider = document.getElementById('waste-slider') as HTMLInputElement;
  const wastePct = document.getElementById('waste-pct') as HTMLInputElement;
  wasteSlider.addEventListener('input', () => { wastePct.value = wasteSlider.value; });
  wastePct.addEventListener('input', () => { wasteSlider.value = wastePct.value; });

  // ── Mix presets ───────────────────────────────────────────────────────────────
  document.querySelectorAll('.mix-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeMix = (btn as HTMLElement).dataset.mix!;
      document.querySelectorAll('.mix-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      (document.getElementById('custom-mix-inputs') as HTMLElement).hidden = activeMix !== 'custom';
    });
  });

  // ── Volume calculation ───────────────────────────────────────────────────────
  function getVolume(): number | null {
    const toM = (val: string, unit: 'mm'|'m'|'ft'|'in') => {
      const n = parseFloat(val);
      if (isNaN(n) || n <= 0) return null;
      if (unit === 'mm') return n / 1000;
      if (unit === 'm') return n;
      if (unit === 'ft') return n * 0.3048;
      if (unit === 'in') return n * 0.0254;
      return n;
    };

    // imperial adjustment: treat "m" inputs as feet, "mm" as inches
    const mUnit: 'm'|'ft' = dimUnit === 'imperial' ? 'ft' : 'm';
    const mmUnit: 'mm'|'in' = dimUnit === 'imperial' ? 'in' : 'mm';

    if (shape === 'slab') {
      const l = toM((document.getElementById('slab-length') as HTMLInputElement).value, mUnit);
      const w = toM((document.getElementById('slab-width') as HTMLInputElement).value, mUnit);
      const t = toM((document.getElementById('slab-thick') as HTMLInputElement).value, mmUnit);
      if (!l || !w || !t) return null;
      return l * w * t;
    }
    if (shape === 'footing') {
      const l = toM((document.getElementById('foot-length') as HTMLInputElement).value, mUnit);
      const w = toM((document.getElementById('foot-width') as HTMLInputElement).value, mUnit);
      const d = toM((document.getElementById('foot-depth') as HTMLInputElement).value, mUnit);
      if (!l || !w || !d) return null;
      return l * w * d;
    }
    if (shape === 'column') {
      const w = toM((document.getElementById('col-width') as HTMLInputElement).value, mmUnit);
      const d = toM((document.getElementById('col-depth') as HTMLInputElement).value, mmUnit);
      const h = toM((document.getElementById('col-height') as HTMLInputElement).value, mUnit);
      const n = parseFloat((document.getElementById('col-count') as HTMLInputElement).value) || 1;
      if (!w || !d || !h) return null;
      return w * d * h * n;
    }
    if (shape === 'round') {
      const diam = toM((document.getElementById('round-diam') as HTMLInputElement).value, mmUnit);
      const h = toM((document.getElementById('round-height') as HTMLInputElement).value, mUnit);
      const n = parseFloat((document.getElementById('round-count') as HTMLInputElement).value) || 1;
      if (!diam || !h) return null;
      const r = diam / 2;
      return Math.PI * r * r * h * n;
    }
    if (shape === 'steps') {
      const run = toM((document.getElementById('step-run') as HTMLInputElement).value, mmUnit);
      const rise = toM((document.getElementById('step-rise') as HTMLInputElement).value, mmUnit);
      const w = toM((document.getElementById('step-width') as HTMLInputElement).value, mUnit);
      const n = parseFloat((document.getElementById('step-count') as HTMLInputElement).value);
      if (!run || !rise || !w || !n) return null;
      // Volume of steps = triangle approach: 0.5 × run × rise × n × width × (n+1)/n
      // More accurate: sum of rectangular blocks
      let vol = 0;
      for (let i = 1; i <= n; i++) { vol += run * (rise * i) * w; }
      return vol;
    }
    return null;
  }

  document.getElementById('calc-concrete-btn')!.addEventListener('click', () => {
    const errorEl = document.getElementById('concrete-error') as HTMLElement;
    const resultsEl = document.getElementById('concrete-results') as HTMLElement;
    errorEl.hidden = true;

    const volNet = getVolume();
    if (volNet === null || volNet <= 0) {
      document.getElementById('concrete-error-msg')!.textContent = 'Please fill in all dimension fields with valid positive values.';
      errorEl.hidden = false; return;
    }

    const waste = parseFloat(wastePct.value) / 100 || 0.10;
    const volTotal = volNet * (1 + waste);
    const weightKg = volTotal * 2400;

    // Get mix ratios
    let mix = mixData[activeMix] || mixData['M20'];
    if (activeMix === 'custom') {
      const c = parseFloat((document.getElementById('custom-c') as HTMLInputElement).value) || 1;
      const s = parseFloat((document.getElementById('custom-s') as HTMLInputElement).value) || 2;
      const a = parseFloat((document.getElementById('custom-a') as HTMLInputElement).value) || 3;
      mix = {c, s, a};
      mixData['custom'] = mix;
    }

    const total = mix.c + mix.s + mix.a;
    const DRY_FACTOR = 1.54;

    // Per m³
    const cementM3perM3 = (mix.c / total) * DRY_FACTOR;
    const sandM3perM3   = (mix.s / total) * DRY_FACTOR;
    const aggM3perM3    = (mix.a / total) * DRY_FACTOR;
    const CEMENT_BAG_VOL = 0.035; // m³ per 50kg bag
    const cementBagsPerM3 = cementM3perM3 / CEMENT_BAG_VOL;

    // Totals
    const cBags = cementBagsPerM3 * volTotal;
    const cKg = cBags * 50;
    const sM3 = sandM3perM3 * volTotal;
    const aM3 = aggM3perM3 * volTotal;
    const waterL = (cKg * 0.5); // W/C = 0.5

    const fmt1 = (n: number) => n.toFixed(2);
    const fmt0 = (n: number) => Math.round(n).toLocaleString();

    // Hero
    (document.getElementById('res-vol-net') as HTMLElement).textContent = fmt1(volNet) + ' m³';
    (document.getElementById('res-vol-net-ft') as HTMLElement).textContent = fmt1(volNet * 35.315) + ' ft³';
    (document.getElementById('res-vol-total') as HTMLElement).textContent = fmt1(volTotal) + ' m³';
    (document.getElementById('res-vol-total-ft') as HTMLElement).textContent = fmt1(volTotal * 35.315) + ' ft³';
    (document.getElementById('res-weight') as HTMLElement).textContent = fmt0(weightKg) + ' kg';
    (document.getElementById('waste-pct-display') as HTMLElement).textContent = Math.round(waste * 100) + '';

    // Materials
    (document.getElementById('mat-cement-bags') as HTMLElement).textContent = fmt1(cBags) + ' bags';
    (document.getElementById('mat-cement-kg') as HTMLElement).textContent = fmt0(cKg) + ' kg';
    (document.getElementById('mat-sand-m3') as HTMLElement).textContent = fmt1(sM3) + ' m³';
    (document.getElementById('mat-sand-kg') as HTMLElement).textContent = fmt0(sM3 * 1500) + ' kg';
    (document.getElementById('mat-agg-m3') as HTMLElement).textContent = fmt1(aM3) + ' m³';
    (document.getElementById('mat-agg-kg') as HTMLElement).textContent = fmt0(aM3 * 1550) + ' kg';
    (document.getElementById('mat-water-l') as HTMLElement).textContent = fmt0(waterL) + ' L';

    // Mix bar
    const cPct = (mix.c / total * 100).toFixed(1);
    const sPct = (mix.s / total * 100).toFixed(1);
    const aPct = (mix.a / total * 100).toFixed(1);
    (document.getElementById('mix-bar-c-fill') as HTMLElement).style.width = cPct + '%';
    (document.getElementById('mix-bar-s-fill') as HTMLElement).style.width = sPct + '%';
    (document.getElementById('mix-bar-a-fill') as HTMLElement).style.width = aPct + '%';
    (document.getElementById('mix-bar-label') as HTMLElement).textContent = `Mix Ratio ${mix.c}:${mix.s}:${mix.a} — Cement ${cPct}% · Sand ${sPct}% · Aggregate ${aPct}%`;

    // Detail table
    const tbody = document.getElementById('detail-table-body') as HTMLElement;
    tbody.innerHTML = '';
    [
      ['🏗️ Cement', fmt1(cementBagsPerM3)+' bags ('+fmt1(cementM3perM3)+' m³)', fmt1(cBags)+' bags ('+fmt0(cKg)+' kg)'],
      ['🏖️ Sand', fmt1(sandM3perM3)+' m³', fmt1(sM3)+' m³ ('+fmt0(sM3*1500)+' kg)'],
      ['🪨 Aggregate', fmt1(aggM3perM3)+' m³', fmt1(aM3)+' m³ ('+fmt0(aM3*1550)+' kg)'],
      ['💧 Water (W/C 0.5)', fmt0(cKg/2*10/10)+' L (per m³ of cement)', fmt0(waterL)+' L'],
    ].forEach(([mat, per, tot]) => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--color-hairline)';
      tr.innerHTML = `<td style="padding:10px 14px;font-weight:500;">${mat}</td><td style="padding:10px 14px;text-align:right;font-family:var(--font-mono);">${per}</td><td style="padding:10px 14px;text-align:right;font-family:var(--font-mono);font-weight:600;color:var(--color-link);">${tot}</td>`;
      tbody.appendChild(tr);
    });

    // Cost
    const costPerBag = parseFloat((document.getElementById('cement-cost') as HTMLInputElement).value);
    const costSection = document.getElementById('cost-section') as HTMLElement;
    if (!isNaN(costPerBag) && costPerBag > 0) {
      const totalCost = Math.round(cBags * costPerBag);
      (document.getElementById('res-cost') as HTMLElement).textContent = 'Rs. ' + totalCost.toLocaleString();
      costSection.hidden = false;
    } else {
      costSection.hidden = true;
    }

    resultsEl.hidden = false;
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  document.getElementById('clear-concrete-btn')!.addEventListener('click', () => {
    document.querySelectorAll('.dim-section input').forEach(i => (i as HTMLInputElement).value = '');
    (document.getElementById('waste-pct') as HTMLInputElement).value = '10';
    (document.getElementById('waste-slider') as HTMLInputElement).value = '10';
    (document.getElementById('cement-cost') as HTMLInputElement).value = '';
    (document.getElementById('concrete-results') as HTMLElement).hidden = true;
    (document.getElementById('concrete-error') as HTMLElement).hidden = true;
  });

  // FAQ
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
