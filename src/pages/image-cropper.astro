  }
  .ic-download-btn:hover { border-color: var(--color-link); background: var(--color-canvas); }
  .ic-download-btn.active { background: var(--color-link-bg); color: var(--color-link); border-color: var(--color-link); }

  .prose-section {
    padding: 32px;
    background: var(--color-canvas);
