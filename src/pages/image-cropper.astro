</style>

<script>
  // ─── Variables & Elements ───────────────────────────────────────────────────
  let cropper: any = null;
  let sourceImage: HTMLImageElement | null = null;
  let currentShape = 'rect';
  let currentFilter = 'none';
  let currentFormat = 'jpg';
  let currentMime = 'image/jpeg';
  let isKeyingEnabled = false;

  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadArea = document.getElementById('upload-area')!;
  const editorArea = document.getElementById('editor-area')!;
  const imageToCrop = document.getElementById('image-to-crop') as HTMLImageElement;

  // ─── File Upload Actions ─────────────────────────────────────────────────────
  document.getElementById('browse-btn')!.addEventListener('click', () => fileInput.click());
  uploadArea.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('button')) fileInput.click();
  });

  fileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleImageFile(file);
  });

  // Drag & drop
  uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
  uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    const file = e.dataTransfer?.files?.[0];
    if (file) handleImageFile(file);
  });

  // Paste from clipboard
  document.getElementById('paste-btn')!.addEventListener('click', async () => {
    try {
      const items = await navigator.clipboard.read();
      for (const item of items) {
        for (const type of item.types) {
          if (type.startsWith('image/')) {
            const blob = await item.getType(type);
            handleImageFile(blob);
            return;
          }
        }
      }
      alert('No image found in clipboard. Copy an image first.');
    } catch (e) {
      alert('Clipboard access denied. Try standard file browser upload.');
    }
  });

  // Sample image
  document.getElementById('sample-btn')!.addEventListener('click', () => {
    const sampleUrl = 'data:image/svg+xml,' + encodeURIComponent(`
      <svg xmlns="http://www.w3.org/2000/svg" width="1000" height="750">
        <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#4f46e5;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#ec4899;stop-opacity:1" />
          </linearGradient>
        </defs>
        <rect width="1000" height="750" fill="url(#grad)" />
        <circle cx="500" cy="320" r="160" fill="#ffffff" opacity="0.15" />
        <path d="M500,240 L530,300 L600,310 L550,360 L560,430 L500,390 L440,430 L450,360 L400,310 L470,300 Z" fill="#ffffff" opacity="0.3"/>
        <text x="500" y="550" text-anchor="middle" font-family="sans-serif" font-weight="bold" font-size="42" fill="#ffffff">CalcQuick Image Tool</text>
        <text x="500" y="600" text-anchor="middle" font-family="sans-serif" font-size="22" fill="#ffffff" opacity="0.8">1000 × 750 • Sample Photography Canvas</text>
      </svg>
    `);
    const img = new Image();
    img.onload = () => initCropper(img.src);
    img.src = sampleUrl;
  });

  function handleImageFile(file: Blob) {
    const reader = new FileReader();
    reader.onload = (e) => {
      if (e.target?.result) {
        initCropper(e.target.result as string);
      }
    };
    reader.readAsDataURL(file);
  }

  // ─── Initialize Cropper.js ──────────────────────────────────────────────────
  function initCropper(imageSrc: string) {
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }

    uploadArea.style.display = 'none';
    editorArea.style.display = '';

    imageToCrop.src = imageSrc;

    // Wait until image is loaded to instantiate
    imageToCrop.onload = () => {
      // @ts-ignore
      cropper = new Cropper(imageToCrop, {
        aspectRatio: NaN,
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 0.8,
        restore: false,
        guides: true,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        crop(event: any) {
          // Update dimensions info in real-time
          const w = Math.round(event.detail.width);
          const h = Math.round(event.detail.height);
          document.getElementById('info-w')!.textContent = String(w);
          document.getElementById('info-h')!.textContent = String(h);

          // Update input boxes if not manually editing
          if (document.activeElement !== document.getElementById('custom-w') &&
              document.activeElement !== document.getElementById('custom-h')) {
            (document.getElementById('custom-w') as HTMLInputElement).value = String(w);
            (document.getElementById('custom-h') as HTMLInputElement).value = String(h);
          }
        }
      });
    };
  }

  // ─── Aspect Ratio / Presets ──────────────────────────────────────────────────
  document.querySelectorAll('.ic-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!cropper) return;
      document.querySelectorAll('.ic-preset-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const ratioAttr = btn.getAttribute('data-ratio')!;
      let aspect = NaN;

      if (ratioAttr !== 'NaN') {
        const parts = ratioAttr.split(':').map(Number);
        if (parts.length === 2) {
          aspect = parts[0] / parts[1];
        } else {
          aspect = Number(ratioAttr);
        }
      }

      cropper.setAspectRatio(aspect);

      // Lock checkbox state based on if aspect is lockable
      const lockBox = document.getElementById('lock-aspect') as HTMLInputElement;
      lockBox.checked = !isNaN(aspect);
    });
  });

  // Aspect ratio lock checkbox
  document.getElementById('lock-aspect')!.addEventListener('change', (e) => {
    if (!cropper) return;
    const locked = (e.target as HTMLInputElement).checked;
    if (locked) {
      const data = cropper.getData();
      cropper.setAspectRatio(data.width / data.height);
    } else {
      cropper.setAspectRatio(NaN);
      document.querySelectorAll('.ic-preset-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('preset-free')!.classList.add('active');
    }
  });

  // Custom height/width change triggers resizing cropBox
  function handleManualSize() {
    if (!cropper) return;
    const w = parseInt((document.getElementById('custom-w') as HTMLInputElement).value);
    const h = parseInt((document.getElementById('custom-h') as HTMLInputElement).value);
    if (isNaN(w) || isNaN(h) || w <= 0 || h <= 0) return;

    const data = cropper.getData();
    cropper.setData({
      x: data.x,
      y: data.y,
      width: w,
      height: h
    });

    const lockBox = document.getElementById('lock-aspect') as HTMLInputElement;
    if (lockBox.checked) {
      cropper.setAspectRatio(w / h);
    }
  }

  document.getElementById('custom-w')!.addEventListener('change', handleManualSize);
  document.getElementById('custom-h')!.addEventListener('change', handleManualSize);

  // ─── Shapes Selection ───────────────────────────────────────────────────────
  document.querySelectorAll('.ic-shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ic-shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentShape = btn.getAttribute('data-shape')!;

      // Handle lock aspect to 1:1 if square or circle
      if (cropper && (currentShape === 'square' || currentShape === 'circle')) {
        cropper.setAspectRatio(1);
        document.querySelectorAll('.ic-preset-btn').forEach(b => b.classList.remove('active'));
        (document.getElementById('lock-aspect') as HTMLInputElement).checked = true;
      }

      const radSlider = document.getElementById('rounded-slider-container')!;
      radSlider.style.display = currentShape === 'rounded' ? 'block' : 'none';
    });
  });
  document.querySelector('.ic-shape-btn[data-shape="rect"]')?.classList.add('active');

  document.getElementById('radius-slider')!.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    document.getElementById('radius-value')!.textContent = val;
  });

  // ─── Toolbar Operations ─────────────────────────────────────────────────────
  document.getElementById('zoom-in-btn')!.addEventListener('click', () => cropper?.zoom(0.1));
  document.getElementById('zoom-out-btn')!.addEventListener('click', () => cropper?.zoom(-0.1));
  document.getElementById('rotate-left-btn')!.addEventListener('click', () => cropper?.rotate(-90));
  document.getElementById('rotate-right-btn')!.addEventListener('click', () => cropper?.rotate(90));

  let scaleX = 1;
  document.getElementById('flip-h-btn')!.addEventListener('click', () => {
    if (!cropper) return;
    scaleX = -scaleX;
    cropper.scaleX(scaleX);
  });

  let scaleY = 1;
  document.getElementById('flip-v-btn')!.addEventListener('click', () => {
    if (!cropper) return;
    scaleY = -scaleY;
    cropper.scaleY(scaleY);
  });

  document.getElementById('reset-btn')!.addEventListener('click', () => {
    if (!cropper) return;
    cropper.reset();
    scaleX = 1;
    scaleY = 1;
    cropper.scale(1, 1);
    cropper.setAspectRatio(NaN);
    document.querySelectorAll('.ic-preset-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('preset-free')!.classList.add('active');
    (document.getElementById('lock-aspect') as HTMLInputElement).checked = false;
  });

  // ─── Sliders Change ─────────────────────────────────────────────────────────
  const sliders = ['brightness', 'contrast', 'saturate', 'hue'];
  sliders.forEach(s => {
    document.getElementById(`slider-${s}`)!.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      document.getElementById(`${s}-val`)!.textContent = val;
    });
  });

  // ─── Quick Filters Selection ────────────────────────────────────────────────
  document.querySelectorAll('.ic-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ic-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.getAttribute('data-filter')!;
    });
  });
  document.querySelector('.ic-filter-btn[data-filter="none"]')?.classList.add('active');

  // ─── Format & Quality Selection ──────────────────────────────────────────────
  document.querySelectorAll('.ic-download-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ic-download-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFormat = btn.getAttribute('data-format')!;
      currentMime = btn.getAttribute('data-mime')!;

      const qualitySection = document.getElementById('jpg-quality')!;
      qualitySection.style.display = currentFormat === 'jpg' ? 'block' : 'none';
    });
  });
  document.querySelector('.ic-download-btn[data-format="jpg"]')?.classList.add('active');

  document.getElementById('quality-slider')!.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    document.getElementById('quality-value')!.textContent = val;
  });

  // ─── Background Removal & Color Keying ───────────────────────────────────────
  const removeBgBtn = document.getElementById('remove-bg-btn')!;
  const autodetectBtn = document.getElementById('autodetect-bg-btn')!;
  const keyColorInput = document.getElementById('key-color') as HTMLInputElement;
  const toleranceSlider = document.getElementById('tolerance-slider') as HTMLInputElement;
  const toleranceContainer = document.getElementById('tolerance-container')!;

  removeBgBtn.addEventListener('click', () => {
    isKeyingEnabled = !isKeyingEnabled;
    removeBgBtn.classList.toggle('active', isKeyingEnabled);
    removeBgBtn.textContent = isKeyingEnabled ? '✅ Background Keyed' : '✨ Key out background';
    toleranceContainer.style.display = isKeyingEnabled ? 'block' : 'none';
  });

  toleranceSlider.addEventListener('input', () => {
    document.getElementById('tolerance-val')!.textContent = toleranceSlider.value;
  });

  autodetectBtn.addEventListener('click', () => {
    if (!cropper) return;
    // Auto detect: Get color of top-left corner pixel of the cropped region
    const tempCanvas = cropper.getCroppedCanvas({ width: 100, height: 100 });
    if (!tempCanvas) return;
    const tempCtx = tempCanvas.getContext('2d')!;
    const pixel = tempCtx.getImageData(0, 0, 1, 1).data;
    const r = pixel[0], g = pixel[1], b = pixel[2];
    
    // Convert to hex
    const hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    keyColorInput.value = hex;

    // Enable keying if not already
    if (!isKeyingEnabled) {
      removeBgBtn.click();
    }
  });

  // Helper: Hex Color to RGB object
  function hexToRgb(hex: string) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? {
      r: parseInt(result[1], 16),
      g: parseInt(result[2], 16),
      b: parseInt(result[3], 16)
    } : { r: 255, g: 255, b: 255 };
  }

  // ─── Export & Download Math ──────────────────────────────────────────────────
  document.getElementById('download-btn')!.addEventListener('click', () => {
    if (!cropper) return;

    // Get cropped canvas at high/native resolution
    const cropCanvas = cropper.getCroppedCanvas();
    if (!cropCanvas) return;

    const outCanvas = document.createElement('canvas');
    outCanvas.width = cropCanvas.width;
    outCanvas.height = cropCanvas.height;
    const outCtx = outCanvas.getContext('2d')!;

    // 1. Draw solid background color (only if not transparent)
    const bgColor = (document.getElementById('bg-color') as HTMLInputElement).value;
    const isTransparentFormat = currentFormat === 'png' || currentFormat === 'webp';
    if (!isTransparentFormat || !isKeyingEnabled) {
      outCtx.fillStyle = bgColor;
      outCtx.fillRect(0, 0, outCanvas.width, outCanvas.height);
    }

    // 2. Apply general CSS filters & color correction options in canvas
    let filterString = '';
    
    // Base preset filter
    if (currentFilter === 'grayscale') filterString += 'grayscale(100%) ';
    else if (currentFilter === 'sepia') filterString += 'sepia(100%) ';
    else if (currentFilter === 'vintage') filterString += 'sepia(50%) contrast(95%) brightness(95%) ';
    else if (currentFilter === 'cool') filterString += 'hue-rotate(30deg) saturate(90%) ';
    else if (currentFilter === 'warm') filterString += 'hue-rotate(-15deg) saturate(110%) ';

    // Adjustment sliders
    const bright = (document.getElementById('slider-brightness') as HTMLInputElement).value;
    const contrast = (document.getElementById('slider-contrast') as HTMLInputElement).value;
    const saturate = (document.getElementById('slider-saturate') as HTMLInputElement).value;
    const hue = (document.getElementById('slider-hue') as HTMLInputElement).value;
    
    filterString += `brightness(${bright}%) contrast(${contrast}%) saturate(${saturate}%) hue-rotate(${hue}deg)`;
    outCtx.filter = filterString.trim();

    // 3. Draw cropped image into offscreen workspace
    outCtx.drawImage(cropCanvas, 0, 0);

    // 4. Color key background removal (optional)
    if (isKeyingEnabled) {
      const imgData = outCtx.getImageData(0, 0, outCanvas.width, outCanvas.height);
      const data = imgData.data;
      
      const keyHex = keyColorInput.value;
      const keyColor = hexToRgb(keyHex);
      const tolerance = parseInt(toleranceSlider.value);
      
      // Calculate tolerance Euclidean distance squared threshold
      const maxDistance = (tolerance / 100) * 255;
      const maxDistanceSq = maxDistance * maxDistance;

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i];
        const g = data[i+1];
        const b = data[i+2];

        // Euclidean color distance sq
        const dR = r - keyColor.r;
        const dG = g - keyColor.g;
        const dB = b - keyColor.b;
        const distSq = dR*dR + dG*dG + dB*dB;

        if (distSq <= maxDistanceSq * 3) {
          // Key out pixel: make alpha 0
          data[i+3] = 0;
        }
      }
      outCtx.putImageData(imgData, 0, 0);
    }

    // 5. Apply shape masking & create final shaped destination canvas
    const finalCanvas = document.createElement('canvas');
    finalCanvas.width = outCanvas.width;
    finalCanvas.height = outCanvas.height;
    const finalCtx = finalCanvas.getContext('2d')!;

    // Background color fill for shape background
    if (!isTransparentFormat) {
      finalCtx.fillStyle = bgColor;
      finalCtx.fillRect(0, 0, finalCanvas.width, finalCanvas.height);
    }

    finalCtx.save();
    finalCtx.beginPath();

    const w = finalCanvas.width;
    const h = finalCanvas.height;

    // Apply shape mask path
    if (currentShape === 'circle') {
      finalCtx.arc(w / 2, h / 2, Math.min(w, h) / 2, 0, Math.PI * 2);
      finalCtx.clip();
    } else if (currentShape === 'rounded') {
      const radius = parseFloat((document.getElementById('radius-slider') as HTMLInputElement).value);
      // Adjust radius relative to export resolution
      const scaledRad = Math.min(radius * (w / 300), Math.min(w, h) / 2);
      roundRect(finalCtx, 0, 0, w, h, scaledRad);
      finalCtx.clip();
    } else if (currentShape === 'oval') {
      finalCtx.ellipse(w / 2, h / 2, w / 2, h / 2, 0, 0, Math.PI * 2);
      finalCtx.clip();
    } else if (currentShape === 'heart') {
      drawHeart(finalCtx, w / 2, h / 2, Math.min(w, h) / 2);
      finalCtx.clip();
    } else if (currentShape === 'diamond') {
      finalCtx.moveTo(w / 2, 0);
      finalCtx.lineTo(w, h / 2);
      finalCtx.lineTo(w / 2, h);
      finalCtx.lineTo(0, h / 2);
      finalCtx.closePath();
      finalCtx.clip();
    } else if (currentShape === 'star') {
      drawStar(finalCtx, w / 2, h / 2, Math.min(w, h) / 2);
      finalCtx.clip();
    } else if (currentShape === 'square') {
      // Crop shape standard square is implicit (aspect is 1:1)
      finalCtx.rect(0, 0, w, h);
      finalCtx.clip();
    }

    // Draw result
    finalCtx.drawImage(outCanvas, 0, 0);
    finalCtx.restore();

    // Trigger download
    const qualityVal = parseInt((document.getElementById('quality-slider') as HTMLInputElement).value) / 100;
    const downloadUrl = finalCanvas.toDataURL(currentMime, qualityVal);

    const anchor = document.createElement('a');
    anchor.download = `calcquick_cropped.${currentFormat}`;
    anchor.href = downloadUrl;
    anchor.click();
  });

  // Shapes support paths
  function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    if (w < 2 * r) r = w / 2;
    if (h < 2 * r) r = h / 2;
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function drawHeart(ctx: CanvasRenderingContext2D, cx: number, cy: number, size: number) {
    ctx.moveTo(cx, cy + size * 0.4);
    ctx.bezierCurveTo(cx - size, cy - size * 0.6, cx - size, cy + size * 0.2, cx, cy + size * 0.95);
    ctx.bezierCurveTo(cx + size, cy + size * 0.2, cx + size, cy - size * 0.6, cx, cy + size * 0.4);
    ctx.closePath();
  }

  function drawStar(ctx: CanvasRenderingContext2D, cx: number, cy: number, size: number) {
    const spikes = 5;
    const outerRadius = size;
    const innerRadius = size * 0.4;
    let rot = (Math.PI / 2) * 3;
    const step = Math.PI / spikes;

    ctx.moveTo(cx, cy - outerRadius);
    for (let i = 0; i < spikes; i++) {
      ctx.lineTo(cx + Math.cos(rot) * outerRadius, cy + Math.sin(rot) * outerRadius);
      rot += step;
      ctx.lineTo(cx + Math.cos(rot) * innerRadius, cy + Math.sin(rot) * innerRadius);
      rot += step;
    }
    ctx.closePath();
  }

  // ─── New Image Trigger ──────────────────────────────────────────────────────
  document.getElementById('new-image-btn')!.addEventListener('click', () => {
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    sourceImage = null;
    imageToCrop.src = '';
    
    // Clear custom sliders back to default
    sliders.forEach(s => {
      (document.getElementById(`slider-${s}`) as HTMLInputElement).value = '100';
      document.getElementById(`${s}-val`)!.textContent = '100';
    });
    (document.getElementById('slider-hue') as HTMLInputElement).value = '0';
    document.getElementById('hue-val')!.textContent = '0';

    // Clear filters
    document.querySelectorAll('.ic-filter-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.ic-filter-btn[data-filter="none"]')?.classList.add('active');
    currentFilter = 'none';

    // Disable keying
    isKeyingEnabled = false;
    removeBgBtn.classList.remove('active');
    removeBgBtn.textContent = '✨ Key out background';
    toleranceContainer.style.display = 'none';

    // Reset formats
    document.querySelectorAll('.ic-download-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.ic-download-btn[data-format="jpg"]')?.classList.add('active');
    currentFormat = 'jpg';
    currentMime = 'image/jpeg';
    document.getElementById('jpg-quality')!.style.display = 'block';

    uploadArea.style.display = '';
    editorArea.style.display = 'none';
    fileInput.value = '';
  });

  // ─── Accordion Logic ────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>