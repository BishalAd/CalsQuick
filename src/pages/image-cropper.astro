  }
  .ic-category-summary::-webkit-details-marker { display: none; }
  .ic-category-summary:hover { background: var(--color-canvas-soft-2); }
  .ic-preset-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 8px;
    background: var(--color-canvas-soft-2);
