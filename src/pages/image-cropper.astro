  }
  .ic-preset-btn:hover { border-color: var(--color-link); background: var(--color-canvas-soft); }
  .ic-preset-btn.active { border-color: var(--color-link); background: var(--color-link-bg); }
  .ic-preset-btn.active .ic-preset-name { color: var(--color-link); font-weight: 600; }
  .ic-preset-name { font-size: 11px; font-weight: 500; color: var(--color-ink); }
  .ic-preset-size { font-size: 10px; color: var(--color-muted); font-family: var(--font-mono); margin-top: 2px; }

  /* Custom dimensions */
  .input-base {
