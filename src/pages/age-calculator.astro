  // ─── TAB 3: ADD OR SUBTRACT FROM DATE (ctype=3) ───
  function calculateAddSub(shouldUpdateUrl = true) {
    hideError();
    const dBase = parseDateFromGroup(addsubMonth, addsubDay, addsubYear, birthHour, birthMinute);
    if (!dBase) {
      showError('Please select a valid base date.');
      return;
    }

    const op = addsubOp.value; // 'add' or 'subtract'
    const sign = op === 'add' ? 1 : -1;
    const yVal = parseInt(addsubYears.value) || 0;
    const mVal = parseInt(addsubMonths.value) || 0;
    const wVal = parseInt(addsubWeeks.value) || 0;
    const dVal = parseInt(addsubDays.value) || 0;
    const bizOnly = addsubBizonly.checked;

    let result = new Date(dBase.getFullYear(), dBase.getMonth(), dBase.getDate());

    if (!bizOnly) {
      // Calendar arithmetic
      result.setFullYear(result.getFullYear() + yVal * sign);
      result.setMonth(result.getMonth() + mVal * sign);
      const daysDiff = (wVal * 7 + dVal) * sign;
      result.setDate(result.getDate() + daysDiff);
    } else {
      // Business days arithmetic (skipping weekends & holidays)
      result.setFullYear(result.getFullYear() + yVal * sign);
      result.setMonth(result.getMonth() + mVal * sign);

      let businessDaysToMove = wVal * 5 + dVal;
      while (businessDaysToMove > 0) {
        result.setDate(result.getDate() + (1 * sign));
        const w = result.getDay();
        const isW = (w === 0 || w === 6);

        const yStr = result.getFullYear();
        const mStr = String(result.getMonth() + 1).padStart(2, '0');
        const dStr = String(result.getDate()).padStart(2, '0');
        const dateStr = `${yStr}-${mStr}-${dStr}`;

        const isCustomH = customHolidays.includes(dateStr);
        const isRegionH = (holidayRegion === 'us' && isUSFederalHoliday(result));
        const isH = !isW && (isCustomH || isRegionH);

        if (!isW && !isH) {
          businessDaysToMove--;
        }
      }
    }

    // Day of the year calculation
    const startOfYear = new Date(result.getFullYear(), 0, 1);
    const diffMs = result.getTime() - startOfYear.getTime();
    const dayNum = Math.floor(diffMs / 86400000) + 1;

    // Render output
    const fmtOptions: Intl.DateTimeFormatOptions = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' };
    document.getElementById('addsub-target-date')!.textContent = result.toLocaleDateString('en-US', fmtOptions);
    document.getElementById('addsub-year-day-num')!.textContent = `Day ${dayNum} of the year (${result.getFullYear()})`;

    addsubResults.hidden = false;
    addsubResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (shouldUpdateUrl) {
      const baseStr = `${addsubYear.value}-${String(parseInt(addsubMonth.value) + 1).padStart(2, '0')}-${String(addsubDay.value).padStart(2, '0')}`;
      
      updateUrl({
        basedate: baseStr,
        years: String(yVal),
        months: String(mVal),
        weeks: String(wVal),
        days: String(dVal),
        operation: op,
        bizonly: bizOnly ? '1' : '0',
        ctype: '3',
        x: 'Calculate'
      });
    }
  }

  document.getElementById('calc-addsub-btn')?.addEventListener('click', () => calculateAddSub(true));
  document.getElementById('reset-addsub-btn')?.addEventListener('click', () => {
    addsubMonth.value = '';
    addsubDay.value = '';
    addsubYear.value = '';
    addsubOp.value = 'add';
    addsubYears.value = '0';
    addsubMonths.value = '0';
    addsubWeeks.value = '0';
    addsubDays.value = '0';
    addsubBizonly.checked = false;
    addsubResults.hidden = true;
    hideError();
    clearUrl();
  });

  // ─── SYNCHRONIZE ON PAGE LOAD FROM URL QUERY STRINGS ───
  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const ctype = params.get('ctype');

    if (ctype === '1') {
      const birthDate = params.get('birthdate');
      const birthTime = params.get('birthtime');
      const toDate = params.get('todate');
      const toTime = params.get('totime');

      if (birthDate) {
        const [y, m, d] = birthDate.split('-').map(Number);
        birthYear.value = String(y);
        birthMonth.value = String(m - 1);
        populateDaySelect(birthMonth, birthDay, birthYear);
        birthDay.value = String(d);

        if (birthTime) {
          const [h, min] = birthTime.split(':').map(Number);
          birthHour.value = String(h);
          birthMinute.value = String(min);
        }
      }

      if (toDate) {
        const [y, m, d] = toDate.split('-').map(Number);
        toYear.value = String(y);
        toMonth.value = String(m - 1);
        populateDaySelect(toMonth, toDay, toYear);
        toDay.value = String(d);

        if (toTime) {
          const [h, min] = toTime.split(':').map(Number);
          toHour.value = String(h);
          toMinute.value = String(min);
        }
      }

      switchTab('chrono', false);
      calculateChrono(false);

    } else if (ctype === '2') {
      const startDate = params.get('startdate');
      const endDate = params.get('enddate');
      const includeEnd = params.get('includeend') === '1';

      if (startDate) {
        const [y, m, d] = startDate.split('-').map(Number);
        diffStartYear.value = String(y);
        diffStartMonth.value = String(m - 1);
        populateDaySelect(diffStartMonth, diffStartDay, diffStartYear);
        diffStartDay.value = String(d);
      }

      if (endDate) {
        const [y, m, d] = endDate.split('-').map(Number);
        diffEndYear.value = String(y);
        diffEndMonth.value = String(m - 1);
        populateDaySelect(diffEndMonth, diffEndDay, diffEndYear);
        diffEndDay.value = String(d);
      }

      diffIncludeEnd.checked = includeEnd;

      switchTab('diff', false);
      calculateDiff(false);

    } else if (ctype === '3') {
      const baseDate = params.get('basedate');
      const yearsVal = params.get('years');
      const monthsVal = params.get('months');
      const weeksVal = params.get('weeks');
      const daysVal = params.get('days');
      const op = params.get('operation') || 'add';
      const bizonly = params.get('bizonly') === '1';

      if (baseDate) {
        const [y, m, d] = baseDate.split('-').map(Number);
        addsubYear.value = String(y);
        addsubMonth.value = String(m - 1);
        populateDaySelect(addsubMonth, addsubDay, addsubYear);
        addsubDay.value = String(d);
      }

      addsubYears.value = yearsVal || '0';
      addsubMonths.value = monthsVal || '0';
      addsubWeeks.value = weeksVal || '0';
      addsubDays.value = daysVal || '0';
      addsubOp.value = op;
      addsubBizonly.checked = bizonly;

      switchTab('addsub', false);
      calculateAddSub(false);
    }
  }

  // Load state and custom holiday lists
  renderCustomHolidaysList();
  initFromUrl();

  // FAQ Expand / Collapse
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!expanded));
      if (ans) ans.classList.toggle('open', !expanded);
      if (icon) icon.classList.toggle('open', !expanded);
    });
  });
</script>
