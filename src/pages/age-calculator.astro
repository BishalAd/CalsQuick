<script>
  // Helper functions for US federal holidays
  function getNthDayOfMonth(year: number, month: number, dayOfWeek: number, n: number): number {
    let count = 0;
    for (let d = 1; d <= 31; d++) {
      const dt = new Date(year, month, d);
      if (dt.getMonth() !== month) break;
      if (dt.getDay() === dayOfWeek) {
        count++;
        if (count === n) return d;
      }
    }
    return 1;
  }

  function getLastDayOfMonth(year: number, month: number, dayOfWeek: number): number {
    for (let d = 31; d >= 20; d--) {
      const dt = new Date(year, month, d);
      if (dt.getMonth() === month && dt.getDay() === dayOfWeek) return d;
    }
    return 31;
  }

  function isUSFederalHoliday(date: Date): boolean {
    const y = date.getFullYear();
    const m = date.getMonth();
    const d = date.getDate();

    if (m === 0 && d === 1) return true; // New Year's Day
    if (m === 0 && d === getNthDayOfMonth(y, 0, 1, 3)) return true; // MLK Day
    if (m === 1 && d === getNthDayOfMonth(y, 1, 1, 3)) return true; // Washington's Birthday
    if (m === 4 && d === getLastDayOfMonth(y, 4, 1)) return true; // Memorial Day
    if (m === 5 && d === 19) return true; // Juneteenth
    if (m === 6 && d === 4) return true; // Independence Day
    if (m === 8 && d === getNthDayOfMonth(y, 8, 1, 1)) return true; // Labor Day
    if (m === 9 && d === getNthDayOfMonth(y, 9, 1, 2)) return true; // Columbus Day
    if (m === 10 && d === 11) return true; // Veterans Day
    if (m === 10 && d === getNthDayOfMonth(y, 10, 4, 4)) return true; // Thanksgiving Day
    if (m === 11 && d === 25) return true; // Christmas Day

    return false;
  }

  // State
  let activeTab = 'chrono';
  let customHolidays: string[] = [];
  let holidayRegion = 'us';

  // Formatting helpers
  const formatNum = (n: number): string => n.toLocaleString();

  // Populate Dropdown Select Helpers
  function populateDaySelect(monthSelect: HTMLSelectElement, daySelect: HTMLSelectElement, yearInput: HTMLInputElement) {
    const month = parseInt(monthSelect.value);
    const year = parseInt(yearInput.value) || new Date().getFullYear();
    const currentVal = daySelect.value;
    
    daySelect.innerHTML = '<option value="">Day</option>';
    let daysInMonth = 31;
    if (!isNaN(month)) {
      daysInMonth = new Date(year, month + 1, 0).getDate();
    }
    for (let i = 1; i <= daysInMonth; i++) {
      const opt = document.createElement('option');
      opt.value = String(i);
      opt.textContent = String(i);
      daySelect.appendChild(opt);
    }
    if (currentVal && parseInt(currentVal) <= daysInMonth) {
      daySelect.value = currentVal;
    }
  }

  function populateHourMinuteSelects(hourSelect: HTMLSelectElement, minuteSelect: HTMLSelectElement) {
    hourSelect.innerHTML = '<option value="">Hour</option>';
    for (let i = 0; i < 24; i++) {
      const opt = document.createElement('option');
      opt.value = String(i);
      const isPm = i >= 12;
      const displayHour = i % 12 === 0 ? 12 : i % 12;
      opt.textContent = `${displayHour} ${isPm ? 'PM' : 'AM'} (${String(i).padStart(2, '0')})`;
      hourSelect.appendChild(opt);
    }

    minuteSelect.innerHTML = '<option value="">Minute</option>';
    for (let i = 0; i < 60; i++) {
      const opt = document.createElement('option');
      opt.value = String(i);
      opt.textContent = String(i).padStart(2, '0');
      minuteSelect.appendChild(opt);
    }
  }

  // Sync Calendar Trigger to Native Hidden Input
  function setupCalendarSync(triggerId: string, pickerId: string, monthId: string, dayId: string, yearId: string) {
    const trigger = document.getElementById(triggerId);
    const picker = document.getElementById(pickerId) as HTMLInputElement;
    const monthSelect = document.getElementById(monthId) as HTMLSelectElement;
    const daySelect = document.getElementById(dayId) as HTMLSelectElement;
    const yearInput = document.getElementById(yearId) as HTMLInputElement;

    if (!trigger || !picker) return;

    trigger.addEventListener('click', () => {
      picker.showPicker();
    });

    picker.addEventListener('change', () => {
      if (!picker.value) return;
      const [y, m, d] = picker.value.split('-').map(Number);
      yearInput.value = String(y);
      monthSelect.value = String(m - 1);
      populateDaySelect(monthSelect, daySelect, yearInput);
      daySelect.value = String(d);
    });
  }

  // Setup Date Listeners to keep day counts correct
  function setupDateChangeListeners(monthId: string, dayId: string, yearId: string) {
    const monthSelect = document.getElementById(monthId) as HTMLSelectElement;
    const daySelect = document.getElementById(dayId) as HTMLSelectElement;
    const yearInput = document.getElementById(yearId) as HTMLInputElement;

    monthSelect?.addEventListener('change', () => populateDaySelect(monthSelect, daySelect, yearInput));
    yearInput?.addEventListener('input', () => populateDaySelect(monthSelect, daySelect, yearInput));
  }

  // Initialize dropdown options on load
  const todayDateObj = new Date();
  
  // Tab 1: Chronological inputs
  const birthMonth = document.getElementById('birth-month') as HTMLSelectElement;
  const birthDay = document.getElementById('birth-day') as HTMLSelectElement;
  const birthYear = document.getElementById('birth-year') as HTMLInputElement;
  const birthHour = document.getElementById('birth-hour') as HTMLSelectElement;
  const birthMinute = document.getElementById('birth-minute') as HTMLSelectElement;
  
  const toMonth = document.getElementById('to-month') as HTMLSelectElement;
