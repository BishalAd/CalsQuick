  // ─── TAB 2: DAYS BETWEEN TWO DATES (ctype=2) ───
  function createCalendarMonthCard(year: number, month: number, startDate: Date, endDate: Date): HTMLElement {
    const card = document.createElement('div');
    card.style.background = 'var(--color-canvas-soft-2)';
    card.style.border = '1px solid var(--color-hairline)';
    card.style.borderRadius = 'var(--radius-md)';
    card.style.padding = '12px';

    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    
    const title = document.createElement('div');
    title.style.fontSize = '13.5px';
    title.style.fontWeight = '600';
    title.style.textAlign = 'center';
    title.style.marginBottom = '8px';
    title.style.color = 'var(--color-ink)';
    title.textContent = `${monthNames[month]} ${year}`;
    card.appendChild(title);

    const firstDay = new Date(year, month, 1).getDay();
    const totalDays = new Date(year, month + 1, 0).getDate();

    let html = '<div class="calendar-grid-container">';
    const dayHeaders = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    dayHeaders.forEach(h => {
      html += `<div class="calendar-day-header">${h}</div>`;
    });

    for (let i = 0; i < firstDay; i++) {
      html += '<div class="calendar-day-cell empty"></div>';
    }

    // Strip times for date comparison
    const sTime = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate()).getTime();
    const eTime = new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate()).getTime();

    for (let d = 1; d <= totalDays; d++) {
      const curDate = new Date(year, month, d);
      const curTime = curDate.getTime();
      const dayOfWeek = curDate.getDay();
      const isW = (dayOfWeek === 0 || dayOfWeek === 6);

      // Check if this day is a holiday
      const yStr = year;
      const mStr = String(month + 1).padStart(2, '0');
      const dStr = String(d).padStart(2, '0');
      const dateStr = `${yStr}-${mStr}-${dStr}`;
      const isCustomH = customHolidays.includes(dateStr);
      const isRegionH = (holidayRegion === 'us' && isUSFederalHoliday(curDate));
      const isHoliday = !isW && (isCustomH || isRegionH);

      let classes = ['calendar-day-cell'];
      if (isW) classes.push('weekend');
      if (isHoliday) classes.push('holiday');

      if (curTime === sTime) {
        classes.push('range-start');
      } else if (curTime === eTime) {
        classes.push('range-end');
      } else if (curTime > sTime && curTime < eTime) {
        classes.push('range');
      }

      // Format title tooltip with holiday name or weekend info if applicable
      let cellTitle = '';
      if (isHoliday) {
        cellTitle = 'Holiday';
      } else if (isW) {
        cellTitle = 'Weekend';
      }

      html += `<div class="${classes.join(' ')}" title="${cellTitle}">${d}</div>`;
    }

    html += '</div>';
    
    const gridContainer = document.createElement('div');
    gridContainer.innerHTML = html;
    card.appendChild(gridContainer.firstChild!);

    return card;
  }

  function renderCalendarsForRange(d1: Date, d2: Date) {
    const container = document.getElementById('diff-calendars-grid');
    if (!container) return;

    // Reset container HTML
    container.innerHTML = '';

    const sameMonth = d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth();

    if (sameMonth) {
      // Create single card
      const card = createCalendarMonthCard(d1.getFullYear(), d1.getMonth(), d1, d2);
      container.appendChild(card);
      // Make it 1 column wide on CSS
      container.style.gridTemplateColumns = '1fr';
    } else {
      // Create two cards: Start Month and End Month
      const cardStart = createCalendarMonthCard(d1.getFullYear(), d1.getMonth(), d1, d2);
      const cardEnd = createCalendarMonthCard(d2.getFullYear(), d2.getMonth(), d1, d2);
      container.appendChild(cardStart);
      container.appendChild(cardEnd);
      // Responsive grid columns
      container.style.gridTemplateColumns = ''; // fall back to CSS grid rules
    }
  }

  function renderCustomHolidaysList() {
    const container = document.getElementById('custom-holidays-list');
    if (!container) return;

    if (customHolidays.length === 0) {
      container.innerHTML = '<span style="font-size: 12px; color: var(--color-muted); padding: 6px;">No custom holidays added yet.</span>';
      return;
    }

    container.innerHTML = '';
    customHolidays.forEach(dateStr => {
      const badge = document.createElement('span');
      badge.className = 'badge-holiday';
      const formattedDate = new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      badge.innerHTML = `<span>${formattedDate}</span><button type="button" data-val="${dateStr}">✕</button>`;
      container.appendChild(badge);

      badge.querySelector('button')?.addEventListener('click', (e) => {
        const val = (e.currentTarget as HTMLButtonElement).dataset.val;
        if (val) {
          customHolidays = customHolidays.filter(item => item !== val);
          renderCustomHolidaysList();
          calculateDiff(true); // Recalculate diff instantly
        }
      });
    });
  }

  function calculateDiff(shouldUpdateUrl = true) {
    hideError();
    const d1 = parseDateFromGroup(diffStartMonth, diffStartDay, diffStartYear, birthHour, birthMinute); // use dummy hours
    const d2 = parseDateFromGroup(diffEndMonth, diffEndDay, diffEndYear, birthHour, birthMinute);

    if (!d1) {
      showError('Please select a valid start date.');
      return;
    }
    if (!d2) {
      showError('Please select a valid end date.');
      return;
    }
    if (d1 > d2) {
      showError('Start date cannot be after the end date.');
      return;
    }

    const includeEnd = diffIncludeEnd.checked;

    // Run business, weekend, and holiday calculations day-by-day
    let weekends = 0;
    let holidays = 0;
    let bizdays = 0;

    const startVal = d1.getTime();
    const endVal = d2.getTime();
    const totalMsDiff = endVal - startVal;
    
    // Calendar days count
    const totalCalendarDays = Math.round(totalMsDiff / 86400000) + (includeEnd ? 1 : 0);
    const limit = Math.round(totalMsDiff / 86400000);
    const endLimit = includeEnd ? limit : limit - 1;

    for (let i = 0; i <= endLimit; i++) {
      const current = new Date(d1.getFullYear(), d1.getMonth(), d1.getDate() + i);
      const w = current.getDay();
      const isW = (w === 0 || w === 6);

      const yStr = current.getFullYear();
      const mStr = String(current.getMonth() + 1).padStart(2, '0');
      const dStr = String(current.getDate()).padStart(2, '0');
      const dateStr = `${yStr}-${mStr}-${dStr}`;

      const isCustomH = customHolidays.includes(dateStr);
      const isRegionH = (holidayRegion === 'us' && isUSFederalHoliday(current));
      const isH = !isW && (isCustomH || isRegionH);

      if (isW) {
        weekends++;
      } else if (isH) {
        holidays++;
      } else {
        bizdays++;
      }
    }

    // Elapsed breakdown (Years, Months, Days)
    let years = d2.getFullYear() - d1.getFullYear();
    let months = d2.getMonth() - d1.getMonth();
    let days = d2.getDate() - d1.getDate();

    if (includeEnd) {
      days += 1;
    }

    if (days < 0) {
      months--;
      const prevMonth = new Date(d2.getFullYear(), d2.getMonth(), 0);
      days += prevMonth.getDate();
    }
    if (months < 0) {
      years--;
      months += 12;
    }

    const daysInTargetMonth = new Date(d2.getFullYear(), d2.getMonth() + 1, 0).getDate();
    if (days >= daysInTargetMonth) {
      months++;
      days -= daysInTargetMonth;
    }
    if (months >= 12) {
      years++;
      months -= 12;
    }

    const totalMonths = years * 12 + months;
    const totalWeeks = Math.floor(totalCalendarDays / 7);
    const remainingDays = totalCalendarDays % 7;

    // Render output
    const fmtLongDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    document.getElementById('diff-summary-title')!.textContent = `Difference between ${fmtLongDate(d1)} and ${fmtLongDate(d2)}:`;
    document.getElementById('diff-summary-subtitle')!.textContent = includeEnd ? 'Including the end date (adds 1 day).' : 'Excluding the end date.';

    let mainValueText = '';
    if (years > 0) mainValueText += `${years} year${years > 1 ? 's' : ''} `;
    if (months > 0) mainValueText += `${months} month${months > 1 ? 's' : ''} `;
    mainValueText += `${days} day${days !== 1 ? 's' : ''}`;
    document.getElementById('diff-main-value')!.textContent = mainValueText;

    document.getElementById('diff-alt-months')!.textContent = `${formatNum(totalMonths)} month${totalMonths !== 1 ? 's' : ''} ${days} day${days !== 1 ? 's' : ''}`;
    document.getElementById('diff-alt-weeks')!.textContent = `${formatNum(totalWeeks)} week${totalWeeks !== 1 ? 's' : ''} ${remainingDays} day${remainingDays !== 1 ? 's' : ''}`;
    document.getElementById('diff-alt-days')!.textContent = `${formatNum(totalCalendarDays)} calendar day${totalCalendarDays !== 1 ? 's' : ''}`;

    document.getElementById('diff-stat-weekends')!.textContent = formatNum(weekends);
    document.getElementById('diff-stat-holidays')!.textContent = formatNum(holidays);
    document.getElementById('diff-stat-bizdays')!.textContent = formatNum(bizdays);

    // Renders visual calendar grids
    renderCalendarsForRange(d1, d2);

    diffResults.hidden = false;
    diffResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (shouldUpdateUrl) {
      const startStr = `${diffStartYear.value}-${String(parseInt(diffStartMonth.value) + 1).padStart(2, '0')}-${String(diffStartDay.value).padStart(2, '0')}`;
      const endStr = `${diffEndYear.value}-${String(parseInt(diffEndMonth.value) + 1).padStart(2, '0')}-${String(diffEndDay.value).padStart(2, '0')}`;
      
      updateUrl({
        startdate: startStr,
        enddate: endStr,
        includeend: includeEnd ? '1' : '0',
        ctype: '2',
        x: 'Calculate'
      });
    }
  }

  document.getElementById('calc-diff-btn')?.addEventListener('click', () => calculateDiff(true));
  document.getElementById('reset-diff-btn')?.addEventListener('click', () => {
    diffStartMonth.value = '';
    diffStartDay.value = '';
