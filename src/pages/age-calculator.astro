  // ─── CHRONOLOGICAL AGE CALCULATION LOGIC (ctype=1) ───
  function parseDateFromGroup(monthEl: HTMLSelectElement, dayEl: HTMLSelectElement, yearEl: HTMLInputElement, hourEl: HTMLSelectElement, minuteEl: HTMLSelectElement): Date | null {
    const m = parseInt(monthEl.value);
    const d = parseInt(dayEl.value);
    const y = parseInt(yearEl.value);
    const h = parseInt(hourEl.value) || 0;
    const min = parseInt(minuteEl.value) || 0;

    if (isNaN(m) || isNaN(d) || isNaN(y)) return null;
    const date = new Date(y, m, d, h, min);
    if (date.getFullYear() !== y || date.getMonth() !== m || date.getDate() !== d) return null;
    return date;
  }

  function calculateChrono(shouldUpdateUrl = true) {
    hideError();
    const birthDateObj = parseDateFromGroup(birthMonth, birthDay, birthYear, birthHour, birthMinute);
    const targetDateObj = parseDateFromGroup(toMonth, toDay, toYear, toHour, toMinute);

    if (!birthDateObj) {
      showError('Please select a valid birth date.');
      return;
    }
    if (!targetDateObj) {
      showError('Please select a valid target calculation date.');
      return;
    }
    if (birthDateObj > targetDateObj) {
      showError('Birth date cannot be in the future of the target calculation date.');
      return;
    }

    let years = targetDateObj.getFullYear() - birthDateObj.getFullYear();
    let months = targetDateObj.getMonth() - birthDateObj.getMonth();
    let days = targetDateObj.getDate() - birthDateObj.getDate();
    let hours = targetDateObj.getHours() - birthDateObj.getHours();
    let minutes = targetDateObj.getMinutes() - birthDateObj.getMinutes();

    if (minutes < 0) {
      hours--;
      minutes += 60;
    }
    if (hours < 0) {
      days--;
      hours += 24;
    }
    if (days < 0) {
      months--;
      const prevMonth = new Date(targetDateObj.getFullYear(), targetDateObj.getMonth(), 0);
      days += prevMonth.getDate();
    }
    if (months < 0) {
      years--;
      months += 12;
    }

    const msPerMin = 60000;
    const totalMs = targetDateObj.getTime() - birthDateObj.getTime();
    const totalSeconds = Math.floor(totalMs / 1000);
    const totalMinutes = Math.floor(totalMs / msPerMin);
    const totalHours = Math.floor(totalMinutes / 60);
    const totalDays = Math.floor(totalHours / 24);
    const totalWeeks = Math.floor(totalDays / 7);
    const totalMonths = years * 12 + months;

    // Next Birthday countdown
    let nextBday = new Date(targetDateObj.getFullYear(), birthDateObj.getMonth(), birthDateObj.getDate(), birthDateObj.getHours(), birthDateObj.getMinutes());
    if (nextBday <= targetDateObj) {
      nextBday = new Date(targetDateObj.getFullYear() + 1, birthDateObj.getMonth(), birthDateObj.getDate(), birthDateObj.getHours(), birthDateObj.getMinutes());
    }
    const bdayMsDiff = nextBday.getTime() - targetDateObj.getTime();
    const bdayDays = Math.floor(bdayMsDiff / 86400000);
    const bdayHours = Math.floor((bdayMsDiff % 86400000) / 3600000);
    const bdayMins = Math.floor((bdayMsDiff % 3600000) / 60000);

    // Zodiac sign
    const m = birthDateObj.getMonth() + 1;
    const d = birthDateObj.getDate();
    const zodiacs = [
      [1, 20, 'Aquarius'], [2, 19, 'Pisces'], [3, 21, 'Aries'], [4, 20, 'Taurus'],
      [5, 21, 'Gemini'], [6, 21, 'Cancer'], [7, 23, 'Leo'], [8, 23, 'Virgo'],
      [9, 23, 'Libra'], [10, 23, 'Scorpio'], [11, 22, 'Sagittarius'], [12, 22, 'Capricorn']
    ];
    let zodiac = 'Capricorn';
    for (const [zm, zd, zn] of zodiacs) {
      if (m === zm && d >= (zd as number)) { zodiac = zn as string; break; }
      if (m === zm - 1 && d < (zd as number)) { zodiac = zn as string; break; }
    }

    // Render results
    (document.getElementById('age-years') as HTMLElement).textContent = String(years);
    
    let detailText = `${years} years, ${months} months, ${days} days`;
    if (birthHour.value || birthMinute.value || toHour.value || toMinute.value) {
      detailText += `, ${hours} hours, ${minutes} minutes`;
    }
    (document.getElementById('age-detail') as HTMLElement).textContent = detailText;
    
    (document.getElementById('stat-months') as HTMLElement).textContent = formatNum(totalMonths);
    (document.getElementById('stat-weeks') as HTMLElement).textContent = formatNum(totalWeeks);
    (document.getElementById('stat-days') as HTMLElement).textContent = formatNum(totalDays);
    (document.getElementById('stat-hours') as HTMLElement).textContent = formatNum(totalHours);
    (document.getElementById('stat-minutes') as HTMLElement).textContent = formatNum(totalMinutes);
    (document.getElementById('stat-seconds') as HTMLElement).textContent = formatNum(totalSeconds);
    
    (document.getElementById('next-bday') as HTMLElement).textContent = nextBday.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + (birthHour.value ? ` at ${nextBday.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}` : '');
    
    let countdownText = `${bdayDays} days`;
    if (birthHour.value || birthMinute.value || toHour.value || toMinute.value) {
      countdownText += `, ${bdayHours} hours, ${bdayMins} mins`;
    }
    (document.getElementById('days-until-bday') as HTMLElement).textContent = countdownText;
    (document.getElementById('zodiac') as HTMLElement).textContent = zodiac;

    chronoResults.hidden = false;
    chronoResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (shouldUpdateUrl) {
      const birthStr = `${birthYear.value}-${String(parseInt(birthMonth.value) + 1).padStart(2, '0')}-${String(birthDay.value).padStart(2, '0')}`;
      const birthTimeStr = birthHour.value ? `${String(birthHour.value).padStart(2, '0')}:${String(birthMinute.value || 0).padStart(2, '0')}` : '';
      const toStr = `${toYear.value}-${String(parseInt(toMonth.value) + 1).padStart(2, '0')}-${String(toDay.value).padStart(2, '0')}`;
      const toTimeStr = toHour.value ? `${String(toHour.value).padStart(2, '0')}:${String(toMinute.value || 0).padStart(2, '0')}` : '';

      updateUrl({
        birthdate: birthStr,
        birthtime: birthTimeStr,
        todate: toStr,
        totime: toTimeStr,
        ctype: '1',
        x: 'Calculate'
      });
    }
  }

