---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { q: 'Age calculator how old am i', a: 'To find out exactly how old you are, simply input your birthdate into our online age calculator. It will instantly show your chronological age in years, months, days, hours, and seconds.' },
  { q: 'What is my age calculator', a: 'Our "what is my age calculator" is a tool designed to measure the precise amount of time that has elapsed since your birth, providing a highly detailed breakdown of your life duration.' },
  { q: 'How old am i', a: 'You can discover "how old am i" by entering your exact day, month, and year of birth above. The tool handles all calendar math automatically, including leap years, to give you your exact age.' },
  { q: 'What is my age', a: 'To calculate "what is my age", use our date of birth age calculator to subtract your birth date from the current date. It will tell you your exact age down to the second.' },
  { q: 'Calculate my age', a: 'You can calculate your age by using our free online chronological calculator, which computes the precise interval between your birth date and today.' },
  { q: 'Age calculator by date of birth', a: 'Yes! Our tool is a dedicated age calculator by date of birth. Simply choose your birth month, day, and year to get started.' },
  { q: 'Age calculator today', a: 'The age calculator today uses the current date and time as the target date, giving you a real-time snapshot of your exact age at this very moment.' },
  { q: 'Online age calculator', a: 'Yes, this is a 100% free online age calculator that works on any web browser on both mobile and desktop devices without requiring any app install.' },
  { q: 'Exact age calculator', a: 'This exact age calculator matches standard legal calendar rules, accounting for leap years and the varying number of days in each calendar month.' },
  { q: 'Date of birth age calculator', a: 'A date of birth age calculator is the only way to calculate chronological age accurately for job applications, school admissions, and official documents.' }
];

const schemas = [
  generateSoftwareApplication({ name: 'Age Calculator', description: 'Free online age calculator that shows your exact age in years, months, days, hours, and minutes with birthday countdown.', url: '/age-calculator' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'BMI Calculator', href: '/bmi-calculator', icon: '⚖️', desc: 'Calculate your body mass index' },
  { name: 'Calorie Calculator', href: '/calorie-calculator', icon: '🔥', desc: 'Find your daily calorie needs' },
  { name: 'Tip Calculator', href: '/tip-calculator', icon: '💰', desc: 'Split the bill perfectly' },
];
---

<CalculatorLayout
  title="Age Calculator — Chronological Age Calculator Online"
  description="Free chronological age calculator to find your exact age on date of birth, today, or a specific date. Calculate your age in years, months, days, and hours."
  canonical="/age-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Age Calculator', url: '/age-calculator' }]}
  relatedCalcs={relatedCalcs}
>
  <!-- Header -->
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Health Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Age Calculator</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Find your exact age in years, months, days — with optional time of birth for precise hours and minutes.
    </p>
  </div>

  <!-- Calculator Panel with Tabs -->
  <div class="calc-panel fade-up stagger-1" id="age-calculator-container">
    <!-- Tabs Switcher -->
    <div class="calc-tabs" role="tablist" aria-label="Age Calculator Modes">
      <button class="tab-btn active" role="tab" aria-selected="true" aria-controls="panel-chrono" id="tab-chrono" type="button">
        📅 Chronological Age
      </button>
      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="panel-diff" id="tab-diff" type="button">
        ⏳ Days Between Dates
      </button>
      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="panel-addsub" id="tab-addsub" type="button">
        ➕ Add/Subtract Date
      </button>
    </div>

    <!-- TAB 1: Chronological Age Panel -->
    <div id="panel-chrono" class="tab-content">
      <div class="calc-form">
        <div class="form-row">
          <div class="form-field">
            <label class="label">Date of Birth</label>
            <div class="date-select-group">
              <select id="birth-month" class="input-base" style="flex: 1.8; min-width: 95px; padding-right: 16px;" aria-label="Birth month">
                <option value="">Month</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
              <select id="birth-day" class="input-base" style="flex: 1; min-width: 60px; padding-right: 16px;" aria-label="Birth day">
                <option value="">Day</option>
                <!-- Filled via js -->
              </select>
              <input type="number" id="birth-year" class="input-base" placeholder="Year" style="flex: 1.2; min-width: 70px; padding-right: 12px;" min="1" max="9999" aria-label="Birth year" />
              <input type="date" id="birth-picker-hidden" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" />
              <button type="button" id="birth-calendar-btn" class="btn-secondary" style="padding: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;" aria-label="Select birth date from calendar">
                📅
              </button>
            </div>
            <p class="field-hint">Select or type your birth date</p>
          </div>

          <div class="form-field">
            <label class="label">Time of Birth <span style="font-size: 11px; color: var(--color-muted); font-weight: normal; margin-left: 4px;">(Optional)</span></label>
            <div class="time-select-group">
              <select id="birth-hour" class="input-base" style="flex: 1; padding-right: 16px;" aria-label="Birth hour">
                <option value="">Hour</option>
                <!-- Filled via js -->
              </select>
              <span style="color: var(--color-muted); font-weight: bold;">:</span>
              <select id="birth-minute" class="input-base" style="flex: 1; padding-right: 16px;" aria-label="Birth minute">
                <option value="">Minute</option>
                <!-- Filled via js -->
              </select>
            </div>
            <p class="field-hint">Enter your birth time</p>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label class="label">Calculate Age On</label>
            <div class="date-select-group">
              <select id="to-month" class="input-base" style="flex: 1.8; min-width: 95px; padding-right: 16px;" aria-label="Target month">
                <option value="">Month</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
              <select id="to-day" class="input-base" style="flex: 1; min-width: 60px; padding-right: 16px;" aria-label="Target day">
                <option value="">Day</option>
                <!-- Filled via js -->
              </select>
              <input type="number" id="to-year" class="input-base" placeholder="Year" style="flex: 1.2; min-width: 70px; padding-right: 12px;" min="1" max="9999" aria-label="Target year" />
              <input type="date" id="to-picker-hidden" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" />
              <button type="button" id="to-calendar-btn" class="btn-secondary" style="padding: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;" aria-label="Select target date from calendar">
                📅
              </button>
            </div>
            <p class="field-hint">Defaults to today</p>
          </div>

          <div class="form-field">
            <label class="label">Target Time <span style="font-size: 11px; color: var(--color-muted); font-weight: normal; margin-left: 4px;">(Optional)</span></label>
            <div class="time-select-group">
              <select id="to-hour" class="input-base" style="flex: 1; padding-right: 16px;" aria-label="Target hour">
                <option value="">Hour</option>
                <!-- Filled via js -->
              </select>
              <span style="color: var(--color-muted); font-weight: bold;">:</span>
              <select id="to-minute" class="input-base" style="flex: 1; padding-right: 16px;" aria-label="Target minute">
                <option value="">Minute</option>
                <!-- Filled via js -->
              </select>
            </div>
            <p class="field-hint">Defaults to current time</p>
          </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 12px;">
          <button id="calc-chrono-btn" class="btn-primary" style="flex: 1;" aria-label="Calculate age">
            Calculate Age
          </button>
          <button id="reset-chrono-btn" class="btn-secondary" aria-label="Reset fields">
            Clear
          </button>
        </div>
      </div>
    </div>

    <!-- TAB 2: Days Between Dates Panel -->
    <div id="panel-diff" class="tab-content" style="display: none;">
      <div class="calc-form">
        <div class="form-row">
          <div class="form-field">
            <label class="label">Start Date</label>
            <div class="date-select-group">
              <select id="diff-start-month" class="input-base" style="flex: 1.8; min-width: 95px; padding-right: 16px;" aria-label="Start month">
                <option value="">Month</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
              <select id="diff-start-day" class="input-base" style="flex: 1; min-width: 60px; padding-right: 16px;" aria-label="Start day">
                <option value="">Day</option>
                <!-- Filled via js -->
              </select>
              <input type="number" id="diff-start-year" class="input-base" placeholder="Year" style="flex: 1.2; min-width: 70px; padding-right: 12px;" min="1" max="9999" aria-label="Start year" />
              <input type="date" id="diff-start-picker-hidden" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" />
              <button type="button" id="diff-start-calendar-btn" class="btn-secondary" style="padding: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;" aria-label="Select start date from calendar">
                📅
              </button>
            </div>
          </div>

          <div class="form-field">
            <label class="label">End Date</label>
            <div class="date-select-group">
              <select id="diff-end-month" class="input-base" style="flex: 1.8; min-width: 95px; padding-right: 16px;" aria-label="End month">
                <option value="">Month</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
              <select id="diff-end-day" class="input-base" style="flex: 1; min-width: 60px; padding-right: 16px;" aria-label="End day">
                <option value="">Day</option>
                <!-- Filled via js -->
              </select>
              <input type="number" id="diff-end-year" class="input-base" placeholder="Year" style="flex: 1.2; min-width: 70px; padding-right: 12px;" min="1" max="9999" aria-label="End year" />
              <input type="date" id="diff-end-picker-hidden" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" />
              <button type="button" id="diff-end-calendar-btn" class="btn-secondary" style="padding: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;" aria-label="Select end date from calendar">
                📅
              </button>
            </div>
          </div>
        </div>

        <div style="margin-top: 4px;">
          <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; cursor: pointer; color: var(--color-body); user-select: none;">
            <input type="checkbox" id="diff-include-end" style="width: 16px; height: 16px; accent-color: var(--color-link);" />
            <span>Include end date in calculation (add 1 day)</span>
          </label>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 16px;">
          <button id="calc-diff-btn" class="btn-primary" style="flex: 1;" aria-label="Calculate difference">
            Calculate Difference
          </button>
          <button id="reset-diff-btn" class="btn-secondary" aria-label="Reset fields">
            Clear
          </button>
        </div>
      </div>
    </div>

    <!-- TAB 3: Add / Subtract Date Panel -->
    <div id="panel-addsub" class="tab-content" style="display: none;">
      <div class="calc-form">
        <div class="form-row">
          <div class="form-field" style="grid-column: span 2;">
            <label class="label">Base Date</label>
            <div class="date-select-group">
              <select id="addsub-month" class="input-base" style="flex: 1.8; min-width: 95px; padding-right: 16px;" aria-label="Base month">
                <option value="">Month</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
              <select id="addsub-day" class="input-base" style="flex: 1; min-width: 60px; padding-right: 16px;" aria-label="Base day">
                <option value="">Day</option>
                <!-- Filled via js -->
              </select>
              <input type="number" id="addsub-year" class="input-base" placeholder="Year" style="flex: 1.2; min-width: 70px; padding-right: 12px;" min="1" max="9999" aria-label="Base year" />
              <input type="date" id="addsub-picker-hidden" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;" />
              <button type="button" id="addsub-calendar-btn" class="btn-secondary" style="padding: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;" aria-label="Select base date from calendar">
                📅
              </button>
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="addsub-op" class="label">Action</label>
            <select id="addsub-op" class="input-base input-lg" aria-label="Add or subtract operation">
              <option value="add">➕ Add</option>
              <option value="subtract">➖ Subtract</option>
            </select>
          </div>
          <div class="form-field">
            <label for="addsub-years" class="label">Years</label>
            <input type="number" id="addsub-years" class="input-base input-lg" value="0" min="0" />
          </div>
        </div>

        <div class="form-row form-row-3" style="gap: 12px;">
          <div class="form-field">
            <label for="addsub-months" class="label">Months</label>
            <input type="number" id="addsub-months" class="input-base input-lg" value="0" min="0" />
          </div>
          <div class="form-field">
            <label for="addsub-weeks" class="label">Weeks</label>
            <input type="number" id="addsub-weeks" class="input-base input-lg" value="0" min="0" />
          </div>
          <div class="form-field">
            <label for="addsub-days" class="label">Days</label>
            <input type="number" id="addsub-days" class="input-base input-lg" value="0" min="0" />
          </div>
        </div>

        <div style="margin-top: 4px;">
          <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; cursor: pointer; color: var(--color-body); user-select: none;">
            <input type="checkbox" id="addsub-bizonly" style="width: 16px; height: 16px; accent-color: var(--color-link);" />
            <span>Calculate using business days only (skips weekends/holidays)</span>
          </label>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 16px;">
          <button id="calc-addsub-btn" class="btn-primary" style="flex: 1;" aria-label="Calculate new date">
            Calculate Date
          </button>
          <button id="reset-addsub-btn" class="btn-secondary" aria-label="Reset fields">
            Clear
          </button>
        </div>
      </div>
    </div>

    <!-- General Error Banner -->
    <div id="calc-error" class="calc-error" role="alert" aria-live="polite" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span id="error-msg"></span>
    </div>

    <!-- RESULTS FOR TAB 1: Chronological Age -->
    <div id="calc-results" hidden aria-live="polite" aria-label="Age calculation results">
      <div class="results-divider"></div>

      <!-- Main Result Card -->
      <div class="main-result-card">
        <div class="main-result-value" id="age-years">--</div>
        <div class="main-result-label">Years Old</div>
        <div class="main-result-detail" id="age-detail">-- years, -- months, -- days</div>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid" role="list" aria-label="Age breakdown">
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-months">--</div>
          <div class="stat-label">Total Months</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-weeks">--</div>
          <div class="stat-label">Total Weeks</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-days">--</div>
          <div class="stat-label">Total Days</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-hours">--</div>
          <div class="stat-label">Total Hours</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-minutes">--</div>
          <div class="stat-label">Total Minutes</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-value" id="stat-seconds">--</div>
          <div class="stat-label">Total Seconds</div>
        </div>
      </div>

      <!-- Birthday & Zodiac Table -->
      <div class="result-panel" style="margin-top: 24px;">
        <div class="result-row">
          <span class="result-row-label">🎂 Next Birthday</span>
          <span class="result-row-value" id="next-bday">--</span>
        </div>
        <div class="result-row">
          <span class="result-row-label">⏳ Time Until Birthday</span>
          <span class="result-row-value" id="days-until-bday">--</span>
        </div>
        <div class="result-row" style="border-bottom: none;">
          <span class="result-row-label">⭐ Zodiac Sign</span>
          <span class="result-row-value" id="zodiac">--</span>
        </div>
      </div>
    </div>

    <!-- RESULTS FOR TAB 2: Days Between Dates -->
    <div id="diff-results" hidden aria-live="polite" aria-label="Date difference results" style="margin-top: 24px;">
      <div class="results-divider"></div>
      <h3 style="font-size: 16px; font-weight: 600; color: var(--color-ink); margin-bottom: 4px;" id="diff-summary-title">Difference between dates:</h3>
      <p style="font-size: 13.5px; color: var(--color-muted); margin-bottom: 20px;" id="diff-summary-subtitle"></p>

      <div class="main-result-card" style="margin-bottom: 20px;">
        <div class="main-result-value" id="diff-main-value" style="font-size: 44px; letter-spacing: -1.5px; line-height: 1.2;">--</div>
        <div class="main-result-label">Elapsed Time</div>
      </div>

      <!-- Alternative breakdowns list -->
      <div class="result-panel" style="margin-bottom: 24px;">
        <div class="result-row">
          <span class="result-row-label">📅 Or Months &amp; Days</span>
          <span class="result-row-value" id="diff-alt-months">--</span>
        </div>
        <div class="result-row">
          <span class="result-row-label">📅 Or Weeks &amp; Days</span>
          <span class="result-row-value" id="diff-alt-weeks">--</span>
        </div>
        <div class="result-row" style="border-bottom: none;">
          <span class="result-row-label">📅 Or Total Days</span>
          <span class="result-row-value" id="diff-alt-days">--</span>
        </div>
      </div>

      <!-- Business day details -->
      <h4 style="font-size: 14px; font-weight: 600; color: var(--color-ink); margin-bottom: 12px;">Workweek &amp; Holiday Breakdown:</h4>
      <div class="stats-grid" style="gap: 12px; margin-bottom: 24px;">
        <div class="stat-card" style="padding: 16px 12px;">
          <div class="stat-value" id="diff-stat-weekends" style="font-size: 24px;">--</div>
          <div class="stat-label" style="font-size: 11px;">Weekend Days</div>
        </div>
        <div class="stat-card" style="padding: 16px 12px; position: relative;">
          <div class="stat-value" id="diff-stat-holidays" style="font-size: 24px;">--</div>
          <div class="stat-label" style="font-size: 11px; display: inline-flex; align-items: center; gap: 4px;">
            <span>Holidays</span>
            <button type="button" id="toggle-holidays-btn" style="border: none; background: transparent; padding: 0; color: var(--color-link); cursor: pointer; text-decoration: underline; font-weight: 600; font-family: inherit; font-size: 11px;">(edit)</button>
          </div>
        </div>
        <div class="stat-card" style="padding: 16px 12px; background: var(--color-canvas-soft-2); border: 1px solid var(--color-link-soft);">
          <div class="stat-value" id="diff-stat-bizdays" style="font-size: 24px; color: var(--color-link);">--</div>
          <div class="stat-label" style="font-size: 11px; font-weight: 600; color: var(--color-ink);">Business Days</div>
        </div>
      </div>

      <!-- Holiday Settings Slideout/Dropdown -->
      <div id="holiday-settings-panel" style="margin-top: -12px; margin-bottom: 24px; padding: 16px; background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);" hidden>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h5 style="font-size: 13.5px; font-weight: 600; color: var(--color-ink); margin: 0;">Holiday &amp; Weekend Settings</h5>
          <button type="button" id="close-holidays-btn" style="border: none; background: transparent; font-size: 16px; cursor: pointer; color: var(--color-muted);">✕</button>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: var(--color-muted); display: block; margin-bottom: 6px;">HOLIDAY SCHEME</label>
            <div style="display: flex; gap: 16px; align-items: center;">
