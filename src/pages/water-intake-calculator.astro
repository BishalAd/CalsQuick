<script>
  // ════════════════════════════════════════════
  // STATE
  // ════════════════════════════════════════════
  let weightUnit: 'kg' | 'lb' = 'kg';
  let gender: 'male' | 'female' | 'child' = 'male';
  let activity: string = 'sedentary';
  let climate: string = 'moderate';
  let conditions: Set<string> = new Set();
  let petType: string = 'dog';
  let glassesTotal = 0;
  let glassesFilled = 0;

  // ════════════════════════════════════════════
  // UNIT TOGGLES
  // ════════════════════════════════════════════
  document.querySelectorAll('.unit-btn[data-unit]').forEach(btn => {
    btn.addEventListener('click', () => {
      weightUnit = (btn as HTMLElement).dataset.unit as 'kg' | 'lb';
      document.querySelectorAll('.unit-btn[data-unit]').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  document.querySelectorAll('.unit-btn[data-gender]').forEach(btn => {
    btn.addEventListener('click', () => {
      gender = (btn as HTMLElement).dataset.gender as any;
      document.querySelectorAll('.unit-btn[data-gender]').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  document.querySelectorAll('.activity-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activity = (btn as HTMLElement).dataset.activity!;
      document.querySelectorAll('.activity-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  document.querySelectorAll('.climate-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      climate = (btn as HTMLElement).dataset.climate!;
      document.querySelectorAll('.climate-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  document.querySelectorAll('.condition-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = (btn as HTMLElement).dataset.condition!;
      if (conditions.has(key)) {
        conditions.delete(key);
        btn.classList.remove('active');
        btn.setAttribute('aria-checked', 'false');
      } else {
        conditions.add(key);
        btn.classList.add('active');
        btn.setAttribute('aria-checked', 'true');
      }
    });
  });

  // Exercise slider sync
  const exSlider = document.getElementById('exercise-slider') as HTMLInputElement;
  const exInput = document.getElementById('exercise-min') as HTMLInputElement;
  exSlider.addEventListener('input', () => {
    exInput.value = exSlider.value;
    updateExPresets(parseInt(exSlider.value));
  });
  exInput.addEventListener('input', () => {
    exSlider.value = exInput.value;
    updateExPresets(parseInt(exInput.value));
  });

  function updateExPresets(val: number) {
    document.querySelectorAll('.ex-preset-btn').forEach(b => {
      const bVal = parseInt((b as HTMLElement).dataset.min!);
      b.classList.toggle('active', bVal === val);
    });
  }

  document.querySelectorAll('.ex-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const m = parseInt((btn as HTMLElement).dataset.min!);
      exInput.value = String(m);
      exSlider.value = String(m);
      updateExPresets(m);
    });
  });

  // Pet type
  document.querySelectorAll('.unit-btn[data-pet]').forEach(btn => {
    btn.addEventListener('click', () => {
      petType = (btn as HTMLElement).dataset.pet!;
      document.querySelectorAll('.unit-btn[data-pet]').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  // ════════════════════════════════════════════
  // CALCULATION
  // ════════════════════════════════════════════
  function calcWaterIntake() {
    const errorEl = document.getElementById('water-error') as HTMLElement;
    const resultsEl = document.getElementById('water-results') as HTMLElement;
    errorEl.hidden = true;

    const weightRaw = parseFloat((document.getElementById('weight-input') as HTMLInputElement).value);
    const age = parseFloat((document.getElementById('age-input') as HTMLInputElement).value);
    const exerciseMins = parseFloat(exInput.value) || 0;

    if (!weightRaw || weightRaw <= 0) {
      document.getElementById('water-error-msg')!.textContent = 'Please enter your body weight.';
      errorEl.hidden = false; return;
    }
    if (!age || age <= 0 || age > 120) {
      document.getElementById('water-error-msg')!.textContent = 'Please enter a valid age (1–120).';
      errorEl.hidden = false; return;
    }

    // Convert to kg
    const weightKg = weightUnit === 'lb' ? weightRaw / 2.205 : weightRaw;

    // ── BASE: 35ml/kg, adjust for gender
    let baseMl = weightKg * 35;
    if (gender === 'male') baseMl *= 1.05;
    else if (gender === 'female') baseMl *= 0.95;
    else if (gender === 'child') baseMl = weightKg * 40; // kids need more per kg

    // Age adjustment
    if (age >= 65) baseMl *= 0.9; // seniors need less but are at higher risk
    else if (age < 14) baseMl = weightKg * 40;

    // ── ACTIVITY multiplier (extra ml)
    const activityExtra: Record<string, number> = {
      sedentary: 0, light: 250, moderate: 500, active: 750, athlete: 1000,
    };
    const exerciseExtra = (exerciseMins / 60) * 600; // ~600ml per hour of exercise
    const totalExtraExercise = (activityExtra[activity] || 0) + exerciseExtra;

    // ── CLIMATE extra
    const climateExtra: Record<string, number> = {
      cold: -200, moderate: 0, warm: 400, hot: 800,
    };
    const extraClimate = climateExtra[climate] || 0;

    // ── CONDITIONS extra
    let extraConditions = 0;
    if (conditions.has('pregnant')) extraConditions += 300;
    if (conditions.has('breastfeeding')) extraConditions += 700;
    if (conditions.has('creatine')) extraConditions += 500;
    if (conditions.has('keto')) extraConditions += 400;
    if (conditions.has('kidney')) extraConditions += 500;
    if (conditions.has('caffeine')) extraConditions += 200;

    const totalMl = Math.round(baseMl + totalExtraExercise + extraClimate + extraConditions);
    const totalL = (totalMl / 1000).toFixed(2);
    const totalOz = Math.round(totalMl / 29.574);
    const totalCups = Math.round(totalMl / 250);

    // ── Update hero
    (document.getElementById('res-water-liters') as HTMLElement).textContent = totalL + ' L';
    (document.getElementById('res-water-oz') as HTMLElement).textContent = `${totalOz} oz / ${totalCups} cups`;

    const badges: Record<string, string> = {
      male: 'Personalized for men', female: 'Personalized for women', child: 'Personalized for children'
    };
    (document.getElementById('res-water-badge') as HTMLElement).textContent = badges[gender] || 'Personalized for you';

    // Stats
    (document.getElementById('stat-base') as HTMLElement).textContent = Math.round(baseMl) + ' ml';
    (document.getElementById('stat-exercise') as HTMLElement).textContent = '+' + Math.round(totalExtraExercise) + ' ml';
    (document.getElementById('stat-climate') as HTMLElement).textContent = (extraClimate >= 0 ? '+' : '') + extraClimate + ' ml';
    (document.getElementById('stat-conditions') as HTMLElement).textContent = '+' + extraConditions + ' ml';

    // Drop animation
    const pct = Math.min((totalMl / 4000) * 100, 100);
    const fillY = 98 - (90 * pct / 100);
    const rect = document.getElementById('water-fill-rect');
    const anim = document.getElementById('water-fill-anim');
    const txt = document.getElementById('drop-pct-text');
    if (rect && anim && txt) {
      anim.setAttribute('from', '98');
      anim.setAttribute('to', String(fillY));
      rect.setAttribute('y', String(fillY));
      txt.textContent = Math.round(pct) + '%';
    }

    // Glass tracker
    glassesTotal = totalCups;
    glassesFilled = 0;
    buildGlassTracker(totalCups);

    // Schedule
    buildSchedule(totalMl, exerciseMins > 0);

    // Tip
    let tip = '💡 <strong>Tip:</strong> ';
    if (conditions.has('creatine')) tip += 'You\'re taking creatine — extra water is essential as creatine draws water into muscles. Distribute intake evenly across the day.';
    else if (conditions.has('pregnant')) tip += 'During pregnancy, adequate hydration supports amniotic fluid and nutrient delivery. Carry a water bottle at all times.';
    else if (conditions.has('breastfeeding')) tip += 'Breast milk is ~87% water. Drink a glass of water every time you nurse to stay ahead of your hydration needs.';
    else if (climate === 'hot') tip += 'In hot weather, sip water every 15–20 minutes even if you don\'t feel thirsty. By the time you\'re thirsty, you may already be 1–2% dehydrated.';
    else if (activity === 'athlete') tip += 'Weigh yourself before and after workouts — each 0.5 kg (1 lb) lost = 500 ml of water to replace. Also replenish electrolytes for long sessions.';
    else tip += 'Spread intake evenly throughout the day. Keep a water bottle visible as a reminder. Morning (after waking) and before meals are the most impactful times to drink.';
    (document.getElementById('water-tip-text') as HTMLElement).innerHTML = tip;

    resultsEl.hidden = false;
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Glass Tracker ─────────────────────────────────────────────────────────
  function buildGlassTracker(total: number) {
    const grid = document.getElementById('glasses-grid') as HTMLElement;
    grid.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const el = document.createElement('span');
      el.className = 'glass-item';
      el.textContent = '🥛';
      el.setAttribute('aria-label', `Glass ${i + 1}`);
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.addEventListener('click', () => toggleGlass(el, i));
      el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') toggleGlass(el, i); });
      grid.appendChild(el);
    }
    updateGlassCount();
  }

  function toggleGlass(el: Element, idx: number) {
    const isFilled = el.classList.contains('filled');
    const glasses = document.querySelectorAll('.glass-item');
    // Fill all up to this index, or unfill from this index
    if (!isFilled) {
      for (let i = 0; i <= idx; i++) glasses[i].classList.add('filled');
      glassesFilled = idx + 1;
    } else {
      for (let i = idx; i < glasses.length; i++) glasses[i].classList.remove('filled');
      glassesFilled = idx;
    }
    updateGlassCount();
  }

  function updateGlassCount() {
    const ml = glassesFilled * 250;
    (document.getElementById('glass-count-display') as HTMLElement).textContent = `${glassesFilled} / ${glassesTotal} glasses`;
    (document.getElementById('glass-ml-display') as HTMLElement).textContent = `${ml} ml consumed`;
    const pct = glassesTotal > 0 ? (glassesFilled / glassesTotal) * 100 : 0;
    (document.getElementById('glass-progress-fill') as HTMLElement).style.width = pct + '%';
  }

  document.getElementById('reset-glasses-btn')!.addEventListener('click', () => {
    glassesFilled = 0;
    document.querySelectorAll('.glass-item').forEach(g => g.classList.remove('filled'));
    updateGlassCount();
  });

  // ── Schedule ──────────────────────────────────────────────────────────────
  function buildSchedule(totalMl: number, hasExercise: boolean) {
    const list = document.getElementById('schedule-list') as HTMLElement;
    const slots = [
      { time: '7:00 AM',  pct: 0.10, note: 'Wake up — rehydrate after sleep' },
      { time: '9:00 AM',  pct: 0.10, note: 'Morning — before or with breakfast' },
      { time: '11:00 AM', pct: 0.10, note: 'Mid-morning — keep energy up' },
      { time: '12:30 PM', pct: 0.10, note: 'Before lunch — helps digestion' },
      { time: '2:00 PM',  pct: 0.10, note: 'Early afternoon — beat the slump' },
      { time: '4:00 PM',  pct: 0.10, note: 'Afternoon — refuel before evening' },
      { time: hasExercise ? '5:30 PM' : '6:00 PM', pct: hasExercise ? 0.20 : 0.10, note: hasExercise ? '🏃 Before/during/after exercise' : 'Before dinner' },
      { time: '8:00 PM',  pct: 0.10, note: 'Evening — gentle wind-down' },
      { time: '10:00 PM', pct: 0.10, note: 'Before bed — small amount only' },
    ];

    list.innerHTML = '';
    slots.forEach(s => {
      const ml = Math.round(totalMl * s.pct);
      const item = document.createElement('div');
      item.className = 'schedule-item';
      item.innerHTML = `
        <span class="sched-time">${s.time}</span>
        <span class="sched-amount">${ml} ml</span>
        <span class="sched-note">${s.note}</span>
      `;
      list.appendChild(item);
    });
  }

  // ════════════════════════════════════════════
  // PET CALCULATOR
  // ════════════════════════════════════════════
  document.getElementById('calc-pet-btn')!.addEventListener('click', () => {
    const errorEl = document.getElementById('pet-error') as HTMLElement;
    const resultsEl = document.getElementById('pet-results') as HTMLElement;
    errorEl.hidden = true;

    const pw = parseFloat((document.getElementById('pet-weight') as HTMLInputElement).value);
    if (!pw || pw <= 0) {
      document.getElementById('pet-error-msg')!.textContent = 'Please enter your pet\'s weight in kg.';
      errorEl.hidden = false; return;
    }

    let minMl: number, maxMl: number, icon: string, dehy: string, tip: string;

    if (petType === 'cat') {
      minMl = pw * 40; maxMl = pw * 60;
      icon = '🐈';
      dehy = 'Skin tenting, dry gums, sunken eyes';
      tip = '🐈 Cats often get water from wet food. If feeding dry food only, increase fresh water availability and consider a water fountain — cats prefer running water.';
    } else if (petType === 'puppy') {
      minMl = pw * 70; maxMl = pw * 100;
      icon = '🐶';
      dehy = 'Lethargy, dry gums, loss of skin elasticity';
      tip = '🐶 Puppies need more water per kg than adult dogs due to rapid growth. Ensure fresh water is always available, especially after play and feeding.';
    } else {
      minMl = pw * 50; maxMl = pw * 60;
      icon = '🐕';
      dehy = 'Lethargy, dry/tacky gums, reduced skin elasticity, sunken eyes';
      tip = '🐕 Active or larger dogs in hot weather may need up to 80–100 ml/kg. Monitor water bowl — if it\'s always empty, increase the amount offered.';
    }

    const midMl = Math.round((minMl + maxMl) / 2);
    const cups = (midMl / 250).toFixed(1);

    (document.getElementById('pet-icon-display') as HTMLElement).textContent = icon;
    (document.getElementById('pet-res-ml') as HTMLElement).textContent = `${midMl} ml`;
    (document.getElementById('pet-res-cups') as HTMLElement).textContent = `${cups} cups`;
    (document.getElementById('pet-weight-display') as HTMLElement).textContent = pw + ' kg';
    (document.getElementById('pet-min') as HTMLElement).textContent = Math.round(minMl) + ' ml/day';
    (document.getElementById('pet-max') as HTMLElement).textContent = Math.round(maxMl) + ' ml/day';
    (document.getElementById('pet-dehy') as HTMLElement).textContent = dehy;
    (document.getElementById('pet-tip-text') as HTMLElement).textContent = tip;

    resultsEl.hidden = false;
  });

  document.getElementById('clear-pet-btn')!.addEventListener('click', () => {
    (document.getElementById('pet-weight') as HTMLInputElement).value = '';
    (document.getElementById('pet-results') as HTMLElement).hidden = true;
    (document.getElementById('pet-error') as HTMLElement).hidden = true;
  });

  // ════════════════════════════════════════════
  // MAIN BUTTON + CLEAR
  // ════════════════════════════════════════════
  document.getElementById('calc-water-btn')!.addEventListener('click', calcWaterIntake);
  (document.getElementById('weight-input') as HTMLInputElement).addEventListener('keydown', e => {
    if ((e as KeyboardEvent).key === 'Enter') calcWaterIntake();
  });

  document.getElementById('clear-water-btn')!.addEventListener('click', () => {
    (document.getElementById('weight-input') as HTMLInputElement).value = '';
    (document.getElementById('age-input') as HTMLInputElement).value = '';
    exInput.value = '0';
    exSlider.value = '0';
    updateExPresets(0);
    conditions.clear();
    document.querySelectorAll('.condition-btn').forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-checked', 'false');
    });
    (document.getElementById('water-results') as HTMLElement).hidden = true;
    (document.getElementById('water-error') as HTMLElement).hidden = true;
  });

  // ════════════════════════════════════════════
  // FAQ
  // ════════════════════════════════════════════
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
