---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { q: 'What is a password manager?', a: 'A password manager is a tool that securely stores and manages your passwords, allowing you to use strong, unique passwords for each account without needing to remember them all.' },
  { q: 'Why should I use a password manager?', a: 'Using a password manager improves security by enabling strong, unique passwords for every site, reduces password reuse, and protects against phishing and data breaches.' },
  { q: 'Is my data safe with this password manager?', a: 'This password manager performs all operations locally in your browser. No data is sent to any server, and your passwords never leave your device.' },
  { q: 'Can I generate strong passwords?', a: 'Yes, the tool includes a strong password generator that creates random, high-entropy passwords based on your length and complexity preferences.' },
  { q: 'What happens if I forget my master password?', a: 'Since the tool stores data only locally and does not transmit it, there is no recovery mechanism. If you forget your master password, you will lose access to stored passwords.' },
];

const schemas = [
  generateSoftwareApplication({ name: 'Password Manager', description: 'Free, offline password manager that runs entirely in your browser. Store, generate, and manage passwords securely without any data leaving your device.', url: '/password-manager' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Word Counter', href: '/word-counter', icon: '📝', desc: 'Count words, characters, and paragraphs' },
  { name: 'JSON Formatter', href: '/json-formatter', icon: '{}', desc: 'Validate and beautify JSON data' },
  { name: 'Online Ruler', href: '/online-ruler', icon: '📏', desc: 'Measure objects on your screen' },
];

---
<CalculatorLayout
  title="Password Manager — Free Offline Password Generator & Vault"
  description="Free, client-side password manager that runs entirely in your browser. Generate strong passwords, store them securely, and never worry about data leaving your device."
  canonical="/password-manager"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Password Manager', url: '/password-manager' }]}
  relatedCalcs={relatedCalcs}
>
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Productivity Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Password Manager</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Manage your passwords securely with this free, offline tool. All data stays in your browser — no servers, no tracking, no risk.
    </p>
  </div>

  <div class="calc-panel fade-up stagger-1" id="password-manager">
    <div class="calc-form">
      <!-- Master Password -->
      <div class="form-row">
        <div class="form-field">
          <label for="master-password" class="label">Master Password <span style="font-size: 11px; color: var(--color-muted); font-weight: normal; margin-left: 4px;">(Optional)</span></label>
          <input type="password" id="master-password" class="input-base input-lg" placeholder="Enter master password to lock vault" aria-label="Master password" />
        </div>
      </div>

      <!-- Password Generator -->
      <div class="form-row">
        <div class="form-field">
          <label for="pass-length" class="label">Password Length</label>
          <input type="number" id="pass-length" class="input-base input-lg" value="16" min="4" max="64" aria-label="Password length" />
        </div>
        <div class="form-field">
          <label for="pass-options" class="label">Options</label>
          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <label class="checkbox-label"><input type="checkbox" id="include-uppercase" checked> A-Z</label>
            <label class="checkbox-label"><input type="checkbox" id="include-lowercase" checked> a-z</label>
            <label class="checkbox-label"><input type="checkbox" id="include-numbers" checked> 0-9</label>
            <label class="checkbox-label"><input type="checkbox" id="include-symbols"> !@#</label>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 16px;">
        <button id="generate-pw-btn" class="btn-primary" style="flex: 1;" aria-label="Generate Password">Generate Password</button>
        <button id="clear-pw-btn" class="btn-secondary" aria-label="Clear">Clear</button>
      </div>

      <!-- Generated Password Display -->
      <div id="generated-password-output" class="result-panel" style="margin-top: 24px; text-align: center; font-family: var(--font-mono); font-size: 20px; letter-spacing: 0.5px; background: var(--color-canvas-soft-2); padding: 16px; border-radius: var(--radius-md); border: 1px solid var(--color-hairline);" hidden>
        <span id="generated-password">———</span>
        <button id="copy-pw-btn" class="btn-secondary btn-sm" style="margin-top: 8px;" aria-label="Copy password">Copy</button>
      </div>
    </div>
  </div>

  <!-- SEO Article Section -->
  <div style="margin-top: 48px;" class="prose-section fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 20px;">The Ultimate Guide to Password Security & Managers</h2>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      In today’s digital world, password security is more important than ever. A strong <strong>password manager</strong> helps you create, store, and use unique, complex passwords for every online account — drastically reducing the risk of credential theft, phishing, and data breaches.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Why Use a Password Manager?</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      The average person manages dozens of online accounts. Reusing passwords across sites creates a single point of failure: if one service is compromised, attackers can try the same credentials elsewhere. A password manager solves this by generating and storing strong, unique passwords for each account, protected by a single master key.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">How Does an Offline Password Manager Work?</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      This tool performs all encryption and storage locally in your browser using the Web Crypto API. Your passwords are encrypted with a key derived from your master password and never transmitted to any server. Even if someone gains access to your device’s storage, decrypting your passwords without the master key is computationally infeasible.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Best Practices for Password Security</h3>
    <ul style="margin-left: 20px; margin-bottom: 16px; color: var(--color-body); line-height: 26px; font-size: 15px; display: flex; flex-direction: column; gap: 8px;">
      <li><strong>Use a strong master password:</strong> Choose a passphrase of at least 12–16 characters that combines words, numbers, and symbols.</li>
      <li><strong>Enable two-factor authentication (2FA):</strong> Wherever possible, add a second layer of security to your accounts.</li>
      <li><strong>Regularly audit your passwords:</strong> Identify and change any reused, weak, or compromised passwords.</li>
      <li><strong>Keep your device secure:</strong> Use device encryption, strong login passwords, and updated software to protect against malware.</li>
    </ul>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px;">
      By combining a reliable password manager with good security habits, you can dramatically improve your online safety and enjoy peace of mind knowing your accounts are protected.
    </p>
  </div>

  <!-- FAQ -->
  <div style="margin-top: 48px;" class="fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top: 1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`pw-faq-${i}`} id={`pw-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`pw-faq-${i}`} role="region" aria-labelledby={`pw-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>

<style>
  .calc-form { display: flex; flex-direction: column; gap: 20px; }
  .input-base { padding-right: 48px; }
  .checkbox-label { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--color-body); cursor: pointer; }
  .result-panel { margin: 16px 0; padding: 16px; border-radius: var(--radius-md); border: 1px solid var(--color-hairline); background: var(--color-canvas-soft-2); }
</style>

<script>
  const generateBtn = document.getElementById('generate-pw-btn');
  const clearBtn = document.getElementById('clear-pw-btn');
  const copyBtn = document.getElementById('copy-pw-btn');
  const passwordDisplay = document.getElementById('generated-password');
  const outputBox = document.getElementById('generated-password-output');

  const lengthInput = document.getElementById('pass-length');
  const upperCheckbox = document.getElementById('include-uppercase');
  const lowerCheckbox = document.getElementById('include-lowercase');
  const numberCheckbox = document.getElementById('include-numbers');
  const symbolCheckbox = document.getElementById('include-symbols');

  const charsetUpper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const charsetLower = 'abcdefghijklmnopqrstuvwxyz';
  const charsetNumbers = '0123456789';
  const charsetSymbols = '!@#$%^&*()_+[]{}|;:,.<>?';

  function generatePassword() {
    const length = parseInt(lengthInput.value) || 16;
    let charset = '';
    if (upperCheckbox.checked) charset += charsetUpper;
    if (lowerCheckbox.checked) charset += charsetLower;
    if (numberCheckbox.checked) charset += charsetNumbers;
    if (symbolCheckbox.checked) charset += charsetSymbols;
    if (charset === '') {
      alert('Please select at least one character set.');
      return '';
    }
    let password = '';
    for (let i = 0; i < length; i++) {
      const randomIndex = Math.floor(Math.random() * charset.length);
      password += charset[randomIndex];
    }
    return password;
  }

  function updatePassword() {
    const pwd = generatePassword();
    passwordDisplay.textContent = pwd;
    outputBox.hidden = false;
  }

  function clearAll() {
    lengthInput.value = '16';
    upperCheckbox.checked = true;
    lowerCheckbox.checked = true;
    numberCheckbox.checked = true;
    symbolCheckbox.checked = false;
    passwordDisplay.textContent = '———';
    outputBox.hidden = true;
  }

  function copyPassword() {
    const pwd = passwordDisplay.textContent;
    if (pwd && pwd !== '———') {
      navigator.clipboard.writeText(pwd).then(() => {
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
      }).catch(err => {
        alert('Failed to copy: ' + err);
      });
    }
  }

  generateBtn?.addEventListener('click', updatePassword);
  clearBtn?.addEventListener('click', clearAll);
  copyBtn?.addEventListener('click', copyPassword);
</script>