</style>

<script>
  // ─── Tool Tab Switching ──────────────────────────────────────────────────────
  const toolPanels: Record<string, HTMLElement> = {
    'pdf-to-image': document.getElementById('tool-pdf-to-image')!,
    'image-to-pdf': document.getElementById('tool-image-to-pdf')!,
    'watermark': document.getElementById('tool-watermark')!,
    'password-protect': document.getElementById('tool-password-protect')!,
  };

  document.querySelectorAll('.pt-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.pt-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const tool = (tab as HTMLElement).dataset.tool!;
      Object.keys(toolPanels).forEach(k => {
        toolPanels[k].style.display = k === tool ? '' : 'none';
      });
    });
  });
  document.querySelector('.pt-tab[data-tool="pdf-to-image"]')?.classList.add('active');

  // ─── PDF to Image ──────────────────────────────────────────────────────────
  let ptiDoc: any = null;
  let ptiSelected: Set<number> = new Set();

  document.getElementById('pti-browse-btn')!.addEventListener('click', () => {
    (document.getElementById('pti-file-input') as HTMLInputElement).click();
  });

  document.getElementById('pti-file-input')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) await loadPTIFile(file);
  });

  async function loadPTIFile(file: File) {
    const arrayBuffer = await file.arrayBuffer();
    const { PDFDocument } = (window as any).PDFLib;
    ptiDoc = await PDFDocument.load(arrayBuffer);
    document.getElementById('pti-upload')!.style.display = 'none';
    document.getElementById('pti-editor')!.style.display = '';
    document.getElementById('pti-file-name')!.textContent = file.name;
    renderPTIPages();
  }

  function renderPTIPages() {
    const grid = document.getElementById('pti-pages-grid')!;
    grid.innerHTML = '';
    for (let i = 0; i < ptiDoc.getPageCount(); i++) {
      const card = document.createElement('div');
      card.className = `pt-page-card${ptiSelected.has(i) ? ' selected' : ''}`;
      card.innerHTML = `
        <div class="pt-page-thumb">📄</div>
        <div class="pt-page-footer">Page ${i + 1}</div>
      `;
      card.addEventListener('click', (e) => {
        if (e.shiftKey) { ptiSelected.add(i); }
        else if (e.ctrlKey) { ptiSelected.has(i) ? ptiSelected.delete(i) : ptiSelected.add(i); }
        else { ptiSelected.clear(); ptiSelected.add(i); }
        renderPTIPages();
      });
      grid.appendChild(card);
    }
  }

  document.getElementById('pti-select-all')!.addEventListener('click', () => {
    for (let i = 0; i < ptiDoc.getPageCount(); i++) ptiSelected.add(i);
    renderPTIPages();
  });

  document.getElementById('pti-download-selected')!.addEventListener('click', () => downloadPTI(true));
  document.getElementById('pti-download-all')!.addEventListener('click', () => downloadPTI(false));
  document.getElementById('pti-new-btn')!.addEventListener('click', () => {
    ptiDoc = null;
    document.getElementById('pti-upload')!.style.display = '';
    document.getElementById('pti-editor')!.style.display = 'none';
    ptiSelected.clear();
  });

  async function downloadPTI(selectedOnly: boolean) {
    if (!ptiDoc) return;
    const format = (document.getElementById('pti-format') as HTMLSelectElement).value;
    const quality = parseInt((document.getElementById('pti-quality') as HTMLInputElement).value) / 100;
    const mime = format === 'jpg' ? 'image/jpeg' : format === 'webp' ? 'image/webp' : 'image/png';
    
    const indices = selectedOnly ? [...ptiSelected] : Array.from({ length: ptiDoc.getPageCount() }, (_, i) => i);
    if (indices.length === 0) { alert('Select pages to download.'); return; }
    
    for (const i of indices) {
      // Create a new doc with just this page and render to canvas
      const { PDFDocument } = (window as any).PDFLib;
      const tempDoc = await PDFDocument.create();
      const [copied] = await tempDoc.copyPages(ptiDoc, [i]);
      tempDoc.addPage(copied);
      const bytes = await tempDoc.save();
      
      // Convert to image using a temporary URL
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      
      // Simple download as PDF for now (full canvas rendering would need pdf.js)
      const a = document.createElement('a');
      a.href = url;
      a.download = `page-${i + 1}.${format}`;
      a.click();
      URL.revokeObjectURL(url);
      await new Promise(r => setTimeout(r, 200));
    }
  }

  // ─── Image to PDF ──────────────────────────────────────────────────────────
  let itpImages: { file: File; url: string; name: string }[] = [];

  document.getElementById('itp-browse-btn')!.addEventListener('click', () => {
    (document.getElementById('itp-file-input') as HTMLInputElement).click();
  });

  document.getElementById('itp-file-input')!.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files) addITPImages(Array.from(files));
  });

  function addITPImages(files: File[]) {
    files.forEach(f => {
      if (itpImages.length >= 20) return;
      itpImages.push({ file: f, url: URL.createObjectURL(f), name: f.name });
    });
    document.getElementById('itp-upload')!.style.display = 'none';
    document.getElementById('itp-editor')!.style.display = '';
    document.getElementById('itp-file-count')!.textContent = `${itpImages.length} image${itpImages.length !== 1 ? 's' : ''}`;
    renderITPImages();
  }

  function renderITPImages() {
    const grid = document.getElementById('itp-images-grid')!;
    grid.innerHTML = itpImages.map((img, i) => `
      <div class="pt-image-card">
        <div class="pt-image-thumb"><img src="${img.url}" alt="${img.name}" /></div>
        <div class="pt-page-footer">${img.name.length > 20 ? img.name.slice(0, 18) + '...' : img.name}</div>
      </div>
    `).join('');
  }

  document.getElementById('itp-sort-az')!.addEventListener('click', () => {
    itpImages.sort((a, b) => a.name.localeCompare(b.name));
    renderITPImages();
  });

  document.getElementById('itp-reverse')!.addEventListener('click', () => {
    itpImages.reverse();
    renderITPImages();
  });

  document.getElementById('itp-convert-btn')!.addEventListener('click', async () => {
    if (itpImages.length === 0) return;
    const { PDFDocument } = (window as any).PDFLib;
    const doc = await PDFDocument.create();
    
    for (const img of itpImages) {
      const arrayBuffer = await img.file.arrayBuffer();
      let image;
      if (img.file.type === 'image/png') {
        image = await doc.embedPng(arrayBuffer);
      } else if (img.file.type === 'image/jpeg' || img.file.type === 'image/jpg') {
        image = await doc.embedJpg(arrayBuffer);
      } else {
        try { image = await doc.embedPng(arrayBuffer); }
        catch { try { image = await doc.embedJpg(arrayBuffer); } catch { continue; } }
      }
      
      const pageSize = (document.getElementById('itp-page-size') as HTMLSelectElement).value;
      let width = image.width, height = image.height;
      
      if (pageSize === 'a4') { width = 595; height = 842; }
      else if (pageSize === 'letter') { width = 612; height = 792; }
      else if (pageSize === 'legal') { width = 612; height = 1008; }
      
      const page = doc.addPage([width, height]);
      const scale = Math.min((width - 40) / image.width, (height - 40) / image.height, 1);
      const x = (width - image.width * scale) / 2;
      const y = (height - image.height * scale) / 2;
      page.drawImage(image, { x, y, width: image.width * scale, height: image.height * scale });
    }
    
    const bytes = await doc.save();
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'images-to-pdf.pdf';
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('itp-new-btn')!.addEventListener('click', () => {
    itpImages.forEach(i => URL.revokeObjectURL(i.url));
    itpImages = [];
    document.getElementById('itp-upload')!.style.display = '';
    document.getElementById('itp-editor')!.style.display = 'none';
  });

  // ─── Watermark ─────────────────────────────────────────────────────────────
  let wmDoc: any = null;
  let wmFileName = '';
  let wmType: 'text' | 'image' = 'text';
  let wmImageBytes: Uint8Array | null = null;
  let wmTargetPages: 'all' | 'first' = 'all';

  document.getElementById('wm-browse-btn')!.addEventListener('click', () => {
    (document.getElementById('wm-file-input') as HTMLInputElement).click();
  });

  document.getElementById('wm-file-input')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const arrayBuffer = await file.arrayBuffer();
    const { PDFDocument } = (window as any).PDFLib;
    wmDoc = await PDFDocument.load(arrayBuffer);
    wmFileName = file.name;
    document.getElementById('wm-upload')!.style.display = 'none';
    document.getElementById('wm-editor')!.style.display = '';
    document.getElementById('wm-file-name')!.textContent = file.name;
  });

  document.getElementById('wm-text-btn')!.addEventListener('click', () => {
    wmType = 'text';
    document.getElementById('wm-text-settings')!.style.display = '';
    document.getElementById('wm-image-settings')!.style.display = 'none';
    document.getElementById('wm-text-btn')!.classList.add('active');
    document.getElementById('wm-image-btn')!.classList.remove('active');
  });

  document.getElementById('wm-image-btn')!.addEventListener('click', () => {
    wmType = 'image';
    document.getElementById('wm-text-settings')!.style.display = 'none';
    document.getElementById('wm-image-settings')!.style.display = '';
    document.getElementById('wm-image-btn')!.classList.add('active');
    document.getElementById('wm-text-btn')!.classList.remove('active');
  });

  document.getElementById('wm-image-browse')!.addEventListener('click', () => {
    (document.getElementById('wm-image-input') as HTMLInputElement).click();
  });

  document.getElementById('wm-image-input')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    document.getElementById('wm-image-name')!.textContent = `✅ ${file.name}`;
    const arrayBuffer = await file.arrayBuffer();
    wmImageBytes = new Uint8Array(arrayBuffer);
  });

  document.getElementById('wm-all-pages')!.addEventListener('click', () => {
    wmTargetPages = 'all';
    document.getElementById('wm-all-pages')!.classList.add('active');
    document.getElementById('wm-first-page')!.classList.remove('active');
  });

  document.getElementById('wm-first-page')!.addEventListener('click', () => {
    wmTargetPages = 'first';
    document.getElementById('wm-first-page')!.classList.add('active');
    document.getElementById('wm-all-pages')!.classList.remove('active');
  });

  document.getElementById('wm-apply-btn')!.addEventListener('click', async () => {
    if (!wmDoc) return;
    const { PDFDocument, rgb, StandardFonts } = (window as any).PDFLib;
    
    const pages = wmTargetPages === 'first' ? [0] : Array.from({ length: wmDoc.getPageCount() }, (_, i) => i);
    const opacity = parseInt((document.getElementById('wm-opacity') as HTMLInputElement).value) / 100;
    
    for (const pageIdx of pages) {
      const page = wmDoc.getPage(pageIdx);
      const { width, height } = page.getSize();
      
      if (wmType === 'text') {
        const text = (document.getElementById('wm-text') as HTMLInputElement).value || 'CONFIDENTIAL';
        const fontSize = parseInt((document.getElementById('wm-font-size') as HTMLInputElement).value) || 60;
        const colorHex = (document.getElementById('wm-color') as HTMLInputElement).value;
        const r = parseInt(colorHex.slice(1, 3), 16) / 255;
        const g = parseInt(colorHex.slice(3, 5), 16) / 255;
        const b = parseInt(colorHex.slice(5, 7), 16) / 255;
        const rotation = parseInt((document.getElementById('wm-rotation') as HTMLSelectElement).value);
        const position = (document.getElementById('wm-position') as HTMLSelectElement).value;
        const font = await wmDoc.embedFont(StandardFonts.HelveticaBold);
        
        if (position === 'tiled') {
          for (let x = 0; x < width + 200; x += 250) {
            for (let y = 0; y < height + 200; y += 150) {
              page.drawText(text, { x, y, size: fontSize, font, color: rgb(r, g, b), opacity, rotate: { type: 'degrees', angle: rotation } });
            }
          }
        } else {
          const textWidth = font.widthOfTextAtSize(text, fontSize);
          const textHeight = fontSize;
          let x = (width - textWidth) / 2, y = (height - textHeight) / 2;
          if (position === 'top') y = height - textHeight - 40;
          else if (position === 'bottom') y = 40;
          else if (position === 'top-left') { x = 40; y = height - textHeight - 40; }
          else if (position === 'top-right') { x = width - textWidth - 40; y = height - textHeight - 40; }
          else if (position === 'bottom-left') { x = 40; y = 40; }
          else if (position === 'bottom-right') { x = width - textWidth - 40; y = 40; }
          
          page.drawText(text, { x, y, size: fontSize, font, color: rgb(r, g, b), opacity, rotate: { type: 'degrees', angle: rotation } });
        }
      } else if (wmType === 'image' && wmImageBytes) {
        try {
          const wmImage = await wmDoc.embedPng(wmImageBytes);
          const scale = parseInt((document.getElementById('wm-image-scale') as HTMLInputElement).value) / 100;
          const imgOpacity = parseInt((document.getElementById('wm-image-opacity') as HTMLInputElement).value) / 100;
          const imgW = wmImage.width * scale;
          const imgH = wmImage.height * scale;
          page.drawImage(wmImage, { x: (width - imgW) / 2, y: (height - imgH) / 2, width: imgW, height: imgH, opacity: imgOpacity });
        } catch(e) { /* Skip if image fails */ }
      }
    }
    
    const bytes = await wmDoc.save();
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = wmFileName.replace('.pdf', '') + '-watermarked.pdf';
    a.click();
    URL.revokeObjectURL(url);
  });

  // ─── Password Protect ──────────────────────────────────────────────────────
  let ppDoc: any = null;
  let ppFileName = '';

  document.getElementById('pp-browse-btn')!.addEventListener('click', () => {
    (document.getElementById('pp-file-input') as HTMLInputElement).click();
  });

  document.getElementById('pp-file-input')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const arrayBuffer = await file.arrayBuffer();
    const { PDFDocument } = (window as any).PDFLib;
    ppDoc = await PDFDocument.load(arrayBuffer);
    ppFileName = file.name;
    document.getElementById('pp-upload')!.style.display = 'none';
    document.getElementById('pp-editor')!.style.display = '';
    document.getElementById('pp-file-name')!.textContent = file.name;
  });

  document.getElementById('pp-owner-password')!.addEventListener('input', (e) => {
    const pw = (e.target as HTMLInputElement).value;
    const strengthBar = document.getElementById('pp-password-strength')!;
    let strength = 0;
    if (pw.length >= 8) strength++;
    if (pw.match(/[A-Z]/)) strength++;
    if (pw.match(/[0-9]/)) strength++;
    if (pw.match(/[^A-Za-z0-9]/)) strength++;
    if (pw.length >= 12) strength++;
    
    const colors = ['#dc2626', '#f59e0b', '#eab308', '#84cc16', '#10b981'];
    const widths = ['20%', '40%', '60%', '80%', '100%'];
    strengthBar.style.width = widths[Math.min(strength, 4)];
    strengthBar.style.background = colors[Math.min(strength, 4)];
  });

  document.getElementById('pp-enc-128')!.addEventListener('click', function() {
    this.classList.add('active');
    document.getElementById('pp-enc-256')!.classList.remove('active');
  });

  document.getElementById('pp-enc-256')!.addEventListener('click', function() {
    this.classList.add('active');
    document.getElementById('pp-enc-128')!.classList.remove('active');
  });

  document.getElementById('pp-apply-btn')!.addEventListener('click', async () => {
    if (!ppDoc) return;
    const password = (document.getElementById('pp-owner-password') as HTMLInputElement).value;
    if (!password) { alert('Please enter a password.'); return; }
    if (password.length < 4) { alert('Password must be at least 4 characters.'); return; }
    
    ppDoc.setTitle(ppFileName);
    ppDoc.setAuthor('PDF Tools');
    
    const permissions: any = {};
    const denyPrint = (document.getElementById('pp-deny-print') as HTMLInputElement).checked;
    const denyCopy = (document.getElementById('pp-deny-copy') as HTMLInputElement).checked;
    const denyEdit = (document.getElementById('pp-deny-edit') as HTMLInputElement).checked;
    const denyAnnotate = (document.getElementById('pp-deny-annotate') as HTMLInputElement).checked;
    const allowFillForms = (document.getElementById('pp-allow-fill-forms') as HTMLInputElement).checked;
    
    if (denyPrint) permissions.printing = false;
    if (denyCopy) permissions.copying = false;
    if (denyEdit) permissions.modifying = false;
    if (denyAnnotate) permissions.annotating = false;
    if (allowFillForms) permissions.fillingForms = true;
    
    ppDoc.setEncryption(password, password, permissions);
    
    const bytes = await ppDoc.save();
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = ppFileName.replace('.pdf', '') + '-protected.pdf';
    a.click();
    URL.revokeObjectURL(url);
  });

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>