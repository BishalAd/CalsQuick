---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';
const faqs = [
  { q: 'How is overtime pay calculated?', a: 'Under the Fair Labor Standards Act (FLSA), overtime pay is 1.5× your regular hourly rate for hours worked beyond 40 in a workweek. Formula: Overtime Pay = 1.5 × Regular Rate × Overtime Hours. For example, if you earn $20/hour and work 45 hours: 40 regular hours = $800 + 5 overtime hours × $30 = $150, total = $950.' },
  { q: 'What is the overtime rate for time and a half?', a: 'Time and a half means 1.5× your normal hourly rate. At $15/hour, overtime rate = $22.50/hour. At $25/hour, overtime rate = $37.50/hour. This is the federal minimum overtime rate — some states and union contracts require higher multiplier like double time (2×).' },
  { q: 'Who is eligible for overtime pay?', a: 'Under FLSA, hourly (non-exempt) employees must receive overtime. Salaried (exempt) employees earning above $35,568/year (2024) in executive, administrative, professional, or computer roles are generally NOT eligible for overtime. However, many salaried workers earning less than this threshold ARE eligible. Always check your classification.' },
  { q: 'How does overtime work in California?', a: 'California has the strictest overtime laws: daily overtime at 1.5× for hours over 8 in a day (up to 12 hours), double time (2×) for hours over 12 in a day, 1.5× for the first 8 hours on the 7th consecutive day, and 2× for hours over 8 on the 7th day. California also pays overtime on a weekly basis for hours over 40. The law that gives the employee the higher pay applies.' },
  { q: 'Is overtime calculated daily or weekly?', a: 'Federal law (FLSA) uses weekly overtime — hours over 40 per workweek. Several states (California, Alaska, Colorado, Nevada) add daily overtime — hours over 8 or 12 in a single day. Some states calculate both and pay whichever is higher. Our calculator supports all three modes: federal weekly, daily, and California-style combined.' },
  { q: 'How is overtime calculated for salaried employees?', a: 'If a salaried non-exempt employee is eligible for overtime, first calculate their regular hourly rate: Annual Salary ÷ 52 weeks ÷ 40 hours. For a $50,000 salary: $50,000 ÷ 52 ÷ 40 = $24.04/hour regular rate. Overtime is then 1.5× $24.04 = $36.06 per overtime hour. Semi-monthly and monthly salaried employees use the same formula.' },
  { q: 'What is double time pay?', a: 'Double time (2×) is required in California for hours worked beyond 12 in a day or beyond 8 on the 7th consecutive workday. Some union contracts and employer policies also provide double time. At $20/hour regular rate, double time = $40/hour.' },
  { q: 'Do weekends and holidays count as overtime?', a: 'Under federal law: No. Overtime is based on hours over 40 in a workweek, regardless of which days you work. Weekends and holidays do not automatically trigger overtime pay. However — many employers voluntarily pay premium rates for holiday work, and some union contracts require it. Some states (Massachusetts, Rhode Island) have holiday pay laws for retail workers.' },
  { q: 'How is overtime calculated when I work multiple jobs at different rates?', a: 'If you work two jobs for the same employer at different rates, the blended (weighted average) rate applies. Example: 30 hours at $15 and 20 hours at $20 = (30×15 + 20×20) ÷ 50 = $17.00/hour weighted average. Overtime = 1.5 × $17.00 = $25.50/hour for the 10 overtime hours.' },
  { q: 'What is the FLSA regular rate of pay?', a: 'The regular rate includes hourly wages, salary, commissions, non-discretionary bonuses, and shift differentials. It does NOT include discretionary bonuses, gifts, paid time off, expense reimbursements, or employer benefit contributions. The regular rate is the basis for overtime calculation — getting this right is crucial for compliance.' },
  { q: 'How do I calculate overtime for tipped employees?', a: 'The regular rate for tipped employees includes both the cash wage and the tip credit. If the cash wage is $2.13/hour and the tip credit is $5.12/hour, the regular rate is $7.25/hour (federal minimum). Overtime is 1.5 × $7.25 = $10.875/hour, minus the tip credit of $5.12, so the employer must pay at least $5.755/hour for overtime hours.' },
  { q: 'Can an employer refuse to pay overtime?', a: 'No. If you are a non-exempt employee who worked more than 40 hours, your employer is legally required to pay overtime under FLSA. Employers cannot ask you to work "off the clock," average hours across two weeks to avoid overtime, or give comp time (in the private sector) instead of overtime pay. Violations can be reported to the Department of Labor Wage and Hour Division.' },
];

const schemas = [
  generateSoftwareApplication({ name: 'Overtime Pay Calculator', description: 'Free overtime pay calculator for US and international workers. Calculate time and a half, double time, daily and weekly overtime. Supports hourly, salaried, and multi-rate employees. Includes California, Alaska, Colorado, and Nevada state rules.', url: '/overtime-calculator' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Workers Comp Calculator', href: '/workers-comp-calculator', icon: '🏥', desc: 'Work injury benefits' },
  { name: 'Percentage Calculator', href: '/percentage-calculator', icon: '📊', desc: 'Quick percentage math' },
  { name: 'Tip Calculator', href: '/tip-calculator', icon: '💰', desc: 'Calculate and split tips' },
];

// Overtime rule presets
const rulePresets = [
  { key:'federal', label:'Federal (FLSA)', desc:'40 hrs/week, 1.5× overtime', daily:false, weeklyOT:40, multiplier:1.5, doubleThreshold:null, doubleMultiplier:null },
  { key:'california', label:'California', desc:'8 hrs/day + 40 hrs/week, 1.5× & 2×', daily:true, dailyOT:8, weeklyOT:40, multiplier:1.5, doubleThreshold:12, doubleMultiplier:2 },
  { key:'alaska', label:'Alaska', desc:'8 hrs/day + 40 hrs/week', daily:true, dailyOT:8, weeklyOT:40, multiplier:1.5, doubleThreshold:null, doubleMultiplier:null },
  { key:'colorado', label:'Colorado', desc:'12 hrs/day + 40 hrs/week', daily:true, dailyOT:12, weeklyOT:40, multiplier:1.5, doubleThreshold:null, doubleMultiplier:null },
  { key:'nevada', label:'Nevada', desc:'8 hrs/day + 40 hrs/week (some exceptions)', daily:true, dailyOT:8, weeklyOT:40, multiplier:1.5, doubleThreshold:null, doubleMultiplier:null },
  { key:'custom', label:'Custom', desc:'Set your own rules', daily:false, weeklyOT:40, multiplier:1.5, doubleThreshold:null, doubleMultiplier:null },
];
---

<CalculatorLayout
  title="Overtime Pay Calculator — Time and a Half, Double Time, Daily & Weekly OT"
  description="Free overtime pay calculator for US and international workers. Calculate overtime at 1.5× and 2× rates. Supports federal FLSA, California, Alaska, Colorado, Nevada rules plus custom settings. For hourly, salaried, tipped, and multi-rate employees."
  canonical="/overtime-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Overtime Pay Calculator', url: '/overtime-calculator' }]}
  relatedCalcs={relatedCalcs}
>
  <div style="margin-bottom:32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom:8px;">Employment & Payroll Tools</div>
    <h1 class="text-display-lg" style="color:var(--color-ink);margin-bottom:12px;">Overtime Pay Calculator</h1>
    <p class="text-body-lg" style="color:var(--color-body);max-width:640px;">
      Calculate your overtime pay at time and a half or double time. Supports federal FLSA rules, California daily OT, and custom settings. Works for hourly, salaried, tipped, and multi-rate employees.
    </p>
  </div>

  <div class="calc-panel fade-up stagger-1">
    <div class="calc-form">
      <!-- Rule preset -->
      <div>
        <label class="label">Overtime Rules</label>
        <div class="preset-grid">
          {rulePresets.map((p,i)=>(
            <button class={`preset-btn ${i===0?'active':''}`} data-rule={p.key} aria-pressed={i===0?'true':'false'}>
              <span class="preset-label">{p.label}</span>
              <span class="preset-desc">{p.desc}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Custom settings (shown when custom selected) -->
      <div id="custom-settings" hidden>
        <div class="two-col">
          <div><label for="custom-weekly" class="label">Weekly OT Threshold (hrs)</label><input type="number" id="custom-weekly" class="input-base" value="40" min="1" max="168" /></div>
          <div><label for="custom-multiplier" class="label">OT Multiplier</label><input type="number" id="custom-multiplier" class="input-base" value="1.5" min="1" max="5" step="0.1" /></div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;color:var(--color-body);">
            <input type="checkbox" id="custom-daily" style="accent-color:var(--color-link);" /> Enable Daily OT
          </label>
          <div id="custom-daily-settings" hidden style="display:flex;gap:8px;align-items:center;">
            <input type="number" id="custom-daily-threshold" class="input-base" placeholder="8" min="1" max="24" style="width:70px;" />
            <span style="font-size:13px;color:var(--color-muted);">hrs/day</span>
          </div>
        </div>
      </div>

      <!-- Pay type -->
      <div>
        <label class="label">How Are You Paid?</label>
        <div class="pay-type-grid">
          <button class="pay-btn active" data-pay="hourly" aria-pressed="true">⏱️ Hourly Rate</button>
          <button class="pay-btn" data-pay="salary" aria-pressed="false">💼 Annual Salary</button>
          <button class="pay-btn" data-pay="dual" aria-pressed="false">🔀 Two Different Rates</button>
        </div>
      </div>

      <!-- Hourly inputs -->
      <div id="pay-hourly">
        <div class="two-col">
          <div>
            <label for="hourly-rate" class="label">Hourly Rate ($)</label>
            <div class="input-dollar-wrap">
              <span class="dollar-sign">$</span>
              <input type="number" id="hourly-rate" class="input-base input-lg input-dollar" placeholder="e.g. 20.00" min="0.01" step="0.01" />
            </div>
          </div>
          <div>
            <label for="weekly-hours" class="label">Total Hours Worked This Week</label>
            <input type="number" id="weekly-hours" class="input-base input-lg" placeholder="e.g. 45" min="1" max="168" step="0.5" />
          </div>
        </div>
        <!-- Daily breakdown (for daily OT states) -->
        <div id="daily-breakdown" hidden style="margin-top:14px;">
          <label class="label">Daily Hours Breakdown</label>
          <p style="font-size:12px;color:var(--color-muted);margin-bottom:8px;">Enter hours per day (Mon–Sun). Leave empty for 0.</p>
          <div class="daily-grid">
            {['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(d=>(
              <div><label style="font-size:12px;font-weight:500;color:var(--color-body);display:block;margin-bottom:4px;">{d}</label><input type="number" class="input-base daily-hour" placeholder="8" min="0" max="24" step="0.5" /></div>
            ))}
          </div>
        </div>
      </div>

      <!-- Salary inputs -->
      <div id="pay-salary" hidden>
        <div class="two-col">
          <div>
            <label for="annual-salary" class="label">Annual Salary ($)</label>
            <div class="input-dollar-wrap">
              <span class="dollar-sign">$</span>
              <input type="number" id="annual-salary" class="input-base input-lg input-dollar" placeholder="e.g. 50000" min="1" step="100" />
            </div>
          </div>
          <div>
            <label for="salary-hours" class="label">Standard Weekly Hours</label>
            <input type="number" id="salary-hours" class="input-base input-lg" value="40" min="1" max="168" />
          </div>
        </div>
        <div class="two-col" style="margin-top:16px;">
          <div>
            <label for="salary-ot-hours" class="label">Overtime Hours This Week</label>
            <input type="number" id="salary-ot-hours" class="input-base input-lg" placeholder="e.g. 10" min="0" step="0.5" />
          </div>
          <div>
            <label for="salary-double-hours" class="label">Double Time Hours (if applicable)</label>
            <input type="number" id="salary-double-hours" class="input-base input-lg" placeholder="0" min="0" step="0.5" value="0" />
          </div>
        </div>
      </div>

      <!-- Dual rate inputs -->
      <div id="pay-dual" hidden>
        <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px;">For employees working two jobs at different rates for the same employer. A blended (weighted average) rate is used for overtime.</p>
        <div class="two-col">
          <div>
            <label for="rate1" class="label">Job 1 — Hourly Rate ($)</label>
            <div class="input-dollar-wrap">
              <span class="dollar-sign">$</span>
              <input type="number" id="rate1" class="input-base input-dollar" placeholder="e.g. 20" min="0.01" step="0.01" />
            </div>
            <label for="hours1" class="label" style="margin-top:8px;">Job 1 — Hours</label>
            <input type="number" id="hours1" class="input-base" placeholder="e.g. 30" min="0" step="0.5" />
          </div>
          <div>
            <label for="rate2" class="label">Job 2 — Hourly Rate ($)</label>
            <div class="input-dollar-wrap">
              <span class="dollar-sign">$</span>
              <input type="number" id="rate2" class="input-base input-dollar" placeholder="e.g. 25" min="0.01" step="0.01" />
            </div>
            <label for="hours2" class="label" style="margin-top:8px;">Job 2 — Hours</label>
            <input type="number" id="hours2" class="input-base" placeholder="e.g. 20" min="0" step="0.5" />
          </div>
        </div>
      </div>

      <!-- Quick hours presets -->
      <div>
        <label class="label">Quick Hours</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          {[40,45,50,55,60,70,80].map(h=>(
            <button class="quick-btn" data-hours={h}>{h}h</button>
          ))}
        </div>
      </div>

      <div style="display:flex;gap:12px;">
        <button id="calc-ot-btn" class="btn-primary" style="flex:1;">Calculate Overtime Pay</button>
        <button id="reset-ot-btn" class="btn-secondary">Clear</button>
      </div>
    </div>

    <div id="ot-error" class="calc-error" role="alert" hidden><span id="ot-error-msg"></span></div>

    <div id="ot-results" hidden aria-live="polite" style="margin-top:24px;">
      <div class="results-divider"></div>
      <div class="ot-hero">
        <div class="ot-hero-value" id="ot-total-pay">—</div>
        <div class="ot-hero-label">Total Gross Pay This Week</div>
      </div>
      <div class="ot-stats">
        <div class="ot-stat"><div class="ots-label">Regular Pay</div><div class="ots-value" id="ot-regular-pay">—</div></div>
        <div class="ot-stat"><div class="ots-label">Overtime Pay</div><div class="ots-value" id="ot-ot-pay">—</div></div>
        <div class="ot-stat"><div class="ots-label">Double Time Pay</div><div class="ots-value" id="ot-dt-pay">—</div></div>
        <div class="ot-stat"><div class="ots-label">Effective Hourly Rate</div><div class="ots-value" id="ot-effective-rate">—</div></div>
      </div>
      <div class="result-panel" style="margin-top:16px;" id="ot-breakdown"></div>
    </div>
  </div>

  <!-- State comparison table -->
  <div style="margin-bottom:40px;margin-top:48px;" class="fade-up">
    <h2 style="color:var(--color-ink);margin-bottom:8px;font-size:22px;font-weight:600;">Overtime Laws by State — Quick Reference</h2>
    <div style="overflow-x:auto;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:13px;color:var(--color-body);">
        <thead><tr style="background:var(--color-canvas-soft-2);border-bottom:1px solid var(--color-hairline);font-weight:600;color:var(--color-ink);"><th style="padding:11px 14px;text-align:left;">State</th><th style="padding:11px 14px;text-align:left;">Daily OT</th><th style="padding:11px 14px;text-align:left;">Weekly OT</th><th style="padding:11px 14px;text-align:left;">Double Time</th><th style="padding:11px 14px;text-align:left;">Notes</th></tr></thead>
        <tbody>
          {[
            ['Federal (FLSA)','None','1.5× over 40 hrs','No','Minimum standard for all states'],
            ['California','1.5× over 8 hrs/day, 2× over 12','1.5× over 40 hrs','Yes','Strictest US overtime laws'],
            ['Alaska','1.5× over 8 hrs/day','1.5× over 40 hrs','No','Daily OT for most industries'],
            ['Colorado','1.5× over 12 hrs/day','1.5× over 40 hrs','No','Daily OT only above 12 hrs'],
            ['Nevada','1.5× over 8 hrs/day','1.5× over 40 hrs','No','Daily OT for lower-wage workers'],
            ['Oregon','1.5× over 10 hrs/day (manufacturing)','1.5× over 40 hrs','No','Manufacturing-only daily OT'],
            ['Puerto Rico','1.5× over 8 hrs/day','1.5× over 40 hrs','Yes (2×)','Double time after 8 daily OT hrs'],
            ['New York','None','1.5× over 40 hrs','No','Follows federal FLSA standard'],
            ['Texas','None','1.5× over 40 hrs','No','Follows federal FLSA standard'],
            ['Florida','None','1.5× over 40 hrs','No','Follows federal FLSA standard'],
            ['UK / EU','None','Varies by country','Varies','EU: max 48 hrs/week. OT pay varies.'],
            ['Canada','Varies by province','1.5× over 40-44 hrs','Varies','BC: 1.5× over 8/day + 40/week'],
          ].map(r=>(
            <tr style="border-top:1px solid var(--color-hairline);"><td style="padding:11px 14px;font-weight:600;">{r[0]}</td><td style="padding:11px 14px;">{r[1]}</td><td style="padding:11px 14px;">{r[2]}</td><td style="padding:11px 14px;">{r[3]}</td><td style="padding:11px 14px;font-size:12px;color:var(--color-muted);">{r[4]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- SEO Article -->
  <div class="prose-section fade-up" style="margin-top:48px;">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:20px;">Overtime Pay: Complete Guide to Time and a Half, Double Time, and State Laws</h2>
    <p class="text-body-md" style="color:var(--color-body);line-height:28px;margin-bottom:16px;">
      Under the federal Fair Labor Standards Act (FLSA), non-exempt employees must receive <strong>overtime pay at 1.5× their regular rate</strong> for all hours worked beyond 40 in a single workweek. This "time and a half" rule applies to approximately 80% of US workers. With the average American working 38.7 hours per week, millions of workers earn overtime pay every pay period — and understanding exactly how it is calculated ensures you receive every dollar you are owed.
    </p>
    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">California Overtime: The Strictest Rules in the US</h3>
    <p class="text-body-md" style="color:var(--color-body);line-height:28px;margin-bottom:16px;">
      California goes beyond federal law with <strong>daily overtime</strong> requirements. Employees earn 1.5× for hours 8–12 in a single day, and <strong>double time (2×)</strong> for hours beyond 12 in a day. California also requires double time for hours beyond 8 on the 7th consecutive workday. When both daily and weekly overtime apply, employees receive the higher rate — never both stacked. Our California preset handles this calculation automatically.
    </p>
    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">International Overtime: UK, Canada, and Beyond</h3>
    <p class="text-body-md" style="color:var(--color-body);line-height:28px;">
      In Canada, overtime rules vary by province — British Columbia requires 1.5× over 8 hours/day plus 1.5× over 40/week, while Ontario requires 1.5× over 44 hours/week. The UK and EU limit working hours to 48 per week under the Working Time Directive, with overtime pay rates left to employment contracts. In Australia, overtime rates are set by Modern Awards and Enterprise Agreements — typically 1.5× for the first 2-3 hours and 2× thereafter. Our custom settings mode lets you configure the calculator for any country's rules.
    </p>
  </div>

  <!-- FAQ -->
  <div style="margin-top:48px;" class="fade-up">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top:1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`ot-faq-${i}`}><span>{faq.q}</span><svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
          <div class="faq-answer" id={`ot-faq-${i}`} role="region">{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>

<style>
  .calc-form{display:flex;flex-direction:column;gap:20px;}
  .results-divider{height:1px;background:var(--color-hairline);margin:20px 0;}
  .calc-error{display:flex;align-items:center;gap:8px;padding:12px 16px;background:var(--color-error-soft);border:1px solid var(--color-hairline);border-radius:var(--radius-md);margin-top:16px;font-size:14px;color:var(--color-error);}
  .prose-section{padding:32px;background:var(--color-canvas);border-radius:var(--radius-lg);border:1px solid var(--color-hairline);}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .input-dollar-wrap{position:relative;}
  .dollar-sign{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--color-muted);font-weight:600;z-index:1;}
  .input-dollar{padding-left:30px !important;}
  .preset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .preset-btn{display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px 8px;border:1px solid var(--color-hairline);border-radius:var(--radius-lg);background:var(--color-canvas-soft-2);cursor:pointer;transition:all 0.15s;text-align:center;}
  .preset-btn:hover{border-color:var(--color-link);}
  .preset-btn.active{border-color:var(--color-link);background:var(--color-canvas);box-shadow:0 0 0 2px rgba(99,102,241,0.1);}
  .preset-label{font-size:13px;font-weight:600;color:var(--color-ink);}
  .preset-desc{font-size:11px;color:var(--color-muted);line-height:1.3;}
  .pay-type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .pay-btn{padding:10px 8px;font-size:13px;font-weight:500;border:1px solid var(--color-hairline);border-radius:var(--radius-md);background:var(--color-canvas-soft-2);cursor:pointer;transition:all 0.15s;}
  .pay-btn:hover{border-color:var(--color-link);}
  .pay-btn.active{border-color:var(--color-link);background:var(--color-canvas);box-shadow:0 0 0 2px rgba(99,102,241,0.1);}
  .daily-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
  .quick-btn{padding:6px 14px;border:1px solid var(--color-hairline);border-radius:var(--radius-pill);background:var(--color-canvas-soft-2);cursor:pointer;font-size:13px;font-weight:500;transition:all 0.15s;}
  .quick-btn:hover{border-color:var(--color-link);}
  .ot-hero{text-align:center;padding:36px 24px;background:linear-gradient(135deg,rgba(245,158,11,0.08),rgba(239,68,68,0.06));border:2px solid #f59e0b;border-radius:var(--radius-lg);}
  .ot-hero-value{font-size:clamp(40px,7vw,64px);font-weight:700;color:#f59e0b;letter-spacing:-1.5px;font-family:var(--font-mono);}
  .ot-hero-label{font-size:15px;color:var(--color-muted);margin-top:8px;}
  .ot-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px;}
  .ot-stat{padding:14px;text-align:center;background:var(--color-canvas-soft-2);border:1px solid var(--color-hairline);border-radius:var(--radius-md);}
  .ots-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin-bottom:6px;}
  .ots-value{font-size:16px;font-weight:700;color:var(--color-ink);font-family:var(--font-mono);}
  .result-panel{background:var(--color-canvas-soft);border:1px solid var(--color-hairline);border-radius:var(--radius-lg);padding:16px 20px;}
  .result-row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--color-hairline);}
  .result-row-label{font-size:14px;color:var(--color-body);}
  .result-row-value{font-size:14px;font-weight:600;color:var(--color-ink);}
  @media(max-width:768px){.preset-grid{grid-template-columns:repeat(2,1fr);}.daily-grid{grid-template-columns:repeat(4,1fr);}.ot-stats{grid-template-columns:repeat(2,1fr);}.pay-type-grid{grid-template-columns:repeat(2,1fr);}.two-col{grid-template-columns:1fr;}.prose-section{padding:20px 16px;}}
  @media(max-width:480px){.preset-grid{grid-template-columns:1fr;}.daily-grid{grid-template-columns:repeat(3,1fr);}}
</style>

<script>
  const rules:Record<string,any>={
    federal:{daily:false,weeklyOT:40,multiplier:1.5,doubleThreshold:null,doubleMultiplier:null},
    california:{daily:true,dailyOT:8,weeklyOT:40,multiplier:1.5,doubleThreshold:12,doubleMultiplier:2},
    alaska:{daily:true,dailyOT:8,weeklyOT:40,multiplier:1.5,doubleThreshold:null,doubleMultiplier:null},
    colorado:{daily:true,dailyOT:12,weeklyOT:40,multiplier:1.5,doubleThreshold:null,doubleMultiplier:null},
    nevada:{daily:true,dailyOT:8,weeklyOT:40,multiplier:1.5,doubleThreshold:null,doubleMultiplier:null},
    custom:{daily:false,weeklyOT:40,multiplier:1.5,doubleThreshold:null,doubleMultiplier:null},
  };
  let activeRule='federal';
  let payType='hourly';

  document.querySelectorAll('.preset-btn').forEach(b=>b.addEventListener('click',()=>{
    activeRule=(b as HTMLElement).dataset.rule!;
    document.querySelectorAll('.preset-btn').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});
    b.classList.add('active');b.setAttribute('aria-pressed','true');
    (document.getElementById('custom-settings') as HTMLElement).hidden=activeRule!=='custom';
    const r=rules[activeRule];
    updateDailyVisibility(r.daily);
  }));

  document.querySelectorAll('.pay-btn').forEach(b=>b.addEventListener('click',()=>{
    payType=(b as HTMLElement).dataset.pay!;
    document.querySelectorAll('.pay-btn').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});
    b.classList.add('active');b.setAttribute('aria-pressed','true');
    (document.getElementById('pay-hourly') as HTMLElement).hidden=payType!=='hourly';
    (document.getElementById('pay-salary') as HTMLElement).hidden=payType!=='salary';
    (document.getElementById('pay-dual') as HTMLElement).hidden=payType!=='dual';
  }));

  document.getElementById('custom-daily')?.addEventListener('change',(e)=>{
    (document.getElementById('custom-daily-settings') as HTMLElement).hidden=!(e.target as HTMLInputElement).checked;
  });

  function updateDailyVisibility(show:boolean){
    (document.getElementById('daily-breakdown') as HTMLElement).hidden=!show||payType==='salary';
  }

  document.querySelectorAll('.quick-btn').forEach(b=>b.addEventListener('click',()=>{
    const h=parseFloat((b as HTMLElement).dataset.hours!);
    (document.getElementById('weekly-hours') as HTMLInputElement).value=String(h);
  }));

  // Update daily visibility when rule changes
  function getRule(){
    if(activeRule==='custom'){
      const daily=document.getElementById('custom-daily') as HTMLInputElement;
      return{
        daily:daily?.checked||false,
        dailyOT:parseFloat((document.getElementById('custom-daily-threshold') as HTMLInputElement)?.value)||8,
        weeklyOT:parseFloat((document.getElementById('custom-weekly') as HTMLInputElement)?.value)||40,
        multiplier:parseFloat((document.getElementById('custom-multiplier') as HTMLInputElement)?.value)||1.5,
        doubleThreshold:null,doubleMultiplier:null,
      };
    }
    return rules[activeRule];
  }

  document.getElementById('calc-ot-btn')!.addEventListener('click',()=>{
    const errEl=document.getElementById('ot-error') as HTMLElement,resEl=document.getElementById('ot-results') as HTMLElement;
    errEl.hidden=true;resEl.hidden=true;
    try{
      const rule=getRule();
      let regularPay=0,otPay=0,dtPay=0,totalHours=0,regularHours=0,otHours=0,dtHours=0;
      let hourlyRate=0;

      if(payType==='hourly'){
        hourlyRate=parseFloat((document.getElementById('hourly-rate') as HTMLInputElement).value);
        if(isNaN(hourlyRate)||hourlyRate<=0) throw 'Enter a valid hourly rate.';
        const weeklyHrs=parseFloat((document.getElementById('weekly-hours') as HTMLInputElement).value);
        if(isNaN(weeklyHrs)||weeklyHrs<=0) throw 'Enter total hours worked.';

        if(rule.daily){
          // Daily OT calculation
          const days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
          let dailyHours:number[]=[];
          document.querySelectorAll('.daily-hour').forEach((el:any)=>{
            const v=parseFloat(el.value)||0;
            dailyHours.push(v);
            totalHours+=v;
          });
          if(totalHours===0) totalHours=weeklyHrs;

          // Calculate daily OT
          dailyHours.forEach(dh=>{
            if(rule.doubleThreshold && dh>rule.doubleThreshold){
              dtHours+=dh-rule.doubleThreshold;
              otHours+=rule.doubleThreshold-rule.dailyOT;
              regularHours+=rule.dailyOT;
            } else if(dh>rule.dailyOT){
              otHours+=dh-rule.dailyOT;
              regularHours+=rule.dailyOT;
            } else {
              regularHours+=dh;
            }
          });
          // Weekly OT: only count hours not already paid as daily OT
          const alreadyOTPaid=otHours+dtHours;
          const remainingRegular=Math.max(0,regularHours-rule.weeklyOT);
          if(remainingRegular>0 && alreadyOTPaid===0){
            otHours+=remainingRegular;
            regularHours-=remainingRegular;
          }
        } else {
          totalHours=weeklyHrs;
          regularHours=Math.min(totalHours,rule.weeklyOT);
          otHours=Math.max(0,totalHours-rule.weeklyOT);
        }

        regularPay=hourlyRate*regularHours;
        otPay=hourlyRate*rule.multiplier*otHours;
        if(rule.doubleMultiplier) dtPay=hourlyRate*rule.doubleMultiplier*dtHours;

      } else if(payType==='salary'){
        const salary=parseFloat((document.getElementById('annual-salary') as HTMLInputElement).value);
        if(isNaN(salary)||salary<=0) throw 'Enter a valid annual salary.';
        const stdHrs=parseFloat((document.getElementById('salary-hours') as HTMLInputElement).value)||40;
        hourlyRate=salary/52/stdHrs;
        otHours=parseFloat((document.getElementById('salary-ot-hours') as HTMLInputElement).value)||0;
        dtHours=parseFloat((document.getElementById('salary-double-hours') as HTMLInputElement).value)||0;
        regularPay=hourlyRate*stdHrs;
        otPay=hourlyRate*rule.multiplier*otHours;
        if(rule.doubleMultiplier) dtPay=hourlyRate*rule.doubleMultiplier*dtHours;
        totalHours=stdHrs+otHours+dtHours;
        regularHours=stdHrs;

      } else {
        const r1=parseFloat((document.getElementById('rate1') as HTMLInputElement).value);
        const h1=parseFloat((document.getElementById('hours1') as HTMLInputElement).value)||0;
        const r2=parseFloat((document.getElementById('rate2') as HTMLInputElement).value);
        const h2=parseFloat((document.getElementById('hours2') as HTMLInputElement).value)||0;
        if(isNaN(r1)||isNaN(r2)||r1<=0||r2<=0) throw 'Enter both hourly rates.';
        totalHours=h1+h2;
        hourlyRate=(r1*h1+r2*h2)/totalHours;
        regularHours=Math.min(totalHours,rule.weeklyOT);
        otHours=Math.max(0,totalHours-rule.weeklyOT);
        regularPay=r1*h1+r2*h2;
        // OT is based on blended rate for hours over 40
        if(otHours>0){
          const regBlended=Math.min(totalHours,rule.weeklyOT);
          const regPayBlended=hourlyRate*regBlended;
          regularPay=regPayBlended;
          otPay=hourlyRate*rule.multiplier*otHours;
        }
      }

      const totalPay=regularPay+otPay+dtPay;
      const effectiveRate=totalHours>0?totalPay/totalHours:hourlyRate;

      document.getElementById('ot-total-pay')!.textContent='$'+totalPay.toLocaleString(undefined,{minimumFractionDigits:2});
      document.getElementById('ot-regular-pay')!.textContent='$'+regularPay.toLocaleString(undefined,{minimumFractionDigits:2});
      document.getElementById('ot-ot-pay')!.textContent='$'+otPay.toLocaleString(undefined,{minimumFractionDigits:2});
      document.getElementById('ot-dt-pay')!.textContent='$'+dtPay.toLocaleString(undefined,{minimumFractionDigits:2});
      document.getElementById('ot-effective-rate')!.textContent='$'+effectiveRate.toLocaleString(undefined,{minimumFractionDigits:2})+'/hr';
      document.getElementById('ot-breakdown')!.innerHTML=`
        <div class="result-row"><span class="result-row-label">⏱️ Regular Rate</span><span class="result-row-value">$${hourlyRate.toFixed(2)}/hr</span></div>
        <div class="result-row"><span class="result-row-label">📋 Regular Hours</span><span class="result-row-value">${regularHours.toFixed(1)} hrs</span></div>
        <div class="result-row"><span class="result-row-label">⏰ Overtime Hours</span><span class="result-row-value">${otHours.toFixed(1)} hrs ($${(hourlyRate*rule.multiplier).toFixed(2)}/hr)</span></div>
        ${dtHours>0?`<div class="result-row"><span class="result-row-label">🔥 Double Time Hours</span><span class="result-row-value">${dtHours.toFixed(1)} hrs ($${(hourlyRate*(rule.doubleMultiplier||2)).toFixed(2)}/hr)</span></div>`:''}
        <div class="result-row" style="border-bottom:none;"><span class="result-row-label">📊 Total Hours</span><span class="result-row-value" style="font-weight:700;">${totalHours.toFixed(1)} hrs</span></div>
      `;
      resEl.hidden=false;
    }catch(e:any){
      document.getElementById('ot-error-msg')!.textContent=typeof e==='string'?e:e.message;
      errEl.hidden=false;
    }
  });

  document.getElementById('reset-ot-btn')!.addEventListener('click',()=>{
    document.querySelectorAll('#ot-calculator input[type=number]').forEach((i:any)=>{i.value='';});
    (document.getElementById('salary-hours') as HTMLInputElement).value='40';
    (document.getElementById('ot-results') as HTMLElement).hidden=true;
  });

  document.querySelectorAll('.faq-question').forEach(btn=>{btn.addEventListener('click',()=>{
    const e=btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded',String(!e));
    document.getElementById(btn.getAttribute('aria-controls')!)?.classList.toggle('open',!e);
  })});
</script>
