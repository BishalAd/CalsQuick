---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { 
    q: 'What is a JSON formatter and validator?', 
    a: 'A JSON formatter and validator is a free online tool that helps developers work with JSON (JavaScript Object Notation) data. It performs three main functions: (1) Validation — checks if your JSON syntax is correct and highlights errors with line numbers and descriptions, (2) Formatting — transforms minified/compressed JSON into readable, indented format (pretty print) or compresses formatted JSON to save space (minify), (3) Analysis — provides a tree view for exploring nested JSON structures, counts objects/arrays/keys, and estimates data size. Our tool processes everything in your browser — your JSON data never leaves your device.' 
  },
  { 
    q: 'How do I fix common JSON errors?', 
    a: 'Our validator identifies common JSON errors with precise line/column numbers: (1) Missing commas between array elements or object properties, (2) Trailing commas after the last element (not allowed in JSON), (3) Unquoted property keys — all keys must be in double quotes, (4) Single quotes instead of double quotes — JSON only accepts double quotes, (5) Comments in JSON — JSON doesn\'t support comments (use "$comment" key as workaround), (6) Missing closing brackets or braces, (7) Invalid escape sequences in strings. Each error shows the exact location and a description of the problem.' 
  },
  { 
    q: 'What is the tree view and how do I use it?', 
    a: 'The interactive tree view displays your JSON data as a collapsible hierarchical structure, similar to a file explorer. Each object and array can be expanded/collapsed to explore nested data. Key features: Click arrows to expand/collapse nodes, See data types with color coding (strings in green, numbers in blue, booleans in purple, null in gray, objects/arrays with distinct icons), Search within the tree to find specific keys or values, Click on any node to copy its JSONPath, and View the size of each node. This is invaluable for understanding large API responses or complex configuration files.' 
  },
  { 
    q: 'How do I query JSON data using JSONPath?', 
    a: 'JSONPath is a query language for JSON, similar to XPath for XML. Our tool includes a JSONPath evaluator where you can write queries to extract specific data. Examples: "$.store.book[0].title" (get first book title), "$..author" (get all authors anywhere in the JSON), "$.store.book[?(@.price < 10)]" (filter books under $10), "$.store.book[-1:]" (get the last book), "$.store.*" (get all children of store). Results are highlighted in both the tree view and a separate results panel. Perfect for testing API responses and data extraction.' 
  },
  { 
    q: 'Can I compare two JSON documents (diff)?', 
    a: 'Yes! Our JSON diff tool compares two JSON documents side-by-side and highlights the differences. It shows: Added keys (present in second JSON but not first), Removed keys (present in first JSON but not second), Changed values (different values for the same key), Unchanged sections (grayed out for context). The diff works on nested structures and arrays, making it perfect for comparing API responses, configuration changes, or database record versions. You can also see a summary of total additions, deletions, and modifications.' 
  },
  { 
    q: 'What export formats are available?', 
    a: 'We support multiple export/conversion formats: Pretty Print JSON (formatted with 2-space indentation), Minified JSON (compressed, no whitespace — smallest file size), CSV (converts flat JSON arrays to CSV format), XML (converts JSON to XML structure), YAML (converts JSON to YAML format — cleaner for configuration files), and Copy to clipboard (formatted or minified). You can also download the formatted JSON as a .json file. Each format is generated in your browser with no data transmission.' 
  },
  { 
    q: 'How large of a JSON file can I format?', 
    a: 'Since processing happens in your browser, limits depend on your device\'s memory. Most modern devices can handle: JSON up to 10MB smoothly, Files with up to 100,000 lines, Deeply nested structures (up to 1000 levels), and Large arrays with thousands of elements. For very large files (>50MB), we recommend using the tree view sparingly and working with the formatted text view. The tool shows a performance warning if your JSON approaches your browser\'s limits. For production use with massive datasets, consider using jq or a desktop tool.' 
  },
  { 
    q: 'Can I edit JSON directly in the tool?', 
    a: 'Yes! Our tool includes a built-in JSON editor with syntax highlighting, auto-indentation, and real-time validation. Features: Syntax highlighting for strings, numbers, booleans, null, and keys, Auto-indentation as you type, Real-time error detection with red underlines, Line numbers for easy reference, Undo/redo support, and Auto-completion suggestions for closing brackets. The editor works like a code editor specifically optimized for JSON editing. Changes are reflected in real-time in the tree view.' 
  },
  { 
    q: 'What\'s the difference between JSON and JavaScript objects?', 
    a: 'While JSON is derived from JavaScript, there are key differences: (1) JSON keys must be double-quoted strings; JavaScript allows unquoted keys, (2) JSON only supports double quotes; JavaScript accepts single quotes, (3) JSON doesn\'t support comments; JavaScript does, (4) JSON doesn\'t allow trailing commas; JavaScript does, (5) JSON is purely data; JavaScript objects can contain functions, (6) JSON only supports null; JavaScript has undefined. Our validator helps catch these differences when converting between JSON and JavaScript.' 
  },
  { 
    q: 'How do I convert JSON to CSV or Excel?', 
    a: 'Our JSON to CSV converter handles flat JSON arrays automatically: Each object in the array becomes a row, Object keys become column headers, Nested objects are flattened with dot notation, and Missing keys in some objects are handled gracefully. For Excel: Export as CSV and open in Excel, or use our formatted output. For complex nested JSON: Use the tree view to explore the structure first, then use JSONPath to extract the specific data you need before converting to CSV. This gives you clean, structured data for spreadsheet analysis.' 
  },
  { 
    q: 'Is my JSON data secure when using this tool?', 
    a: 'Absolutely! 100% of JSON processing happens in your browser using JavaScript. Your data is NEVER sent to any server, cloud, or third-party service. No one can see, access, or intercept your JSON. This is critical because JSON often contains: API keys and authentication tokens, User data and personal information, Business logic and proprietary configurations, Database records, and Financial data. You can verify this by disconnecting your internet after loading the page — all features continue working. For maximum security, use this tool for sensitive production data with complete confidence.' 
  },
  { 
    q: 'What are the best practices for working with JSON?', 
    a: 'Professional JSON best practices: (1) Always validate JSON before using it in production — our validator catches syntax errors instantly, (2) Use consistent indentation (2 spaces is the standard), (3) Avoid deeply nested structures (more than 5-6 levels becomes hard to maintain), (4) Use meaningful, camelCase key names, (5) Don\'t include comments — use a "$comment" or "_comment" key if needed for documentation, (6) Keep JSON files under 1MB when possible for API performance, (7) Minify JSON for production to reduce bandwidth, (8) Always pretty-print JSON in version control for readable diffs.' 
  },
];

const schemas = [
  generateSoftwareApplication({
    name: 'JSON Formatter & Validator — Pretty Print, Validate, Tree View & Diff',
    description: 'Free online JSON formatter, validator, and editor. Pretty print, minify, validate JSON with error highlighting. Interactive tree view, JSONPath query, diff comparison, and export to CSV, XML, YAML.',
    url: '/json-formatter',
  }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Password Generator', href: '/password-generator', icon: '🔐', desc: 'Create strong passwords' },
  { name: 'QR Code Generator', href: '/qr-code-generator', icon: '📱', desc: 'Generate QR codes' },
  { name: 'Color Palette Generator', href: '/color-palette-generator', icon: '🎨', desc: 'Create color schemes' },
  { name: 'Word Counter', href: '/word-counter', icon: '📝', desc: 'Count words & characters' },
];

const sampleJSON = `{
  "store": {
    "name": "Tech Books & More",
    "location": {
      "address": "123 Main Street",
      "city": "San Francisco",
      "state": "CA",
      "zip": "94105"
    },
    "books": [
      {
        "title": "JavaScript: The Good Parts",
        "author": "Douglas Crockford",
        "price": 29.99,
        "inStock": true,
        "tags": ["javascript", "programming", "web"]
      },
      {
        "title": "Clean Code",
        "author": "Robert C. Martin",
        "price": 39.99,
        "inStock": false,
        "tags": ["programming", "best-practices"]
      },
      {
        "title": "Design Patterns",
        "author": "Gang of Four",
        "price": 49.99,
        "inStock": true,
        "tags": ["design", "patterns", "architecture"]
      }
    ],
    "employees": 12,
    "openSince": "2019-03-15"
  }
}`;

const exportFormats = [
  { id: 'pretty', name: 'Pretty Print', icon: '📝' },
  { id: 'minify', name: 'Minify', icon: '📦' },
  { id: 'csv', name: 'CSV', icon: '📊' },
  { id: 'xml', name: 'XML', icon: '📋' },
  { id: 'yaml', name: 'YAML', icon: '📄' },
];
---

<CalculatorLayout
  title="JSON Formatter & Validator — Pretty Print, Validate, Tree View & Diff"
  description="Free online JSON formatter, validator, and editor. Pretty print JSON, validate with error highlighting, explore with tree view, query with JSONPath, compare diffs, and export to CSV/XML/YAML."
  canonical="/json-formatter"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'JSON Formatter', url: '/json-formatter' }]}
  relatedCalcs={relatedCalcs}
>

  <!-- Header -->
  <div style="margin-bottom: 24px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Developer Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">JSON Formatter & Validator</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 700px;">
      Pretty print, validate, and explore JSON data. Interactive tree view, JSONPath querying, diff comparison, and export to CSV, XML, YAML. All processing happens in your browser.
    </p>
  </div>

  <!-- MAIN WORKSPACE -->
  <div class="jf-workspace fade-up stagger-1" style="margin-bottom: 24px;">
    
    <!-- Toolbar -->
    <div class="jf-toolbar">
      <div class="jf-toolbar-left">
        <button id="jf-format-btn" class="btn-primary" style="font-size:13px;padding:8px 16px;">✨ Format / Pretty Print</button>
        <button id="jf-minify-btn" class="btn-secondary" style="font-size:12px;padding:8px 14px;">📦 Minify</button>
        <button id="jf-validate-btn" class="btn-secondary" style="font-size:12px;padding:8px 14px;">✅ Validate</button>
        <button id="jf-clear-btn" class="btn-secondary" style="font-size:12px;padding:8px 14px;">🗑️ Clear</button>
        <button id="jf-sample-btn" class="btn-secondary" style="font-size:12px;padding:8px 14px;">📝 Load Sample</button>
      </div>
      <div class="jf-toolbar-right">
        <button id="jf-copy-btn" class="btn-secondary" style="font-size:12px;padding:8px 14px;">📋 Copy</button>
        <select id="jf-export-select" class="input-base" style="width:auto;font-size:12px;padding:6px 10px;">
          <option value="">📥 Export As...</option>
          {exportFormats.map(f => (
            <option value={f.id}>{f.icon} {f.name}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Editor + Tree View -->
    <div class="jf-main-grid">
      
      <!-- Editor -->
      <div class="jf-editor-panel">
        <div class="jf-editor-header">
          <span class="jf-editor-title">📝 JSON Input</span>
          <span class="jf-editor-stats" id="jf-stats">—</span>
        </div>
        <textarea id="jf-input" class="jf-editor-textarea" placeholder="Paste your JSON here..." spellcheck="false"></textarea>
        <div id="jf-error-panel" class="jf-error-panel" style="display:none;"></div>
      </div>

      <!-- Tree View -->
      <div class="jf-tree-panel">
        <div class="jf-tree-header">
          <span class="jf-editor-title">🌳 Tree View</span>
          <div style="display:flex;gap:6px;">
            <input type="text" id="jf-search" class="input-base" placeholder="🔍 Search keys/values..." style="font-size:11px;padding:4px 10px;width:160px;" />
            <button id="jf-expand-all" class="btn-secondary" style="font-size:10px;padding:4px 10px;">📂 Expand</button>
            <button id="jf-collapse-all" class="btn-secondary" style="font-size:10px;padding:4px 10px;">📁 Collapse</button>
          </div>
        </div>
        <div id="jf-tree-container" class="jf-tree-container">
          <div class="jf-empty-tree">
            <span style="font-size:36px;opacity:0.4;">🌳</span>
            <p style="color:var(--color-muted);font-size:13px;">Enter valid JSON to see tree view</p>
          </div>
        </div>
        <!-- JSONPath -->
        <div class="jf-jsonpath-bar">
          <input type="text" id="jf-jsonpath-input" class="input-base" placeholder="JSONPath query (e.g., $.store.books[0].title)" style="font-size:11px;padding:4px 10px;flex:1;" />
          <button id="jf-jsonpath-btn" class="btn-secondary" style="font-size:11px;padding:4px 12px;">🔍 Query</button>
        </div>
        <div id="jf-jsonpath-results" style="display:none;"></div>
      </div>
    </div>

    <!-- Diff Panel -->
    <div class="jf-diff-section" id="jf-diff-section" style="display:none;">
      <div class="jf-diff-header">
        <span class="jf-editor-title">🔍 JSON Diff Comparison</span>
        <button id="jf-diff-toggle-btn" class="btn-secondary" style="font-size:11px;padding:6px 12px;">Compare Two JSONs</button>
        <button id="jf-diff-close-btn" class="btn-secondary" style="font-size:11px;padding:6px 12px;">✕ Close</button>
      </div>
      <div id="jf-diff-container" class="jf-diff-container">
        <div class="jf-diff-panel">
          <div class="jf-diff-label">📄 Original JSON</div>
          <textarea id="jf-diff-left" class="jf-diff-textarea" placeholder="Paste original JSON..." spellcheck="false"></textarea>
        </div>
        <div class="jf-diff-panel">
          <div class="jf-diff-label">📄 Modified JSON</div>
          <textarea id="jf-diff-right" class="jf-diff-textarea" placeholder="Paste modified JSON..." spellcheck="false"></textarea>
        </div>
      </div>
      <button id="jf-diff-compare-btn" class="btn-primary" style="width:100%;margin-top:8px;">🔍 Compare JSON</button>
      <div id="jf-diff-results" style="display:none;margin-top:10px;"></div>
    </div>
  </div>

  <!-- SEO Article -->
  <div class="prose-section fade-up" style="margin-top:32px;">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:20px;">JSON Formatter & Validator — Essential Developer Tool</h2>
    
    <p class="text-body-md" style="color:var(--color-body);line-height:28px;margin-bottom:16px;">
      JSON (JavaScript Object Notation) is the <strong>universal data format of the web</strong> — used by REST APIs, configuration files, databases (MongoDB, Firebase), and data exchange between virtually every modern application. Our <strong>free JSON formatter and validator</strong> is an essential tool for every developer: format messy JSON into clean, readable code; validate syntax with precise error messages; explore complex nested structures with an interactive tree view; query data with JSONPath; compare two JSON documents with a visual diff; and export to CSV, XML, or YAML. Everything runs locally in your browser — your API responses, config files, and data stay private.
    </p>

    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">Common JSON Errors & How to Fix Them</h3>
    <div style="overflow-x:auto;margin:16px 0 24px;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:14px;color:var(--color-body);text-align:left;">
        <thead>
          <tr style="background:var(--color-canvas-soft-2);border-bottom:1px solid var(--color-hairline);font-weight:600;color:var(--color-ink);">
            <th style="padding:12px 16px;">Error</th>
            <th style="padding:12px 16px;">Example (Wrong)</th>
            <th style="padding:12px 16px;">Fix (Correct)</th>
            <th style="padding:12px 16px;">Detection</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Trailing Comma', '{"name": "John",}', '{"name": "John"}', 'Last item has comma'],
            ['Single Quotes', "{'name': 'John'}", '{"name": "John"}', 'Single quotes found'],
            ['Unquoted Key', '{name: "John"}', '{"name": "John"}', 'Key without quotes'],
            ['Missing Comma', '{"a": 1\n"b": 2}', '{"a": 1,\n"b": 2}', 'No comma between items'],
            ['Comment in JSON', '{// comment\n"a": 1}', '{"a": 1}', '// or /* detected'],
            ['Undefined Value', '{"a": undefined}', '{"a": null}', 'undefined not valid'],
          ].map(([error, wrong, fix, detection]) => (
            <tr style="border-bottom:1px solid var(--color-hairline);">
              <td style="padding:10px 16px;font-weight:600;color:#dc2626;">{error}</td>
              <td style="padding:10px 16px;font-family:var(--font-mono);font-size:12px;color:#dc2626;">{wrong}</td>
              <td style="padding:10px 16px;font-family:var(--font-mono);font-size:12px;color:#10b981;">{fix}</td>
              <td style="padding:10px 16px;color:var(--color-muted);">{detection}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">JSONPath Query Examples</h3>
    <div style="overflow-x:auto;margin:16px 0;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:14px;color:var(--color-body);text-align:left;">
        <thead>
          <tr style="background:var(--color-canvas-soft-2);border-bottom:1px solid var(--color-hairline);font-weight:600;color:var(--color-ink);">
            <th style="padding:12px 16px;">Query</th>
            <th style="padding:12px 16px;">Description</th>
            <th style="padding:12px 16px;">Example Result</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['$.store.name', 'Get a specific property', '"Tech Books & More"'],
            ['$.store.books[*].title', 'Get all book titles', '["JavaScript: The Good Parts", ...]'],
            ['$..author', 'Find all authors anywhere', '["Douglas Crockford", ...]'],
            ['$.store.books[0]', 'Get first book', '{title: "JavaScript: The Good Parts", ...}'],
            ['$.store.books[-1:]', 'Get last book', '{title: "Design Patterns", ...}'],
            ['$.store.books[?(@.price < 35)]', 'Filter by condition', 'Books under $35'],
            ['$.store.*', 'All children of store', '[books array, employees, ...]'],
            ['$.store.books.length', 'Count array elements', '3'],
          ].map(([query, desc, result]) => (
            <tr style="border-bottom:1px solid var(--color-hairline);">
              <td style="padding:10px 16px;font-family:var(--font-mono);font-size:13px;color:var(--color-link);font-weight:600;">{query}</td>
              <td style="padding:10px 16px;">{desc}</td>
              <td style="padding:10px 16px;color:var(--color-muted);">{result}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- FAQ -->
  <div style="margin-top:48px;" class="fade-up">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top:1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`jf-faq-${i}`} id={`jf-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`jf-faq-${i}`} role="region" aria-labelledby={`jf-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>

</CalculatorLayout>

<style>
  .jf-workspace {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    overflow: hidden;
  }

  .jf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--color-canvas-soft-2);
    border-bottom: 1px solid var(--color-hairline);
    flex-wrap: wrap;
    gap: 8px;
  }
  .jf-toolbar-left, .jf-toolbar-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .jf-main-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 0;
    min-height: 500px;
  }

  /* Editor */
  .jf-editor-panel {
    border-right: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
  }
  .jf-editor-header, .jf-tree-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background: var(--color-canvas-soft-2);
    border-bottom: 1px solid var(--color-hairline);
    gap: 8px;
  }
  .jf-editor-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .jf-editor-stats {
    font-size: 10px;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }
  .jf-editor-textarea {
    flex: 1;
    width: 100%;
    border: none;
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    resize: none;
    outline: none;
    background: var(--color-canvas);
    color: var(--color-ink);
    min-height: 400px;
    tab-size: 2;
  }
  .jf-editor-textarea:focus {
    box-shadow: inset 0 0 0 2px var(--color-link);
  }

  /* Error Panel */
  .jf-error-panel {
    padding: 12px 16px;
    background: #fef2f2;
    border-top: 2px solid #dc2626;
    font-size: 13px;
    color: #991b1b;
    font-family: var(--font-mono);
    line-height: 1.6;
  }
  .jf-error-panel.success {
    background: #ecfdf5;
    border-top: 2px solid #10b981;
    color: #065f46;
  }

  /* Tree View */
  .jf-tree-panel {
    display: flex;
    flex-direction: column;
    max-height: 600px;
  }
  .jf-tree-container {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
  }
  .jf-empty-tree {
    text-align: center;
    padding: 40px 20px;
  }

  .jf-tree-node {
    cursor: pointer;
    user-select: none;
  }
  .jf-tree-toggle {
    display: inline-block;
    width: 16px;
    text-align: center;
    font-size: 10px;
    color: var(--color-muted);
    transition: transform 0.15s;
  }
  .jf-tree-toggle.expanded { transform: rotate(90deg); }
  .jf-tree-key { color: #881391; font-weight: 500; }
  .jf-tree-string { color: #0a6b3c; }
  .jf-tree-number { color: #1a56db; }
  .jf-tree-boolean { color: #7c3aed; }
  .jf-tree-null { color: #6b7280; font-style: italic; }
  .jf-tree-bracket { color: var(--color-muted); }
  .jf-tree-count { color: var(--color-muted); font-size: 10px; margin-left: 4px; }
  .jf-tree-highlight { background: #fef3c7; border-radius: 2px; padding: 0 2px; }

  /* JSONPath */
  .jf-jsonpath-bar {
    display: flex;
    gap: 6px;
    padding: 8px;
    border-top: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
  }
  .jf-jsonpath-results {
    padding: 10px;
    background: #ecfdf5;
    border-top: 1px solid #a7f3d0;
    font-family: var(--font-mono);
    font-size: 12px;
    max-height: 150px;
    overflow-y: auto;
    white-space: pre-wrap;
    color: #065f46;
  }

  /* Diff */
  .jf-diff-section {
    border-top: 1px solid var(--color-hairline);
    padding: 14px;
  }
  .jf-diff-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .jf-diff-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .jf-diff-panel {
    display: flex;
    flex-direction: column;
  }
  .jf-diff-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 4px;
  }
  .jf-diff-textarea {
    width: 100%;
    height: 150px;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    padding: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    resize: vertical;
    background: var(--color-canvas);
    color: var(--color-ink);
  }
  .jf-diff-added { background: #dcfce7; color: #166534; }
  .jf-diff-removed { background: #fef2f2; color: #991b1b; text-decoration: line-through; }
  .jf-diff-changed { background: #fef3c7; color: #92400e; }

  .prose-section {
    padding: 32px;
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
  }

  @media (max-width: 900px) {
    .jf-main-grid {
      grid-template-columns: 1fr;
    }
    .jf-editor-panel { border-right: none; border-bottom: 1px solid var(--color-hairline); }
    .jf-tree-panel { max-height: 400px; }
    .jf-diff-container { grid-template-columns: 1fr; }
    .prose-section { padding: 20px 16px; }
  }
</style>

<script>
  // ─── State ────────────────────────────────────────────────────────────────────
  let parsedJSON: any = null;
  let formattedJSON = '';

  // ─── Format & Validate ───────────────────────────────────────────────────────
  function formatJSON(pretty: boolean = true) {
    const input = (document.getElementById('jf-input') as HTMLTextAreaElement).value.trim();
    const errorPanel = document.getElementById('jf-error-panel')!;
    const treeContainer = document.getElementById('jf-tree-container')!;
    
    if (!input) {
      errorPanel.style.display = '';
      errorPanel.className = 'jf-error-panel';
      errorPanel.innerHTML = '⚠️ Please enter JSON data.';
      treeContainer.innerHTML = '<div class="jf-empty-tree"><span style="font-size:36px;opacity:0.4;">🌳</span><p style="color:var(--color-muted);font-size:13px;">Enter valid JSON to see tree view</p></div>';
      updateStats();
      return;
    }

    try {
      parsedJSON = JSON.parse(input);
      errorPanel.style.display = '';
      errorPanel.className = 'jf-error-panel success';
      
      const size = new Blob([input]).size;
      const keys = countKeys(parsedJSON);
      errorPanel.innerHTML = `✅ Valid JSON • ${keys} keys • ${formatSize(size)} • ${getDepth(parsedJSON)} levels deep`;
      
      formattedJSON = JSON.stringify(parsedJSON, null, pretty ? 2 : 0);
      if (pretty) {
        (document.getElementById('jf-input') as HTMLTextAreaElement).value = formattedJSON;
      }
      
      renderTree(parsedJSON);
      updateStats();
      
    } catch(e: any) {
      errorPanel.style.display = '';
      errorPanel.className = 'jf-error-panel';
      
      // Extract line and position from error message
      const match = e.message.match(/position (\d+)/);
      let errorMsg = e.message;
      if (match) {
        const pos = parseInt(match[1]);
        const lines = input.substring(0, pos).split('\n');
        const line = lines.length;
        const col = lines[lines.length - 1].length + 1;
        errorMsg = `❌ Line ${line}, Column ${col}: ${e.message.replace(/at position \d+/, '')}`;
      }
      
      errorPanel.innerHTML = errorMsg;
      treeContainer.innerHTML = '<div class="jf-empty-tree"><span style="font-size:36px;opacity:0.4;">❌</span><p style="color:#dc2626;font-size:13px;">Invalid JSON — fix errors to see tree view</p></div>';
      updateStats();
    }
  }

  function countKeys(obj: any): number {
    if (typeof obj !== 'object' || obj === null) return 0;
    if (Array.isArray(obj)) return obj.reduce((sum, item) => sum + countKeys(item), 0);
    return Object.keys(obj).length + Object.values(obj).reduce((sum: number, val: any) => sum + countKeys(val), 0);
  }

  function getDepth(obj: any): number {
    if (typeof obj !== 'object' || obj === null) return 0;
    if (Array.isArray(obj)) return 1 + Math.max(0, ...obj.map(getDepth));
    return 1 + Math.max(0, ...Object.values(obj).map(getDepth));
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    return (bytes / 1024).toFixed(1) + ' KB';
  }

  function updateStats() {
    const input = (document.getElementById('jf-input') as HTMLTextAreaElement).value;
    const lines = input.split('\n').length;
    const chars = input.length;
    document.getElementById('jf-stats')!.textContent = `${lines} lines • ${chars} chars`;
  }

  // ─── Tree View ───────────────────────────────────────────────────────────────
  function renderTree(data: any) {
    const container = document.getElementById('jf-tree-container')!;
    container.innerHTML = '';
    container.appendChild(buildTreeNode('root', data, '$'));
    updateTreeVisibility();
  }

  function buildTreeNode(key: string, value: any, path: string): HTMLElement {
    const node = document.createElement('div');
    node.className = 'jf-tree-node';
    node.dataset.path = path;
    
    const type = value === null ? 'null' : Array.isArray(value) ? 'array' : typeof value;
    
    if (type === 'object' || type === 'array') {
      const entries = type === 'array' ? value.map((v: any, i: number) => [String(i), v]) : Object.entries(value);
      const count = entries.length;
      const bracket = type === 'array' ? ['[', ']'] : ['{', '}'];
      
      const header = document.createElement('span');
      header.className = 'jf-tree-header';
      header.innerHTML = `
        <span class="jf-tree-toggle expanded">▶</span>
        <span class="jf-tree-key">${key}</span>: 
        <span class="jf-tree-bracket">${bracket[0]}</span>
        <span class="jf-tree-count">${count} item${count !== 1 ? 's' : ''}</span>
      `;
      header.addEventListener('click', (e) => {
        e.stopPropagation();
        const toggle = header.querySelector('.jf-tree-toggle')!;
        toggle.classList.toggle('expanded');
        const children = node.querySelector('.jf-tree-children') as HTMLElement;
        if (children) children.style.display = toggle.classList.contains('expanded') ? '' : 'none';
      });
      node.appendChild(header);
      
      const children = document.createElement('div');
      children.className = 'jf-tree-children';
      children.style.marginLeft = '20px';
      
      entries.forEach(([k, v]: [string, any]) => {
        children.appendChild(buildTreeNode(k, v, type === 'array' ? `${path}[${k}]` : `${path}.${k}`));
      });
      
      const footer = document.createElement('div');
      footer.style.marginLeft = '20px';
      footer.innerHTML = `<span class="jf-tree-bracket">${bracket[1]}</span>`;
      children.appendChild(footer);
      
      node.appendChild(children);
    } else {
      const valClass = type === 'string' ? 'jf-tree-string' : 
                       type === 'number' ? 'jf-tree-number' : 
                       type === 'boolean' ? 'jf-tree-boolean' : 'jf-tree-null';
      const displayVal = type === 'string' ? `"${value}"` : String(value);
      
      node.innerHTML = `
        <span style="margin-left:16px;"></span>
        <span class="jf-tree-key">${key}</span>: 
        <span class="${valClass}" data-value="${displayVal}">${displayVal}</span>
      `;
    }
    
    return node;
  }

  function updateTreeVisibility() {
    // Apply search highlighting
    const searchTerm = ((document.getElementById('jf-search') as HTMLInputElement).value || '').toLowerCase();
    const container = document.getElementById('jf-tree-container')!;
    
    container.querySelectorAll('.jf-tree-highlight').forEach(el => {
      el.classList.remove('jf-tree-highlight');
    });
    
    if (searchTerm) {
      container.querySelectorAll('[data-value]').forEach(el => {
        if ((el as HTMLElement).dataset.value?.toLowerCase().includes(searchTerm)) {
          el.classList.add('jf-tree-highlight');
        }
      });
    }
  }

  document.getElementById('jf-search')!.addEventListener('input', updateTreeVisibility);
  document.getElementById('jf-expand-all')!.addEventListener('click', () => {
    document.querySelectorAll('.jf-tree-toggle').forEach(t => t.classList.add('expanded'));
    document.querySelectorAll('.jf-tree-children').forEach(c => (c as HTMLElement).style.display = '');
  });
  document.getElementById('jf-collapse-all')!.addEventListener('click', () => {
    document.querySelectorAll('.jf-tree-toggle').forEach(t => t.classList.remove('expanded'));
    document.querySelectorAll('.jf-tree-children').forEach(c => (c as HTMLElement).style.display = 'none');
  });

  // ─── JSONPath ─────────────────────────────────────────────────────────────────
  document.getElementById('jf-jsonpath-btn')!.addEventListener('click', () => {
    const query = (document.getElementById('jf-jsonpath-input') as HTMLInputElement).value.trim();
    if (!query || !parsedJSON) return;
    
    const resultsDiv = document.getElementById('jf-jsonpath-results')!;
    resultsDiv.style.display = '';
    
    try {
      const results = evaluateJSONPath(parsedJSON, query);
      if (results.length === 0) {
        resultsDiv.innerHTML = '<span style="color:var(--color-muted);">No matches found for this query.</span>';
      } else {
        resultsDiv.innerHTML = results.map((r: any) => 
          `<div style="margin-bottom:4px;">• ${JSON.stringify(r, null, 0).substring(0, 200)}</div>`
        ).join('');
      }
    } catch(e) {
      resultsDiv.innerHTML = `<span style="color:#dc2626;">Invalid query syntax.</span>`;
    }
  });

  function evaluateJSONPath(data: any, query: string): any[] {
    // Simplified JSONPath implementation
    const results: any[] = [];
    
    // $.key - direct child
    if (query.startsWith('$.')) {
      const path = query.substring(2);
      if (!path.includes('.') && !path.includes('[')) {
        if (data && typeof data === 'object' && path in data) {
          return [data[path]];
        }
      }
    }
    
    // $..key - recursive search
    if (query.startsWith('$..')) {
      const key = query.substring(3);
      searchRecursive(data, key, results);
      return results;
    }
    
    // Try to evaluate nested path
    try {
      const parts = query.substring(2).split('.');
      let current = data;
      for (const part of parts) {
        const bracketMatch = part.match(/^(\w+)\[(\d+)\]$/);
        if (bracketMatch) {
          current = current[bracketMatch[1]]?.[parseInt(bracketMatch[2])];
        } else {
          current = current?.[part];
        }
        if (current === undefined) return [];
      }
      return [current];
    } catch(e) {
      return [];
    }
  }

  function searchRecursive(obj: any, key: string, results: any[]) {
    if (typeof obj !== 'object' || obj === null) return;
    if (Array.isArray(obj)) {
      obj.forEach(item => searchRecursive(item, key, results));
    } else {
      if (key in obj) results.push(obj[key]);
      Object.values(obj).forEach(val => searchRecursive(val, key, results));
    }
  }

  // ─── Diff ─────────────────────────────────────────────────────────────────────
  document.getElementById('jf-diff-toggle-btn')!.addEventListener('click', () => {
    document.getElementById('jf-diff-section')!.style.display = '';
    document.getElementById('jf-diff-results')!.style.display = 'none';
  });

  document.getElementById('jf-diff-close-btn')!.addEventListener('click', () => {
    document.getElementById('jf-diff-section')!.style.display = 'none';
  });

  document.getElementById('jf-diff-compare-btn')!.addEventListener('click', () => {
    const leftInput = (document.getElementById('jf-diff-left') as HTMLTextAreaElement).value.trim();
    const rightInput = (document.getElementById('jf-diff-right') as HTMLTextAreaElement).value.trim();
    const resultsDiv = document.getElementById('jf-diff-results')!;
    
    if (!leftInput || !rightInput) {
      resultsDiv.style.display = '';
      resultsDiv.innerHTML = '<p style="color:#dc2626;">Please enter JSON in both panels.</p>';
      return;
    }

    try {
      const left = JSON.parse(leftInput);
      const right = JSON.parse(rightInput);
      const diff = compareJSON(left, right);
      
      resultsDiv.style.display = '';
      resultsDiv.innerHTML = `
        <div style="display:flex;gap:16px;margin-bottom:10px;font-size:13px;">
          <span style="color:#10b981;">+${diff.added} added</span>
          <span style="color:#dc2626;">-${diff.removed} removed</span>
          <span style="color:#f59e0b;">~${diff.changed} changed</span>
          <span style="color:var(--color-muted);">${diff.unchanged} unchanged</span>
        </div>
        <div style="font-family:var(--font-mono);font-size:12px;line-height:1.8;max-height:300px;overflow-y:auto;background:var(--color-canvas-soft-2);border-radius:6px;padding:12px;">
          ${diff.details.map((d: any) => `
            <div class="jf-diff-${d.type}">${d.type === 'added' ? '+ ' : d.type === 'removed' ? '- ' : '~ '}${d.path}: ${JSON.stringify(d.value).substring(0, 100)}</div>
          `).join('')}
        </div>
      `;
    } catch(e) {
      resultsDiv.style.display = '';
      resultsDiv.innerHTML = `<p style="color:#dc2626;">Invalid JSON in one or both panels.</p>`;
    }
  });

  function compareJSON(left: any, right: any, path: string = '$'): { added: number; removed: number; changed: number; unchanged: number; details: any[] } {
    const result = { added: 0, removed: 0, changed: 0, unchanged: 0, details: [] as any[] };
    
    if (typeof left !== typeof right || (typeof left !== 'object' && left !== right)) {
      result.changed = 1;
      result.details.push({ type: 'changed', path, value: right });
      return result;
    }
    
    if (typeof left !== 'object' || left === null) {
      if (left === right) { result.unchanged = 1; }
      else { result.changed = 1; result.details.push({ type: 'changed', path, value: right }); }
      return result;
    }
    
    const allKeys = new Set([...Object.keys(left || {}), ...Object.keys(right || {})]);
    for (const key of allKeys) {
      if (!(key in left)) {
        result.added++;
        result.details.push({ type: 'added', path: `${path}.${key}`, value: right[key] });
      } else if (!(key in right)) {
        result.removed++;
        result.details.push({ type: 'removed', path: `${path}.${key}`, value: left[key] });
      } else {
        const sub = compareJSON(left[key], right[key], `${path}.${key}`);
        result.added += sub.added;
        result.removed += sub.removed;
        result.changed += sub.changed;
        result.unchanged += sub.unchanged;
        result.details.push(...sub.details);
      }
    }
    
    return result;
  }

  // ─── Export ───────────────────────────────────────────────────────────────────
  document.getElementById('jf-export-select')!.addEventListener('change', function() {
    const format = (this as HTMLSelectElement).value;
    if (!format || !parsedJSON) return;
    
    let output = '';
    let mime = 'text/plain';
    let ext = 'txt';
    
    switch(format) {
      case 'pretty':
        output = JSON.stringify(parsedJSON, null, 2);
        mime = 'application/json';
        ext = 'json';
        break;
      case 'minify':
        output = JSON.stringify(parsedJSON);
        mime = 'application/json';
        ext = 'json';
        break;
      case 'csv':
        output = jsonToCSV(parsedJSON);
        mime = 'text/csv';
        ext = 'csv';
        break;
      case 'xml':
        output = jsonToXML(parsedJSON);
        mime = 'application/xml';
        ext = 'xml';
        break;
      case 'yaml':
        output = jsonToYAML(parsedJSON);
        mime = 'text/yaml';
        ext = 'yaml';
        break;
    }
    
    const blob = new Blob([output], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `formatted.${ext}`;
    a.click();
    URL.revokeObjectURL(url);
    (this as HTMLSelectElement).value = '';
  });

  function jsonToCSV(data: any): string {
    if (!Array.isArray(data)) {
      if (typeof data === 'object' && data !== null) {
        // Single object
        const keys = Object.keys(data);
        return keys.join(',') + '\n' + keys.map(k => JSON.stringify(data[k])).join(',');
      }
      return String(data);
    }
    if (data.length === 0) return '';
    const keys = Object.keys(data[0]);
    const rows = data.map(row => keys.map(k => {
      const val = row[k];
      return typeof val === 'string' ? `"${val.replace(/"/g, '""')}"` : val;
    }).join(','));
    return [keys.join(','), ...rows].join('\n');
  }

  function jsonToXML(data: any, rootName: string = 'root'): string {
    const build = (obj: any, name: string): string => {
      if (obj === null) return `<${name}>null</${name}>`;
      if (typeof obj !== 'object') return `<${name}>${obj}</${name}>`;
      if (Array.isArray(obj)) {
        return obj.map((item, i) => build(item, `${name}_${i}`)).join('\n');
      }
      const children = Object.entries(obj).map(([k, v]) => build(v, k)).join('\n');
      return `<${name}>\n${children}\n</${name}>`;
    };
    return '<?xml version="1.0" encoding="UTF-8"?>\n' + build(data, rootName);
  }

  function jsonToYAML(data: any, indent: number = 0): string {
    const spaces = '  '.repeat(indent);
    if (data === null) return 'null';
    if (typeof data !== 'object') return String(data);
    if (Array.isArray(data)) {
      return data.map(item => `${spaces}- ${jsonToYAML(item, indent + 1).trimStart()}`).join('\n');
    }
    return Object.entries(data).map(([k, v]) => {
      if (typeof v === 'object' && v !== null) {
        return `${spaces}${k}:\n${jsonToYAML(v, indent + 1)}`;
      }
      return `${spaces}${k}: ${jsonToYAML(v, 0)}`;
    }).join('\n');
  }

  // ─── Event Listeners ─────────────────────────────────────────────────────────
  document.getElementById('jf-format-btn')!.addEventListener('click', () => formatJSON(true));
  document.getElementById('jf-minify-btn')!.addEventListener('click', () => formatJSON(false));
  document.getElementById('jf-validate-btn')!.addEventListener('click', () => formatJSON(true));
  document.getElementById('jf-clear-btn')!.addEventListener('click', () => {
    (document.getElementById('jf-input') as HTMLTextAreaElement).value = '';
    parsedJSON = null;
    document.getElementById('jf-error-panel')!.style.display = 'none';
    document.getElementById('jf-tree-container')!.innerHTML = '<div class="jf-empty-tree"><span style="font-size:36px;opacity:0.4;">🌳</span><p style="color:var(--color-muted);font-size:13px;">Enter valid JSON to see tree view</p></div>';
    updateStats();
  });
  document.getElementById('jf-sample-btn')!.addEventListener('click', () => {
    (document.getElementById('jf-input') as HTMLTextAreaElement).value = sampleJSON;
    formatJSON(true);
  });
  document.getElementById('jf-copy-btn')!.addEventListener('click', async () => {
    const text = (document.getElementById('jf-input') as HTMLTextAreaElement).value;
    try { await navigator.clipboard.writeText(text); } catch {}
  });

  // Live formatting on input (debounced)
  let debounceTimer: ReturnType<typeof setTimeout>;
  document.getElementById('jf-input')!.addEventListener('input', () => {
    updateStats();
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => formatJSON(true), 500);
  });

  // ─── Init ──────────────────────────────────────────────────────────────────
  (document.getElementById('jf-input') as HTMLTextAreaElement).value = sampleJSON;
  formatJSON(true);

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>