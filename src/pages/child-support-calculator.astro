<script>
  const STATE_MODELS: Record<string, { model: string; name: string; pcts?: number[] }> = {
    AL:{model:'income_shares',name:'Alabama'},AK:{model:'percentage',name:'Alaska',pcts:[27,35.3,43.2,50.3,57.7]},
    AZ:{model:'income_shares',name:'Arizona'},AR:{model:'income_shares',name:'Arkansas'},
    CA:{model:'income_shares',name:'California'},CO:{model:'income_shares',name:'Colorado'},
    CT:{model:'income_shares',name:'Connecticut'},DE:{model:'melson',name:'Delaware'},
    FL:{model:'income_shares',name:'Florida'},GA:{model:'income_shares',name:'Georgia'},
    HI:{model:'melson',name:'Hawaii'},ID:{model:'income_shares',name:'Idaho'},
    IL:{model:'percentage',name:'Illinois',pcts:[20,28,32,40,45]},
    IN:{model:'income_shares',name:'Indiana'},IA:{model:'income_shares',name:'Iowa'},
    KS:{model:'income_shares',name:'Kansas'},KY:{model:'income_shares',name:'Kentucky'},
    LA:{model:'income_shares',name:'Louisiana'},ME:{model:'income_shares',name:'Maine'},
    MD:{model:'income_shares',name:'Maryland'},MA:{model:'income_shares',name:'Massachusetts'},
    MI:{model:'income_shares',name:'Michigan'},MN:{model:'income_shares',name:'Minnesota'},
    MS:{model:'income_shares',name:'Mississippi'},MO:{model:'income_shares',name:'Missouri'},
    MT:{model:'melson',name:'Montana'},NE:{model:'income_shares',name:'Nebraska'},
    NV:{model:'income_shares',name:'Nevada'},NH:{model:'income_shares',name:'New Hampshire'},
    NJ:{model:'income_shares',name:'New Jersey'},NM:{model:'income_shares',name:'New Mexico'},
    NY:{model:'income_shares',name:'New York'},NC:{model:'income_shares',name:'North Carolina'},
    ND:{model:'income_shares',name:'North Dakota'},OH:{model:'income_shares',name:'Ohio'},
    OK:{model:'income_shares',name:'Oklahoma'},OR:{model:'income_shares',name:'Oregon'},
    PA:{model:'income_shares',name:'Pennsylvania'},RI:{model:'income_shares',name:'Rhode Island'},
    SC:{model:'income_shares',name:'South Carolina'},SD:{model:'income_shares',name:'South Dakota'},
    TN:{model:'income_shares',name:'Tennessee'},TX:{model:'percentage',name:'Texas',pcts:[20,25,30,35,40]},
    UT:{model:'income_shares',name:'Utah'},VT:{model:'income_shares',name:'Vermont'},
    VA:{model:'income_shares',name:'Virginia'},WA:{model:'income_shares',name:'Washington'},
    WV:{model:'income_shares',name:'West Virginia'},WI:{model:'percentage',name:'Wisconsin',pcts:[17,25,29,31,34]},
    WY:{model:'income_shares',name:'Wyoming'},DC:{model:'income_shares',name:'Washington D.C.'},
  };

  // Basic obligation table (Income Shares) — simplified guideline for 1 child
  // Returns monthly obligation based on combined gross income
  function getBaseObligation(combinedMonthly: number, children: number): number {
    // Simplified schedule per child — courts use detailed tables
    const perChildRate = children === 1 ? 0.17 : children === 2 ? 0.14 : children === 3 ? 0.12 : children === 4 ? 0.10 : 0.09;
    const base = combinedMonthly * perChildRate * children;
    return Math.min(base, combinedMonthly * 0.50); // cap at 50% of combined
  }

  const fmt = (n: number) => '$' + Math.round(n).toLocaleString();
  let numChildren = 1;
  let custodyType = 'sole';

  // State change
  document.getElementById('cs-state')!.addEventListener('change', (e) => {
    const code = (e.target as HTMLSelectElement).value;
    const wrap = document.getElementById('model-badge-wrap') as HTMLElement;
    if (code && STATE_MODELS[code]) {
      const s = STATE_MODELS[code];
      const names: Record<string, string> = { income_shares: 'Income Shares Model', percentage: 'Percentage of Income Model', melson: 'Melson Formula' };
      const descs: Record<string, string> = {
        income_shares: 'Both parents\' incomes combined, proportionally shared',
        percentage: 'Fixed % of paying parent\'s net income',
        melson: 'Complex formula with self-support reserves'
      };
      (document.getElementById('model-badge-text') as HTMLElement).textContent = names[s.model];
      (document.getElementById('model-desc-text') as HTMLElement).textContent = descs[s.model];
      wrap.hidden = false;
    } else { wrap.hidden = true; }
  });

  // Children buttons
  document.querySelectorAll('.child-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      numChildren = parseInt((btn as HTMLElement).dataset.children!);
      document.querySelectorAll('.child-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
    });
  });

  // Custody
  document.querySelectorAll('.custody-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      custodyType = (btn as HTMLElement).dataset.custody!;
      document.querySelectorAll('.custody-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      (document.getElementById('parenting-time-wrap') as HTMLElement).hidden = custodyType !== 'shared';
    });
  });

  // Parenting time slider sync
  const ptSlider = document.getElementById('parenting-slider') as HTMLInputElement;
  const ptInput = document.getElementById('paying-pct') as HTMLInputElement;
  ptSlider.addEventListener('input', () => { ptInput.value = ptSlider.value; });
  ptInput.addEventListener('input', () => { ptSlider.value = ptInput.value; });

  // Income quick buttons
  document.querySelectorAll('.income-quick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = (btn as HTMLElement).dataset.val!;
      const target = (btn as HTMLElement).dataset.target!;
      (document.getElementById(target) as HTMLInputElement).value = val;
    });
  });

  let lastMonthlySupport = 0;

  document.getElementById('calc-cs-btn')!.addEventListener('click', () => {
    const errorEl = document.getElementById('cs-error') as HTMLElement;
    const resultsEl = document.getElementById('cs-results') as HTMLElement;
    errorEl.hidden = true;

    const stateCode = (document.getElementById('cs-state') as HTMLSelectElement).value;
    if (!stateCode || !STATE_MODELS[stateCode]) {
      document.getElementById('cs-error-msg')!.textContent = 'Please select your state.';
      errorEl.hidden = false; return;
    }

    const payingIncome = parseFloat((document.getElementById('paying-income') as HTMLInputElement).value);
    const receivingIncome = parseFloat((document.getElementById('receiving-income') as HTMLInputElement).value) || 0;

    if (!payingIncome || payingIncome <= 0) {
      document.getElementById('cs-error-msg')!.textContent = 'Please enter the paying parent\'s monthly income.';
      errorEl.hidden = false; return;
    }

    const stateInfo = STATE_MODELS[stateCode];
    const childcare = parseFloat((document.getElementById('childcare-cost') as HTMLInputElement).value) || 0;
    const healthIns = parseFloat((document.getElementById('health-insurance') as HTMLInputElement).value) || 0;
    const medical = parseFloat((document.getElementById('medical-expenses') as HTMLInputElement).value) || 0;
    const education = parseFloat((document.getElementById('education-cost') as HTMLInputElement).value) || 0;
    const totalExtras = childcare + healthIns + medical + education;
    const parentingTimePct = parseFloat(ptInput.value) / 100 || 0.35;

    let baseSupport = 0;
    let payerShare = 0;
    const combined = payingIncome + receivingIncome;

    if (stateInfo.model === 'percentage') {
      const pcts = stateInfo.pcts || [20, 25, 30, 35, 40];
      const idx = Math.min(numChildren - 1, pcts.length - 1);
      const netIncome = payingIncome * 0.75; // approximate net
      baseSupport = netIncome * (pcts[idx] / 100);
      payerShare = 100;
    } else {
      // Income shares / Melson approximation
      baseSupport = getBaseObligation(combined, numChildren);
      payerShare = combined > 0 ? (payingIncome / combined) * 100 : 50;
      baseSupport = baseSupport * (payerShare / 100);
    }

    // Extras — paying parent's proportional share
    const extrasPayerShare = totalExtras * (payerShare / 100);

    // Shared custody reduction
    let custodyAdj = 0;
    if (custodyType === 'shared') {
      custodyAdj = baseSupport * parentingTimePct;
    } else if (custodyType === 'primary') {
      custodyAdj = baseSupport * 0.10; // small reduction for visitation
    }

    const total = Math.max(0, baseSupport + extrasPayerShare - custodyAdj);
    lastMonthlySupport = total;

    // Update results
    const modelNames: Record<string,string> = { income_shares:'Income Shares', percentage:'Percentage', melson:'Melson Formula' };
    (document.getElementById('cs-res-state') as HTMLElement).textContent = stateInfo.name + ' Child Support';
    (document.getElementById('cs-model-badge') as HTMLElement).textContent = modelNames[stateInfo.model];
    (document.getElementById('res-monthly-support') as HTMLElement).textContent = fmt(total);
    (document.getElementById('res-children-count') as HTMLElement).textContent = `for ${numChildren} child${numChildren>1?'ren':''}`;
    (document.getElementById('res-annual-support') as HTMLElement).textContent = fmt(total * 12);
    (document.getElementById('res-pct-income') as HTMLElement).textContent = (total / payingIncome * 100).toFixed(1) + '%';

    (document.getElementById('rb-paying-income') as HTMLElement).textContent = fmt(payingIncome) + '/mo';
    (document.getElementById('rb-receiving-income') as HTMLElement).textContent = fmt(receivingIncome) + '/mo';
    (document.getElementById('rb-combined') as HTMLElement).textContent = fmt(combined) + '/mo';
    (document.getElementById('rb-payer-share') as HTMLElement).textContent = payerShare.toFixed(1) + '%';
    (document.getElementById('rb-base-support') as HTMLElement).textContent = fmt(baseSupport) + '/mo';

    const extrasRow = document.getElementById('rb-extras-row') as HTMLElement;
    if (totalExtras > 0) {
      (document.getElementById('rb-extras') as HTMLElement).textContent = fmt(extrasPayerShare) + '/mo';
      extrasRow.hidden = false;
    } else { extrasRow.hidden = true; }

    const custodyRow = document.getElementById('rb-custody-row') as HTMLElement;
    if (custodyAdj > 0) {
      (document.getElementById('rb-custody-adj') as HTMLElement).textContent = `−${fmt(custodyAdj)}/mo`;
      custodyRow.hidden = false;
    } else { custodyRow.hidden = true; }

    (document.getElementById('rb-total') as HTMLElement).textContent = fmt(total) + '/mo';

    // Income bar
    const payerPct = combined > 0 ? (payingIncome / combined * 100) : 50;
    const recPct = 100 - payerPct;
    (document.getElementById('income-bar-payer') as HTMLElement).style.width = payerPct + '%';
    (document.getElementById('income-bar-receiver') as HTMLElement).style.width = recPct + '%';
    (document.getElementById('ibar-payer-pct') as HTMLElement).textContent = payerPct.toFixed(1) + '%';
    (document.getElementById('ibar-receiver-pct') as HTMLElement).textContent = recPct.toFixed(1) + '%';

    // Duration
    (document.getElementById('dur-5') as HTMLElement).textContent = fmt(total * 12 * 5);
    (document.getElementById('dur-10') as HTMLElement).textContent = fmt(total * 12 * 10);
    (document.getElementById('dur-18') as HTMLElement).textContent = '—';
    (document.getElementById('dur-22') as HTMLElement).textContent = '—';

    resultsEl.hidden = false;
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // Duration with child age
  document.getElementById('calc-duration-btn')!.addEventListener('click', () => {
    if (lastMonthlySupport <= 0) return;
    const age = parseFloat((document.getElementById('child-age-input') as HTMLInputElement).value);
    if (isNaN(age) || age < 0 || age > 17) return;
    const yrsTo18 = Math.max(0, 18 - age);
    const yrsTo22 = Math.max(0, 22 - age);
    (document.getElementById('dur-18') as HTMLElement).textContent = fmt(lastMonthlySupport * 12 * yrsTo18);
    (document.getElementById('dur-22') as HTMLElement).textContent = fmt(lastMonthlySupport * 12 * yrsTo22);
  });

  document.getElementById('clear-cs-btn')!.addEventListener('click', () => {
    (document.getElementById('cs-state') as HTMLSelectElement).value = '';
    (document.getElementById('model-badge-wrap') as HTMLElement).hidden = true;
    ['paying-income','receiving-income','childcare-cost','health-insurance','medical-expenses','education-cost','child-age-input'].forEach(id => {
      (document.getElementById(id) as HTMLInputElement).value = '';
    });
    (document.getElementById('cs-results') as HTMLElement).hidden = true;
    (document.getElementById('cs-error') as HTMLElement).hidden = true;
  });

  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
