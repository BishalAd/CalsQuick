  }
  .copy-btn:hover { background: var(--color-canvas-soft-2); color: var(--color-ink); border-color: var(--color-hairline-strong); }
  .copy-btn.copied { background: var(--color-success-soft, #d1fae5); color: #065f46; border-color: #6ee7b7; }

  /* ─── Details Grid ─── */
  .ip-details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .ip-detail-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    position: relative;
  }
  .ip-detail-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
  .ip-detail-body { flex: 1; min-width: 0; }
  .ip-detail-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    font-family: var(--font-mono);
    margin-bottom: 4px;
  }
  .ip-detail-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    font-family: var(--font-mono);
    word-break: break-all;
  }
  .ip-detail-value-sm { font-size: 12px; }
  .mini-copy-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-muted);
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .mini-copy-btn:hover { color: var(--color-ink); }

  /* ─── VPN Status ─── */
  .vpn-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft-2);
    flex-wrap: wrap;
    gap: 8px;
  }
  .vpn-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .vpn-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-muted);
    flex-shrink: 0;
    transition: background 0.3s;
  }
  .vpn-dot.vpn-on { background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.15); }
  .vpn-dot.vpn-off { background: #6b7280; }
  .vpn-dot.vpn-maybe { background: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
  .vpn-hint { font-size: 12px; color: var(--color-muted); }

  /* ─── Raw JSON ─── */
  .raw-json-block {
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 16px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--color-body);
    overflow-x: auto;
    white-space: pre;
    max-height: 300px;
    overflow-y: auto;
  }

  /* ─── vs grid ─── */
  .vs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .vs-card {
    padding: 20px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
  }
  .vs-public { background: var(--color-canvas-soft-2); }
  .vs-private { background: var(--color-canvas-soft-2); }
  .vs-card-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
  .vs-title { font-size: 15px; font-weight: 600; color: var(--color-ink); }
  .vs-subtitle { font-size: 12px; color: var(--color-muted); margin-top: 2px; }
  .vs-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .vs-list li {
    font-size: 13px;
    color: var(--color-body);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }
  .vs-list li::before { content: '·'; position: absolute; left: 4px; color: var(--color-muted); }
  .vs-example {
    font-size: 12px;
    color: var(--color-muted);
    border-top: 1px solid var(--color-hairline);
    padding-top: 10px;
    margin-top: 8px;
  }
  .vs-example code {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
  }

  /* ─── Device Grid ─── */
  .device-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .device-card {
    padding: 16px;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
  }
  .device-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .device-name { font-size: 14px; font-weight: 600; color: var(--color-ink); }
  .device-steps {
    padding-left: 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .device-steps li { font-size: 12.5px; color: var(--color-body); line-height: 1.5; }

  /* ─── Privacy Grid ─── */
  .privacy-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .privacy-card {
    padding: 16px;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
  }
  .privacy-icon { font-size: 22px; margin-bottom: 8px; }
  .privacy-title { font-size: 14px; font-weight: 600; color: var(--color-ink); margin-bottom: 6px; }
  .privacy-desc { font-size: 13px; color: var(--color-body); line-height: 1.55; }

  /* ─── Calc error reuse ─── */
  .calc-error { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--color-error-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); font-size: 14px; color: var(--color-error); }
  .prose-section { padding: 32px; background: var(--color-canvas); border-radius: var(--radius-lg); border: 1px solid var(--color-hairline); }
  code { background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: 4px; padding: 1px 6px; font-family: var(--font-mono); font-size: 13px; }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .privacy-grid { grid-template-columns: repeat(2, 1fr); }
    .device-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .ip-details-grid { grid-template-columns: 1fr; }
    .vs-grid { grid-template-columns: 1fr; }
    .device-grid { grid-template-columns: 1fr; }
    .privacy-grid { grid-template-columns: 1fr; }
    .prose-section { padding: 20px 16px; }
    .ip-hero { padding: 28px 16px 20px; }
  }
  @media (max-width: 480px) {
    .ip-hero-value { letter-spacing: -0.5px; }
    .device-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // ─── Types ──────────────────────────────────────────────────────────────────
  interface IPData {
    ip: string;
    ipv4?: string;
    ipv6?: string;
    city?: string;
    region?: string;
    country?: string;
    country_name?: string;
    org?: string;
    asn?: string;
    timezone?: string;
    loc?: string;
    hostname?: string;
    postal?: string;
  }

  // ─── DOM ────────────────────────────────────────────────────────────────────
  const loading  = document.getElementById('ip-loading')!;
  const main     = document.getElementById('ip-main')!;
  const errorEl  = document.getElementById('ip-error')!;
  const errorMsg = document.getElementById('ip-error-msg')!;

  const displayIp    = document.getElementById('display-ip')!;
  const displayType  = document.getElementById('display-ip-type')!;
  const detailIpv4   = document.getElementById('detail-ipv4')!;
  const detailIpv6   = document.getElementById('detail-ipv6')!;
  const detailLoc    = document.getElementById('detail-location')!;
  const detailFlag   = document.getElementById('detail-flag')!;
  const detailCountry = document.getElementById('detail-country')!;
  const detailCity   = document.getElementById('detail-city')!;
  const detailIsp    = document.getElementById('detail-isp')!;
  const detailTz     = document.getElementById('detail-timezone')!;
  const detailAsn    = document.getElementById('detail-asn')!;
  const vpnDot       = document.getElementById('vpn-dot')!;
  const vpnText      = document.getElementById('vpn-text')!;
  const vpnHint      = document.getElementById('vpn-hint')!;
  const vsPublicIp   = document.getElementById('vs-public-ip')!;
  const rawPanel     = document.getElementById('raw-json-panel')!;
  const rawContent   = document.getElementById('raw-json-content')!;

  let rawData: any = null;
  let currentIp = '';

  // ─── Country flag emoji from country code ───────────────────────────────────
  function countryFlag(code: string): string {
    if (!code || code.length !== 2) return '🌍';
    const offset = 127397;
    return String.fromCodePoint(...[...code.toUpperCase()].map(c => c.charCodeAt(0) + offset));
  }

  // ─── Is IPv6? ───────────────────────────────────────────────────────────────
  function isIPv6(ip: string): boolean {
    return ip.includes(':');
  }

  // ─── Detect VPN heuristically ───────────────────────────────────────────────
  function detectVPN(data: IPData): { status: 'vpn' | 'maybe' | 'clean', label: string, hint: string } {
    const org = (data.org || '').toLowerCase();
    const vpnKeywords = ['vpn', 'proxy', 'hosting', 'cloud', 'datacenter', 'data center',
      'digitalocean', 'linode', 'vultr', 'amazon', 'google cloud', 'microsoft azure',
      'ovh', 'hetzner', 'contabo', 'mullvad', 'nordvpn', 'expressvpn', 'private'];
    const isLikelyVPN = vpnKeywords.some(kw => org.includes(kw));

    if (isLikelyVPN) {
      return {
        status: 'vpn',
        label: '🛡️ VPN or Proxy Detected',
        hint: 'Your IP belongs to a hosting or VPN provider. Your real IP is hidden.'
      };
    }
    return {
      status: 'clean',
      label: '🔓 No VPN Detected',
      hint: 'Your real IP address appears to be visible. Use a VPN to hide your IP.'
    };
  }

  // ─── Fetch IP data via multiple fallbacks (to bypass blocklists & rate limits) ───
  async function fetchIPData(): Promise<IPData> {
    // 1. Try ipinfo.io
    try {
      const res = await fetch('https://ipinfo.io/json');
      if (res.ok) {
        const data = await res.json();
        if (data && data.ip) return data;
      }
    } catch (e) {
      console.warn('ipinfo.io failed, trying freeipapi.com...', e);
    }

    // 2. Try freeipapi.com (resilient fallback, no token needed)
    try {
      const res = await fetch('https://freeipapi.com/api/json');
      if (res.ok) {
        const data = await res.json();
        if (data && data.ipAddress) {
          return {
            ip: data.ipAddress,
            city: data.cityName || '',
            region: data.regionName || '',
            country: data.countryCode || '',
            country_name: data.countryName || '',
            org: data.isp || data.asName || '—',
            timezone: data.timeZone || '—',
            loc: data.latitude && data.longitude ? `${data.latitude},${data.longitude}` : undefined,
          };
        }
      }
    } catch (e) {
      console.warn('freeipapi.com failed, trying ipapi.co...', e);
    }

    // 3. Try ipapi.co (another fallback, no token needed)
    try {
      const res = await fetch('https://ipapi.co/json/');
      if (res.ok) {
        const data = await res.json();
        if (data && data.ip) {
          return {
            ip: data.ip,
            city: data.city || '',
            region: data.region || '',
            country: data.country || '',
            country_name: data.country_name || '',
            org: data.org || '—',
            timezone: data.timezone || '—',
            loc: data.latitude && data.longitude ? `${data.latitude},${data.longitude}` : undefined,
          };
        }
      }
    } catch (e) {
      console.warn('ipapi.co failed, trying /cdn-cgi/trace...', e);
    }

    // 4. Try same-origin /cdn-cgi/trace (never blocked by adblockers on Cloudflare deployments)
    try {
      const res = await fetch('/cdn-cgi/trace');
      if (res.ok) {
        const text = await res.text();
        const lines = text.split('\n');
        let ip = '';
        let loc = '';
        for (const line of lines) {
          if (line.startsWith('ip=')) ip = line.substring(3).trim();
          if (line.startsWith('loc=')) loc = line.substring(4).trim();
        }
        if (ip) {
          return {
            ip,
            country: loc,
            country_name: loc === 'NP' ? 'Nepal' : loc,
            org: 'Cloudflare Network',
          };
        }
      }
    } catch (e) {
      console.warn('/cdn-cgi/trace failed, trying ipify.org...', e);
    }

    // 5. Absolute fallback: ipify (only IP, no geo)
    const res = await fetch('https://api.ipify.org?format=json');
    if (!res.ok) throw new Error('All IP services failed');
    const { ip } = await res.json();
    return { ip } as IPData;
  }

  // ─── Fetch IPv6 via ipify ──────────────────────────────────────────────────
  async function fetchIPv6(): Promise<string | null> {
    try {
      const res = await fetch('https://api6.ipify.org?format=json', { signal: AbortSignal.timeout(3000) });
      const data = await res.json();
      return data.ip && isIPv6(data.ip) ? data.ip : null;
    } catch {
      return null;
    }
  }

  // ─── Render ─────────────────────────────────────────────────────────────────
  function render(data: IPData) {
    const ip = data.ip || '—';
    const ipv6 = data.ipv6 || null;
    const isV6 = isIPv6(ip);

    currentIp = ip;
    rawData = data;

    // Hero
    displayIp.textContent = ip;
    displayType.textContent = isV6 ? 'IPv6' : 'IPv4';
    vsPublicIp.textContent = ip;

    // IPv4 detail
    if (!isV6) {
      detailIpv4.textContent = ip;
    } else {
      detailIpv4.textContent = 'Not detected (IPv6 connection)';
      detailIpv4.style.color = 'var(--color-muted)';
      detailIpv4.style.fontSize = '12px';
    }

    // IPv6 detail
    if (ipv6) {
      detailIpv6.textContent = ipv6;
    } else if (isV6) {
      detailIpv6.textContent = ip;
    } else {
      detailIpv6.textContent = 'Not available on this connection';
      detailIpv6.style.color = 'var(--color-muted)';
    }

    // Location
    const city = data.city || '';
    const region = data.region || '';
    const country = data.country || '';
    const countryName = data.country_name || country;

    detailLoc.textContent = [city, region, countryName].filter(Boolean).join(', ') || '—';
    detailFlag.textContent = countryFlag(country);
    detailCountry.textContent = countryName || '—';
    detailCity.textContent = [city, region].filter(Boolean).join(', ') || '—';
    detailIsp.textContent = data.org || '—';
    detailTz.textContent = data.timezone || '—';
    detailAsn.textContent = data.org?.split(' ')[0] || '—';

    // VPN status
    const vpn = detectVPN(data);
    vpnDot.className = 'vpn-dot ' + (vpn.status === 'vpn' ? 'vpn-on' : vpn.status === 'maybe' ? 'vpn-maybe' : 'vpn-off');
    vpnText.textContent = vpn.label;
    vpnHint.textContent = vpn.hint;

    // Show
    loading.hidden = true;
    main.hidden = false;
    errorEl.hidden = true;
  }

  // ─── Load ───────────────────────────────────────────────────────────────────
  async function load() {
    loading.hidden = false;
    main.hidden = true;
    errorEl.hidden = true;

    try {
      // Fetch IP data + IPv6 in parallel
      const [ipData, ipv6] = await Promise.all([
        fetchIPData(),
        fetchIPv6(),
      ]);

      if (ipv6) ipData.ipv6 = ipv6;
      render(ipData);
    } catch (err) {
      loading.hidden = true;
      errorEl.hidden = false;
      errorMsg.textContent = 'Unable to detect your IP address. Please check your connection and try again.';
    }
  }

  // ─── Copy ───────────────────────────────────────────────────────────────────
  async function copyText(text: string, btn: HTMLElement) {
    try {
      await navigator.clipboard.writeText(text);
      const orig = btn.innerHTML;
      btn.innerHTML = btn.tagName === 'BUTTON' && btn.classList.contains('copy-btn')
        ? `<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7l4 4 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg> Copied!`
        : `<svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2 7l4 4 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
      btn.classList.add('copied');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 1800);
    } catch {}
  }

  document.getElementById('copy-ip-btn')!.addEventListener('click', (e) => {
    copyText(currentIp, e.currentTarget as HTMLElement);
  });

  document.querySelectorAll('.mini-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      const targetEl = targetId ? document.getElementById(targetId) : null;
      const text = targetEl?.textContent?.trim() || '';
      if (text && text !== '—' && !text.includes('Not')) {
        copyText(text, btn as HTMLElement);
      }
    });
  });

  // ─── Refresh ─────────────────────────────────────────────────────────────────
  document.getElementById('refresh-btn')!.addEventListener('click', load);
  document.getElementById('retry-btn')?.addEventListener('click', load);

  // ─── Raw JSON toggle ─────────────────────────────────────────────────────────
  document.getElementById('full-report-btn')!.addEventListener('click', () => {
    const isHidden = rawPanel.hidden;
    rawPanel.hidden = !isHidden;
    if (!isHidden) return;
    rawContent.textContent = JSON.stringify(rawData, null, 2);
  });

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });

  // ─── Init ─────────────────────────────────────────────────────────────────
  load();
</script>
