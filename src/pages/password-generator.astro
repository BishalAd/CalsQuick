<script>
  // ─── State ────────────────────────────────────────────────────────────────────
  let currentMode: 'random' | 'passphrase' | 'pronounceable' | 'pin' = 'random';
  let generatedPasswords: string[] = [];

  // Character sets
  const UPPERCASE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWERCASE = 'abcdefghijklmnopqrstuvwxyz';
  const NUMBERS = '0123456789';
  const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';
  const AMBIGUOUS = 'Il1O0';
  const CONSONANTS = 'bcdfghjklmnpqrstvwxyz';
  const VOWELS = 'aeiou';

  // Passphrase word list (short, common words)
  const WORD_LIST = [
    'apple','banana','orange','grape','mango','peach','cherry','lemon','lime','kiwi',
    'ocean','river','lake','mountain','forest','desert','valley','island','canyon','cliff',
    'tiger','eagle','dolphin','wolf','bear','hawk','fox','owl','deer','lion',
    'sunset','sunrise','thunder','lightning','rainbow','breeze','storm','cloud','frost','mist',
    'coffee','bread','cheese','honey','spice','sugar','butter','cream','toast','salad',
    'guitar','piano','violin','drums','flute','cello','harp','organ','trumpet','sax',
    'rocket','planet','star','comet','galaxy','orbit','nebula','cosmos','meteor','aurora',
    'castle','bridge','tower','garden','palace','temple','harbor','plaza','village','cabin',
    'silver','golden','copper','bronze','crystal','amber','pearl','coral','jade','ivory',
    'dragon','phoenix','wizard','knight','castle','sword','shield','crown','throne','quest',
    'autumn','winter','spring','summer','harvest','bloom','frost','blaze','dusk','dawn',
    'travel','journey','voyage','quest','adventure','expedition','passage','wander','roam','explore',
  ];

  // ─── Crypto Random ──────────────────────────────────────────────────────────
  function cryptoRandom(max: number): number {
    const array = new Uint32Array(1);
    crypto.getRandomValues(array);
    return array[0] % max;
  }

  function shuffleArray<T>(arr: T[]): T[] {
    const shuffled = [...arr];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = cryptoRandom(i + 1);
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  // ─── Generate Random Password ────────────────────────────────────────────────
  function generateRandom(): string {
    const length = parseInt((document.getElementById('pg-length') as HTMLInputElement).value);
    const useUpper = (document.getElementById('pg-uppercase') as HTMLInputElement).checked;
    const useLower = (document.getElementById('pg-lowercase') as HTMLInputElement).checked;
    const useNumbers = (document.getElementById('pg-numbers') as HTMLInputElement).checked;
    const useSymbols = (document.getElementById('pg-symbols') as HTMLInputElement).checked;
    const excludeAmbiguous = (document.getElementById('pg-ambiguous') as HTMLInputElement).checked;
    const noRepeat = (document.getElementById('pg-unique') as HTMLInputElement).checked;

    let chars = '';
    if (useUpper) chars += UPPERCASE;
    if (useLower) chars += LOWERCASE;
    if (useNumbers) chars += NUMBERS;
    if (useSymbols) chars += SYMBOLS;
    if (!chars) chars = LOWERCASE + NUMBERS; // fallback

    if (excludeAmbiguous) {
      chars = chars.split('').filter(c => !AMBIGUOUS.includes(c)).join('');
    }

    if (chars.length === 0) chars = LOWERCASE;

    let password = '';
    const used = new Set<string>();

    // Ensure at least one of each required type
    const required: string[] = [];
    if (useUpper) required.push(UPPERCASE[excludeAmbiguous ? 0 : cryptoRandom(26)]);
    if (useLower) required.push(LOWERCASE[excludeAmbiguous ? 0 : cryptoRandom(26)]);
    if (useNumbers) required.push(NUMBERS[cryptoRandom(10)]);
    if (useSymbols) required.push(SYMBOLS[cryptoRandom(SYMBOLS.length)]);

    for (const ch of required) {
      password += ch;
      used.add(ch);
    }

    while (password.length < length) {
      const ch = chars[cryptoRandom(chars.length)];
      if (noRepeat && used.has(ch)) continue;
      password += ch;
      used.add(ch);
    }

    // Shuffle to avoid predictable positions of required chars
    return shuffleArray(password.split('')).join('');
  }

  // ─── Generate Passphrase ────────────────────────────────────────────────────
  function generatePassphrase(): string {
    const numWords = parseInt((document.getElementById('pg-words') as HTMLInputElement).value);
    const separator = document.querySelector('.pg-sep-btn.active')?.getAttribute('data-sep') || '-';
    const capitalize = (document.getElementById('pg-capitalize') as HTMLInputElement).checked;
    const addNumbers = (document.getElementById('pg-add-numbers-pp') as HTMLInputElement).checked;

    const words: string[] = [];
    const used = new Set<string>();

    for (let i = 0; i < numWords; i++) {
      let word: string;
      let attempts = 0;
      do {
        word = WORD_LIST[cryptoRandom(WORD_LIST.length)];
        attempts++;
      } while (used.has(word) && attempts < 50);
      used.add(word);
      words.push(capitalize ? word.charAt(0).toUpperCase() + word.slice(1) : word);
    }

    let passphrase = words.join(separator);

    if (addNumbers) {
      passphrase += separator + cryptoRandom(100).toString().padStart(2, '0');
    }

    return passphrase;
  }

  // ─── Generate Pronounceable ─────────────────────────────────────────────────
  function generatePronounceable(): string {
    const length = parseInt((document.getElementById('pg-pron-length') as HTMLInputElement).value);
    const capitalize = (document.getElementById('pg-pron-capitalize') as HTMLInputElement).checked;
    const addNumbers = (document.getElementById('pg-pron-numbers') as HTMLInputElement).checked;

    let result = '';
    for (let i = 0; i < length; i++) {
      if (i % 2 === 0) {
        result += CONSONANTS[cryptoRandom(CONSONANTS.length)];
      } else {
        result += VOWELS[cryptoRandom(VOWELS.length)];
      }
    }

    if (capitalize) {
      result = result.charAt(0).toUpperCase() + result.slice(1);
    }

    if (addNumbers) {
      result += cryptoRandom(100).toString().padStart(2, '0');
    }

    return result;
  }

  // ─── Generate PIN ───────────────────────────────────────────────────────────
  function generatePIN(): string {
    const length = parseInt((document.getElementById('pg-pin-length') as HTMLInputElement).value);
    let pin = '';
    for (let i = 0; i < length; i++) {
      pin += cryptoRandom(10).toString();
    }
    return pin;
  }

  // ─── Calculate Entropy ──────────────────────────────────────────────────────
  function calculateEntropy(password: string): number {
    let poolSize = 0;
    if (/[A-Z]/.test(password)) poolSize += 26;
    if (/[a-z]/.test(password)) poolSize += 26;
    if (/[0-9]/.test(password)) poolSize += 10;
    if (/[^A-Za-z0-9]/.test(password)) poolSize += 32;
    if (poolSize === 0) poolSize = 26;
    return Math.log2(Math.pow(poolSize, password.length));
  }

  // ─── Analyze Password Strength ──────────────────────────────────────────────
  function analyzePassword(password: string): { score: number; label: string; color: string; details: string[] } {
    let score = 0;
    const details: string[] = [];

    // Length check
    if (password.length >= 16) { score += 25; details.push('✅ 16+ characters'); }
    else if (password.length >= 12) { score += 15; details.push('✅ 12+ characters'); }
    else if (password.length >= 8) { score += 8; details.push('⚠️ 8+ characters (minimum)'); }
    else { score += 0; details.push('❌ Under 8 characters'); }

    // Character variety
    let variety = 0;
    if (/[A-Z]/.test(password)) variety++;
    if (/[a-z]/.test(password)) variety++;
    if (/[0-9]/.test(password)) variety++;
    if (/[^A-Za-z0-9]/.test(password)) variety++;
    score += variety * 8;
    details.push(`${variety >= 3 ? '✅' : '⚠️'} ${variety}/4 character types`);

    // Entropy
    const entropy = calculateEntropy(password);
    if (entropy >= 100) { score += 25; details.push('✅ Very high entropy'); }
    else if (entropy >= 80) { score += 18; details.push('✅ High entropy'); }
    else if (entropy >= 60) { score += 10; details.push('⚠️ Moderate entropy'); }
    else { score += 3; details.push('❌ Low entropy'); }

    // Pattern detection
    const commonPatterns = ['123', 'abc', 'qwerty', 'password', 'admin', 'letmein'];
    const lower = password.toLowerCase();
    let hasPattern = false;
    for (const pattern of commonPatterns) {
      if (lower.includes(pattern)) { hasPattern = true; break; }
    }
    if (!hasPattern) { score += 10; details.push('✅ No common patterns'); }
    else { score -= 5; details.push('❌ Contains common pattern'); }

    // Repeating characters
    if (/(.)\1{2,}/.test(password)) { score -= 5; details.push('❌ Repeating characters'); }
    else { score += 5; details.push('✅ No repeating characters'); }

    score = Math.max(0, Math.min(100, score));

    let label: string, color: string;
    if (score >= 86) { label = 'Very Strong'; color = '#10b981'; }
    else if (score >= 71) { label = 'Strong'; color = '#84cc16'; }
    else if (score >= 51) { label = 'Fair'; color = '#eab308'; }
    else if (score >= 26) { label = 'Weak'; color = '#f59e0b'; }
    else { label = 'Very Weak'; color = '#dc2626'; }

    return { score, label, color, details };
  }

  // ─── Generate All ───────────────────────────────────────────────────────────
  function generateAll() {
    let count = 5;
    const passwords: string[] = [];

    switch (currentMode) {
      case 'random':
        count = parseInt((document.getElementById('pg-count') as HTMLInputElement).value) || 5;
        for (let i = 0; i < count; i++) passwords.push(generateRandom());
        break;
      case 'passphrase':
        count = parseInt((document.getElementById('pg-pp-count') as HTMLInputElement).value) || 3;
        for (let i = 0; i < count; i++) passwords.push(generatePassphrase());
        break;
      case 'pronounceable':
        count = parseInt((document.getElementById('pg-pron-count') as HTMLInputElement).value) || 5;
        for (let i = 0; i < count; i++) passwords.push(generatePronounceable());
        break;
      case 'pin':
        count = parseInt((document.getElementById('pg-pin-count') as HTMLInputElement).value) || 5;
        for (let i = 0; i < count; i++) passwords.push(generatePIN());
        break;
    }

    generatedPasswords = passwords;
    renderResults();
  }

  function renderResults() {
    const container = document.getElementById('pg-results-list')!;
    
    if (generatedPasswords.length === 0) {
      container.innerHTML = `<div class="pg-empty-state"><div class="pg-empty-icon">🔐</div><p style="color:var(--color-muted);">Click "Generate Passwords" to create secure passwords</p></div>`;
      return;
    }

    container.innerHTML = generatedPasswords.map((pw, i) => {
      const entropy = calculateEntropy(pw);
      return `
        <div class="pg-password-row">
          <span class="pg-password-text">${escapeHTML(pw)}</span>
          <span class="pg-password-entropy">${entropy.toFixed(0)} bits</span>
          <button class="pg-copy-btn" data-index="${i}">📋 Copy</button>
        </div>
      `;
    }).join('');

    // Copy buttons
    container.querySelectorAll('.pg-copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        try {
          await navigator.clipboard.writeText(generatedPasswords[idx]);
          btn.classList.add('copied');
          btn.textContent = '✓ Copied';
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.textContent = '📋 Copy';
          }, 2000);
        } catch {
          // Fallback
          const input = document.createElement('input');
          input.value = generatedPasswords[idx];
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }
      });
    });
  }

  // ─── Event Listeners ────────────────────────────────────────────────────────
  document.getElementById('pg-generate-btn')!.addEventListener('click', generateAll);
  document.getElementById('pg-regenerate-btn')!.addEventListener('click', generateAll);

  document.getElementById('pg-copy-all-btn')!.addEventListener('click', async () => {
    if (generatedPasswords.length === 0) return;
    const text = generatedPasswords.join('\n');
    try {
      await navigator.clipboard.writeText(text);
    } catch {}
  });

  // Mode switching
  document.querySelectorAll('.pg-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pg-mode-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = (btn as HTMLElement).dataset.mode as any;
      
      document.getElementById('pg-random-settings')!.style.display = currentMode === 'random' ? '' : 'none';
      document.getElementById('pg-passphrase-settings')!.style.display = currentMode === 'passphrase' ? '' : 'none';
      document.getElementById('pg-pron-settings')!.style.display = currentMode === 'pronounceable' ? '' : 'none';
      document.getElementById('pg-pin-settings')!.style.display = currentMode === 'pin' ? '' : 'none';
    });
  });

  // Length sliders
  document.getElementById('pg-length')!.addEventListener('input', function() {
    document.getElementById('pg-length-val')!.textContent = (this as HTMLInputElement).value;
  });
  document.getElementById('pg-words')!.addEventListener('input', function() {
    document.getElementById('pg-words-val')!.textContent = (this as HTMLInputElement).value;
  });
  document.getElementById('pg-pron-length')!.addEventListener('input', function() {
    document.getElementById('pg-pron-length-val')!.textContent = (this as HTMLInputElement).value;
  });
  document.getElementById('pg-pin-length')!.addEventListener('input', function() {
    document.getElementById('pg-pin-length-val')!.textContent = (this as HTMLInputElement).value;
  });

  // Preset chips
  document.querySelectorAll('.pg-preset-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const len = (chip as HTMLElement).dataset.length!;
      (document.getElementById('pg-length') as HTMLInputElement).value = len;
      document.getElementById('pg-length-val')!.textContent = len;
      document.querySelectorAll('.pg-preset-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
    });
  });

  document.querySelectorAll('.pg-pin-preset').forEach(chip => {
    chip.addEventListener('click', () => {
      const len = (chip as HTMLElement).dataset.length!;
      (document.getElementById('pg-pin-length') as HTMLInputElement).value = len;
      document.getElementById('pg-pin-length-val')!.textContent = len;
    });
  });

  // Separator buttons
  document.querySelectorAll('.pg-sep-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pg-sep-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Strength Analyzer
  document.getElementById('pg-analyze-btn')!.addEventListener('click', () => {
    const password = (document.getElementById('pg-analyzer-input') as HTMLInputElement).value;
    if (!password) return;
    
    const result = analyzePassword(password);
    const resultsDiv = document.getElementById('pg-analyzer-results')!;
    resultsDiv.style.display = '';
    
    document.getElementById('pg-strength-bar')!.style.width = result.score + '%';
    document.getElementById('pg-strength-bar')!.style.background = result.color;
    document.getElementById('pg-strength-label')!.textContent = result.label;
    document.getElementById('pg-strength-label')!.style.color = result.color;
    document.getElementById('pg-strength-score')!.textContent = `Score: ${result.score}/100 • Entropy: ${calculateEntropy(password).toFixed(1)} bits`;
    document.getElementById('pg-analyzer-details')!.innerHTML = result.details.map(d => `<div class="pg-detail-item">${d}</div>`).join('');
  });

  // Breach Check
  document.getElementById('pg-check-breach-btn')!.addEventListener('click', async () => {
    const password = (document.getElementById('pg-analyzer-input') as HTMLInputElement).value;
    if (!password) return;
    
    const breachDiv = document.getElementById('pg-breach-result')!;
    breachDiv.style.display = '';
    breachDiv.innerHTML = '<p style="font-size:12px;color:var(--color-muted);">🔄 Checking against known breaches...</p>';
    
    try {
      // Hash the password with SHA-1
      const encoder = new TextEncoder();
      const data = encoder.encode(password);
      const hashBuffer = await crypto.subtle.digest('SHA-1', data);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('').toUpperCase();
      
      const prefix = hashHex.slice(0, 5);
      const suffix = hashHex.slice(5);
      
      const response = await fetch(`https://api.pwnedpasswords.com/range/${prefix}`);
      const text = await response.text();
      
      const found = text.split('\n').some(line => line.startsWith(suffix));
      
      if (found) {
        breachDiv.innerHTML = '<div class="pg-breach-danger">⚠️ <strong>This password has been compromised!</strong><br/>It appears in known data breaches. Do NOT use this password. Generate a new, unique password instead.</div>';
      } else {
        breachDiv.innerHTML = '<div class="pg-breach-safe">✅ <strong>Password not found in breaches.</strong><br/>This password has not appeared in any known data breaches. However, always use unique passwords for every account.</div>';
      }
    } catch(e) {
      breachDiv.innerHTML = '<p style="font-size:12px;color:var(--color-muted);">⚠️ Could not check breaches. Ensure you\'re connected to the internet.</p>';
    }
  });

  // ─── Init ──────────────────────────────────────────────────────────────────
  generateAll();

  function escapeHTML(str: string): string {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>