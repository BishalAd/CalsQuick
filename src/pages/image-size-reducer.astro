</style>

<script>
  // ─── State ────────────────────────────────────────────────────────────────────
  let singleImage: HTMLImageElement | null = null;
  let singleOriginalBlob: Blob | null = null;
  let singleCompressedBlob: Blob | null = null;
  let singleOriginalSize = 0;
  let currentFormat = 'jpg';
  let currentMime = 'image/jpeg';
  let currentQuality = 85;
  let previewMode: 'original' | 'compressed' | 'comparison' = 'original';

  // Batch state
  let batchFiles: { file: File; originalSize: number; compressedBlob?: Blob; compressedSize?: number; processed: boolean }[] = [];

  // ─── Tab Switching ──────────────────────────────────────────────────────────
  document.querySelectorAll('.isr-mode-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.isr-mode-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const mode = (tab as HTMLElement).dataset.mode!;
      document.getElementById('single-panel')!.style.display = mode === 'single' ? '' : 'none';
      document.getElementById('batch-panel')!.style.display = mode === 'batch' ? '' : 'none';
    });
  });

  // ─── File Size Formatter ────────────────────────────────────────────────────
  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(2) + ' MB';
  }

  // ─── Single Image: Upload ──────────────────────────────────────────────────
  const singleFileInput = document.getElementById('single-file-input') as HTMLInputElement;
  const singleUpload = document.getElementById('single-upload')!;
  const singleEditor = document.getElementById('single-editor')!;

  document.getElementById('single-browse-btn')!.addEventListener('click', () => singleFileInput.click());
  singleUpload.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('button')) singleFileInput.click();
  });

  singleFileInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) loadSingleImage(file);
  });

  // Drag and drop
  singleUpload.addEventListener('dragover', (e) => { e.preventDefault(); singleUpload.classList.add('drag-over'); });
  singleUpload.addEventListener('dragleave', () => singleUpload.classList.remove('drag-over'));
  singleUpload.addEventListener('drop', (e) => {
    e.preventDefault();
    singleUpload.classList.remove('drag-over');
    const file = e.dataTransfer?.files?.[0];
    if (file) loadSingleImage(file);
  });

  // Paste
  document.getElementById('single-paste-btn')!.addEventListener('click', async () => {
    try {
      const items = await navigator.clipboard.read();
      for (const item of items) {
        if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
          const blob = await item.getType(item.types[0]);
          loadSingleImage(blob);
          return;
        }
      }
      alert('No image found in clipboard.');
    } catch(e) { alert('Clipboard access denied.'); }
  });

  // Sample
  document.getElementById('single-sample-btn')!.addEventListener('click', () => {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#3b82f6"/><stop offset="100%" style="stop-color:#8b5cf6"/></linearGradient></defs><rect width="1920" height="1080" fill="url(#g)"/><text x="960" y="520" text-anchor="middle" font-family="sans-serif" font-size="48" fill="white">Sample Photo 1920×1080</text><circle cx="300" cy="300" r="80" fill="white" opacity="0.2"/><circle cx="1600" cy="800" r="120" fill="white" opacity="0.15"/></svg>`;
    const blob = new Blob([svg], { type: 'image/svg+xml' });
    loadSingleImage(blob);
  });

  function loadSingleImage(file: Blob | File) {
    singleOriginalBlob = file;
    singleOriginalSize = file.size;
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      singleImage = img;
      singleUpload.style.display = 'none';
      singleEditor.style.display = '';
      updateSinglePreview('original');
      updateSingleInfo();
      compressSingle();
    };
    img.src = url;
  }

  // ─── Single Image: Compression ─────────────────────────────────────────────
  function compressSingle() {
    if (!singleImage) return;
    
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d')!;
    
    // Resize
    let w = singleImage.width;
    let h = singleImage.height;
    const maxW = parseInt((document.getElementById('single-max-width') as HTMLInputElement).value);
    const customW = parseInt((document.getElementById('single-width') as HTMLInputElement).value);
    const customH = parseInt((document.getElementById('single-height') as HTMLInputElement).value);
    
    if (maxW && w > maxW) {
      const ratio = maxW / w;
      w = maxW;
      h = Math.round(h * ratio);
    }
    if (customW && customH) {
      w = customW;
      h = customH;
    }
    
    canvas.width = w;
    canvas.height = h;
    ctx.drawImage(singleImage, 0, 0, w, h);
    
    canvas.toBlob((blob) => {
      if (blob) {
        singleCompressedBlob = blob;
        updateSinglePreview('compressed');
        updateSingleInfo();
      }
    }, currentMime, currentQuality / 100);
  }

  function updateSinglePreview(mode: 'original' | 'compressed' | 'comparison') {
    previewMode = mode;
    const img = document.getElementById('single-preview-img') as HTMLImageElement;
    
    if (mode === 'original' && singleOriginalBlob) {
      img.src = URL.createObjectURL(singleOriginalBlob);
    } else if (mode === 'compressed' && singleCompressedBlob) {
      img.src = URL.createObjectURL(singleCompressedBlob);
    } else if (mode === 'comparison') {
      img.src = URL.createObjectURL(singleOriginalBlob!);
    }
    
    document.querySelectorAll('.isr-preview-tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`.isr-preview-tab[data-view="${mode}"]`)?.classList.add('active');
  }

  function updateSingleInfo() {
    document.getElementById('single-original-size')!.textContent = formatSize(singleOriginalSize);
    document.getElementById('single-dimensions')!.textContent = singleImage ? `${singleImage.width} × ${singleImage.height}` : '—';
    
    if (singleCompressedBlob) {
      const compressedSize = singleCompressedBlob.size;
      document.getElementById('single-compressed-size')!.textContent = formatSize(compressedSize);
      const reduction = ((1 - compressedSize / singleOriginalSize) * 100).toFixed(1);
      document.getElementById('single-reduction')!.textContent = `${reduction}%`;
    }
  }

  // ─── Controls ──────────────────────────────────────────────────────────────
  document.getElementById('single-quality')!.addEventListener('input', (e) => {
    currentQuality = parseInt((e.target as HTMLInputElement).value);
    document.getElementById('single-quality-val')!.textContent = String(currentQuality);
    compressSingle();
  });

  document.getElementById('single-max-width')!.addEventListener('change', compressSingle);
  document.getElementById('single-width')!.addEventListener('change', compressSingle);
  document.getElementById('single-height')!.addEventListener('change', compressSingle);

  document.querySelectorAll('.isr-compress-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = parseInt((btn as HTMLElement).dataset.quality!);
      (document.getElementById('single-quality') as HTMLInputElement).value = String(q);
      currentQuality = q;
      document.getElementById('single-quality-val')!.textContent = String(q);
      compressSingle();
    });
  });

  document.querySelectorAll('.isr-quick-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      (document.getElementById('single-max-width') as HTMLInputElement).value = el.dataset.maxw!;
      (document.getElementById('single-quality') as HTMLInputElement).value = el.dataset.quality!;
      currentQuality = parseInt(el.dataset.quality!);
      document.getElementById('single-quality-val')!.textContent = el.dataset.quality!;
      
      const fmt = el.dataset.format!;
      currentFormat = fmt;
      document.querySelectorAll('.isr-format-btn').forEach(b => {
        b.classList.remove('active');
        if ((b as HTMLElement).dataset.format === fmt) b.classList.add('active');
      });
      
      compressSingle();
    });
  });

  document.querySelectorAll('.isr-format-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.isr-format-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFormat = (btn as HTMLElement).dataset.format!;
      currentMime = (btn as HTMLElement).dataset.mime!;
      compressSingle();
    });
  });
  document.querySelector('.isr-format-btn[data-format="jpg"]')?.classList.add('active');

  // Preview tabs
  document.querySelectorAll('.isr-preview-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      updateSinglePreview((tab as HTMLElement).dataset.view as any);
    });
  });

  // Download
  document.getElementById('single-download-btn')!.addEventListener('click', () => {
    if (!singleCompressedBlob) return;
    const url = URL.createObjectURL(singleCompressedBlob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `compressed-image.${currentFormat}`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Reset
  document.getElementById('single-reset-btn')!.addEventListener('click', () => {
    singleImage = null;
    singleOriginalBlob = null;
    singleCompressedBlob = null;
    singleUpload.style.display = '';
    singleEditor.style.display = 'none';
  });

  // ─── Batch Processing ──────────────────────────────────────────────────────
  const batchFileInput = document.getElementById('batch-file-input') as HTMLInputElement;
  const batchUpload = document.getElementById('batch-upload')!;
  const batchEditor = document.getElementById('batch-editor')!;

  document.getElementById('batch-browse-btn')!.addEventListener('click', () => batchFileInput.click());
  batchUpload.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('button')) batchFileInput.click();
  });

  batchFileInput.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) loadBatchFiles(Array.from(files));
  });

  batchUpload.addEventListener('dragover', (e) => { e.preventDefault(); batchUpload.classList.add('drag-over'); });
  batchUpload.addEventListener('dragleave', () => batchUpload.classList.remove('drag-over'));
  batchUpload.addEventListener('drop', (e) => {
    e.preventDefault();
    batchUpload.classList.remove('drag-over');
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) loadBatchFiles(Array.from(files));
  });

  function loadBatchFiles(files: File[]) {
    batchFiles = files.slice(0, 20).map(f => ({
      file: f,
      originalSize: f.size,
      processed: false,
    }));
    batchUpload.style.display = 'none';
    batchEditor.style.display = '';
    renderBatchList();
  }

  function renderBatchList() {
    const container = document.getElementById('batch-image-list')!;
    document.getElementById('batch-count')!.textContent = String(batchFiles.length);
    
    container.innerHTML = batchFiles.map((bf, i) => `
      <div class="batch-image-card">
        <img class="batch-image-preview" src="${URL.createObjectURL(bf.file)}" alt="Image ${i + 1}" />
        <div class="batch-image-info">
          <div class="name">${bf.file.name}</div>
          <div style="color:var(--color-muted);">Original: ${formatSize(bf.originalSize)}</div>
          ${bf.processed && bf.compressedSize ? `<div style="color:#10b981;">Compressed: ${formatSize(bf.compressedSize)} (${((1 - bf.compressedSize / bf.originalSize) * 100).toFixed(1)}% reduced)</div>` : '<div style="color:var(--color-muted);">Not processed</div>'}
        </div>
      </div>
    `).join('');
  }

  document.getElementById('batch-process-all-btn')!.addEventListener('click', async () => {
    const format = (document.getElementById('batch-format') as HTMLSelectElement).value;
    const quality = parseInt((document.getElementById('batch-quality') as HTMLInputElement).value) / 100;
    const maxW = parseInt((document.getElementById('batch-max-width') as HTMLInputElement).value);
    
    const mimeMap: Record<string, string> = { jpg: 'image/jpeg', png: 'image/png', webp: 'image/webp', bmp: 'image/bmp' };
    const mime = mimeMap[format] || 'image/jpeg';
    
    for (const bf of batchFiles) {
      await new Promise<void>((resolve) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let w = img.width, h = img.height;
          if (maxW && w > maxW) { h = Math.round(h * (maxW / w)); w = maxW; }
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d')!.drawImage(img, 0, 0, w, h);
          canvas.toBlob((blob) => {
            if (blob) {
              bf.compressedBlob = blob;
              bf.compressedSize = blob.size;
              bf.processed = true;
            }
            resolve();
          }, mime, quality);
        };
        img.src = URL.createObjectURL(bf.file);
      });
    }
    renderBatchList();
  });

  document.getElementById('batch-download-all-btn')!.addEventListener('click', () => {
    const processed = batchFiles.filter(bf => bf.processed && bf.compressedBlob);
    if (processed.length === 0) { alert('No processed images. Click "Process All" first.'); return; }
    
    processed.forEach((bf, i) => {
      const url = URL.createObjectURL(bf.compressedBlob!);
      const a = document.createElement('a');
      a.href = url;
      const ext = (document.getElementById('batch-format') as HTMLSelectElement).value;
      a.download = `${bf.file.name.replace(/\.[^.]+$/, '')}-compressed.${ext}`;
      setTimeout(() => { a.click(); URL.revokeObjectURL(url); }, i * 300);
    });
  });

  document.getElementById('batch-clear-btn')!.addEventListener('click', () => {
    batchFiles = [];
    batchUpload.style.display = '';
    batchEditor.style.display = 'none';
  });

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>