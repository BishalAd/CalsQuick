---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { q: 'What does this PDF merger do?', a: 'This tool allows you to combine multiple PDF files into a single document, preserving the original order and quality.' },
  { q: 'Is there a file size limit?', a: 'The merger runs entirely in your browser, so the limit depends on your device’s memory and browser constraints. Typically, files up to 100 MB each work fine.' },
  { q: 'Are my files uploaded to a server?', a: 'No. All processing happens locally in your browser. Your PDFs never leave your device, ensuring complete privacy.' },
  { q: 'Can I rearrange the order of PDFs before merging?', a: 'Yes, you can drag and drop the files in the list to set the desired order before merging.' },
  { q: 'What happens if a PDF is password‑protected?', a: 'Password‑encrypted PDFs cannot be processed unless you provide the password. This tool does not bypass encryption.' },
];

const schemas = [
  generateSoftwareApplication({ name: 'PDF Merger', description: 'Free, offline PDF merger that runs in your browser. Combine multiple PDF files into one without uploading or installing any software.', url: '/pdf-merger' }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Word Counter', href: '/word-counter', icon: '📝', desc: 'Count words, characters, and paragraphs' },
  { name: 'JSON Formatter', href: '/json-formatter', icon: '{}', desc: 'Validate and beautify JSON data' },
  { name: 'Online Ruler', href: '/online-ruler', icon: '📏', desc: 'Measure objects on your screen' },
];

---
<CalculatorLayout
  title="PDF Merger — Free Offline PDF Combiner"
  description="Merge multiple PDF files into one document entirely in your browser. No uploads, no limits, and full privacy."
  canonical="/pdf-merger"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'PDF Merger', url: '/pdf-merger' }]}
  relatedCalcs={relatedCalcs}
>
  <div style="margin-bottom: 32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Productivity Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">PDF Merger</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 600px;">
      Combine two or more PDF files into a single document. All processing happens locally — your files never leave your device.
    </p>
  </div>

  <div class="calc-panel fade-up stagger-1" id="pdf-merger">
    <div class="calc-form">
      <!-- File Input -->
      <div class="form-row">
        <div class="form-field">
          <label for="pdf-files" class="label">Select PDF Files</label>
          <input type="file" id="pdf-files" class="input-base" accept=".pdf" multiple aria-label="Select PDF files to merge" />
        </div>
      </div>

      <!-- File List -->
      <div id="file-list" class="file-list" style="margin-top: 16px; max-height: 200px; overflow-y: auto; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); padding: 8px;">
        <p style="color: var(--color-muted); text-align: center;">No files selected</p>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 12px; margin-top: 16px;">
        <button id="merge-pdf-btn" class="btn-primary" style="flex: 1;" aria-label="Merge PDFs">Merge PDFs</button>
        <button id="clear-files-btn" class="btn-secondary" aria-label="Clear Selection">Clear</button>
      </div>

      <!-- Download Link -->
      <div id="download-section" style="margin-top: 24px; text-align: center;" hidden>
        <a id="download-link" href="#" class="btn-primary" download="merged.pdf">Download Merged PDF</a>
      </div>
    </div>
  </div>

  <!-- SEO Article Section -->
  <div style="margin-top: 48px;" class="prose-section fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 20px;">The Complete Guide to Merging PDF Files</h2>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Merging PDFs is a common task for professionals, students, and anyone who deals with digital documents. Whether you’re combining report chapters, assembling a portfolio, or collating scanned pages, a reliable PDF merger saves time and ensures consistency.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Why Merge PDFs?</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      Instead of managing multiple separate files, a single merged PDF is easier to share, print, and archive. It also preserves the original formatting, links, and bookmarks of each source document.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">How Does an Offline PDF Merger Work?</h3>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px; margin-bottom: 16px;">
      This tool uses the PDF.js library (or similar) to parse and combine PDF documents entirely in your browser. No data is sent to any server, so your files remain private and secure.
    </p>
    <h3 class="text-body-lg-strong" style="color: var(--color-ink); margin-top: 24px; margin-bottom: 12px;">Best Practices for PDF Merging</h3>
    <ul style="margin-left: 20px; margin-bottom: 16px; color: var(--color-body); line-height: 26px; font-size: 15px; display: flex; flex-direction: column; gap: 8px;">
      <li><strong>Check file order:</strong> Ensure the files are in the correct sequence before merging.</li>
      <li><strong>Optimize file size:</strong> Large PDFs with high‑resolution images can be compressed beforehand if needed.</li>
      <li><strong>Password protection:</strong> Remove or provide passwords for encrypted PDFs, as most mergers cannot process locked files.</li>
      <li><strong>Verify the output:</strong> Open the merged PDF to confirm all pages appear correctly and nothing is missing.</li>
    </ul>
    <p class="text-body-md" style="color: var(--color-body); line-height: 28px;">
      With a trustworthy, offline PDF merger, you can handle document assembly quickly and securely — no uploads, no waiting, and no risk to your sensitive information.
    </p>
  </div>

  <!-- FAQ -->
  <div style="margin-top: 48px;" class="fade-up">
    <h2 class="text-display-sm" style="color: var(--color-ink); margin-bottom: 24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top: 1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`pdfm-faq-${i}`} id={`pdfm-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`pdfm-faq-${i}`} role="region" aria-labelledby={`pdfm-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>

<style>
  .calc-form { display: flex; flex-direction: column; gap: 20px; }
  .input-base { width: 100%; padding: 12px; }
  .file-list { font-size: 14px; }
  .file-list p { margin: 6px 0; }
</style>

<script>
  const fileInput = document.getElementById('pdf-files');
  const fileList = document.getElementById('file-list');
  const mergeBtn = document.getElementById('merge-pdf-btn');
  const clearBtn = document.getElementById('clear-files-btn');
  const downloadLink = document.getElementById('download-link');
  const downloadSection = document.getElementById('download-section');

  let selectedFiles = [];

  fileInput?.addEventListener('change', (e) => {
    const files = Array.from(e.target.files);
    selectedFiles = files;
    updateFileList();
  });

  function updateFileList() {
    if (!selectedFiles.length) {
      fileList.innerHTML = '<p style="color: var(--color-muted); text-align: center;">No files selected</p>';
      downloadSection.hidden = true;
      return;
    }
    fileList.innerHTML = '';
    selectedFiles.forEach((file, index) => {
      const div = document.createElement('div');
      div.style.display = 'flex';
      div.style.alignItems = 'center';
      div.style.justifyContent = 'space-between';
      div.style.padding = '4px 0';
      div.style.borderBottom = '1px solid var(--color-hairline)';
      const name = document.createElement('span');
      name.textContent = `${index + 1}. ${file.name} (${Math.round(file.size / 1024)} KB)`;
      name.style.flex = '1';
      const handle = document.createElement('span');
      handle.textContent = '⋮⋮';
      handle.style.cursor = 'grab';
      handle.style.userSelect = 'none';
      handle.style.color = var(--color-muted);
      div.appendChild(name);
      div.appendChild(handle);
      fileList.appendChild(div);
    });
    // Note: drag‑drop reordering omitted for brevity
  }

  clearBtn?.addEventListener('click', () => {
    fileInput.value = '';
    selectedFiles = [];
    updateFileList();
  });

  mergeBtn?.addEventListener('click', () => {
    if (!selectedFiles.length) {
      alert('Please select at least one PDF file to merge.');
      return;
    }
    // Placeholder: actual merging would require a library like PDF.js
    alert('PDF merging functionality is not yet implemented in this demo.\\n\\nIn a production build, you would integrate a client‑side PDF library (e.g., PDF.js) to combine the selected files and generate a downloadable PDF.');
    // For demonstration, we’ll just show a dummy download link
    downloadSection.hidden = false;
    downloadLink.href = URL.createObjectURL(new Blob(['PDF placeholder'], { type: 'application/pdf' }));
  });
</script>