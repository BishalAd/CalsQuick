---

<CalculatorLayout
  title="Workers Comp Calculator — Estimate Weekly Benefits by State (2024)"
  description="Free workers compensation calculator for all 50 US states. Estimate your weekly workers comp benefits, temporary disability payments, permanent disability value, and settlement amount. Uses accurate 2024 state maximum rates."
  canonical="/workers-comp-calculator"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Workers Comp Calculator', url: '/workers-comp-calculator' }]}
  relatedCalcs={relatedCalcs}
>

  <!-- Disclaimer Banner -->
  <div class="disclaimer-banner fade-up" role="alert" style="margin-bottom:24px;">
    <span style="font-size:16px;">⚠️</span>
    <p style="margin:0;font-size:13px;line-height:1.5;color:var(--color-body);">
      <strong>Legal Disclaimer:</strong> This calculator provides estimates for informational purposes only. Workers compensation laws vary by state and individual circumstances. This is not legal advice. Consult a licensed workers compensation attorney for guidance on your specific claim.
    </p>
  </div>

  <!-- Header -->
  <div style="margin-bottom:32px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom:8px;">Legal & Financial Tools</div>
    <h1 class="text-display-lg" style="color:var(--color-ink);margin-bottom:12px;">Workers Comp Calculator</h1>
    <p class="text-body-lg" style="color:var(--color-body);max-width:640px;">
      Estimate your workers compensation weekly benefits, total payments, and settlement value for all 50 US states. Based on 2024 state maximum rates and standard disability calculations.
    </p>
  </div>

  <!-- MAIN CALCULATOR -->
  <div class="calc-panel fade-up stagger-1" style="margin-bottom:40px;">
    <div class="calc-form">

      <!-- State selector -->
      <div>
        <label for="state-select" class="label">Your State</label>
        <select id="state-select" class="input-base input-lg" style="height:48px;padding:0 14px;" aria-label="Select your state">
          <option value="">— Select State —</option>
          {Object.entries(stateData).sort((a,b)=>a[1].name.localeCompare(b[1].name)).map(([code, s]) => (
            <option value={code}>{s.name} ({code})</option>
          ))}
        </select>
        <div id="state-info" class="state-info-bar" hidden>
          <span id="state-rate-display"></span>
          <span id="state-max-display"></span>
        </div>
      </div>

      <!-- Pay type + wages -->
      <div>
        <label class="label" style="margin-bottom:8px;">How Are You Paid?</label>
        <div class="pay-type-grid" role="group" aria-label="Pay type">
          <button class="pay-btn active" data-pay="weekly" aria-pressed="true">💵 Weekly Wage</button>
          <button class="pay-btn" data-pay="hourly" aria-pressed="false">⏱️ Hourly + Hours</button>
          <button class="pay-btn" data-pay="annual" aria-pressed="false">📅 Annual Salary</button>
        </div>
      </div>

      <!-- Weekly wage input -->
      <div id="pay-weekly-wrap">
        <label for="weekly-wage" class="label">Average Weekly Wage (before injury)</label>
        <div class="input-dollar-wrap">
          <span class="dollar-sign">$</span>
          <input type="number" id="weekly-wage" class="input-base input-lg input-dollar"
            placeholder="e.g. 1200" min="1" step="0.01"
            aria-label="Average weekly wage" />
        </div>
        <p style="font-size:12px;color:var(--color-muted);margin-top:5px;">Your gross (pre-tax) weekly earnings in the 52 weeks before injury</p>
      </div>

      <!-- Hourly input -->
      <div id="pay-hourly-wrap" hidden>
        <div class="two-col">
          <div>
            <label for="hourly-rate" class="label">Hourly Rate</label>
            <div class="input-dollar-wrap">
              <span class="dollar-sign">$</span>
              <input type="number" id="hourly-rate" class="input-base input-dollar" placeholder="e.g. 25.00" min="1" step="0.01" aria-label="Hourly rate" />
            </div>
          </div>
          <div>
            <label for="hours-per-week" class="label">Hours Per Week</label>
            <input type="number" id="hours-per-week" class="input-base" placeholder="e.g. 40" min="1" max="84" step="0.5" aria-label="Hours per week" />
          </div>
        </div>
      </div>

      <!-- Annual salary input -->
      <div id="pay-annual-wrap" hidden>
        <label for="annual-salary" class="label">Annual Salary</label>
        <div class="input-dollar-wrap">
          <span class="dollar-sign">$</span>
          <input type="number" id="annual-salary" class="input-base input-lg input-dollar"
            placeholder="e.g. 62400" min="1" step="100"
            aria-label="Annual salary" />
        </div>
      </div>

      <!-- Disability type -->
      <div>
        <label class="label" style="margin-bottom:10px;">Type of Disability</label>
        <div class="disability-list" role="radiogroup" aria-label="Disability type">
          {[
            { key:'ttd', label:'Temporary Total Disability (TTD)', desc:'Completely unable to work during recovery', icon:'🏥' },
            { key:'tpd', label:'Temporary Partial Disability (TPD)', desc:'Working light duty at reduced wages', icon:'💼' },
            { key:'ppd', label:'Permanent Partial Disability (PPD)', desc:'Permanent impairment after reaching MMI', icon:'🩺' },
            { key:'ptd', label:'Permanent Total Disability (PTD)', desc:'Cannot return to any work — lifetime benefits', icon:'♿' },
          ].map((d, i) => (
            <label class={`disability-radio ${i===0?'active':''}`} data-type={d.key}>
              <input type="radio" name="disability-type" value={d.key} checked={i===0} class="sr-only" />
              <div class="dr-icon">{d.icon}</div>
              <div class="dr-body">
                <div class="dr-label">{d.label}</div>
                <div class="dr-desc">{d.desc}</div>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- TTD duration -->
      <div id="ttd-duration-wrap">
        <label for="ttd-weeks" class="label">Expected Recovery Duration</label>
        <div class="input-with-unit-row">
          <input type="number" id="ttd-weeks" class="input-base input-lg" placeholder="e.g. 12" min="1" max="520" step="1" aria-label="Recovery weeks" style="flex:1;" />
          <span class="unit-label-text">weeks</span>
        </div>
        <div class="quick-weeks" style="margin-top:8px;">
          {[4,8,12,26,52,104].map(w => (
            <button class="quick-week-btn" data-weeks={w} aria-label={`${w} weeks`}>{w}w</button>
          ))}
        </div>
      </div>

      <!-- TPD fields -->
      <div id="tpd-wrap" hidden>
        <label for="tpd-current-wage" class="label">Current Light-Duty Weekly Wage</label>
        <div class="input-dollar-wrap">
          <span class="dollar-sign">$</span>
          <input type="number" id="tpd-current-wage" class="input-base input-lg input-dollar"
            placeholder="e.g. 600" min="1" step="0.01"
            aria-label="Current light duty wage" />
        </div>
        <div style="margin-top:12px;">
          <label for="tpd-weeks" class="label">Duration (weeks)</label>
          <input type="number" id="tpd-weeks" class="input-base" placeholder="e.g. 8" min="1" max="260" style="max-width:160px;" aria-label="TPD duration weeks" />
        </div>
      </div>

      <!-- PPD fields -->
      <div id="ppd-wrap" hidden>
        <div class="two-col">
          <div>
            <label for="impairment-rating" class="label">Impairment Rating (%)</label>
            <div style="position:relative;display:flex;align-items:center;">
              <input type="number" id="impairment-rating" class="input-base input-lg" placeholder="e.g. 15" min="1" max="100" step="1" aria-label="Impairment rating percentage" style="padding-right:40px;" />
              <span class="unit-badge">%</span>
            </div>
          </div>
          <div>
            <label for="body-part-select" class="label">Injured Body Part</label>
            <select id="body-part-select" class="input-base" style="height:44px;padding:0 10px;" aria-label="Injured body part">
              <option value="whole_body">Whole Body / Back (General)</option>
              <option value="back_lumbar">Back / Lumbar Spine</option>
              <option value="neck">Neck / Cervical</option>
              <option value="shoulder">Shoulder</option>
              <option value="upper_arm">Upper Arm</option>
              <option value="elbow">Elbow</option>
              <option value="forearm">Forearm</option>
              <option value="wrist">Wrist</option>
              <option value="hand">Hand</option>
              <option value="thumb">Thumb</option>
              <option value="index_finger">Index Finger</option>
              <option value="middle_finger">Middle Finger</option>
              <option value="ring_finger">Ring Finger</option>
              <option value="little_finger">Little Finger</option>
              <option value="hip">Hip</option>
              <option value="upper_leg">Upper Leg / Thigh</option>
              <option value="knee">Knee</option>
              <option value="lower_leg">Lower Leg</option>
              <option value="ankle">Ankle</option>
              <option value="foot">Foot</option>
              <option value="great_toe">Great Toe</option>
              <option value="other_toe">Other Toe</option>
              <option value="eye">Eye (one)</option>
              <option value="hearing_one">Hearing Loss (one ear)</option>
              <option value="hearing_both">Hearing Loss (both ears)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- PTD duration -->
      <div id="ptd-wrap" hidden>
        <label for="ptd-years" class="label">Expected Years Receiving Benefits</label>
        <div class="input-with-unit-row">
          <input type="number" id="ptd-years" class="input-base input-lg" placeholder="e.g. 20" min="1" max="60" step="1" aria-label="Years receiving PTD benefits" style="flex:1;" />
          <span class="unit-label-text">years</span>
        </div>
        <p style="font-size:12px;color:var(--color-muted);margin-top:5px;">Many states provide PTD benefits for life. Enter your estimated remaining working years or life expectancy.</p>
      </div>

      <!-- Additional weekly comp (for offset) -->
      <div>
        <label for="other-income" class="label">
          Other Disability Income (SSDI, pension, etc.) <span style="font-size:11px;font-weight:400;color:var(--color-muted);">(optional — for offset calculation)</span>
        </label>
        <div class="input-dollar-wrap">
          <span class="dollar-sign">$</span>
          <input type="number" id="other-income" class="input-base input-dollar"
            placeholder="0" min="0" step="1"
            aria-label="Other weekly disability income" />
        </div>
      </div>

      <div style="display:flex;gap:12px;margin-top:4px;">
        <button id="calc-wc-btn" class="btn-primary" style="flex:1;">Calculate Workers Comp Benefits</button>
        <button id="clear-wc-btn" class="btn-secondary">Reset</button>
      </div>
    </div>

    <!-- Error -->
    <div id="wc-error" class="calc-error" role="alert" aria-live="polite" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3M8 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span id="wc-error-msg"></span>
    </div>

    <!-- RESULTS -->
    <div id="wc-results" hidden aria-live="polite">
      <div class="results-divider" style="margin:28px 0;"></div>

      <!-- State + type banner -->
      <div class="result-state-banner">
        <span id="res-state-name">—</span>
        <span class="result-type-badge" id="res-type-badge">TTD</span>
      </div>

      <!-- Hero cards -->
      <div class="wc-hero-grid" style="margin-top:16px;">
        <div class="wc-hero-card wc-primary">
          <div class="wc-hero-label">Weekly Benefit</div>
          <div class="wc-hero-value" id="res-weekly-benefit">$—</div>
          <div class="wc-hero-sub" id="res-replacement-rate">—% wage replacement</div>
        </div>
        <div class="wc-hero-card">
          <div class="wc-hero-label">Total Estimated Benefit</div>
          <div class="wc-hero-value" id="res-total-benefit">$—</div>
          <div class="wc-hero-sub" id="res-duration-label">—</div>
        </div>
        <div class="wc-hero-card">
          <div class="wc-hero-label">Monthly Equivalent</div>
          <div class="wc-hero-value" id="res-monthly">$—</div>
          <div class="wc-hero-sub">per month (approx.)</div>
        </div>
      </div>

      <!-- Detailed breakdown -->
      <div class="result-panel" style="margin-top:20px;">
        <div class="result-row">
          <span class="result-row-label">📊 Average Weekly Wage (AWW)</span>
          <span class="result-row-value" id="res-aww">$—</span>
        </div>
        <div class="result-row">
          <span class="result-row-label">⚖️ State Replacement Rate</span>
          <span class="result-row-value" id="res-rate-pct">—%</span>
        </div>
        <div class="result-row">
          <span class="result-row-label">🧮 Calculated Benefit</span>
          <span class="result-row-value" id="res-calc-benefit">$—/week</span>
        </div>
        <div class="result-row">
          <span class="result-row-label">🏛️ State Maximum Benefit</span>
          <span class="result-row-value" id="res-state-max">$—/week</span>
        </div>
        <div class="result-row" id="offset-row" hidden>
          <span class="result-row-label">➖ SSDI / Other Income Offset</span>
          <span class="result-row-value" id="res-offset" style="color:#e5241a;">−$—/week</span>
        </div>
        <div class="result-row" style="border-bottom:none;">
          <span class="result-row-label" style="font-weight:600;font-size:15px;">✅ Final Weekly Benefit</span>
          <span class="result-row-value" id="res-final-weekly" style="font-size:18px;font-weight:700;color:var(--color-link);">$—</span>
        </div>
      </div>

      <!-- Wage comparison bar -->
      <div class="wage-bar-wrap" style="margin-top:20px;">
        <div style="font-size:13px;font-weight:600;color:var(--color-ink);margin-bottom:8px;">Wage Replacement Visualization</div>
        <div class="wage-bar-labels">
          <span>Workers Comp Benefit</span>
          <span>Pre-Injury Weekly Wage</span>
        </div>
        <div class="wage-bar-track">
          <div class="wage-bar-comp" id="wage-bar-comp"></div>
          <div class="wage-bar-gap" id="wage-bar-gap"></div>
        </div>
        <div class="wage-bar-amounts">
          <span style="color:var(--color-link);" id="bar-comp-amount">$—</span>
