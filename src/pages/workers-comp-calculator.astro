// PPD weeks per body part per AMA schedule (simplified)
const bodyPartWeeks: Record<string, number> = {
  'thumb': 75, 'index_finger': 46, 'middle_finger': 40, 'ring_finger': 25, 'little_finger': 20,
  'hand': 244, 'wrist': 244, 'forearm': 280, 'elbow': 280, 'upper_arm': 312, 'shoulder': 312,
  'great_toe': 38, 'other_toe': 16, 'foot': 205, 'ankle': 205, 'lower_leg': 288, 'knee': 288,
  'upper_leg': 320, 'hip': 320, 'eye': 160, 'hearing_one': 52, 'hearing_both': 200,
  'back_lumbar': 400, 'neck': 400, 'whole_body': 500,
};

const schemas = [
  generateSoftwareApplication({
    name: 'Workers Comp Calculator',
    description: 'Free workers compensation calculator. Estimate your weekly workers comp benefits, total disability payments, and settlement value by state. Covers all 50 US states with accurate maximum benefit rates.',
    url: '/workers-comp-calculator',
  }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Annuity Calculator', href: '/annuity-calculator', icon: '📈', desc: 'Estimate annuity payments' },
  { name: '401(k) Calculator', href: '/401k-calculator', icon: '🏦', desc: 'Retirement savings planner' },
