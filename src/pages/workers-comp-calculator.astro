  <!-- STATE MAXIMUM REFERENCE TABLE -->
  <div style="margin-bottom:40px;" class="fade-up">
    <h2 style="color:var(--color-ink);margin-bottom:8px;font-size:22px;font-weight:600;">Workers Comp Maximum Weekly Benefits by State (2024)</h2>
    <p class="text-body-sm" style="color:var(--color-body);margin-bottom:16px;">Maximum weekly temporary total disability (TTD) benefit amounts for all 50 states.</p>
    <div style="overflow-x:auto;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:13px;color:var(--color-body);text-align:left;">
