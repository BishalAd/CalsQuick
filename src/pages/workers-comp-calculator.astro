  // Build state table
  function buildStateTable() {
    const sorted = Object.entries(STATE_DATA).sort((a,b)=>a[1].name.localeCompare(b[1].name));
    const half = Math.ceil(sorted.length / 2);
    const left = sorted.slice(0, half);
    const right = sorted.slice(half);
    const tbody = document.getElementById('state-table-body') as HTMLElement;
    const maxRows = Math.max(left.length, right.length);
    for (let i = 0; i < maxRows; i++) {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--color-hairline)';
      const renderCell = (entry: [string, {max:number;rate:number;name:string}] | undefined) => {
        if (!entry) return '<td colspan="3"></td>';
        const [code, s] = entry;
        return `<td style="padding:8px 14px;font-weight:500;">${s.name}</td>
                <td style="padding:8px 14px;text-align:right;font-family:var(--font-mono);font-weight:600;color:var(--color-link);">${fmt(s.max)}</td>
                <td style="padding:8px 14px;text-align:center;font-family:var(--font-mono);">${(s.rate*100).toFixed(0)}%</td>`;
      };
      tr.innerHTML = renderCell(left[i]) + renderCell(right[i]);
      tbody.appendChild(tr);
    }
  }
  buildStateTable();

  // MAIN CALCULATE
  document.getElementById('calc-wc-btn')!.addEventListener('click', () => {
    const errorEl = document.getElementById('wc-error') as HTMLElement;
    const resultsEl = document.getElementById('wc-results') as HTMLElement;
    errorEl.hidden = true;

    const stateCode = (document.getElementById('state-select') as HTMLSelectElement).value;
    if (!stateCode || !STATE_DATA[stateCode]) {
      document.getElementById('wc-error-msg')!.textContent = 'Please select your state.';
      errorEl.hidden = false; return;
    }
    const state = STATE_DATA[stateCode];

    // Get AWW
    let aww = 0;
    if (payType === 'weekly') {
      aww = parseFloat((document.getElementById('weekly-wage') as HTMLInputElement).value);
    } else if (payType === 'hourly') {
      const rate = parseFloat((document.getElementById('hourly-rate') as HTMLInputElement).value);
      const hrs = parseFloat((document.getElementById('hours-per-week') as HTMLInputElement).value);
      if (!isNaN(rate) && !isNaN(hrs)) aww = rate * hrs;
    } else {
      const annual = parseFloat((document.getElementById('annual-salary') as HTMLInputElement).value);
      if (!isNaN(annual)) aww = annual / 52;
    }

    if (!aww || aww <= 0) {
      document.getElementById('wc-error-msg')!.textContent = 'Please enter your wage information.';
      errorEl.hidden = false; return;
    }

    const otherIncome = parseFloat((document.getElementById('other-income') as HTMLInputElement).value) || 0;

    // Calculate base weekly benefit
    let calcBenefit = aww * state.rate;
    const cappedBenefit = Math.min(calcBenefit, state.max);

    // Apply offset
    const totalDisability = cappedBenefit + otherIncome;
    const offsetThreshold = aww * 0.80; // 80% AWW rule
    let offset = 0;
    if (totalDisability > offsetThreshold) {
      offset = Math.max(0, totalDisability - offsetThreshold);
    }
    const finalWeekly = Math.max(0, cappedBenefit - offset);

    // Duration and totals
    let totalBenefit = 0;
    let durationLabel = '';
    let typeLabel = '';

    if (disabilityType === 'ttd') {
      const weeks = parseFloat((document.getElementById('ttd-weeks') as HTMLInputElement).value) || 0;
      if (weeks <= 0) { document.getElementById('wc-error-msg')!.textContent = 'Enter expected recovery duration in weeks.'; errorEl.hidden=false; return; }
      totalBenefit = finalWeekly * weeks;
      durationLabel = `${weeks} weeks of benefits`;
      typeLabel = 'Temporary Total Disability';
    } else if (disabilityType === 'tpd') {
      const currentWage = parseFloat((document.getElementById('tpd-current-wage') as HTMLInputElement).value) || 0;
      const weeks = parseFloat((document.getElementById('tpd-weeks') as HTMLInputElement).value) || 0;
      if (weeks <= 0) { document.getElementById('wc-error-msg')!.textContent = 'Enter TPD duration in weeks.'; errorEl.hidden=false; return; }
      const wageDiff = Math.max(0, aww - currentWage);
      const tpdBenefit = wageDiff * state.rate;
      totalBenefit = Math.min(tpdBenefit, state.max) * weeks;
      durationLabel = `${weeks} weeks TPD benefits`;
      typeLabel = 'Temporary Partial Disability';
    } else if (disabilityType === 'ppd') {
      const impRating = parseFloat((document.getElementById('impairment-rating') as HTMLInputElement).value) || 0;
      const bodyPart = (document.getElementById('body-part-select') as HTMLSelectElement).value;
      if (impRating <= 0) { document.getElementById('wc-error-msg')!.textContent = 'Enter impairment rating percentage.'; errorEl.hidden=false; return; }
      const maxWeeks = BODY_PART_WEEKS[bodyPart] || 500;
      const ppdWeeks = (impRating / 100) * maxWeeks;
      totalBenefit = finalWeekly * ppdWeeks;
      durationLabel = `${ppdWeeks.toFixed(1)} weeks PPD (${impRating}% of ${maxWeeks} max weeks)`;
      typeLabel = 'Permanent Partial Disability';
    } else {
      const years = parseFloat((document.getElementById('ptd-years') as HTMLInputElement).value) || 0;
      if (years <= 0) { document.getElementById('wc-error-msg')!.textContent = 'Enter expected years of PTD benefits.'; errorEl.hidden=false; return; }
      totalBenefit = finalWeekly * 52 * years;
      durationLabel = `${years} years of PTD benefits`;
      typeLabel = 'Permanent Total Disability';
    }

    // Populate results
    (document.getElementById('res-state-name') as HTMLElement).textContent = `${state.name} Workers Compensation`;
    (document.getElementById('res-type-badge') as HTMLElement).textContent = typeLabel;
    (document.getElementById('res-weekly-benefit') as HTMLElement).textContent = fmt(finalWeekly);
    (document.getElementById('res-replacement-rate') as HTMLElement).textContent = `${(finalWeekly/aww*100).toFixed(1)}% wage replacement`;
    (document.getElementById('res-total-benefit') as HTMLElement).textContent = fmt(totalBenefit);
    (document.getElementById('res-duration-label') as HTMLElement).textContent = durationLabel;
    (document.getElementById('res-monthly') as HTMLElement).textContent = fmt(finalWeekly * 4.333);
    (document.getElementById('res-aww') as HTMLElement).textContent = fmt(aww) + '/week';
    (document.getElementById('res-rate-pct') as HTMLElement).textContent = (state.rate*100).toFixed(2) + '%';
    (document.getElementById('res-calc-benefit') as HTMLElement).textContent = fmt(calcBenefit) + '/week';
    (document.getElementById('res-state-max') as HTMLElement).textContent = fmt(state.max) + '/week';
    (document.getElementById('res-final-weekly') as HTMLElement).textContent = fmt(finalWeekly) + '/week';

    // Offset row
    const offsetRow = document.getElementById('offset-row') as HTMLElement;
    if (offset > 0) {
      (document.getElementById('res-offset') as HTMLElement).textContent = `−${fmt(offset)}/week`;
      offsetRow.hidden = false;
    } else {
      offsetRow.hidden = true;
    }

    // Wage bar
    const compPct = Math.min((finalWeekly / aww) * 100, 100);
    const gapPct = Math.max(0, 100 - compPct);
    (document.getElementById('wage-bar-comp') as HTMLElement).style.width = compPct + '%';
    (document.getElementById('wage-bar-gap') as HTMLElement).style.width = gapPct + '%';
    (document.getElementById('bar-comp-amount') as HTMLElement).textContent = fmt(finalWeekly);
    (document.getElementById('bar-gap-amount') as HTMLElement).textContent = fmt(aww - finalWeekly) + ' gap';
    (document.getElementById('bar-total-amount') as HTMLElement).textContent = fmt(aww);

    // Settlement estimate
    (document.getElementById('settle-low') as HTMLElement).textContent = fmt(totalBenefit * 0.8);
    (document.getElementById('settle-mid') as HTMLElement).textContent = fmt(totalBenefit * 1.5);
    (document.getElementById('settle-high') as HTMLElement).textContent = fmt(totalBenefit * 3.0);

    resultsEl.hidden = false;
    resultsEl.scrollIntoView({ behavior:'smooth', block:'nearest' });
  });

  document.getElementById('clear-wc-btn')!.addEventListener('click', () => {
    (document.getElementById('state-select') as HTMLSelectElement).value = '';
    (document.getElementById('state-info') as HTMLElement).hidden = true;
    ['weekly-wage','hourly-rate','hours-per-week','annual-salary','ttd-weeks',
     'tpd-current-wage','tpd-weeks','impairment-rating','ptd-years','other-income'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (el) el.value = '';
    });
    (document.getElementById('wc-results') as HTMLElement).hidden = true;
    (document.getElementById('wc-error') as HTMLElement).hidden = true;
    document.querySelectorAll('.quick-week-btn').forEach(b => b.classList.remove('active'));
  });

  // FAQ
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>
