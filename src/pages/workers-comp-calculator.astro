  const fmt = (n:number) => '$' + Math.round(n).toLocaleString();
  const fmt2 = (n:number) => '$' + n.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g,',');

  // Pay type
  let payType = 'weekly';
  let disabilityType = 'ttd';

  document.querySelectorAll('.pay-btn').forEach(btn => {
