---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { generateFAQ, generateSoftwareApplication } from '../utils/seo';

const faqs = [
  { 
    q: 'What is a unit converter and how does it work?', 
    a: 'A unit converter is a free online tool that instantly converts measurements from one unit to another across various categories like length, weight, temperature, volume, area, speed, time, and more. Simply enter a value, select the "from" unit and "to" unit, and the conversion is calculated instantly using precise mathematical formulas and conversion factors. Our all-in-one converter supports 15+ categories with 200+ units — from common conversions (miles to kilometers, pounds to kilograms, Fahrenheit to Celsius) to specialized ones (data storage, fuel economy, pressure, angle). All calculations happen in your browser for instant results.' 
  },
  { 
    q: 'What unit categories does this converter support?', 
    a: 'Our comprehensive unit converter supports 15+ categories: (1) Length — meters, feet, inches, miles, kilometers, yards, centimeters, millimeters, nautical miles, (2) Weight/Mass — kilograms, pounds, ounces, grams, tons, stone, (3) Temperature — Celsius, Fahrenheit, Kelvin, (4) Volume — liters, gallons, milliliters, cups, fluid ounces, cubic meters, (5) Area — square meters, square feet, acres, hectares, square miles, (6) Speed — mph, km/h, m/s, knots, (7) Time — seconds, minutes, hours, days, weeks, months, years, (8) Digital Storage — bytes, KB, MB, GB, TB, PB, (9) Fuel Economy — mpg, km/l, L/100km, (10) Pressure — bar, psi, pascal, atm, (11) Angle — degrees, radians, gradians, (12) Frequency — hertz, kilohertz, megahertz, (13) Energy — joules, calories, kilowatt-hours, (14) Power — watts, kilowatts, horsepower, (15) Data Transfer — bps, kbps, mbps, gbps.' 
  },
  { 
    q: 'How do I convert between metric and imperial units?', 
    a: 'Our converter makes metric-imperial conversions effortless. Common conversions: Length: 1 inch = 2.54 cm, 1 foot = 0.3048 meters, 1 mile = 1.60934 km, 1 meter = 3.28084 feet. Weight: 1 pound = 0.453592 kg, 1 kg = 2.20462 pounds, 1 ounce = 28.3495 grams. Volume: 1 gallon (US) = 3.78541 liters, 1 liter = 0.264172 gallons. Temperature: °F = (°C × 9/5) + 32, °C = (°F − 32) × 5/9. Simply select your units and the tool applies the exact conversion factor. No memorization needed!' 
  },
  { 
    q: 'Does this converter support currency exchange rates?', 
    a: 'Yes! Our currency converter fetches live exchange rates for 30+ major currencies including USD, EUR, GBP, JPY, AUD, CAD, CHF, CNY, INR, and more. The rates are updated daily from reliable public APIs. You can convert between any two currencies with real-time accuracy. For offline use or when rates are unavailable, we use cached rates. Note: Currency rates fluctuate constantly — the displayed rate is the most recent available and should be used for reference. For financial transactions, check with your bank or exchange service.' 
  },
  { 
    q: 'Can I convert cooking measurements?', 
    a: 'Absolutely! Our volume and weight converters are perfect for cooking and baking conversions: Cups to milliliters, tablespoons to milliliters, Fluid ounces to milliliters, Grams to ounces, Pounds to grams, Teaspoons to milliliters. We include both US customary and metric cooking units. For example: 1 cup = 240 ml, 1 tablespoon = 15 ml, 1 teaspoon = 5 ml, 1 fluid ounce = 29.5735 ml. The converter handles precise decimal conversions essential for baking accuracy.' 
  },
  { 
    q: 'How do I convert digital storage units (bytes, KB, MB, GB, TB)?', 
    a: 'Our data storage converter handles both decimal (SI) and binary (IEC) units. Decimal: 1 KB = 1000 bytes, 1 MB = 1000 KB, 1 GB = 1000 MB (used by hard drive manufacturers). Binary: 1 KiB = 1024 bytes, 1 MiB = 1024 KiB, 1 GiB = 1024 MiB (used by operating systems). Simply select your units and we handle the math. Common conversions: 1 GB ≈ 1000 MB (decimal) or 1024 MB (binary), 1 TB = 1000 GB, 1 PB = 1000 TB. This helps explain why a "1TB" hard drive shows as ~931GB in Windows.' 
  },
  { 
    q: 'Can I save my favorite conversions for quick access?', 
    a: 'Yes! Our favorites feature lets you save frequently used conversions for one-click access. While browsing any category, click the star icon to save that conversion pair (e.g., "Miles → Kilometers"). Saved favorites appear in a dedicated "Favorites" tab and persist in your browser\'s local storage — they\'ll still be there when you return. You can save unlimited favorites and remove them anytime. This is perfect for conversions you use regularly, like currency rates or cooking measurements.' 
  },
  { 
    q: 'How accurate are the conversions?', 
    a: 'Our conversions use precise, scientifically-accepted conversion factors with high decimal precision. For example: 1 inch = exactly 2.54 cm, 1 pound = exactly 0.45359237 kg, 1 gallon (US) = exactly 3.785411784 liters. Results are displayed with appropriate decimal places (usually 2-6 depending on the category) to balance accuracy with readability. For scientific or engineering use, we show up to 10 decimal places. All temperature conversions use the exact formulas: °F = (°C × 9/5) + 32 and K = °C + 273.15.' 
  },
  { 
    q: 'Can I use this converter offline?', 
    a: 'Yes! Most conversion categories work completely offline — all formulas and conversion factors are embedded in the JavaScript code. The currency converter requires an internet connection for live rates but will use cached rates when offline. The tool loads once and continues working even without internet. This makes it reliable for: International travel, Areas with poor connectivity, Quick reference in meetings, and Students without constant internet access.' 
  },
  { 
    q: 'What are the most commonly converted units?', 
    a: 'Based on global usage data, the most frequent conversions are: (1) Miles to Kilometers (and vice versa) — travel and navigation, (2) Pounds to Kilograms — weight/fitness, (3) Fahrenheit to Celsius — weather/temperature, (4) Inches to Centimeters — measurements/DIY, (5) Gallons to Liters — fuel/volume, (6) USD to EUR — currency, (7) Feet to Meters — construction/real estate, (8) Ounces to Grams — cooking, (9) MPH to km/h — speed limits, (10) MB to GB — digital storage. Our tool surfaces these popular conversions at the top of each category for quick access.' 
  },
  { 
    q: 'How do I convert compound units (e.g., m/s to km/h)?', 
    a: 'For speed conversions like m/s to km/h, we handle the compound math automatically. Example: 1 m/s = 3.6 km/h (because 1 meter × 3600 seconds / 1000 meters = 3.6 km/h). Other compound conversions: km/h to mph (multiply by 0.621371), knots to km/h (multiply by 1.852), and liters/100km to mpg (complex formula). The converter applies the correct mathematical relationship, so you get accurate results without manual calculations.' 
  },
  { 
    q: 'Is there a way to see the conversion formula used?', 
    a: 'Yes! When you perform a conversion, the tool shows the formula used below the result. For example, converting Celsius to Fahrenheit shows: "Formula: °F = (°C × 9/5) + 32". This educational feature helps you understand the math behind the conversion and learn the relationships between units. For complex conversions, the step-by-step calculation is shown. Students find this particularly helpful for learning unit conversions in math and science classes.' 
  },
];

const schemas = [
  generateSoftwareApplication({
    name: 'Unit Converter — Free All-in-One Conversion Tool (15+ Categories)',
    description: 'Free all-in-one unit converter with 15+ categories: length, weight, temperature, volume, area, speed, time, data storage, currency, fuel economy, pressure, angle, energy, power, and more.',
    url: '/unit-converter',
  }),
  generateFAQ(faqs),
];

const relatedCalcs = [
  { name: 'Currency Converter', href: '/currency-converter', icon: '💱', desc: 'Live exchange rates' },
  { name: 'Percentage Calculator', href: '/percentage-calculator', icon: '🔢', desc: 'Quick percentage math' },
  { name: 'Age Calculator', href: '/age-calculator', icon: '🎂', desc: 'Calculate your age' },
  { name: 'BMI Calculator', href: '/bmi-calculator', icon: '⚖️', desc: 'Body mass index' },
];

const categories = [
  { id: 'length', icon: '📏', name: 'Length', units: ['Meter (m)', 'Kilometer (km)', 'Centimeter (cm)', 'Millimeter (mm)', 'Mile (mi)', 'Yard (yd)', 'Foot (ft)', 'Inch (in)', 'Nautical Mile (nmi)'] },
  { id: 'weight', icon: '⚖️', name: 'Weight/Mass', units: ['Kilogram (kg)', 'Gram (g)', 'Milligram (mg)', 'Pound (lb)', 'Ounce (oz)', 'Stone (st)', 'Ton (t)', 'Carat (ct)'] },
  { id: 'temperature', icon: '🌡️', name: 'Temperature', units: ['Celsius (°C)', 'Fahrenheit (°F)', 'Kelvin (K)'] },
  { id: 'volume', icon: '🪣', name: 'Volume', units: ['Liter (L)', 'Milliliter (mL)', 'Gallon (US)', 'Quart (US)', 'Pint (US)', 'Cup (US)', 'Fluid Ounce (US)', 'Tablespoon', 'Teaspoon', 'Cubic Meter (m³)'] },
  { id: 'area', icon: '📐', name: 'Area', units: ['Square Meter (m²)', 'Square Kilometer (km²)', 'Square Foot (ft²)', 'Square Mile (mi²)', 'Acre', 'Hectare (ha)', 'Square Yard (yd²)', 'Square Inch (in²)'] },
  { id: 'speed', icon: '🏃', name: 'Speed', units: ['Meters/Second (m/s)', 'Kilometers/Hour (km/h)', 'Miles/Hour (mph)', 'Knots (kn)', 'Feet/Second (ft/s)'] },
  { id: 'time', icon: '⏰', name: 'Time', units: ['Second (s)', 'Minute (min)', 'Hour (h)', 'Day (d)', 'Week (wk)', 'Month (mo)', 'Year (yr)', 'Millisecond (ms)'] },
  { id: 'data', icon: '💾', name: 'Data Storage', units: ['Byte (B)', 'Kilobyte (KB)', 'Megabyte (MB)', 'Gigabyte (GB)', 'Terabyte (TB)', 'Petabyte (PB)', 'Kibibyte (KiB)', 'Mebibyte (MiB)', 'Gibibyte (GiB)'] },
  { id: 'fuel', icon: '⛽', name: 'Fuel Economy', units: ['Miles/Gallon (mpg US)', 'Miles/Gallon (mpg UK)', 'Kilometers/Liter (km/L)', 'Liters/100km (L/100km)'] },
  { id: 'pressure', icon: '🎈', name: 'Pressure', units: ['Pascal (Pa)', 'Kilopascal (kPa)', 'Bar', 'PSI (lb/in²)', 'Atmosphere (atm)', 'mmHg', 'Torr'] },
  { id: 'angle', icon: '📐', name: 'Angle', units: ['Degree (°)', 'Radian (rad)', 'Gradian (grad)', 'Minute of Arc', 'Second of Arc'] },
  { id: 'energy', icon: '⚡', name: 'Energy', units: ['Joule (J)', 'Kilojoule (kJ)', 'Calorie (cal)', 'Kilocalorie (kcal)', 'Watt-hour (Wh)', 'Kilowatt-hour (kWh)', 'Electronvolt (eV)'] },
  { id: 'power', icon: '🔌', name: 'Power', units: ['Watt (W)', 'Kilowatt (kW)', 'Megawatt (MW)', 'Horsepower (hp)', 'BTU/Hour', 'Foot-pound/min'] },
  { id: 'frequency', icon: '📡', name: 'Frequency', units: ['Hertz (Hz)', 'Kilohertz (kHz)', 'Megahertz (MHz)', 'Gigahertz (GHz)'] },
  { id: 'currency', icon: '💱', name: 'Currency', units: ['USD ($)', 'EUR (€)', 'GBP (£)', 'JPY (¥)', 'AUD (A$)', 'CAD (C$)', 'CHF (Fr)', 'CNY (¥)', 'INR (₹)', 'NPR (Rs)', 'BRL (R$)', 'MXN (Mex$)', 'KRW (₩)', 'SGD (S$)', 'NZD (NZ$)'] },
];

const popularConversions = [
  { from: 'Mile (mi)', to: 'Kilometer (km)', cat: 'length' },
  { from: 'Pound (lb)', to: 'Kilogram (kg)', cat: 'weight' },
  { from: 'Fahrenheit (°F)', to: 'Celsius (°C)', cat: 'temperature' },
  { from: 'Inch (in)', to: 'Centimeter (cm)', cat: 'length' },
  { from: 'Gallon (US)', to: 'Liter (L)', cat: 'volume' },
  { from: 'Ounce (oz)', to: 'Gram (g)', cat: 'weight' },
  { from: 'Miles/Hour (mph)', to: 'Kilometers/Hour (km/h)', cat: 'speed' },
  { from: 'Gigabyte (GB)', to: 'Megabyte (MB)', cat: 'data' },
  { from: 'Foot (ft)', to: 'Meter (m)', cat: 'length' },
  { from: 'Cup (US)', to: 'Milliliter (mL)', cat: 'volume' },
];
</script>

<CalculatorLayout
  title="Unit Converter — Free All-in-One Conversion Tool (Length, Weight, Temperature & More)"
  description="Free all-in-one unit converter with 15+ categories, 200+ units. Convert length, weight, temperature, volume, area, speed, time, data storage, currency, fuel economy, and more. Works offline."
  canonical="/unit-converter"
  schema={schemas}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Unit Converter', url: '/unit-converter' }]}
  relatedCalcs={relatedCalcs}
>

  <!-- Header -->
  <div style="margin-bottom: 24px;" class="fade-up">
    <div class="eyebrow" style="margin-bottom: 8px;">Conversion Tools</div>
    <h1 class="text-display-lg" style="color: var(--color-ink); margin-bottom: 12px;">Unit Converter</h1>
    <p class="text-body-lg" style="color: var(--color-body); max-width: 700px;">
      Convert between 200+ units across 15 categories. Length, weight, temperature, volume, currency, data storage, speed, and more. Smart search, favorites, and precise conversions — all in one tool.
    </p>
  </div>

  <!-- MAIN WORKSPACE -->
  <div class="uc-workspace fade-up stagger-1" style="margin-bottom: 24px;">
    
    <!-- Category Tabs -->
    <div class="uc-category-bar">
      <div class="uc-category-scroll" id="uc-category-scroll">
        {categories.map(cat => (
          <button class="uc-cat-btn" data-cat={cat.id}>
            <span class="uc-cat-icon">{cat.icon}</span>
            <span class="uc-cat-name">{cat.name}</span>
          </button>
        ))}
      </div>
      <button id="uc-favorites-tab" class="uc-cat-btn uc-fav-btn">
        <span class="uc-cat-icon">⭐</span>
        <span class="uc-cat-name">Favorites</span>
      </button>
      <button id="uc-popular-tab" class="uc-cat-btn uc-popular-btn">
        <span class="uc-cat-icon">🔥</span>
        <span class="uc-cat-name">Popular</span>
      </button>
    </div>

    <!-- Converter Panel -->
    <div class="uc-converter-panel">
      
      <!-- Search -->
      <div class="uc-search-bar">
        <span class="uc-search-icon">🔍</span>
        <input type="text" id="uc-search-input" class="uc-search-input" placeholder="Search units... (e.g., 'miles to km', 'pounds', 'celsius')" />
      </div>

      <!-- Converter -->
      <div class="uc-converter">
        <div class="uc-input-group">
          <label class="uc-label">From</label>
          <div class="uc-unit-input-wrap">
            <input type="number" id="uc-from-value" class="uc-value-input" value="1" step="any" />
            <select id="uc-from-unit" class="uc-unit-select"></select>
          </div>
        </div>

        <div class="uc-swap-area">
          <button id="uc-swap-btn" class="uc-swap-btn" title="Swap units">⇄</button>
        </div>

        <div class="uc-input-group">
          <label class="uc-label">To</label>
          <div class="uc-unit-input-wrap">
            <input type="number" id="uc-to-value" class="uc-value-input uc-result" readonly />
            <select id="uc-to-unit" class="uc-unit-select"></select>
          </div>
        </div>
      </div>

      <!-- Result Details -->
      <div id="uc-result-details" class="uc-result-details">
        <div class="uc-formula-box" id="uc-formula-box" style="display:none;">
          <span class="uc-formula-label">📐 Formula:</span>
          <span class="uc-formula-text" id="uc-formula-text"></span>
        </div>
        <div class="uc-alternatives" id="uc-alternatives"></div>
      </div>

      <!-- Favorite Button -->
      <button id="uc-fav-btn" class="uc-fav-toggle" title="Save to favorites">☆ Save to Favorites</button>
    </div>

    <!-- Quick Conversions Table -->
    <div class="uc-quick-table" id="uc-quick-table" style="display:none;">
      <h3 class="uc-quick-title">📊 Quick Reference — <span id="uc-quick-title"></span></h3>
      <div class="uc-quick-grid" id="uc-quick-grid"></div>
    </div>
  </div>

  <!-- POPULAR CONVERSIONS -->
  <div class="uc-popular-section fade-up" style="margin-bottom:32px;">
    <h2 style="color:var(--color-ink);font-size:18px;font-weight:600;margin-bottom:12px;">🔥 Most Popular Conversions</h2>
    <div class="uc-popular-grid" id="uc-popular-grid"></div>
  </div>

  <!-- SEO Article -->
  <div class="prose-section fade-up" style="margin-top:24px;">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:20px;">Free Online Unit Converter — Complete Conversion Tool</h2>
    
    <p class="text-body-md" style="color:var(--color-body);line-height:28px;margin-bottom:16px;">
      Whether you're traveling abroad, cooking from an international recipe, doing homework, or working on a DIY project, our <strong>free all-in-one unit converter</strong> has you covered. With <strong>15+ categories and 200+ units</strong>, you can convert anything from miles to kilometers, pounds to kilograms, Fahrenheit to Celsius, gallons to liters, gigabytes to megabytes, and much more. The smart search lets you find any conversion instantly — just type "miles to km" or "cups to ml" and get your answer. All conversions use precise formulas and work completely offline.
    </p>

    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">Complete Category List</h3>
    <div style="overflow-x:auto;margin:16px 0 24px;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:14px;color:var(--color-body);text-align:left;">
        <thead>
          <tr style="background:var(--color-canvas-soft-2);border-bottom:1px solid var(--color-hairline);font-weight:600;color:var(--color-ink);">
            <th style="padding:12px 16px;">Category</th>
            <th style="padding:12px 16px;">Common Units</th>
            <th style="padding:12px 16px;">Most Used Conversion</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['📏 Length', 'Meter, Foot, Inch, Mile, Kilometer, Yard, cm, mm', 'Miles ↔ Kilometers'],
            ['⚖️ Weight', 'Kilogram, Pound, Ounce, Gram, Stone, Ton', 'Pounds ↔ Kilograms'],
            ['🌡️ Temperature', 'Celsius, Fahrenheit, Kelvin', '°F ↔ °C'],
            ['🪣 Volume', 'Liter, Gallon, Cup, mL, Fluid Ounce, Tablespoon', 'Gallons ↔ Liters'],
            ['📐 Area', 'm², ft², Acre, Hectare, mi², yd²', 'Square Feet ↔ Square Meters'],
            ['🏃 Speed', 'm/s, km/h, mph, Knots', 'mph ↔ km/h'],
            ['⏰ Time', 'Second, Minute, Hour, Day, Week, Year', 'Hours ↔ Minutes'],
            ['💾 Data', 'Byte, KB, MB, GB, TB, KiB, MiB, GiB', 'GB ↔ MB'],
            ['⛽ Fuel', 'mpg, km/L, L/100km', 'mpg ↔ L/100km'],
            ['💱 Currency', 'USD, EUR, GBP, JPY, INR, CNY, 30+ more', 'USD ↔ EUR'],
          ].map(([cat, units, conversion]) => (
            <tr style="border-bottom:1px solid var(--color-hairline);">
              <td style="padding:10px 16px;font-weight:600;">{cat}</td>
              <td style="padding:10px 16px;color:var(--color-muted);">{units}</td>
              <td style="padding:10px 16px;color:var(--color-link);font-weight:500;">{conversion}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="text-body-lg-strong" style="color:var(--color-ink);margin-top:24px;margin-bottom:12px;">Essential Conversion Factors</h3>
    <div style="overflow-x:auto;margin:16px 0;border:1px solid var(--color-hairline);border-radius:var(--radius-md);">
      <table style="width:100%;border-collapse:collapse;font-size:14px;color:var(--color-body);text-align:left;">
        <thead>
          <tr style="background:var(--color-canvas-soft-2);border-bottom:1px solid var(--color-hairline);font-weight:600;color:var(--color-ink);">
            <th style="padding:12px 16px;">From</th>
            <th style="padding:12px 16px;">To</th>
            <th style="padding:12px 16px;">Multiply By</th>
            <th style="padding:12px 16px;">Common Use</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Inches', 'Centimeters', '2.54', 'Screen sizes, height'],
            ['Feet', 'Meters', '0.3048', 'Room dimensions'],
            ['Miles', 'Kilometers', '1.60934', 'Distance, travel'],
            ['Pounds', 'Kilograms', '0.453592', 'Body weight, shipping'],
            ['Ounces', 'Grams', '28.3495', 'Cooking, food labels'],
            ['Gallons (US)', 'Liters', '3.78541', 'Fuel, liquid volume'],
            ['Fahrenheit', 'Celsius', '(°F - 32) × 5/9', 'Weather, cooking'],
            ['mph', 'km/h', '1.60934', 'Speed limits, vehicles'],
          ].map(([from, to, factor, use]) => (
            <tr style="border-bottom:1px solid var(--color-hairline);">
              <td style="padding:10px 16px;font-weight:500;">{from}</td>
              <td style="padding:10px 16px;color:var(--color-link);">{to}</td>
              <td style="padding:10px 16px;font-family:var(--font-mono);">{factor}</td>
              <td style="padding:10px 16px;color:var(--color-muted);">{use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- FAQ -->
  <div style="margin-top:48px;" class="fade-up">
    <h2 class="text-display-sm" style="color:var(--color-ink);margin-bottom:24px;">Frequently Asked Questions</h2>
    <div class="faq-list" style="border-top:1px solid var(--color-hairline);">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={`uc-faq-${i}`} id={`uc-faq-btn-${i}`}>
            <span>{faq.q}</span>
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`uc-faq-${i}`} role="region" aria-labelledby={`uc-faq-btn-${i}`}>{faq.a}</div>
        </div>
      ))}
    </div>
  </div>

</CalculatorLayout>

<style>
  .uc-workspace {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    overflow: hidden;
  }

  /* Category Bar */
  .uc-category-bar {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-hairline);
    overflow-x: auto;
    background: var(--color-canvas-soft-2);
    padding: 4px 8px;
  }
  .uc-category-scroll {
    display: flex;
    gap: 4px;
    flex: 1;
    overflow-x: auto;
  }
  .uc-cat-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 14px;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s;
    font-family: inherit;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .uc-cat-btn:hover { background: var(--color-canvas); color: var(--color-ink); }
  .uc-cat-btn.active { background: var(--color-link); color: white; }
  .uc-cat-icon { font-size: 16px; }
  .uc-cat-name { font-weight: 600; }
  .uc-fav-btn { border-left: 1px solid var(--color-hairline); padding-left: 16px; }
  .uc-popular-btn { border-left: 1px solid var(--color-hairline); }

  /* Converter Panel */
  .uc-converter-panel {
    padding: 24px;
    max-width: 700px;
    margin: 0 auto;
  }

  .uc-search-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 60px;
    padding: 8px 16px;
    margin-bottom: 20px;
  }
  .uc-search-icon { font-size: 16px; opacity: 0.5; }
  .uc-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 14px;
    outline: none;
    font-family: inherit;
    color: var(--color-ink);
  }
  .uc-search-input::placeholder { color: var(--color-muted); }

  /* Converter */
  .uc-converter {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .uc-input-group {
    flex: 1;
    min-width: 0;
  }
  .uc-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
    display: block;
