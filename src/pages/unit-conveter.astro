    .prose-section { padding: 20px 16px; }
  }
</style>

<script>
  // ─── Conversion Factors ──────────────────────────────────────────────────────
  const conversionData: Record<string, Record<string, number | ((v: number) => number)>> = {
    length: {
      'Meter (m)': 1,
      'Kilometer (km)': 1000,
      'Centimeter (cm)': 0.01,
      'Millimeter (mm)': 0.001,
      'Mile (mi)': 1609.344,
      'Yard (yd)': 0.9144,
      'Foot (ft)': 0.3048,
      'Inch (in)': 0.0254,
      'Nautical Mile (nmi)': 1852,
    },
    weight: {
      'Kilogram (kg)': 1,
      'Gram (g)': 0.001,
      'Milligram (mg)': 0.000001,
      'Pound (lb)': 0.45359237,
      'Ounce (oz)': 0.028349523125,
      'Stone (st)': 6.35029318,
      'Ton (t)': 1000,
      'Carat (ct)': 0.0002,
    },
    volume: {
      'Liter (L)': 1,
      'Milliliter (mL)': 0.001,
      'Gallon (US)': 3.785411784,
      'Quart (US)': 0.946352946,
      'Pint (US)': 0.473176473,
      'Cup (US)': 0.24,
      'Fluid Ounce (US)': 0.02957353,
      'Tablespoon': 0.015,
      'Teaspoon': 0.005,
      'Cubic Meter (m³)': 1000,
    },
    area: {
      'Square Meter (m²)': 1,
      'Square Kilometer (km²)': 1000000,
      'Square Foot (ft²)': 0.09290304,
      'Square Mile (mi²)': 2589988.110336,
      'Acre': 4046.8564224,
      'Hectare (ha)': 10000,
      'Square Yard (yd²)': 0.83612736,
      'Square Inch (in²)': 0.00064516,
    },
    speed: {
      'Meters/Second (m/s)': 1,
      'Kilometers/Hour (km/h)': 0.277777778,
      'Miles/Hour (mph)': 0.44704,
      'Knots (kn)': 0.514444444,
      'Feet/Second (ft/s)': 0.3048,
    },
    time: {
      'Second (s)': 1,
      'Minute (min)': 60,
      'Hour (h)': 3600,
      'Day (d)': 86400,
      'Week (wk)': 604800,
      'Month (mo)': 2629800,
      'Year (yr)': 31557600,
      'Millisecond (ms)': 0.001,
    },
    data: {
      'Byte (B)': 1,
      'Kilobyte (KB)': 1000,
      'Megabyte (MB)': 1000000,
      'Gigabyte (GB)': 1000000000,
      'Terabyte (TB)': 1000000000000,
      'Petabyte (PB)': 1000000000000000,
      'Kibibyte (KiB)': 1024,
      'Mebibyte (MiB)': 1048576,
      'Gibibyte (GiB)': 1073741824,
    },
    fuel: {
      'Miles/Gallon (mpg US)': 1,
      'Miles/Gallon (mpg UK)': 0.832674,
      'Kilometers/Liter (km/L)': 2.352145,
      'Liters/100km (L/100km)': (v: number) => 235.2145 / v,
    },
    pressure: {
      'Pascal (Pa)': 1,
      'Kilopascal (kPa)': 1000,
      'Bar': 100000,
      'PSI (lb/in²)': 6894.75729,
      'Atmosphere (atm)': 101325,
      'mmHg': 133.322368,
      'Torr': 133.322368,
    },
    angle: {
      'Degree (°)': 1,
      'Radian (rad)': 57.2957795,
      'Gradian (grad)': 0.9,
      'Minute of Arc': 1/60,
      'Second of Arc': 1/3600,
    },
    energy: {
      'Joule (J)': 1,
      'Kilojoule (kJ)': 1000,
      'Calorie (cal)': 4.184,
      'Kilocalorie (kcal)': 4184,
      'Watt-hour (Wh)': 3600,
      'Kilowatt-hour (kWh)': 3600000,
      'Electronvolt (eV)': 1.602176634e-19,
    },
    power: {
      'Watt (W)': 1,
      'Kilowatt (kW)': 1000,
      'Megawatt (MW)': 1000000,
      'Horsepower (hp)': 745.699872,
      'BTU/Hour': 0.29307107,
      'Foot-pound/min': 0.0225969658,
    },
    frequency: {
      'Hertz (Hz)': 1,
      'Kilohertz (kHz)': 1000,
      'Megahertz (MHz)': 1000000,
      'Gigahertz (GHz)': 1000000000,
    },
  };

  // ─── State ────────────────────────────────────────────────────────────────────
  let currentCategory = 'length';
  let favorites: { cat: string; from: string; to: string }[] = [];
  let currencyRates: Record<string, number> = {};

  // ─── Currency Rates (Fallback) ──────────────────────────────────────────────
  const fallbackRates: Record<string, number> = {
    USD: 1, EUR: 0.92, GBP: 0.79, JPY: 149.5, AUD: 1.53, CAD: 1.36, CHF: 0.88,
    CNY: 7.24, INR: 83.5, NPR: 133.5, BRL: 4.97, MXN: 17.1, KRW: 1320, SGD: 1.34, NZD: 1.63,
  };

  // ─── DOM Elements ────────────────────────────────────────────────────────────
  const fromValue = document.getElementById('uc-from-value') as HTMLInputElement;
  const toValue = document.getElementById('uc-to-value') as HTMLInputElement;
  const fromUnit = document.getElementById('uc-from-unit') as HTMLSelectElement;
  const toUnit = document.getElementById('uc-to-unit') as HTMLSelectElement;

  // ─── Category Selection ─────────────────────────────────────────────────────
  function selectCategory(catId: string) {
    currentCategory = catId;
    document.querySelectorAll('.uc-cat-btn').forEach(b => b.classList.remove('active'));
    document.querySelector(`.uc-cat-btn[data-cat="${catId}"]`)?.classList.add('active');
    
    populateUnits(catId);
    convert();
    updateQuickTable();
    updateFavButton();
    updateFormula();
  }

  function populateUnits(catId: string) {
    const cat = categories.find(c => c.id === catId);
    if (!cat) return;
    
    const unitNames = cat.units;
    fromUnit.innerHTML = unitNames.map((u, i) => `<option value="${u}" ${i === 0 ? 'selected' : ''}>${u}</option>`).join('');
    toUnit.innerHTML = unitNames.map((u, i) => `<option value="${u}" ${i === Math.min(1, unitNames.length - 1) ? 'selected' : ''}>${u}</option>`).join('');
  }

  // ─── Conversion Logic ────────────────────────────────────────────────────────
  function convert() {
    const value = parseFloat(fromValue.value) || 0;
    const from = fromUnit.value;
    const to = toUnit.value;
    
    let result: number;
    
    if (currentCategory === 'temperature') {
      result = convertTemperature(value, from, to);
    } else if (currentCategory === 'currency') {
      result = convertCurrency(value, from, to);
    } else {
      result = convertStandard(value, from, to, currentCategory);
    }
    
    toValue.value = formatNumber(result);
    updateAlternatives(value, from, to);
    updateFormula();
  }

  function convertStandard(value: number, from: string, to: string, category: string): number {
    const factors = conversionData[category];
    if (!factors) return value;
    
    const fromFactor = factors[from];
    const toFactor = factors[to];
    
    if (typeof fromFactor === 'function' || typeof toFactor === 'function') {
      // Handle special fuel economy
      if (category === 'fuel') {
        const baseValue = typeof fromFactor === 'number' ? value * fromFactor : fromFactor(value);
        return typeof toFactor === 'number' ? baseValue / toFactor : toFactor(baseValue);
      }
    }
    
    if (typeof fromFactor === 'number' && typeof toFactor === 'number') {
      return (value * fromFactor) / toFactor;
    }
    
    return value;
  }

  function convertTemperature(value: number, from: string, to: string): number {
    // Convert to Celsius first
    let celsius: number;
    if (from.includes('Celsius')) celsius = value;
    else if (from.includes('Fahrenheit')) celsius = (value - 32) * 5/9;
    else if (from.includes('Kelvin')) celsius = value - 273.15;
    else celsius = value;
    
    // Convert from Celsius to target
    if (to.includes('Celsius')) return celsius;
    if (to.includes('Fahrenheit')) return (celsius * 9/5) + 32;
    if (to.includes('Kelvin')) return celsius + 273.15;
    return celsius;
  }

  function convertCurrency(value: number, from: string, to: string): number {
    const rates = Object.keys(currencyRates).length > 0 ? currencyRates : fallbackRates;
    
    const fromCode = from.match(/\(([^)]+)\)/)?.[1] || 'USD';
    const toCode = to.match(/\(([^)]+)\)/)?.[1] || 'EUR';
    
    const fromRate = rates[fromCode] || 1;
    const toRate = rates[toCode] || 1;
    
    return (value / fromRate) * toRate;
  }

  function formatNumber(num: number): string {
    if (Math.abs(num) < 0.000001 && num !== 0) return num.toExponential(6);
    if (Math.abs(num) < 0.01) return num.toFixed(6);
    if (Math.abs(num) < 1) return num.toFixed(4);
    if (Math.abs(num) < 1000) return num.toFixed(2);
    return num.toLocaleString('en-US', { maximumFractionDigits: 2 });
  }

  // ─── UI Updates ──────────────────────────────────────────────────────────────
  function updateFormula() {
    const box = document.getElementById('uc-formula-box')!;
    const text = document.getElementById('uc-formula-text')!;
    
    if (currentCategory === 'temperature') {
      const from = fromUnit.value;
      const to = toUnit.value;
      if (from.includes('Celsius') && to.includes('Fahrenheit')) {
        box.style.display = ''; text.textContent = '°F = (°C × 9/5) + 32';
      } else if (from.includes('Fahrenheit') && to.includes('Celsius')) {
        box.style.display = ''; text.textContent = '°C = (°F − 32) × 5/9';
      } else if (from.includes('Celsius') && to.includes('Kelvin')) {
        box.style.display = ''; text.textContent = 'K = °C + 273.15';
      } else {
        box.style.display = 'none';
      }
    } else if (currentCategory === 'fuel') {
      box.style.display = '';
      text.textContent = 'Using fuel economy conversion formula';
    } else {
      box.style.display = 'none';
    }
  }

  function updateAlternatives(value: number, from: string, to: string) {
    const container = document.getElementById('uc-alternatives')!;
    if (currentCategory === 'temperature' || currentCategory === 'currency') {
      container.innerHTML = '';
      return;
    }
    
    const cat = categories.find(c => c.id === currentCategory);
    if (!cat) return;
    
    const otherUnits = cat.units.filter(u => u !== from && u !== to).slice(0, 4);
    container.innerHTML = otherUnits.map(u => {
      const altValue = convertStandard(value, from, u, currentCategory);
      return `<span class="uc-alt-chip">${formatNumber(altValue)} ${u.split(' (')[0]}</span>`;
    }).join('');
  }

  function updateQuickTable() {
    const table = document.getElementById('uc-quick-table')!;
    const grid = document.getElementById('uc-quick-grid')!;
    const title = document.getElementById('uc-quick-title')!;
    
    if (currentCategory === 'currency' || currentCategory === 'temperature') {
      table.style.display = 'none';
      return;
    }
    
    table.style.display = '';
    const cat = categories.find(c => c.id === currentCategory);
    title.textContent = `${cat?.name} Quick Reference`;
    
    const from = fromUnit.value;
    const to = toUnit.value;
    const values = [0.1, 0.5, 1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
    
    grid.innerHTML = values.map(v => {
      const result = convertStandard(v, from, to, currentCategory);
      return `<div class="uc-quick-item">
        <span>${v} ${from.split(' (')[0]}</span>
        <span>${formatNumber(result)} ${to.split(' (')[0]}</span>
      </div>`;
    }).join('');
  }

  function updateFavButton() {
    const btn = document.getElementById('uc-fav-btn')!;
    const from = fromUnit.value;
    const to = toUnit.value;
    const isFav = favorites.some(f => f.cat === currentCategory && f.from === from && f.to === to);
    
    btn.textContent = isFav ? '⭐ Saved to Favorites' : '☆ Save to Favorites';
    btn.classList.toggle('saved', isFav);
  }

  // ─── Favorites ───────────────────────────────────────────────────────────────
  document.getElementById('uc-fav-btn')!.addEventListener('click', () => {
    const from = fromUnit.value;
    const to = toUnit.value;
    const existing = favorites.findIndex(f => f.cat === currentCategory && f.from === from && f.to === to);
    
    if (existing >= 0) {
      favorites.splice(existing, 1);
    } else {
      favorites.push({ cat: currentCategory, from, to });
    }
    
    try { localStorage.setItem('uc_favorites', JSON.stringify(favorites)); } catch(e) {}
    updateFavButton();
    if (document.querySelector('.uc-fav-btn.active')) renderFavorites();
  });

  function renderFavorites() {
    const grid = document.getElementById('uc-quick-grid')!;
    const table = document.getElementById('uc-quick-table')!;
    const title = document.getElementById('uc-quick-title')!;
    table.style.display = '';
    title.textContent = '⭐ Saved Favorites';
    
    if (favorites.length === 0) {
      grid.innerHTML = '<p style="color:var(--color-muted);padding:20px;">No favorites yet. Browse categories and click "Save to Favorites" on conversions you use often.</p>';
      return;
    }
    
    grid.innerHTML = favorites.map(f => `
      <div class="uc-popular-card" style="cursor:pointer;" onclick="loadFavorite('${f.cat}','${f.from}','${f.to}')">
        <span class="uc-popular-icon">⭐</span>
        <span class="uc-popular-text">
          <span class="uc-popular-from">${f.from}</span>
          <span class="uc-popular-arrow">→</span>
          <span class="uc-popular-to">${f.to}</span>
        </span>
      </div>
    `).join('');
  }

  (window as any).loadFavorite = (cat: string, from: string, to: string) => {
    selectCategory(cat);
    fromUnit.value = from;
    toUnit.value = to;
    convert();
    updateFavButton();
    updateQuickTable();
  };

  document.getElementById('uc-favorites-tab')!.addEventListener('click', () => {
    document.querySelectorAll('.uc-cat-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('uc-favorites-tab')!.classList.add('active');
    renderFavorites();
  });

  document.getElementById('uc-popular-tab')!.addEventListener('click', () => {
    document.querySelectorAll('.uc-cat-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('uc-popular-tab')!.classList.add('active');
    renderPopularConversions();
  });

  function renderPopularConversions() {
    const grid = document.getElementById('uc-quick-grid')!;
    const table = document.getElementById('uc-quick-table')!;
    const title = document.getElementById('uc-quick-title')!;
    table.style.display = '';
    title.textContent = '🔥 Popular Conversions';
    
    grid.innerHTML = popularConversions.map(p => `
      <div class="uc-popular-card" onclick="loadFavorite('${p.cat}','${p.from}','${p.to}')">
        <span class="uc-popular-icon">🔥</span>
        <span class="uc-popular-text">
          <span class="uc-popular-from">${p.from.split(' (')[0]}</span>
          <span class="uc-popular-arrow">→</span>
          <span class="uc-popular-to">${p.to.split(' (')[0]}</span>
        </span>
      </div>
    `).join('');
  }

  // ─── Smart Search ────────────────────────────────────────────────────────────
  document.getElementById('uc-search-input')!.addEventListener('input', function() {
    const query = (this as HTMLInputElement).value.toLowerCase().trim();
    if (!query) return;
    
    // Check for "X to Y" pattern
    const toMatch = query.match(/(.+?)\s+(?:to|in|→|->)\s+(.+)/);
    if (toMatch) {
      const searchFrom = toMatch[1].trim();
      const searchTo = toMatch[2].trim();
      
      for (const cat of categories) {
        const fromUnit = cat.units.find(u => u.toLowerCase().includes(searchFrom));
        const toUnit = cat.units.find(u => u.toLowerCase().includes(searchTo));
        if (fromUnit && toUnit) {
          selectCategory(cat.id);
          document.getElementById('uc-from-unit')!.value = fromUnit;
          document.getElementById('uc-to-unit')!.value = toUnit;
          convert();
          updateFavButton();
          updateQuickTable();
          return;
        }
      }
    }
    
    // Search for a single unit
    for (const cat of categories) {
      const found = cat.units.find(u => u.toLowerCase().includes(query));
      if (found) {
        selectCategory(cat.id);
        document.getElementById('uc-from-unit')!.value = found;
        convert();
        updateFavButton();
        updateQuickTable();
        return;
      }
    }
  });

  // ─── Event Listeners ─────────────────────────────────────────────────────────
  document.querySelectorAll('.uc-cat-btn[data-cat]').forEach(btn => {
    btn.addEventListener('click', () => selectCategory((btn as HTMLElement).dataset.cat!));
  });

  fromValue.addEventListener('input', convert);
  fromUnit.addEventListener('change', () => { convert(); updateFavButton(); updateQuickTable(); updateFormula(); });
  toUnit.addEventListener('change', () => { convert(); updateFavButton(); updateQuickTable(); updateFormula(); });

  document.getElementById('uc-swap-btn')!.addEventListener('click', () => {
    const temp = fromUnit.value;
    fromUnit.value = toUnit.value;
    toUnit.value = temp;
    fromValue.value = toValue.value;
    convert();
    updateFavButton();
    updateQuickTable();
    updateFormula();
  });

  // ─── Fetch Live Currency Rates ──────────────────────────────────────────────
  async function fetchCurrencyRates() {
    try {
      const response = await fetch('https://open.er-api.com/v6/latest/USD');
      const data = await response.json();
      if (data.rates) {
        currencyRates = data.rates;
      }
    } catch(e) {
      // Use fallback rates
      currencyRates = fallbackRates;
    }
  }

  // ─── Init ──────────────────────────────────────────────────────────────────
  function init() {
    // Load favorites
    try {
      const saved = localStorage.getItem('uc_favorites');
      if (saved) favorites = JSON.parse(saved);
    } catch(e) {}
    
    // Load currency rates
    fetchCurrencyRates();
    
    // Select default category
    selectCategory('length');
    
    // Render popular grid
    const popularGrid = document.getElementById('uc-popular-grid')!;
    popularGrid.innerHTML = popularConversions.map(p => `
      <div class="uc-popular-card" onclick="loadFavorite('${p.cat}','${p.from}','${p.to}')">
        <span class="uc-popular-icon">🔥</span>
        <span class="uc-popular-text">
          <span class="uc-popular-from">${p.from.split(' (')[0]}</span>
          <span class="uc-popular-arrow">→</span>
          <span class="uc-popular-to">${p.to.split(' (')[0]}</span>
        </span>
      </div>
    `).join('');
  }

  init();

  // ─── FAQ ─────────────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const ans = id ? document.getElementById(id) : null;
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!exp));
      if (ans) ans.classList.toggle('open', !exp);
      if (icon) icon.classList.toggle('open', !exp);
    });
  });
</script>