---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumb from '../components/global/Breadcrumb.astro';
import RelatedCalcs from '../components/calculator/RelatedCalcs.astro';
import { generateBreadcrumb, generateOrganization } from '../utils/seo';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: object | object[];
  breadcrumbs: Array<{ name: string; url: string }>;
  relatedCalcs?: Array<{ name: string; href: string; icon: string; desc: string }>;
}

const { title, description, canonical, schema, breadcrumbs, relatedCalcs } = Astro.props;

const bcSchema = generateBreadcrumb(breadcrumbs);
const orgSchema = generateOrganization();
const schemas = [bcSchema, orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<BaseLayout {title} {description} {canonical} schema={schemas}>
  <Header />
  <main id="main-content">
    <div class="container-site" style="padding-top: 16px; padding-bottom: 8px;">
      <Breadcrumb items={breadcrumbs} />
    </div>
    <div class="container-site" style="padding-top: 8px; padding-bottom: 64px;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 32px;" class="calc-layout-grid">
        <div class="calc-main">
          <slot />
        </div>
        {relatedCalcs && relatedCalcs.length > 0 && (
          <aside class="calc-sidebar">
            <RelatedCalcs calcs={relatedCalcs} />
          </aside>
        )}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @media (min-width: 1024px) {
    .calc-layout-grid {
      grid-template-columns: 1fr 280px !important;
    }
  }
</style>
