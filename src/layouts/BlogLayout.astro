---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumb from '../components/global/Breadcrumb.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  author: string;
  tags?: string[];
  canonical: string;
}

const { title, description, pubDate, category, author, tags, canonical } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: canonical },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'CalcQuick',
    logo: {
      '@type': 'ImageObject',
      url: 'https://calcquick.online/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://calcquick.online${canonical}`,
  },
};
---

<BaseLayout {title} {description} {canonical} schema={articleSchema} ogType="article">
  <Header />
  <main id="main-content">
    <div class="container-site" style="padding-top: 24px; padding-bottom: 8px;">
      <Breadcrumb items={breadcrumbs} />
    </div>

    <article class="blog-article">
      <header class="article-header">
        <div class="article-meta">
          <span class="badge" style="background: var(--color-link-bg); color: var(--color-link); border-color: transparent;">{category}</span>
          <time datetime={pubDate.toISOString()} class="article-date">{formattedDate}</time>
        </div>
        <h1 class="text-display-lg article-title" style="color: var(--color-ink); margin-top: 12px; margin-bottom: 16px;">{title}</h1>
        <p class="article-description text-body-lg" style="color: var(--color-body);">{description}</p>
        
        <div class="article-author-row">
          <div class="author-avatar" aria-hidden="true">{author.charAt(0)}</div>
          <div>
            <div class="author-name">{author}</div>
            <div class="author-label">Author</div>
          </div>
        </div>
      </header>

      <div class="article-divider"></div>

      <div class="article-content prose">
        <slot />
      </div>

      {tags && tags.length > 0 && (
        <div class="article-tags">
          <span class="tags-label">Tags:</span>
          {tags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>
      )}
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }
  .article-header {
    margin-bottom: 32px;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .article-date {
    font-size: 13px;
    color: var(--color-muted);
  }
  .article-author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }
  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
  }
  .author-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .author-label {
    font-size: 11px;
    color: var(--color-muted);
  }
  .article-divider {
    height: 1px;
    background: var(--color-hairline);
    margin: 32px 0;
  }
  
  /* Markdown content styling */
  .article-content {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-body);
  }
  .article-content :global(p) {
    margin-bottom: 24px;
  }
  .article-content :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 40px;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }
  .article-content :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 28px;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }
  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 24px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-content :global(li) {
    color: var(--color-body);
  }
  .article-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .article-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
  }
  .article-content :global(a:hover) {
    color: var(--color-link-deep);
  }
  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-ink);
    padding-left: 20px;
    margin: 32px 0;
    font-style: italic;
    color: var(--color-body);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .tags-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted);
  }
  .tag-pill {
    font-size: 12px;
    color: var(--color-muted);
    background: var(--color-canvas-soft-2);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  @media (max-width: 768px) {
    .blog-article { padding: 16px 16px 64px; }
  }
</style>
